---
import { Search, MessageSquare, CalendarIcon, ImageIcon, Users, Clock, MapPin, ChevronRight } from '@lucide/astro';

interface Props {
  upcomingEvents: any[];
  featuredArticles: any[];
  formatDateShort: (date: Date | null) => string;
  formatTime: (date: Date | null) => string;
  t: (key: string) => string;
}

const { upcomingEvents, featuredArticles, formatDateShort, formatTime, t } = Astro.props;
---

<div class="flex flex-col gap-6 lg:col-span-4">

  {/* Search and Filters */}
  <div class="bg-brand-white border border-black/5 dark:bg-brand-dark-card dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
      <div class="mb-6 relative">
          <input type="text" placeholder={t('publications.sidebar.search')} class="bg-gray-50 border border-black/10 dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none focus:ring-1 focus:ring-brand-gold/50 pl-10 pr-4 py-2.5 rounded-sm text-brand-black text-sm w-full" />
          <Search class="absolute dark:text-gray-400 h-4 left-3 text-gray-400 top-3 w-4" />
      </div>

      <div class="mb-6">
          <h4 class="dark:text-gray-400 font-semibold mb-3 text-gray-600 text-sm">{t('publications.filters.type')}</h4>
          <ul class="space-y-3">
              <li class="bg-brand-gold/10 flex font-medium items-center justify-between p-2 rounded text-brand-gold text-sm">
                  <span class="flex gap-2 items-center"> {t('publications.filters.type.all')}</span>
                  <span>126</span>
              </li>
              <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                  <span class="flex gap-2 items-center"><MessageSquare class="h-4 w-4"/> {t('publications.filters.type.communique')}</span>
                  <span>34</span>
              </li>
              <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                  <span class="flex gap-2 items-center"><CalendarIcon class="h-4 w-4"/> {t('publications.compose.event')}s</span>
                  <span>50</span>
              </li>
              <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                  <span class="flex gap-2 items-center"><ImageIcon class="h-4 w-4"/> {t('publications.filters.type.news')}</span>
                  <span>28</span>
              </li>
          </ul>
      </div>

      <div class="mb-6">
          <h4 class="dark:text-gray-400 font-semibold mb-3 text-gray-600 text-sm">{t('publications.filters.visibility')}</h4>
           <ul class="space-y-3">
              <li class="bg-brand-gold/10 flex font-medium items-center justify-between p-2 rounded text-brand-gold text-sm">
                  <span class="flex gap-2 items-center"> {t('publications.tabs.all')}</span>
                  <span>126</span>
              </li>
              <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                  <span class="flex gap-2 items-center"><Users class="h-4 w-4"/> {t('publications.tabs.public')}</span>
                  <span>80</span>
              </li>
              <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                  <span class="flex gap-2 items-center"><Users class="h-4 w-4"/> {t('publications.filters.visibility.members')}</span>
                  <span>46</span>
              </li>
          </ul>
      </div>

      <div class="space-y-4">
          <div>
              <label class="block dark:text-gray-400 font-semibold mb-2 text-gray-600 text-sm">{t('publications.filters.community')}</label>
              <select class="bg-brand-white border border-black/10 dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none p-2 rounded text-brand-black text-sm w-full">
                  <option>{t('publications.tabs.all')} as comunidades</option>
              </select>
          </div>
          <div>
              <label class="block dark:text-gray-400 font-semibold mb-2 text-gray-600 text-sm">{t('publications.filters.sort')}</label>
              <select class="bg-brand-white border border-black/10 dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none p-2 rounded text-brand-black text-sm w-full">
                  <option>{t('publications.filters.sort.recent')}</option>
              </select>
          </div>
      </div>
  </div>

  {/* Upcoming Events */}
  <div class="bg-brand-white border border-black/5 dark:bg-brand-dark-card dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
      <div class="flex items-center justify-between mb-6">
          <h3 class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest uppercase">Próximos {t('publications.compose.event')}s</h3>
          <a href="/eventos" class="hover:underline text-brand-gold text-xs">{t('publications.sidebar.events.view_all')}</a>
      </div>
      <div class="space-y-4">
          {upcomingEvents.map((event) => (
              <div class="cursor-pointer flex gap-4 group items-start">
                  <div class="bg-brand-white border border-black/10 dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/10 flex flex-col flex-shrink-0 group-hover:border-brand-gold h-12 items-center justify-center rounded transition-colors w-12">
                      <span class="font-bold leading-tight text-brand-gold text-sm">{formatDateShort(event.date as unknown as Date).split(' ')[0]}</span>
                      <span class="dark:text-gray-400 text-[10px] text-gray-600 uppercase">{formatDateShort(event.date as unknown as Date).split(' ')[2]}</span>
                  </div>
                  <div>
                      <h4 class="dark:text-brand-white font-bold group-hover:text-brand-gold text-brand-black text-sm transition-colors">{event.title}</h4>
                      <div class="dark:text-gray-400 flex gap-2 items-center mt-1 text-gray-600 text-xs">
                          <span class="flex items-center"><Clock class="h-3 mr-1 w-3" /> {formatTime(event.date as unknown as Date)}</span>
                          <span class="flex items-center"><MapPin class="h-3 mr-1 w-3" /> {event.location}</span>
                      </div>
                  </div>
              </div>
          ))}
          {upcomingEvents.length === 0 && <p class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-sm">{t('publications.sidebar.events.empty')}</p>}
      </div>
  </div>

  {/* Featured Publications */}
  <div class="bg-brand-white border border-black/5 dark:bg-brand-dark-card dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
      <div class="flex items-center justify-between mb-6">
          <h3 class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest uppercase">{t('publications.sidebar.featured.title')}</h3>
          <a href="/publicacoes" class="hover:underline text-brand-gold text-xs">{t('publications.sidebar.featured.view_all')}</a>
      </div>
      <div class="space-y-4">
           {featuredArticles.map((article) => (
               <div class="cursor-pointer flex gap-3 group">
                   <div class="bg-gray-100 dark:bg-brand-black flex-shrink-0 h-16 overflow-hidden rounded w-16">
                       {article.coverImageUrl ? (
                            <img src={article.coverImageUrl} alt={article.title} class="group-hover:scale-110 h-full object-cover transition-transform w-full" />
                       ) : (
                           <div class="flex h-full items-center justify-center text-brand-gold/20 w-full"><ImageIcon class="h-6 w-6" /></div>
                       )}
                   </div>
                   <div>
                       <h4 class="dark:text-brand-white font-bold group-hover:text-brand-gold leading-tight line-clamp-2 mb-1 text-brand-black text-sm transition-colors">{article.title}</h4>
                       <p class="dark:text-gray-400 text-gray-600 text-xs">{formatDateShort(article.publishedAt as unknown as Date)} • {Math.floor(Math.random() * 500)} reações</p>
                   </div>
               </div>
           ))}
           {featuredArticles.length === 0 && <p class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-sm">{t('publications.sidebar.featured.empty')}</p>}
      </div>
  </div>

  {/* Ecosystem CTA */}
  <div class="bg-brand-white border border-black/5 dark:bg-brand-dark-card dark:bg-brand-dark-card dark:border-white/5 group overflow-hidden p-6 relative rounded-sm">
      <div class="absolute bg-brand-gold/5 inset-0 mix-blend-overlay"></div>
      <div class="flex flex-col items-center relative text-center z-10">
           <div class="bg-brand-gold/10 flex h-12 items-center justify-center mb-4 rounded-full text-brand-gold w-12">
               <Users class="h-6 w-6" />
           </div>
           <h3 class="dark:text-brand-white font-bold mb-2 text-brand-black text-lg">{t('publications.cta.title')}</h3>
           <p class="dark:text-gray-400 mb-6 text-balance text-gray-600 text-sm">{t('publications.cta.desc')}</p>
           <button class="bg-brand-gold dark:text-brand-white flex font-bold hover:bg-brand-gold-dark items-center justify-center px-6 py-3 rounded text-brand-black text-sm tracking-widest transition-colors uppercase w-full">
               {t('publications.cta.btn')} <ChevronRight class="h-4 ml-2 w-4" />
           </button>
      </div>
  </div>

</div>
