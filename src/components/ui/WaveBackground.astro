---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`absolute inset-0 overflow-hidden pointer-events-none z-0 ${className}`}>
  <svg
    class="absolute top-0 left-0 w-full h-full text-brand-black dark:text-brand-gold opacity-[0.03] dark:opacity-[0.08]"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 600"
    preserveAspectRatio="xMidYMid slice"
  >
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Wave Layer 1 -->
      <path d="M-100 250 C 260 50, 460 450, 820 250 C 1180 50, 1380 450, 1540 250" />
      <path d="M-100 270 C 260 70, 460 470, 820 270 C 1180 70, 1380 470, 1540 270" />
      <path d="M-100 290 C 260 90, 460 490, 820 290 C 1180 90, 1380 490, 1540 290" />
      <path d="M-100 310 C 260 110, 460 510, 820 310 C 1180 110, 1380 510, 1540 310" />
      <path d="M-100 330 C 260 130, 460 530, 820 330 C 1180 130, 1380 530, 1540 330" />
      <path d="M-100 350 C 260 150, 460 550, 820 350 C 1180 150, 1380 550, 1540 350" />

      <!-- Wave Layer 2 (Modulating Cross-Waves) -->
      <path d="M-100 300 C 260 500, 460 100, 820 300 C 1180 500, 1380 100, 1540 300" opacity="0.6" />
      <path d="M-100 320 C 260 520, 460 120, 820 320 C 1180 520, 1380 120, 1540 320" opacity="0.6" />
      <path d="M-100 340 C 260 540, 460 140, 820 340 C 1180 540, 1380 140, 1540 340" opacity="0.6" />
    </g>
  </svg>
</div>