---
import { db } from '@/data/db/db';
import { notifications } from '@/data/db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { getSession } from '@/utils/session';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const response = new Response();
const session = await getSession(Astro.request, response);

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

let userNotifications: any[] = [];
let unreadCount = 0;

if (session.userId) {
  userNotifications = await db
    .select()
    .from(notifications)
    .where(eq(notifications.userId, session.userId))
    .orderBy(desc(notifications.createdAt))
    .limit(10);

  unreadCount = userNotifications.filter(n => !n.isRead).length;
}

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(date));
};
---

<div class="inline-block relative" id="notification-bell-container">
  <button id="notification-button" class="dark:text-gray-400 focus-visible focus:outline-none hover:text-brand-gold p-2 relative text-brand-black transition-colors" aria-label="Notificaciones" aria-expanded="false" aria-controls="notification-dropdown">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
    {unreadCount > 0 && (
      <span class="absolute bg-red-500 border-2 border-brand-white dark:border-brand-black h-2.5 right-1 rounded-full top-1 w-2.5"></span>
    )}
  </button>

  <div id="notification-dropdown" class="absolute bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-brand-dark hidden mt-2 origin-top-right overflow-hidden premium-shadow right-0 rounded-sm transform transition-all w-80 z-50">
    <div class="bg-gray-50 border-b border-gray-200 dark:bg-brand-black/50 dark:border-brand-dark flex items-center justify-between p-4">
      <h3 class="dark:text-brand-white font-semibold text-brand-black text-sm tracking-wider uppercase">{t('ui.notification.title')}</h3>
      {unreadCount > 0 && (
        <button id="mark-all-read" class="dark:hover:text-brand-black dark:text-brand-white focus-visible font-semibold hover:text-brand-black text-brand-gold text-xs transition-colors">{t('ui.notification.mark_read')}</button>
      )}
    </div>

    <div class="dark:divide-brand-dark divide-gray-100 divide-y max-h-96 overflow-y-auto">
      {userNotifications.length === 0 ? (
        <div class="dark:text-gray-400 font-semibold p-8 text-center text-gray-500 text-sm">
          No tienes notificaciones.
        </div>
      ) : (
        userNotifications.map(notification => (
          <a
            href={notification.linkUrl || '#'}
            class={`block p-4 hover:bg-gray-50 dark:hover:bg-brand-dark/50 transition-colors focus-visible ${!notification.isRead ? 'bg-brand-gold/10 dark:bg-brand-gold/5 border-l-2 border-brand-gold' : 'border-l-2 border-transparent'}`}
            data-notification-id={notification.id}
          >
            <div class="flex gap-3">
              <div class={`w-2 h-2 mt-1.5 rounded-full flex-shrink-0 transition-colors ${!notification.isRead ? 'bg-brand-gold shadow-[0_0_8px_rgba(212,175,55,0.5)]' : 'bg-transparent'}`}></div>
              <div>
                <p class={`text-sm ${!notification.isRead ? 'text-brand-black dark:text-brand-white font-semibold dark:text-brand-white' : 'text-gray-600 dark:text-gray-300'}`}>
                  {notification.message}
                </p>
                <span class="block dark:text-gray-400 dark:text-gray-500 font-semibold mt-1.5 text-gray-500 text-xs tracking-wider uppercase">{formatDate(notification.createdAt as unknown as Date)}</span>
              </div>
            </div>
          </a>
        ))
      )}
    </div>
  </div>
</div>

<script>
  const button = document.getElementById('notification-button');
  const dropdown = document.getElementById('notification-dropdown');
  const markAllBtn = document.getElementById('mark-all-read');
  const notificationLinks = document.querySelectorAll('a[data-notification-id]');

  if (button && dropdown) {
    button.addEventListener('click', () => {
      dropdown.classList.toggle('hidden');
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!button.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  // Handle Mark All as Read
  if (markAllBtn) {
    markAllBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/notifications/read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ markAll: true })
        });
        // Visual update
        const dots = dropdown?.querySelectorAll('.bg-brand-gold');
        dots?.forEach(dot => {
          dot.classList.remove('bg-brand-gold');
          dot.classList.add('bg-transparent');
        });
        const badge = button?.querySelector('.bg-red-500');
        if (badge) badge.remove();
        markAllBtn.remove();
      } catch (e) {
        console.error(e);
      }
    });
  }

  // Handle individual click marking as read
  notificationLinks.forEach(link => {
    link.addEventListener('click', () => {
      const id = link.getAttribute('data-notification-id');
      fetch('/api/notifications/read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      }).catch(console.error);
    });
  });
</script>