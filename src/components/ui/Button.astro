---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  type = 'button',
  id
} = Astro.props;

const baseStyles = "font-bold text-sm tracking-[0.2em] uppercase px-8 py-4 text-center transition-colors flex items-center justify-center gap-2.5 rounded-sm focus-visible";

const variants = {
  primary: "bg-brand-gold text-brand-black dark:text-brand-white hover:bg-gray-100 dark:bg-brand-black dark:hover:bg-brand-white dark:bg-brand-dark-card hover:text-brand-black dark:text-brand-white dark:hover:text-brand-white dark:hover:text-brand-black dark:text-brand-white",
  outline: "border border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-brand-black dark:text-brand-white",
  ghost: "text-brand-gold hover:text-brand-black dark:text-brand-white dark:hover:text-brand-white"
};

const combinedClasses = `${baseStyles} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={combinedClasses} id={id}>
    <slot />
  </a>
) : (
  <button type={type} class={combinedClasses} id={id}>
    <slot />
  </button>
)}
