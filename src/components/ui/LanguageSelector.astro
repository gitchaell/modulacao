---
// src/components/ui/LanguageSelector.astro
import { getLangFromUrl } from '@/utils/i18n';
const lang = getLangFromUrl(Astro.cookies);

const flags = {
  pt: 'fi-br',
  en: 'fi-us',
  es: 'fi-es'
};
const currentFlag = flags[lang as keyof typeof flags] || 'fi-br';
---
<div class="group h-full relative">
  <div class="cursor-pointer dark:text-brand-white duration-200 flex font-semibold gap-2.5 group-hover:text-brand-gold h-full items-center justify-center px-3 text-brand-black text-sm transition-colors">
    <span class={`fi ${currentFlag} rounded-sm w-5 h-3.5 overflow-hidden inline-block object-cover`}></span>
    {lang.toUpperCase()}
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="duration-200 group-hover:rotate-180 transition-transform"><path d="m6 9 6 6 6-6"/></svg>
  </div>

  <div class="absolute bg-white border border-gray-200 dark:bg-brand-dark dark:border-white/10 duration-200 group-hover:opacity-100 group-hover:visible invisible mt-2 opacity-0 right-0 rounded-sm shadow-lg transition-all w-32 z-50">
    <button class="dark:hover:bg-brand-gold/10 dark:text-brand-white flex gap-2 hover:bg-brand-gold/20 hover:text-brand-gold items-center px-4 py-2 text-brand-black text-left text-sm w-full" data-lang="pt">
      <span class="fi fi-br h-3.5 inline-block object-cover overflow-hidden rounded-sm w-5"></span> PT
    </button>
    <button class="dark:hover:bg-brand-gold/10 dark:text-brand-white flex gap-2 hover:bg-brand-gold/20 hover:text-brand-gold items-center px-4 py-2 text-brand-black text-left text-sm w-full" data-lang="en">
      <span class="fi fi-us h-3.5 inline-block object-cover overflow-hidden rounded-sm w-5"></span> EN
    </button>
    <button class="dark:hover:bg-brand-gold/10 dark:text-brand-white flex gap-2 hover:bg-brand-gold/20 hover:text-brand-gold items-center px-4 py-2 text-brand-black text-left text-sm w-full" data-lang="es">
      <span class="fi fi-es h-3.5 inline-block object-cover overflow-hidden rounded-sm w-5"></span> ES
    </button>
  </div>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-lang]') as HTMLButtonElement;

    if (btn) {
      const lang = btn.dataset.lang;
      if (lang) {
        document.cookie = `lang=${lang}; path=/; max-age=31536000`;

        // Fetch new content without reloading
        try {
          const res = await fetch(window.location.href);
          const html = await res.text();

          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Swap header and main and footer, preserving body class/attributes
          const newHeader = doc.querySelector('header');
          const oldHeader = document.querySelector('header');
          if (newHeader && oldHeader) oldHeader.replaceWith(newHeader);

          const newMain = doc.querySelector('main');
          const oldMain = document.querySelector('main');
          if (newMain && oldMain) oldMain.replaceWith(newMain);

          const newFooter = doc.querySelector('footer');
          const oldFooter = document.querySelector('footer');
          if (newFooter && oldFooter) oldFooter.replaceWith(newFooter);

          // Update title
          document.title = doc.title;
        } catch(err) {
           console.error("Failed to load language without reload, falling back.", err);
           window.location.reload();
        }
      }
    }
  });
</script>