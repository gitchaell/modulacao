---
import { Users, Globe, LayoutGrid, Heart } from '@lucide/astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="border-b border-black/5 dark:border-white/5 gap-4 grid grid-cols-2 md:grid-cols-4 pb-8">
  <div class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 flex flex-col items-center justify-center p-6 rounded-2xl text-center">
    <Users class="h-8 mb-4 text-brand-gold w-8" />
    <span class="dark:text-brand-white font-bold mb-1 text-2xl text-brand-black">{t('about.stats.members')}</span>
    <span class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-xs tracking-wider uppercase">{t('about.stats.members_label')}</span>
  </div>
  <div class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 flex flex-col items-center justify-center p-6 rounded-2xl text-center">
    <Globe class="h-8 mb-4 text-brand-gold w-8" />
    <span class="dark:text-brand-white font-bold mb-1 text-2xl text-brand-black">{t('about.stats.countries')}</span>
    <span class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-xs tracking-wider uppercase">{t('about.stats.countries_label')}</span>
  </div>
  <div class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 flex flex-col items-center justify-center p-6 rounded-2xl text-center">
    <LayoutGrid class="h-8 mb-4 text-brand-gold w-8" />
    <span class="dark:text-brand-white font-bold mb-1 text-2xl text-brand-black">{t('about.stats.projects')}</span>
    <span class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-xs tracking-wider uppercase">{t('about.stats.projects_label')}</span>
  </div>
  <div class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 flex flex-col items-center justify-center p-6 rounded-2xl text-center">
    <Heart class="h-8 mb-4 text-brand-gold w-8" />
    <span class="dark:text-brand-white font-bold mb-1 text-2xl text-brand-black">{t('about.stats.purpose')}</span>
    <span class="dark:text-gray-400 dark:text-gray-500 text-gray-500 dark:text-gray-400 text-xs tracking-wider uppercase">{t('about.stats.purpose_label')}</span>
  </div>
</section>
