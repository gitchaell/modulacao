---
interface Props {
  class?: string;
  noPadding?: boolean;
}
const { class: className, noPadding = false } = Astro.props;
const paddingClass = noPadding ? "" : "p-6";
---
<div class={`bg-brand-dark-card border border-brand-dark/50 rounded-xl shadow-sm ${paddingClass} ${className || ''}`}>
  <slot />
</div>