---
interface Props {
  class?: string;
  noPadding?: boolean;
}
const { class: className, noPadding = false } = Astro.props;
const paddingClass = noPadding ? "" : "p-10";
---
<div class={`relative bg-white dark:bg-brand-dark-card border border-gray-200/50 dark:border-white/5 rounded-sm premium-shadow hover:-translate-y-1 transition-all duration-300 ease-out overflow-hidden group ${paddingClass} ${className || ''}`}>
  <div class="absolute bg-gradient-to-r duration-300 from-transparent group-hover:opacity-50 h-[2px] left-0 opacity-0 pointer-events-none to-transparent top-0 transition-opacity via-brand-gold/10 w-full"></div>
  <div class="relative z-10">
    <slot />
  </div>
</div>