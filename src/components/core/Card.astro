---
interface Props {
  class?: string;
  noPadding?: boolean;
}
const { class: className, noPadding = false } = Astro.props;
const paddingClass = noPadding ? "" : "p-8";
---
<div class={`relative bg-white/80 dark:bg-[#1A1A1A]/80 backdrop-blur-md border border-gray-200/50 dark:border-white/5 rounded-2xl shadow-lg hover:shadow-brand-gold/20 hover:border-brand-gold/30 hover:-translate-y-1 transition-all duration-300 overflow-hidden ${paddingClass} ${className || ''}`}>
  <!-- Subtle inner glow effect for dark mode -->
  <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent opacity-0 dark:opacity-100 pointer-events-none"></div>
  <div class="relative z-10">
    <slot />
  </div>
</div>