---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  as?: 'button' | 'a';
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
}

const {
  as = 'button',
  href,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  class: className,
  ...rest
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-semibold transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-brand-black disabled:opacity-50 disabled:pointer-events-none rounded-sm";

const variants = {
  primary: "bg-brand-gold text-brand-black font-semibold uppercase tracking-widest hover:bg-brand-gold-dark hover:-translate-y-[2px] premium-shadow border border-transparent",
  secondary: "bg-gray-100 dark:bg-brand-dark-card text-brand-black dark:text-white hover:bg-gray-200 dark:hover:bg-[#2A2A2A] border border-black/5 dark:border-white/10 hover:border-black/10 dark:hover:border-white/20 premium-shadow",
  outline: "border border-brand-gold bg-transparent text-brand-gold hover:bg-brand-gold hover:text-brand-black backdrop-blur-sm premium-shadow",
  ghost: "text-brand-gold hover:bg-brand-gold/10"
};

const sizes = {
  sm: "h-8 px-4 text-xs",
  md: "h-10 px-6 py-2 text-sm",
  lg: "h-14 px-10 text-base"
};

const widthClass = fullWidth ? "w-full" : "";

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${widthClass} ${className || ''}`;
---
{as === 'a' ? (
  <a href={href} class={classes} aria-label={rest['aria-label'] || rest.title || undefined} {...rest as any}>
    <slot />
  </a>
) : (
  <button class={classes} aria-label={rest['aria-label'] || rest.title || (typeof Astro.slots.render === 'function' ? undefined : 'Button')} {...rest}>
    <slot />
  </button>
)}