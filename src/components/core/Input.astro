---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'input'> {
  label?: string;
  error?: string;
  helperText?: string;
}

const { label, error, helperText, class: className, id, ...rest } = Astro.props;
const inputId = id || Math.random().toString(36).substring(7);
---
<div class="flex flex-col gap-2 w-full">
  {label && (
    <label for={inputId} class="dark:text-brand-offwhite font-semibold text-brand-black text-sm tracking-wide uppercase">
      {label}
    </label>
  )}
  <input
    id={inputId}
    class={`flex h-12 w-full rounded-sm border bg-white dark:bg-brand-black/50 px-4 py-3 text-sm text-brand-black dark:text-white placeholder:text-gray-500 dark:text-gray-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold disabled:cursor-not-allowed disabled:opacity-50 ${error ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 dark:border-gray-700 hover:border-brand-gold/50'} ${className || ''}`}
    aria-label={label || rest['aria-label']}
    aria-invalid={error ? "true" : "false"}
    aria-required={rest.required ? "true" : undefined}
    aria-describedby={error ? `${inputId}-error` : helperText ? `${inputId}-helper` : undefined}
    {...rest}
  />
  {error && (
    <span id={`${inputId}-error`} class="font-semibold text-red-500 text-xs" role="alert">
      {error}
    </span>
  )}
  {helperText && !error && (
    <span id={`${inputId}-helper`} class="dark:text-gray-400 text-gray-500 text-xs">
      {helperText}
    </span>
  )}
</div>