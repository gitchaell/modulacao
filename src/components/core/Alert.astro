---
interface Props {
  variant?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
  class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

const variants = {
  info: 'bg-blue-50/50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800',
  success: 'bg-green-50/50 dark:bg-green-900/20 text-green-800 dark:text-green-300 border-green-200 dark:border-green-800',
  warning: 'bg-yellow-50/50 dark:bg-yellow-900/20 text-yellow-800 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800',
  error: 'bg-red-50/50 dark:bg-red-900/20 text-red-800 dark:text-red-300 border-red-200 dark:border-red-800'
};
---
<div class={`rounded-sm border p-4 ${variants[variant]} ${className}`} role="alert">
  {title && <h3 class="text-sm font-semibold mb-1 uppercase tracking-wider">{title}</h3>}
  <div class="text-sm opacity-90">
    <slot />
  </div>
</div>