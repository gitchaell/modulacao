---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class={className}>
  <ol class="dark:text-gray-400 flex items-center space-x-2 text-gray-500 text-sm">
    {crumbs.map((crumb, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <svg class="h-4 mx-2 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        )}
        {crumb.href ? (
          <a href={crumb.href} class="hover:text-brand-gold transition-colors">{crumb.label}</a>
        ) : (
          <span class="dark:text-brand-white font-semibold text-brand-black" aria-current="page">{crumb.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
