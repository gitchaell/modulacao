---
// src/components/core/Footer.astro
import SocialLinks from '@/components/ui/SocialLinks.astro';
---
<footer class="py-20 text-base font-semibold border-t border-white/5 bg-[#0a0a0a] text-brand-white mt-auto">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-12 lg:gap-8">

    <!-- Brand Column -->
    <div class="col-span-1 lg:col-span-2 lg:pr-12">
      <div class="flex items-center gap-4 mb-8">
        <svg class="w-12 h-12 text-brand-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <div>
          <div class="font-bold text-sm tracking-widest text-brand-white">MODULAÇÃO</div>
          <div class="font-bold text-sm tracking-widest text-brand-white">SANTA CRUZ</div>
        </div>
      </div>
      <p class="text-base text-gray-400 leading-relaxed max-w-sm">
        Unimos esporte, ciência, arte e propósito para transformar esforço em evolução e resultados em legado.
      </p>

      <SocialLinks class="flex gap-5 mt-8" />
    </div>

    <!-- Links Columns -->
    <div>
      <h4 class="font-bold text-xs uppercase tracking-widest text-brand-gold mb-3">NAVEGAÇÃO</h4>
      <ul class="space-y-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-brand-white transition-colors">Início</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Sobre Nós</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Publicações</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Artigos</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Futebol</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Shop</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Contato</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs uppercase tracking-widest text-brand-gold mb-3">FUTEBOL</h4>
      <ul class="space-y-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-brand-white transition-colors">Equipe</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Campeonatos</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Calendário</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Resultados</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Jogadores</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Estatísticas</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs uppercase tracking-widest text-brand-gold mb-3">MEMBROS</h4>
      <ul class="space-y-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-brand-white transition-colors">Área do Membro</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Eventos</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Perfil</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Planos de Membro</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-xs uppercase tracking-widest text-brand-gold mb-3">INFORMAÇÕES</h4>
      <ul class="space-y-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-brand-white transition-colors">FAQ</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Termos de Uso</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Privacidade</a></li>
        <li><a href="/" class="hover:text-brand-white transition-colors">Política de Cookies</a></li>
      </ul>
    </div>

    <!-- Contact Column -->
    <div class="col-span-1 lg:col-span-1">
      <h4 class="font-bold text-xs uppercase tracking-widest text-brand-gold mb-3">CONTATO</h4>
      <ul class="space-y-3 text-sm text-gray-400">
        <li class="flex items-center gap-2">
          <svg class="text-brand-gold w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <a href="mailto:contato@modulacao.com" class="hover:text-brand-white">contato@modulacao.com</a>
        </li>
        <li class="flex items-center gap-2">
          <svg class="text-brand-gold w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+55 11 9999-9999</span>
        </li>
        <li class="flex items-start gap-2">
          <svg class="text-brand-gold w-4 h-4 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Santa Cruz, Bolívia</span>
        </li>
      </ul>
    </div>

  </div>

  <!-- Copyright -->
  <div class="max-w-[1400px] mx-auto px-6 mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-gray-500">
    <div>&copy; {new Date().getFullYear()} Modulação Dakila. Todos os direitos reservados.</div>
    <div class="flex items-center gap-2.5">
      Parte do Ecossistema Dakila
      <svg class="w-5 h-5 text-brand-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
  </div>
</footer>