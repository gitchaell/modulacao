---
// src/components/core/Footer.astro
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = await useTranslations(lang);
---
<footer class="bg-brand-white border-black/5 border-t dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/5 dark:text-brand-white font-semibold mt-auto py-20 text-base text-brand-black">
  <div class="gap-12 grid grid-cols-1 lg:gap-8 lg:grid-cols-6 lg:px-12 max-w-[1400px] md:grid-cols-2 mx-auto px-6">

    <!-- Brand Column -->
    <div class="col-span-1 lg:col-span-2 lg:pr-12">
      <div class="flex gap-4 items-center mb-8">
        <svg class="h-12 text-brand-gold w-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <div>
          <div class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest">{t('footer.brand.name')}</div>
          <div class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest">{t('footer.brand.location')}</div>
        </div>
      </div>
      <p class="dark:text-gray-400 leading-relaxed max-w-sm text-base text-gray-600">
        {t('footer.brand.desc')}
      </p>

      <SocialLinks class="flex gap-5 mt-8" />
    </div>

    <!-- Links Columns -->
    <div>
      <h4 class="font-bold mb-3 text-brand-gold text-xs tracking-widest uppercase">{t('footer.nav.navigation')}</h4>
      <ul class="dark:text-gray-400 space-y-2 text-gray-600 text-sm">
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Início</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Sobre Nós</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Publicações</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Artigos</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Futebol</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Shop</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Contato</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold mb-3 text-brand-gold text-xs tracking-widest uppercase">{t('footer.nav.football')}</h4>
      <ul class="dark:text-gray-400 space-y-2 text-gray-600 text-sm">
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Equipe</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Campeonatos</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Calendário</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Resultados</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Jogadores</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Estatísticas</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold mb-3 text-brand-gold text-xs tracking-widest uppercase">{t('footer.nav.members')}</h4>
      <ul class="dark:text-gray-400 space-y-2 text-gray-600 text-sm">
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Área do Membro</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Eventos</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Perfil</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Planos de Membro</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold mb-3 text-brand-gold text-xs tracking-widest uppercase">{t('footer.nav.info')}</h4>
      <ul class="dark:text-gray-400 space-y-2 text-gray-600 text-sm">
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">FAQ</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Termos de Uso</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Privacidade</a></li>
        <li><a href="/" class="dark:hover:text-brand-white dark:text-gray-500 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">Política de Cookies</a></li>
      </ul>
    </div>

    <!-- Contact Column -->
    <div class="col-span-1 lg:col-span-1">
      <h4 class="font-bold mb-3 text-brand-gold text-xs tracking-widest uppercase">{t('footer.nav.contact')}</h4>
      <ul class="dark:text-gray-400 space-y-3 text-gray-600 text-sm">
        <li class="flex gap-2 items-center">
          <svg class="h-4 text-brand-gold w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <a href="mailto:contato@modulacao.com" class="dark:text-brand-white hover:text-brand-black text-brand-black">contato@modulacao.com</a>
        </li>
        <li class="flex gap-2 items-center">
          <svg class="h-4 text-brand-gold w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+55 11 9999-9999</span>
        </li>
        <li class="flex gap-2 items-start">
          <svg class="h-4 mt-0.5 text-brand-gold w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Santa Cruz, Bolívia</span>
        </li>
      </ul>
    </div>

  </div>

  <!-- Copyright -->
  <div class="border-black/5 border-t dark:border-white/5 dark:text-gray-400 flex flex-col gap-6 items-center justify-between max-w-[1400px] md:flex-row mt-20 mx-auto pt-8 px-6 text-gray-500 text-sm">
    <div>&copy; {new Date().getFullYear()} {t('footer.copyright')}</div>
    <div class="flex gap-2.5 items-center">
      {t('footer.ecosystem')}
      <svg class="h-5 text-brand-gold w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
  </div>
</footer>