---
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { ChevronRight, Send } from '@lucide/astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<div class="space-y-6">
  <div>
    <h2 class="dark:text-brand-white font-bold font-display mb-2 text-2xl text-brand-black tracking-widest uppercase">{t('contact.form.title2')}</h2>
    <p class="dark:text-gray-400 text-gray-500 dark:text-gray-400 text-sm">{t('contact.form.desc')}</p>
  </div>

  <form id="contact-form" method="POST" action="/api/contacto" class="space-y-6">
    <div id="form-success" class="bg-green-500/10 border border-green-500/20 font-semibold hidden p-4 rounded-sm text-green-500 text-sm">
      {t('contact.form.success')}
    </div>
    <div id="form-error" class="bg-red-500/10 border border-red-500/20 font-semibold hidden p-4 rounded-sm text-red-500 text-sm">
      {t('contact.form.error')}
    </div>

    <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
      <Input type="text" name="name" label="" placeholder={t('contact.form.name.label')} required class="bg-gray-50 border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 placeholder:text-gray-500 dark:text-gray-400 text-brand-black" />
      <Input type="email" name="email" label="" placeholder={t('contact.form.email.label')} required class="bg-gray-50 border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 placeholder:text-gray-500 dark:text-gray-400 text-brand-black" />
    </div>

    <div class="relative">
       <select name="subject" class="appearance-none bg-gray-50 border border-black/10 cursor-pointer dark:bg-brand-dark dark:border-white/10 dark:text-brand-white flex focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold hover:border-brand-gold/50 px-4 py-3 rounded-sm text-brand-black text-sm w-full">
         <option value="" disabled selected>{t('contact.form.subject.label')}</option>
         <option value="duvida">{t('contact.form.subject.opt1')}</option>
         <option value="suporte">{t('contact.form.subject.opt2')}</option>
         <option value="parceria">{t('contact.form.subject.opt3')}</option>
       </select>
       <div class="absolute flex inset-y-0 items-center pointer-events-none px-4 right-0 text-brand-gold">
         <ChevronRight class="h-4 rotate-90 w-4" />
       </div>
    </div>

    <div>
      <textarea
        id="message"
        name="message"
        required
        rows="5"
        placeholder={t('contact.form.message.placeholder')}
        class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 duration-300 flex focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold hover:border-brand-gold/50 placeholder:text-gray-500 dark:text-gray-400 px-4 py-3 rounded-sm text-brand-black text-sm transition-all w-full"
      ></textarea>
    </div>

    <div class="flex gap-3 items-start">
      <input type="checkbox" id="privacy" required class="bg-gray-50 border-black/10 cursor-pointer dark:bg-brand-dark dark:border-white/10 focus:ring-brand-gold mt-1 rounded-sm text-brand-gold" />
      <label for="privacy" class="dark:text-gray-400 text-gray-500 dark:text-gray-400 text-sm">
        {t('contact.form.privacy')} <a href="#" class="hover:underline text-brand-gold">{t('contact.form.privacy.link')}</a>
      </label>
    </div>

    <div class="pt-2">
      <Button type="submit" class="!bg-brand-gold !text-brand-black dark:!text-brand-black dark:text-brand-white flex gap-2 hover:!bg-brand-gold-dark items-center justify-center w-full">
        <Send class="h-4 w-4" /> {t('contact.form.submit')}
      </Button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      const formData = new FormData(form);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        if (res.ok) {
          successMsg?.classList.remove('hidden');
          form.reset();
        } else {
          errorMsg?.classList.remove('hidden');
        }
      } catch (error) {
        errorMsg?.classList.remove('hidden');
      }
    });
  }
</script>
