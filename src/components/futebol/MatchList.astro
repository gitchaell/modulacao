---
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { Calendar, MapPin } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<!-- Próximo Jogo -->
<div>
  <h2 class="dark:text-brand-white font-bold mb-4 text-brand-black text-xl tracking-wide uppercase">{t('futebol.matches.next_match')}</h2>
  <Card class="bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/60 dark:border-white/5 group overflow-hidden relative">
    <div class="absolute bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] duration-500 from-brand-gold/5 group-hover:opacity-100 inset-0 opacity-0 to-transparent transition-opacity via-transparent"></div>

    <div class="mb-8 text-center">
      <div class="dark:text-brand-gray-light dark:text-brand-white/70 mb-1 text-brand-black text-xs tracking-widest uppercase">{t('futebol.matches.champ_name')}</div>
      <div class="font-medium text-brand-gold text-sm uppercase">{t('futebol.matches.phase')}</div>
    </div>

    <div class="flex items-center justify-between mb-8 px-4">
      <div class="flex flex-col items-center">
        <!-- Placeholder for Modulação Dakila logo -->
        <div class="bg-brand-white border border-brand-gold dark:bg-black/30 flex h-20 items-center justify-center mb-3 rounded-full shadow-[0_0_15px_rgba(206,170,105,0.2)] w-20">
          <div class="border border-brand-gold/50 flex h-16 items-center justify-center rounded-full w-16">
             <span class="font-bold leading-tight text-[10px] text-brand-gold text-center">MODULAÇÃO<br/>DAKILA</span>
          </div>
        </div>
        <span class="dark:text-brand-white font-medium text-brand-black text-sm">MODULAÇÃO DAKILA</span>
      </div>

      <div class="font-bold text-2xl text-brand-gold">{t('futebol.matches.vs')}</div>

      <div class="flex flex-col items-center">
        <!-- Placeholder for FC Rivera logo -->
        <div class="bg-brand-white border border-gray-200 dark:bg-black/30 dark:border-white/20 flex h-20 items-center justify-center mb-3 rounded-full w-20">
           <div class="bg-gray-100 border border-gray-100 dark:bg-white/5 dark:border-white/10 flex h-16 items-center justify-center rounded-full w-16">
             <span class="dark:text-brand-white/50 font-bold text-brand-black text-xs uppercase">RIV</span>
           </div>
        </div>
        <span class="dark:text-brand-gray-light dark:text-brand-white/70 font-medium text-brand-black text-sm">FC RIVERA</span>
      </div>
    </div>

    <div class="border-gray-200 border-t dark:border-white/5 flex flex-col gap-3 pt-6">
      <div class="dark:text-brand-gray-light dark:text-brand-white/70 flex gap-2 items-center justify-center text-brand-black text-sm">
        <Calendar class="h-4 text-brand-gold w-4" />
        <span>{t('futebol.matches.date')}</span>
      </div>
      <div class="dark:text-brand-gray-light dark:text-brand-white/70 flex gap-2 items-center justify-center mb-4 text-brand-black text-sm">
        <MapPin class="h-4 text-brand-gold w-4" />
        <span>{t('futebol.matches.location')}</span>
      </div>
      <Button variant="outline" class="border-brand-gold font-bold hover:bg-brand-gold hover:text-black text-brand-gold text-xs tracking-wider uppercase w-full">
        {t('futebol.matches.buy_ticket')}
      </Button>
    </div>
  </Card>
</div>
