---
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { Calendar, MapPin } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<!-- Próximo Jogo -->
<div>
  <h2 class="text-xl font-bold text-brand-black dark:text-brand-white mb-4 tracking-wide uppercase">{t('futebol.matches.next_match')}</h2>
  <Card class="bg-brand-white/80 dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 relative overflow-hidden group">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

    <div class="text-center mb-8">
      <div class="text-xs text-brand-black/70 dark:text-brand-gray-light uppercase tracking-widest mb-1">{t('futebol.matches.champ_name')}</div>
      <div class="text-sm text-brand-gold font-medium uppercase">{t('futebol.matches.phase')}</div>
    </div>

    <div class="flex items-center justify-between mb-8 px-4">
      <div class="flex flex-col items-center">
        <!-- Placeholder for Modulação Dakila logo -->
        <div class="w-20 h-20 rounded-full border border-brand-gold flex items-center justify-center bg-brand-white dark:bg-black/30 mb-3 shadow-[0_0_15px_rgba(206,170,105,0.2)]">
          <div class="w-16 h-16 rounded-full border border-brand-gold/50 flex items-center justify-center">
             <span class="text-[10px] text-brand-gold font-bold text-center leading-tight">MODULAÇÃO<br/>DAKILA</span>
          </div>
        </div>
        <span class="text-sm font-medium text-brand-black dark:text-brand-white">MODULAÇÃO DAKILA</span>
      </div>

      <div class="text-2xl font-bold text-brand-gold">{t('futebol.matches.vs')}</div>

      <div class="flex flex-col items-center">
        <!-- Placeholder for FC Rivera logo -->
        <div class="w-20 h-20 rounded-full border border-gray-200 dark:border-white/20 flex items-center justify-center bg-brand-white dark:bg-black/30 mb-3">
           <div class="w-16 h-16 rounded-full border border-gray-100 dark:border-white/10 flex items-center justify-center bg-gray-100 dark:bg-white/5">
             <span class="text-xs text-brand-black/50 dark:text-brand-white/50 font-bold uppercase">RIV</span>
           </div>
        </div>
        <span class="text-sm font-medium text-brand-black/70 dark:text-brand-gray-light">FC RIVERA</span>
      </div>
    </div>

    <div class="flex flex-col gap-3 pt-6 border-t border-gray-200 dark:border-white/5">
      <div class="flex items-center justify-center gap-2 text-sm text-brand-black/70 dark:text-brand-gray-light">
        <Calendar class="w-4 h-4 text-brand-gold" />
        <span>{t('futebol.matches.date')}</span>
      </div>
      <div class="flex items-center justify-center gap-2 text-sm text-brand-black/70 dark:text-brand-gray-light mb-4">
        <MapPin class="w-4 h-4 text-brand-gold" />
        <span>{t('futebol.matches.location')}</span>
      </div>
      <Button variant="outline" class="w-full border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-black uppercase text-xs font-bold tracking-wider">
        {t('futebol.matches.buy_ticket')}
      </Button>
    </div>
  </Card>
</div>
