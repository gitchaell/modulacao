---
import Card from '@/components/core/Card.astro';
import Avatar from '@/components/core/Avatar.astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-8">
  <!-- Classificação -->
  <div>
    <h2 class="text-xl font-bold text-brand-black dark:text-brand-white mb-4 tracking-wide uppercase">{t('futebol.standings.title')}</h2>
    <Card noPadding class="bg-brand-white/80 dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 overflow-hidden">
      <div class="bg-brand-white dark:bg-brand-dark-card p-4 border-b border-gray-200 dark:border-white/5 flex items-center justify-between">
        <span class="font-bold text-brand-black dark:text-brand-white">{t('futebol.standings.group')}</span>
        <div class="flex gap-4 text-xs font-medium text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/70">
          <span class="w-6 text-center" title="Pontos">{t('futebol.standings.pts')}</span>
          <span class="w-6 text-center hidden sm:block" title="Jogos">{t('futebol.standings.j')}</span>
          <span class="w-6 text-center" title="Vitórias">{t('futebol.standings.v')}</span>
          <span class="w-6 text-center hidden sm:block" title="Empates">{t('futebol.standings.e')}</span>
          <span class="w-6 text-center hidden sm:block" title="Derrotas">{t('futebol.standings.d')}</span>
          <span class="w-6 text-center" title="Saldo de Gols">{t('futebol.standings.sg')}</span>
        </div>
      </div>

      <div class="divide-y divide-gray-100 dark:divide-white/5">
        <!-- Team 1 (Modulação) -->
        <div class="p-4 flex items-center justify-between bg-brand-gold/5 border-l-2 border-brand-gold">
          <div class="flex items-center gap-3">
            <span class="text-brand-gold font-bold w-4 text-center">1</span>
            <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center border border-brand-gold/30">
               <span class="text-[8px] text-brand-gold font-bold">MD</span>
            </div>
            <span class="font-medium text-brand-black dark:text-brand-white text-sm">Modulação Dakila</span>
          </div>
          <div class="flex gap-4 text-sm">
            <span class="w-6 text-center font-bold text-brand-black dark:text-brand-white">12</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">4</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">4</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">0</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">0</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">+8</span>
          </div>
        </div>

        <!-- Team 2 -->
        <div class="p-4 flex items-center justify-between hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-3">
            <span class="text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/50 font-bold w-4 text-center">2</span>
            <div class="w-6 h-6 rounded-full bg-gray-100 dark:bg-white/10 flex items-center justify-center border border-gray-200 dark:border-white/10"></div>
            <span class="font-medium text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light text-sm">Atlético Central</span>
          </div>
          <div class="flex gap-4 text-sm">
            <span class="w-6 text-center font-bold text-brand-black dark:text-brand-white">7</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">4</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">2</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">1</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">1</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">+2</span>
          </div>
        </div>

        <!-- Team 3 -->
        <div class="p-4 flex items-center justify-between hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-3">
            <span class="text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/50 font-bold w-4 text-center">3</span>
            <div class="w-6 h-6 rounded-full bg-gray-100 dark:bg-white/10 flex items-center justify-center border border-gray-200 dark:border-white/10"></div>
            <span class="font-medium text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light text-sm">FC Rivera</span>
          </div>
          <div class="flex gap-4 text-sm">
            <span class="w-6 text-center font-bold text-brand-black dark:text-brand-white">4</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">4</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">1</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">1</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light hidden sm:block">2</span>
            <span class="w-6 text-center text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">-3</span>
          </div>
        </div>
      </div>
    </Card>
  </div>

  <!-- Artilheiros -->
  <div>
    <h2 class="text-xl font-bold text-brand-black dark:text-brand-white mb-4 tracking-wide uppercase">{t('futebol.scorers.title')}</h2>
    <Card noPadding class="bg-brand-white/80 dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 overflow-hidden">
      <div class="bg-brand-white dark:bg-brand-dark-card p-4 border-b border-gray-200 dark:border-white/5 flex items-center">
        <span class="w-10 text-xs font-medium text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/70">{t('futebol.scorers.pos')}</span>
        <span class="flex-1 text-xs font-medium text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/70">{t('futebol.scorers.player')}</span>
        <span class="w-16 text-center text-xs font-medium text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/70">{t('futebol.scorers.matches')}</span>
        <span class="w-16 text-center text-xs font-medium text-brand-black dark:text-brand-white/50 dark:text-brand-gray-light/70">{t('futebol.scorers.goals')}</span>
      </div>

      <div class="divide-y divide-gray-100 dark:divide-white/5">
        <!-- Scorer 1 -->
        <div class="p-4 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center bg-brand-gold/5 border-l-2 border-brand-gold group">
          <div class="w-6 text-center font-bold text-brand-gold text-lg">1</div>
          <div class="flex items-center gap-3">
            <Avatar alt="Lucas Silva" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&q=80&w=100&h=100" />
            <div>
              <div class="text-sm font-medium text-brand-black dark:text-brand-white leading-tight">Lucas Silva</div>
              <div class="text-xs text-brand-gold">Modulação Dakila</div>
            </div>
          </div>
          <div class="w-16 text-center text-sm text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">4</div>
          <div class="w-16 text-center font-bold text-brand-gold text-xl">6</div>
        </div>

        <!-- Scorer 2 -->
        <div class="p-4 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center hover:bg-gray-100 dark:hover:bg-white/5 transition-colors group">
          <div class="w-6 text-center font-medium text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light text-lg group-hover:text-brand-black dark:text-brand-white dark:group-text-gray-400 dark:text-gray-500 hover:text-brand-black dark:hover:text-brand-white transition-colors">2</div>
          <div class="flex items-center gap-3">
            <Avatar alt="Marcos Costa" src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&q=80&w=100&h=100" />
            <div>
              <div class="text-sm font-medium text-brand-black dark:text-brand-white leading-tight">Marcos Costa</div>
              <div class="text-xs text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light group-hover:text-brand-black dark:text-brand-white dark:group-hover:text-brand-black dark:text-white transition-colors">Atlético Central</div>
            </div>
          </div>
          <div class="w-16 text-center text-sm text-brand-black dark:text-brand-white/70 dark:text-brand-gray-light">4</div>
          <div class="w-16 text-center font-bold text-brand-gold text-xl">5</div>
        </div>
      </div>
    </Card>
  </div>
</div>
