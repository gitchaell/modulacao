---
import Button from '@/components/core/Button.astro';
import { Users, ChevronRight } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<div class="bg-brand-white border border-brand-gold/20 dark:bg-brand-dark-card/80 flex flex-col gap-8 items-center justify-between md:flex-row md:p-12 overflow-hidden p-8 relative rounded-xl">
  <div class="absolute bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] inset-0 mix-blend-overlay opacity-5"></div>
  <div class="absolute bg-gradient-to-l from-brand-gold/10 h-full pointer-events-none right-0 to-transparent top-0 w-1/2"></div>

  <div class="flex gap-6 items-center relative z-10">
    <div class="bg-brand-gold/10 border border-brand-gold/30 flex h-16 items-center justify-center rounded-full text-brand-gold w-16">
      <Users class="h-8 w-8" />
    </div>
    <div>
      <h2 class="dark:text-brand-white font-bold mb-2 md:text-3xl text-2xl text-brand-black">{t('futebol.cta.title')}</h2>
      <p class="dark:text-brand-gray-light dark:text-brand-white/70 md:text-base text-brand-black text-sm">
        {t('futebol.cta.desc')}
      </p>
    </div>
  </div>

  <div class="md:w-auto relative w-full z-10">
    <Button class="bg-brand-gold dark:text-brand-white font-bold hover:bg-brand-gold/90 hover:shadow-[0_0_30px_rgba(206,170,105,0.5)] md:w-auto px-8 py-4 shadow-[0_0_20px_rgba(206,170,105,0.3)] text-brand-black text-sm tracking-wider transition-all uppercase w-full">
      {t('futebol.cta.btn')} <ChevronRight class="h-4 inline ml-2 w-4" />
    </Button>
  </div>
</div>
