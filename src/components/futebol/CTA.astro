---
import Button from '@/components/core/Button.astro';
import { Users, ChevronRight } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<div class="relative overflow-hidden rounded-xl border border-brand-gold/20 bg-brand-white dark:bg-brand-dark-card/80 p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
  <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5 mix-blend-overlay"></div>
  <div class="absolute right-0 top-0 w-1/2 h-full bg-gradient-to-l from-brand-gold/10 to-transparent pointer-events-none"></div>

  <div class="relative z-10 flex items-center gap-6">
    <div class="w-16 h-16 rounded-full border border-brand-gold/30 flex items-center justify-center bg-brand-gold/10 text-brand-gold">
      <Users class="w-8 h-8" />
    </div>
    <div>
      <h2 class="text-2xl md:text-3xl font-bold text-brand-black dark:text-brand-white mb-2">{t('futebol.cta.title')}</h2>
      <p class="text-brand-black/70 dark:text-brand-gray-light text-sm md:text-base">
        {t('futebol.cta.desc')}
      </p>
    </div>
  </div>

  <div class="relative z-10 w-full md:w-auto">
    <Button class="w-full md:w-auto bg-brand-gold text-brand-black hover:bg-brand-gold/90 font-bold px-8 py-4 uppercase tracking-wider text-sm transition-all shadow-[0_0_20px_rgba(206,170,105,0.3)] hover:shadow-[0_0_30px_rgba(206,170,105,0.5)]">
      {t('futebol.cta.btn')} <ChevronRight class="w-4 h-4 ml-2 inline" />
    </Button>
  </div>
</div>
