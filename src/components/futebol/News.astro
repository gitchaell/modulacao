---
import Card from '@/components/core/Card.astro';
import { Play } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Últimas Notícias -->
  <div class="lg:col-span-8">
    <h2 class="text-xl font-bold text-brand-black dark:text-brand-white mb-4 tracking-wide uppercase">{t('futebol.news.title')}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- News Card 1 -->
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 group h-full flex flex-col">
        <div class="relative h-48 w-full overflow-hidden">
          <img src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&q=80&w=800" alt="Time celebrando" class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
          <div class="absolute top-4 left-4">
            <div class="px-2 py-1 text-[10px] font-bold tracking-widest bg-black/80 backdrop-blur-md border border-white/10 text-brand-gold rounded-sm uppercase">{t('futebol.news.card1.badge')}</div>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-lg font-bold text-brand-black dark:text-brand-white mb-2 group-hover:text-brand-gold transition-colors leading-snug">
            {t('futebol.news.card1.title')}
          </h3>
          <p class="text-sm text-brand-black/70 dark:text-brand-gray-light mb-4 line-clamp-2 flex-1">
            {t('futebol.news.card1.desc')}
          </p>
          <div class="flex items-center gap-4 text-xs text-brand-black/50 dark:text-brand-gray-light/70 uppercase tracking-wide">
            <span>{t('futebol.news.card1.date')}</span>
            <span class="w-1 h-1 rounded-full bg-brand-gold/50"></span>
            <span>{t('futebol.news.card1.read_time')}</span>
          </div>
        </div>
      </Card>

      <!-- News Card 2 Stacked -->
      <div class="flex flex-col gap-6">
        <!-- News Card 2a -->
        <Card noPadding class="bg-brand-white dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 group flex-1">
           <div class="relative h-32 w-full overflow-hidden">
              <img src="https://images.unsplash.com/photo-1543326727-cf6c39e8f84c?auto=format&fit=crop&q=80&w=600" alt="Treino" class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
              <div class="absolute top-3 left-3">
                <div class="px-2 py-1 text-[10px] font-bold tracking-widest bg-black/80 backdrop-blur-md border border-white/10 text-white rounded-sm uppercase">{t('futebol.news.card2.badge')}</div>
              </div>
           </div>
           <div class="p-4">
             <h3 class="text-base font-bold text-brand-black dark:text-brand-white mb-2 group-hover:text-brand-gold transition-colors leading-tight line-clamp-2">
               {t('futebol.news.card2.title')}
             </h3>
             <p class="text-xs text-brand-black/70 dark:text-brand-gray-light mb-3 line-clamp-2">
               {t('futebol.news.card2.desc')}
             </p>
             <div class="flex items-center gap-3 text-[10px] text-brand-black/50 dark:text-brand-gray-light/70 uppercase tracking-wide">
                <span>{t('futebol.news.card2.date')}</span>
                <span class="w-1 h-1 rounded-full bg-brand-gold/50"></span>
                <span>{t('futebol.news.card2.read_time')}</span>
             </div>
           </div>
        </Card>

        <!-- News Card 2b -->
        <Card noPadding class="bg-brand-white dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 group flex-1">
           <div class="relative h-32 w-full overflow-hidden">
              <img src="https://images.unsplash.com/photo-1517466787929-bc90951d0974?auto=format&fit=crop&q=80&w=600" alt="Base" class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
              <div class="absolute top-3 left-3">
                <div class="px-2 py-1 text-[10px] font-bold tracking-widest bg-black/80 backdrop-blur-md border border-white/10 text-white rounded-sm uppercase">{t('futebol.news.card3.badge')}</div>
              </div>
           </div>
           <div class="p-4">
             <h3 class="text-base font-bold text-brand-black dark:text-brand-white mb-2 group-hover:text-brand-gold transition-colors leading-tight line-clamp-2">
               {t('futebol.news.card3.title')}
             </h3>
             <p class="text-xs text-brand-black/70 dark:text-brand-gray-light mb-3 line-clamp-2">
               {t('futebol.news.card3.desc')}
             </p>
             <div class="flex items-center gap-3 text-[10px] text-brand-black/50 dark:text-brand-gray-light/70 uppercase tracking-wide">
                <span>{t('futebol.news.card3.date')}</span>
                <span class="w-1 h-1 rounded-full bg-brand-gold/50"></span>
                <span>{t('futebol.news.card3.read_time')}</span>
             </div>
           </div>
        </Card>
      </div>
    </div>
  </div>

  <!-- Destaques -->
  <div class="lg:col-span-4">
    <h2 class="text-xl font-bold text-brand-black dark:text-brand-white mb-4 tracking-wide uppercase">{t('futebol.highlights.title')}</h2>

    <Card noPadding class="bg-brand-white dark:bg-brand-dark-card/60 border border-gray-200 dark:border-white/5 group h-full flex flex-col">
      <div class="relative flex-1 min-h-[250px] w-full overflow-hidden">
        <img src="https://images.unsplash.com/photo-1508344928928-7155b67de238?auto=format&fit=crop&q=80&w=600" alt="Video highlight" class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-500"></div>

        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-14 h-14 rounded-full bg-black/50 backdrop-blur-md border border-white/20 flex items-center justify-center text-white cursor-pointer group-hover:scale-110 group-hover:bg-brand-gold group-hover:border-brand-gold group-hover:text-black transition-all duration-300">
            <Play class="w-6 h-6 ml-1" />
          </div>
        </div>
      </div>

      <div class="p-6 bg-brand-white dark:bg-brand-dark-card border-t border-gray-200 dark:border-white/5">
        <h3 class="text-base font-bold text-brand-black dark:text-brand-white mb-3 group-hover:text-brand-gold transition-colors leading-tight">
          {t('futebol.highlights.card.title')}
        </h3>
        <div class="flex items-center gap-4 text-[10px] text-brand-black/50 dark:text-brand-gray-light/70 uppercase tracking-wide">
          <span>{t('futebol.highlights.card.date')}</span>
          <span class="w-1 h-1 rounded-full bg-brand-gold/50"></span>
          <span>{t('futebol.highlights.card.duration')}</span>
        </div>
      </div>
    </Card>
  </div>
</div>
