---
import { LayoutDashboard, Users, Trophy, CalendarDays, ChartBar } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<section class="max-w-7xl mx-auto px-4 mb-12 border-b border-black/10 dark:border-white/10">
  <div class="flex overflow-x-auto space-x-8 no-scrollbar">
    <a href="#" class="text-brand-gold border-b-2 border-brand-gold pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <LayoutDashboard class="w-5 h-5" />
      {t('futebol.tabs.overview')}
    </a>
    <a href="#" class="text-brand-black/70 dark:text-brand-gray-light hover:text-brand-black dark:hover:text-brand-white pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <Users class="w-5 h-5" />
      {t('futebol.tabs.teams')}
    </a>
    <a href="#" class="text-brand-black/70 dark:text-brand-gray-light hover:text-brand-black dark:hover:text-brand-white pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <Trophy class="w-5 h-5" />
      {t('futebol.tabs.championships')}
    </a>
    <a href="#" class="text-brand-black/70 dark:text-brand-gray-light hover:text-brand-black dark:hover:text-brand-white pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <CalendarDays class="w-5 h-5" />
      {t('futebol.tabs.calendar')}
    </a>
    <a href="#" class="text-brand-black/70 dark:text-brand-gray-light hover:text-brand-black dark:hover:text-brand-white pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <Users class="w-5 h-5" />
      {t('futebol.tabs.players')}
    </a>
    <a href="#" class="text-brand-black/70 dark:text-brand-gray-light hover:text-brand-black dark:hover:text-brand-white pb-4 px-2 whitespace-nowrap font-medium flex items-center gap-2 transition-colors">
      <ChartBar class="w-5 h-5" />
      {t('futebol.tabs.stats')}
    </a>
  </div>
</section>
