---
import { LayoutDashboard, Users, Trophy, CalendarDays, ChartBar } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<section class="border-b border-black/10 dark:border-white/10 max-w-7xl mb-12 mx-auto px-4">
  <div class="flex no-scrollbar overflow-x-auto space-x-8">
    <a href="#" class="border-b-2 border-brand-gold flex font-medium gap-2 items-center pb-4 px-2 text-brand-gold transition-colors whitespace-nowrap">
      <LayoutDashboard class="h-5 w-5" />
      {t('futebol.tabs.overview')}
    </a>
    <a href="#" class="dark:hover:text-brand-black dark:text-brand-gray-light dark:text-brand-white dark:text-brand-white/70 flex font-medium gap-2 hover:text-brand-black items-center pb-4 px-2 text-brand-black transition-colors whitespace-nowrap">
      <Users class="h-5 w-5" />
      {t('futebol.tabs.teams')}
    </a>
    <a href="#" class="dark:hover:text-brand-black dark:text-brand-gray-light dark:text-brand-white dark:text-brand-white/70 flex font-medium gap-2 hover:text-brand-black items-center pb-4 px-2 text-brand-black transition-colors whitespace-nowrap">
      <Trophy class="h-5 w-5" />
      {t('futebol.tabs.championships')}
    </a>
    <a href="#" class="dark:hover:text-brand-black dark:text-brand-gray-light dark:text-brand-white dark:text-brand-white/70 flex font-medium gap-2 hover:text-brand-black items-center pb-4 px-2 text-brand-black transition-colors whitespace-nowrap">
      <CalendarDays class="h-5 w-5" />
      {t('futebol.tabs.calendar')}
    </a>
    <a href="#" class="dark:hover:text-brand-black dark:text-brand-gray-light dark:text-brand-white dark:text-brand-white/70 flex font-medium gap-2 hover:text-brand-black items-center pb-4 px-2 text-brand-black transition-colors whitespace-nowrap">
      <Users class="h-5 w-5" />
      {t('futebol.tabs.players')}
    </a>
    <a href="#" class="dark:hover:text-brand-black dark:text-brand-gray-light dark:text-brand-white dark:text-brand-white/70 flex font-medium gap-2 hover:text-brand-black items-center pb-4 px-2 text-brand-black transition-colors whitespace-nowrap">
      <ChartBar class="h-5 w-5" />
      {t('futebol.tabs.stats')}
    </a>
  </div>
</section>
