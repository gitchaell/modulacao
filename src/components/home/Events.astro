---
import { usePageTranslations,  getLangFromUrl } from '@/utils/i18n';
// src/components/home/Events.astro

import Typography from '@/components/core/Typography.astro';
import Button from '@/components/core/Button.astro';
import { Calendar, MapPin, Clock, ArrowRight } from '@lucide/astro';

interface Props {
  pageDict: Record<string, string>;
}
const { pageDict } = Astro.props;
const lang = getLangFromUrl(Astro.cookies);
const t = usePageTranslations(pageDict, lang);

const events = [
  {
    id: 1,
    date: { day: '15', month: t('home.events.month1') },
    category: t('home.events.cat1'),
    title: t('home.events.event1.title'),
    location: t('home.events.event1.location'),
    time: '16:00',
    type: 'event'
  },
  {
    id: 2,
    date: { day: '22', month: t('home.events.month1') },
    category: t('home.events.cat2'),
    title: t('home.events.event2.title'),
    location: t('home.events.event2.location'),
    time: '15:30',
    type: 'match',
    teams: { home: 'MODULAÇÃO', away: 'FC RIVERA' }
  },
  {
    id: 3,
    date: { day: '05', month: t('home.events.month2') },
    category: t('home.events.cat3'),
    title: t('home.events.event3.title'),
    location: t('home.events.event3.location'),
    time: '09:00',
    type: 'event'
  },
  {
    id: 4,
    date: { day: '18', month: t('home.events.month2') },
    category: t('home.events.cat4'),
    title: t('home.events.event4.title'),
    location: t('home.events.event4.location'),
    time: '14:00',
    type: 'match',
    teams: { home: 'MODULAÇÃO', away: 'ATLÉTICO SUL' }
  }
];
---
<section class="bg-brand-white border-black/5 border-y dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/5 overflow-hidden py-24 relative">
  <div class="-left-40 absolute bg-brand-gold/5 blur-3xl h-96 rounded-full top-40 w-96"></div>

  <div class="container max-w-[1400px] mx-auto px-6 relative z-10">
    <div class="flex flex-col gap-6 justify-between mb-16 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <Typography variant="h6" class="flex font-bold gap-3 items-center mb-3 text-brand-gold text-sm tracking-[0.2em] uppercase">
          <span class="bg-brand-gold h-[2px] w-12"></span>
          {t('home.events.subtitle')}
        </Typography>
        <Typography variant="h2" class="dark:text-brand-white font-bold font-display md:text-5xl text-4xl text-brand-black tracking-tight uppercase">
          {t('home.events.title')}
        </Typography>
      </div>
      <Button as="a" href="/eventos" variant="outline" class="hidden md:flex whitespace-nowrap">
        {t('home.events.btn')}
      </Button>
    </div>

    <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
      {events.map(event => (
        <a href={`/eventos/${event.id}`} class="bg-brand-offwhite border border-black/5 dark:bg-brand-dark dark:border-white/5 duration-300 flex flex-col group hover:border-brand-gold/50 hover:shadow-md overflow-hidden shadow-sm sm:flex-row transition-all">
          {/* Date Block */}
          <div class="bg-gray-100 dark:bg-brand-black border-b border-gray-200 dark:bg-brand-dark-card dark:bg-brand-dark dark:border-white/10 dark:hover:text-brand-white dark:text-brand-white dark:text-gray-500 duration-300 flex flex-row group-hover:bg-brand-gold group-text-gray-500 dark:text-gray-400 hover:text-brand-black items-center justify-between p-6 sm:border-b-0 sm:border-r sm:flex-col sm:justify-center sm:w-32 text-brand-black transition-colors">
            <span class="font-bold text-sm tracking-widest uppercase">{event.date.month}</span>
            <span class="font-bold font-display sm:text-5xl text-4xl">{event.date.day}</span>
          </div>

          {/* Content Block */}
          <div class="flex flex-1 flex-col justify-center p-6 sm:p-8">
            <div class="mb-4">
              <span class="bg-white/10 border border-black/5 dark:border-white/10 dark:text-brand-white font-extrabold inline-block px-3 py-1.5 rounded-sm text-brand-black text-xs tracking-[0.2em] uppercase">
                {event.category}
              </span>
            </div>

            {event.type === 'match' ? (
              <div class="flex gap-4 items-center mb-4">
                <span class="dark:text-brand-white font-bold font-display text-brand-black text-xl">{event.teams?.home}</span>
                <span class="font-bold text-brand-gold text-sm">X</span>
                <span class="dark:text-brand-white/60 font-bold font-display text-brand-black text-xl">{event.teams?.away}</span>
              </div>
            ) : (
              <h3 class="dark:text-brand-white font-bold font-display group-hover:text-brand-gold line-clamp-2 mb-4 text-2xl text-brand-black transition-colors">
                {event.title}
              </h3>
            )}

            <div class="flex flex-col gap-4 mt-auto sm:flex-row">
              <div class="dark:text-gray-400 flex gap-2 items-center text-gray-600 text-sm">
                <MapPin class="h-4 text-brand-gold w-4" />
                <span class="truncate">{event.location}</span>
              </div>
              <div class="dark:text-gray-400 flex gap-2 items-center text-gray-600 text-sm">
                <Clock class="h-4 text-brand-gold w-4" />
                <span>{event.time}</span>
              </div>
            </div>
          </div>

          {/* Arrow */}
          <div class="border-black/5 border-l dark:border-white/5 group-hover:border-brand-gold/20 hidden items-center justify-center px-6 sm:flex transition-colors">
            <ArrowRight class="dark:text-white/20 duration-300 group-hover:text-brand-gold group-hover:translate-x-2 h-6 text-gray-600 dark:text-gray-300 transition-all w-6" />
          </div>
        </a>
      ))}
    </div>

    <Button as="a" href="/eventos" variant="outline" class="flex justify-center md:hidden mt-8 w-full">
      {t('home.events.btn')}
    </Button>
  </div>
</section>
