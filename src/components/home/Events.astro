---
// src/components/home/Events.astro
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="py-24 bg-[#0a0a0a]">
  <div class="container mx-auto px-6 lg:px-12 max-w-[1400px]">
    <div class="flex justify-between items-center mb-12 border-b border-white/10 pb-5">
      <div class="flex items-center gap-5">
        <h2 class="text-lg md:text-xl font-display font-bold text-brand-white uppercase tracking-widest">
          {t('home.events.title')}
        </h2>
        <div class="h-[3px] w-16 bg-brand-gold"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Upcoming Events List -->
      <div class="border border-white/5 bg-[#0d0d0d] p-10 rounded-sm">
        <h3 class="text-[14px] font-bold text-gray-500 uppercase tracking-widest mb-10">{t('home.events.events_subtitle')}</h3>

        <div class="space-y-8">
          <!-- Event Item 1 -->
          <div class="flex gap-8 items-start pb-8 border-b border-white/5">
            <div class="flex flex-col items-center justify-center min-w-[60px]">
              <span class="text-3xl font-bold text-brand-gold leading-none">25</span>
              <span class="text-[12px] font-bold text-brand-gold uppercase tracking-[0.2em] mt-2">MAI</span>
            </div>
            <div>
              <h4 class="font-bold text-brand-white text-[17px] mb-2 hover:text-brand-gold transition-colors cursor-pointer">Encontro de Práticas</h4>
              <div class="flex items-center gap-3 text-[13px] text-gray-400 uppercase tracking-wider font-medium">
                <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 16:00</span>
                <span>•</span>
                <span>Arena Dakila - Santa Cruz, BO</span>
              </div>
            </div>
          </div>

          <!-- Event Item 2 -->
          <div class="flex gap-8 items-start pb-8 border-b border-white/5">
            <div class="flex flex-col items-center justify-center min-w-[60px]">
              <span class="text-3xl font-bold text-brand-gold leading-none">01</span>
              <span class="text-[12px] font-bold text-brand-gold uppercase tracking-[0.2em] mt-2">JUN</span>
            </div>
            <div>
              <h4 class="font-bold text-brand-white text-[17px] mb-2 hover:text-brand-gold transition-colors cursor-pointer">Workshop de Filosofia</h4>
              <div class="flex items-center gap-3 text-[13px] text-gray-400 uppercase tracking-wider font-medium">
                <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 09:00</span>
                <span>•</span>
                <span>Centro de Treinamento</span>
              </div>
            </div>
          </div>

          <!-- Event Item 3 -->
          <div class="flex gap-8 items-start pb-2">
            <div class="flex flex-col items-center justify-center min-w-[60px]">
              <span class="text-3xl font-bold text-brand-gold leading-none">08</span>
              <span class="text-[12px] font-bold text-brand-gold uppercase tracking-[0.2em] mt-2">JUN</span>
            </div>
            <div>
              <h4 class="font-bold text-brand-white text-[17px] mb-2 hover:text-brand-gold transition-colors cursor-pointer">Vivência: Consciência e Ação</h4>
              <div class="flex items-center gap-3 text-[13px] text-gray-400 uppercase tracking-wider font-medium">
                <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 14:00</span>
                <span>•</span>
                <span>Espaço Aberto</span>
              </div>
            </div>
          </div>
        </div>

        <a href="/eventos" class="block w-full text-center mt-10 py-4 border border-white/10 text-brand-gold text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-white/5 transition-colors rounded-sm">
          {t('home.events.view_all')}
        </a>
      </div>

      <!-- Next Match -->
      <div class="border border-white/5 bg-[#0d0d0d] p-10 flex flex-col relative overflow-hidden rounded-sm">
        <div class="absolute top-0 right-0 p-10 opacity-[0.03]">
          <svg class="w-80 h-80 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>

        <div class="flex justify-between items-center mb-12 relative z-10">
          <h3 class="text-[14px] font-bold text-gray-500 uppercase tracking-widest">{t('home.events.matches_subtitle')}</h3>
          <span class="text-[11px] font-bold text-brand-white bg-white/10 px-4 py-2 uppercase tracking-[0.2em] rounded-sm">FASE DE GRUPOS</span>
        </div>

        <div class="flex-1 flex flex-col justify-center relative z-10">
          <div class="flex items-center justify-center gap-10 mb-12">
            <div class="flex flex-col items-center">
              <div class="w-32 h-32 rounded-full border border-brand-gold bg-[#0a0a0a] flex items-center justify-center mb-5 p-6 shadow-[0_0_25px_rgba(212,175,55,0.2)]">
                <svg class="w-full h-full text-brand-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <span class="text-brand-white font-bold text-[15px] uppercase tracking-wider">MODULAÇÃO</span>
            </div>

            <div class="text-3xl font-display font-bold text-gray-600 mb-8">VS</div>

            <div class="flex flex-col items-center">
              <div class="w-32 h-32 rounded-full border border-white/20 bg-[#111] flex items-center justify-center mb-5 p-6">
                <svg class="w-full h-full text-brand-white opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/></svg>
              </div>
              <span class="text-gray-400 font-bold text-[15px] uppercase tracking-wider">FC RIVERA</span>
            </div>
          </div>

          <div class="flex flex-wrap justify-center items-center gap-8 text-[13px] font-medium text-gray-400 uppercase tracking-widest mb-10">
            <span class="flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> 28 MAI, 2024</span>
            <span class="flex items-center gap-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 15:30</span>
            <span class="flex items-center gap-2.5 text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> ARENA DAKILA</span>
          </div>
        </div>

        <a href="#" class="block w-full text-center mt-auto py-4 border border-white/10 text-brand-gold text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-white/5 transition-colors relative z-10 rounded-sm">
          {t('home.events.match_details')}
        </a>
      </div>
    </div>
  </div>
</section>