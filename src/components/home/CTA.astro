---
import { usePageTranslations,  getLangFromUrl } from '@/utils/i18n';
// src/components/home/CTA.astro

import Button from '@/components/core/Button.astro';
import Typography from '@/components/core/Typography.astro';

interface Props {
  pageDict: Record<string, string>;
}
const { pageDict } = Astro.props;
const lang = getLangFromUrl(Astro.cookies);
const t = usePageTranslations(pageDict, lang);
---
<section class="bg-brand-gold overflow-hidden py-24 relative">
  <div class="absolute inset-0 z-0">
    <div class="absolute bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] inset-0 mix-blend-overlay opacity-10"></div>
    <div class="absolute bg-gradient-to-t from-brand-black/20 inset-0 to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 relative text-center z-10">
    <Typography variant="h2" class="dark:text-brand-white font-bold font-display lg:text-6xl max-w-3xl mb-6 md:text-5xl mx-auto text-4xl text-brand-black tracking-tight uppercase">
      {t('home.cta.title1')} <br />
      <span class="dark:text-brand-white text-brand-black">{t('home.cta.title2')}</span>
    </Typography>
    <Typography variant="lead" class="dark:text-brand-white/80 font-medium max-w-2xl mb-10 mx-auto text-brand-black">
      {t('home.cta.desc')}
    </Typography>

    <Button as="a" href="/login" variant="primary" size="lg" class="bg-gray-100 dark:bg-brand-black dark:bg-brand-dark-card dark:text-brand-white hover:bg-brand-white hover:text-brand-black px-12 py-5 text-brand-black">
      {t('home.cta.btn')}
    </Button>
  </div>
</section>
