---
import { usePageTranslations,  getLangFromUrl } from '@/utils/i18n';
// src/components/home/CTA.astro

import Button from '@/components/core/Button.astro';
import Typography from '@/components/core/Typography.astro';

interface Props {
  pageDict: Record<string, string>;
}
const { pageDict } = Astro.props;
const lang = getLangFromUrl(Astro.cookies);
const t = usePageTranslations(pageDict, lang);
---
<section class="py-24 bg-brand-gold relative overflow-hidden">
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10 mix-blend-overlay"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-black/20 to-transparent"></div>
  </div>

  <div class="relative z-10 container mx-auto px-6 text-center">
    <Typography variant="h2" class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-brand-black dark:text-brand-white mb-6 uppercase tracking-tight max-w-3xl mx-auto">
      {t('home.cta.title1')} <br />
      <span class="text-brand-white">{t('home.cta.title2')}</span>
    </Typography>
    <Typography variant="lead" class="text-brand-black dark:text-brand-white/80 font-medium mb-10 max-w-2xl mx-auto">
      {t('home.cta.desc')}
    </Typography>

    <Button as="a" href="/login" variant="primary" size="lg" class="px-12 py-5 bg-brand-black text-brand-white hover:bg-brand-white dark:bg-brand-dark-card hover:text-brand-black dark:text-brand-white">
      {t('home.cta.btn')}
    </Button>
  </div>
</section>
