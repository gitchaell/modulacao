---
// src/components/home/CTA.astro

import Section from '@/components/core/Section.astro';
import Typography from '@/components/core/Typography.astro';
import Button from '@/components/core/Button.astro';

interface Props {
  pageDict: Record<string, string>;
}
const { pageDict } = Astro.props;
const t = (key: string) => pageDict[key] || key;
---
<Section class="py-24 bg-brand-offwhite dark:bg-[#0a0a0a]" contained={true}>
  <div class="bg-gradient-to-r from-gray-100 dark:from-[#111] to-gray-200 dark:to-[#0a0a0a] border border-brand-gold/30 relative overflow-hidden flex flex-col md:flex-row rounded-sm">
    <!-- Abstract background waves -->
    <div class="absolute inset-0 opacity-[0.25] pointer-events-none">
      <svg viewBox="0 0 1000 400" preserveAspectRatio="none" class="w-full h-full text-brand-gold">
        <path d="M0,200 C250,300 350,100 500,200 C650,300 750,100 1000,200 L1000,400 L0,400 Z" fill="none" stroke="currentColor" stroke-width="2"></path>
        <path d="M0,250 C200,350 400,150 600,250 C800,350 900,150 1000,250" fill="none" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </div>

    <div class="flex-1 p-12 lg:p-16 relative z-10 flex flex-col justify-center">
      <Typography variant="small" class="font-bold uppercase tracking-[0.2em] mb-4">FAÇA PARTE DO</Typography>
      <Typography variant="h2" class="font-display font-bold mb-5 leading-tight">ECOSSISTEMA DAKILA</Typography>
      <Typography variant="small" class="mb-10 max-w-lg leading-relaxed">{t('home.cta.subtitle') || 'Junte-se a nós e faça parte de um ecossistema focado em evolução.'}</Typography>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-8">
        <div class="flex items-center gap-3.5">
          <div class="text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <span class="text-sm text-brand-black dark:text-brand-white font-semibold">{t('home.cta.f1') || 'Acesso exclusivo'}</span>
        </div>
        <div class="flex items-center gap-3.5">
          <div class="text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg></div>
          <span class="text-sm text-brand-black dark:text-brand-white font-semibold">{t('home.cta.f2') || 'Conteúdo premium'}</span>
        </div>
        <div class="flex items-center gap-3.5">
          <div class="text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></div>
          <span class="text-sm text-brand-black dark:text-brand-white font-semibold">{t('home.cta.f3') || 'Comunidade global'}</span>
        </div>
        <div class="flex items-center gap-3.5">
          <div class="text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <span class="text-sm text-brand-black dark:text-brand-white font-semibold">{t('home.cta.f4') || 'Networking'}</span>
        </div>
      </div>
    </div>

    <div class="md:w-[380px] bg-white dark:bg-[#0d0d0d] p-10 lg:p-12 relative z-10 flex flex-col justify-center border-t md:border-t-0 md:border-l border-brand-gold/30">
      <div class="flex items-center gap-4 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-brand-gold" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <Typography variant="h5" class="tracking-widest uppercase">{t('home.cta.join_title') || 'ASSOCIE-SE'}</Typography>
      </div>
      <Typography variant="small" class="mb-8 leading-relaxed">{t('home.cta.join_desc') || 'Faça parte da nossa rede de membros associados.'}</Typography>
      <Button as="a" href="/login" variant="primary" class="w-full flex items-center justify-center gap-2">
        {t('home.cta.join_btn') || 'QUERO ME ASSOCIAR'}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </Button>
    </div>
  </div>
</Section>
