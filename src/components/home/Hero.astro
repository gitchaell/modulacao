---
// src/components/home/Hero.astro
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="relative bg-[#0a0a0a] min-h-[75vh] flex items-center pt-24 pb-24 border-b border-white/5 overflow-hidden">
  <!-- Placeholder Image Background -->
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?q=80&w=2070&auto=format&fit=crop" alt="Hero Background" class="w-full h-full object-cover opacity-20 mix-blend-luminosity" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/90 to-transparent"></div>
  </div>

  <div class="relative z-10 container mx-auto px-6 lg:px-12 max-w-[1400px]">
    <div class="max-w-2xl">
      <h2 class="text-brand-gold font-black text-[10px] tracking-[0.2em] uppercase mb-4 leading-relaxed">
        MAIS QUE UM TIME,<br/>SOMOS UM ECOSSISTEMA
      </h2>
      <h1 class="font-display font-bold text-5xl md:text-6xl lg:text-[72px] leading-none mb-6 tracking-tight uppercase">
        <span class="text-brand-white block">PROPÓSITO</span>
        <span class="text-brand-gold block mt-1">QUE TRANSFORMA</span>
      </h1>
      <p class="text-[14px] md:text-[15px] text-gray-300 mb-10 max-w-[480px] leading-relaxed">
        {t('home.hero.desc')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a href="/nosotros" class="bg-brand-gold text-brand-black font-extrabold text-[10px] tracking-[0.15em] uppercase px-8 py-3.5 text-center hover:bg-brand-white transition-colors flex items-center justify-center gap-2 rounded-sm">
          CONHEÇA A MODULAÇÃO
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/login" class="border border-white/20 text-brand-white font-extrabold text-[10px] tracking-[0.15em] uppercase px-10 py-3.5 text-center hover:border-brand-white transition-colors rounded-sm flex items-center justify-center">
          FAÇA PARTE
        </a>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-brand-gold text-[10px] font-bold tracking-[0.15em] uppercase">SIGA-NOS</span>
        <div class="flex items-center gap-3">
          <a href="#" class="text-brand-gold hover:text-brand-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
          <a href="#" class="text-brand-gold hover:text-brand-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg></a>
          <a href="#" class="text-brand-gold hover:text-brand-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="#" class="text-brand-gold hover:text-brand-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>