---
// src/components/home/Highlights.astro
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="py-24 bg-[#0a0a0a] relative">
  <div class="container mx-auto px-6 lg:px-12 max-w-[1400px]">
    <div class="flex justify-between items-center mb-12 border-b border-white/10 pb-5">
      <div class="flex items-center gap-5">
        <h2 class="text-lg md:text-xl font-display font-bold text-brand-white uppercase tracking-widest">
          {t('home.highlights.title')}
        </h2>
        <div class="h-[3px] w-16 bg-brand-gold"></div>
      </div>
      <a href="#" class="border border-brand-gold/30 px-6 py-2.5 text-brand-gold text-[11px] font-bold uppercase tracking-[0.2em] hover:bg-brand-gold hover:text-brand-black transition-colors flex items-center gap-2.5 rounded-sm">
        {t('home.highlights.view_all')} <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Highlight Card 1 -->
      <a href="#" class="group block border border-white/5 bg-[#0d0d0d] hover:border-brand-gold/30 transition-colors overflow-hidden rounded-sm">
        <div class="relative h-56 overflow-hidden">
          <div class="absolute top-5 left-5 z-10 bg-[#0a0a0a]/90 border border-brand-gold/50 text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 text-brand-gold">PUBLICAÇÃO</div>
          <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?q=80&w=2000&auto=format&fit=crop" alt="Highlight 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d] to-transparent opacity-90"></div>
        </div>
        <div class="p-8">
          <h3 class="font-bold text-[16px] text-brand-white mb-3 group-hover:text-brand-gold transition-colors leading-snug">Reunião de Membros Modulação Santa Cruz</h3>
          <p class="text-[13px] text-gray-400 mb-6 line-clamp-2 leading-relaxed">Encontro exclusivo para membros da comunidade Santa Cruz.</p>
          <div class="flex items-center gap-5 text-[11px] text-gray-500 font-bold uppercase tracking-widest">
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> 24 MAI, 2024</span>
            <span class="flex items-center gap-2 text-brand-gold"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Exclusivo</span>
          </div>
        </div>
      </a>

      <!-- Highlight Card 2 -->
      <a href="#" class="group block border border-white/5 bg-[#0d0d0d] hover:border-brand-gold/30 transition-colors overflow-hidden rounded-sm">
        <div class="relative h-56 overflow-hidden">
          <div class="absolute top-5 left-5 z-10 bg-[#0a0a0a]/90 border border-brand-gold/50 text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 text-brand-gold">ARTIGO</div>
          <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop" alt="Highlight 2" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d] to-transparent opacity-90"></div>
        </div>
        <div class="p-8">
          <h3 class="font-bold text-[16px] text-brand-white mb-3 group-hover:text-brand-gold transition-colors leading-snug">A Modulação como princípio da vida</h3>
          <p class="text-[13px] text-gray-400 mb-6 line-clamp-2 leading-relaxed">Entenda como a modulação está presente em todas as coisas.</p>
          <div class="flex items-center gap-5 text-[11px] text-gray-500 font-bold uppercase tracking-widest">
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> 20 MAI, 2024</span>
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> Público</span>
          </div>
        </div>
      </a>

      <!-- Highlight Card 3 -->
      <a href="#" class="group block border border-white/5 bg-[#0d0d0d] hover:border-brand-gold/30 transition-colors overflow-hidden rounded-sm">
        <div class="relative h-56 overflow-hidden">
          <div class="absolute top-5 left-5 z-10 bg-[#0a0a0a]/90 border border-brand-gold/50 text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 text-brand-gold">PUBLICAÇÃO</div>
          <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?q=80&w=2094&auto=format&fit=crop" alt="Highlight 3" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d] to-transparent opacity-90"></div>
        </div>
        <div class="p-8">
          <h3 class="font-bold text-[16px] text-brand-white mb-3 group-hover:text-brand-gold transition-colors leading-snug">Exposição: Artes que inspiram e conectam</h3>
          <p class="text-[13px] text-gray-400 mb-6 line-clamp-2 leading-relaxed">A arte como expressão do invisível e da sua real força.</p>
          <div class="flex items-center gap-5 text-[11px] text-gray-500 font-bold uppercase tracking-widest">
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> 15 MAI, 2024</span>
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> Público</span>
          </div>
        </div>
      </a>

      <!-- Highlight Card 4 -->
      <a href="#" class="group block border border-white/5 bg-[#0d0d0d] hover:border-brand-gold/30 transition-colors overflow-hidden rounded-sm">
        <div class="relative h-56 overflow-hidden">
          <div class="absolute top-5 left-5 z-10 bg-[#0a0a0a]/90 border border-brand-gold/50 text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 text-brand-gold">PUBLICAÇÃO</div>
          <img src="https://images.unsplash.com/photo-1574629810360-7efbb6b04040?q=80&w=2070&auto=format&fit=crop" alt="Highlight 4" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d] to-transparent opacity-90"></div>
        </div>
        <div class="p-8">
          <h3 class="font-bold text-[16px] text-brand-white mb-3 group-hover:text-brand-gold transition-colors leading-snug">Vitória no último campeonato</h3>
          <p class="text-[13px] text-gray-400 mb-6 line-clamp-2 leading-relaxed">Mais que um resultado, uma prova de disciplina e união.</p>
          <div class="flex items-center gap-5 text-[11px] text-gray-500 font-bold uppercase tracking-widest">
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> 10 MAI, 2024</span>
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> Público</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>