---
// src/components/home/Features.astro
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);
---
<section class="py-16 bg-brand-offwhite dark:bg-[#0a0a0a] border-b border-black/5 dark:border-white/5">
  <div class="container mx-auto px-6 lg:px-12 max-w-[1400px]">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-4 divide-x-0 lg:divide-x lg:divide-white/10">
      <!-- Feature 1 -->
      <div class="flex flex-col items-center text-center lg:px-4">
        <div class="w-[72px] h-[72px] rounded-full border border-brand-gold/30 text-brand-gold flex items-center justify-center mb-5 transition-transform hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <h3 class="font-bold text-[11px] uppercase tracking-widest text-brand-gold mb-2.5">{t('home.features.identity.title')}</h3>
        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed max-w-[200px]">{t('home.features.identity.desc')}</p>
      </div>

      <!-- Feature 2 -->
      <div class="flex flex-col items-center text-center lg:px-4">
        <div class="w-[72px] h-[72px] rounded-full border border-brand-gold/30 text-brand-gold flex items-center justify-center mb-5 transition-transform hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="font-bold text-[11px] uppercase tracking-widest text-brand-gold mb-2.5">{t('home.features.unity.title')}</h3>
        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed max-w-[200px]">{t('home.features.unity.desc')}</p>
      </div>

      <!-- Feature 3 -->
      <div class="flex flex-col items-center text-center lg:px-4">
        <div class="w-[72px] h-[72px] rounded-full border border-brand-gold/30 text-brand-gold flex items-center justify-center mb-5 transition-transform hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <h3 class="font-bold text-[11px] uppercase tracking-widest text-brand-gold mb-2.5">{t('home.features.evolution.title')}</h3>
        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed max-w-[200px]">{t('home.features.evolution.desc')}</p>
      </div>

      <!-- Feature 4 -->
      <div class="flex flex-col items-center text-center lg:px-4">
        <div class="w-[72px] h-[72px] rounded-full border border-brand-gold/30 text-brand-gold flex items-center justify-center mb-5 transition-transform hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg>
        </div>
        <h3 class="font-bold text-[11px] uppercase tracking-widest text-brand-gold mb-2.5">{t('home.features.discipline.title')}</h3>
        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed max-w-[200px]">{t('home.features.discipline.desc')}</p>
      </div>

      <!-- Feature 5 -->
      <div class="flex flex-col items-center text-center lg:px-4 col-span-2 lg:col-span-1">
        <div class="w-[72px] h-[72px] rounded-full border border-brand-gold/30 text-brand-gold flex items-center justify-center mb-5 transition-transform hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" x2="12" y1="1" y2="3"/><line x1="12" x2="12" y1="21" y2="23"/><line x1="4.22" x2="5.64" y1="4.22" y2="5.64"/><line x1="18.36" x2="19.78" y1="18.36" y2="19.78"/><line x1="1" x2="3" y1="12" y2="12"/><line x1="21" x2="23" y1="12" y2="12"/><line x1="4.22" x2="5.64" y1="19.78" y2="18.36"/><line x1="18.36" x2="19.78" y1="5.64" y2="4.22"/></svg>
        </div>
        <h3 class="font-bold text-[11px] uppercase tracking-widest text-brand-gold mb-2.5">{t('home.features.purpose.title')}</h3>
        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed max-w-[200px]">{t('home.features.purpose.desc')}</p>
      </div>
    </div>
  </div>
</section>