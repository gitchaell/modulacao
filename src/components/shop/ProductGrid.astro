---
import { Star, ShoppingBag } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);

const destaques = [
  { name: 'Camisa Oficial Modulação Dakila', price: 'R$ 159,90', reviews: 128, category: t('shop.categories.apparel'), img: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=500&auto=format&fit=crop' },
  { name: 'Moletom com Capuz Modulação Dakila', price: 'R$ 199,90', reviews: 96, category: t('shop.categories.apparel'), img: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=500&auto=format&fit=crop' },
  { name: 'Pingente Modulação Dakila', price: 'R$ 89,90', reviews: 74, category: t('shop.categories.accessories'), img: 'https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=500&auto=format&fit=crop' },
  { name: 'Livro: Modulação – A Ciência da Vida', price: 'R$ 69,90', reviews: 52, category: t('shop.categories.books'), img: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?q=80&w=500&auto=format&fit=crop' },
];

const produtos = [
  { name: 'Boné Modulação Dakila', price: 'R$ 89,90', reviews: 42, img: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?q=80&w=500&auto=format&fit=crop' },
  { name: 'Camiseta Básica Modulação Dakila', price: 'R$ 99,90', reviews: 58, img: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=500&auto=format&fit=crop' },
  { name: 'Caderno Modulação Dakila', price: 'R$ 59,90', reviews: 31, img: 'https://images.unsplash.com/photo-1531346878377-a541e4ab0eaf?q=80&w=500&auto=format&fit=crop' },
  { name: 'Caneca Modulação Dakila', price: 'R$ 49,90', reviews: 27, img: 'https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?q=80&w=500&auto=format&fit=crop' },
  { name: 'Quadro Ondas da Modulação', price: 'R$ 249,90', reviews: 18, category: t('shop.categories.art'), img: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?q=80&w=500&auto=format&fit=crop' },
  { name: 'Curso: Consciência e Propósito', price: 'R$ 297,00', reviews: 67, category: t('shop.categories.courses'), img: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?q=80&w=500&auto=format&fit=crop' },
  { name: 'Livro: Filosofia da Modulação', price: 'R$ 79,90', reviews: 44, category: t('shop.categories.books'), img: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?q=80&w=500&auto=format&fit=crop' },
  { name: 'Consultoria em Desenvolvimento Humano', price: 'R$ 450,00', reviews: 15, category: t('shop.categories.services'), img: 'https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=500&auto=format&fit=crop' },
];
---
<div class="flex-1">

  <!-- Destaques Section -->
  <div class="mb-16">
    <div class="flex items-center mb-8">
      <h2 class="text-xl font-medium text-brand-black dark:text-white tracking-widest uppercase">{t('shop.highlights.title')}</h2>
      <div class="ml-4 flex-1 h-px bg-gradient-to-r from-brand-gold/50 to-transparent"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {destaques.map(product => (
        <div class="group bg-brand-white dark:bg-brand-dark-card/50 border border-gray-200 dark:border-white/5 hover:border-brand-gold/30 rounded-xl overflow-hidden transition-all duration-300 hover:transform hover:-translate-y-1 shadow-sm dark:shadow-none">
          <div class="relative aspect-square overflow-hidden bg-gray-100 dark:bg-[#111]">
            {product.category && (
              <div class="absolute top-3 left-3 z-10 bg-brand-white/90 dark:bg-black/70 backdrop-blur-md border border-brand-gold/50 dark:border-brand-gold/20 text-brand-gold text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">
                {product.category}
              </div>
            )}
            <img src={product.img} alt={product.name} class="w-full h-full object-cover opacity-90 dark:opacity-80 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <button class="absolute bottom-4 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 bg-brand-gold text-black font-bold text-xs px-6 py-2 rounded-full uppercase tracking-widest flex items-center gap-2 hover:bg-white">
              <ShoppingBag class="w-4 h-4" />
              {t('shop.products.buy')}
            </button>
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center text-brand-gold">
                <Star class="w-3.5 h-3.5 fill-current" />
                <Star class="w-3.5 h-3.5 fill-current" />
                <Star class="w-3.5 h-3.5 fill-current" />
                <Star class="w-3.5 h-3.5 fill-current" />
                <Star class="w-3.5 h-3.5 fill-current" />
              </div>
              <span class="text-[10px] text-brand-black/50 dark:text-gray-500">({product.reviews})</span>
            </div>
            <h3 class="text-sm font-medium text-brand-black dark:text-white mb-2 line-clamp-2 group-hover:text-brand-gold transition-colors">{product.name}</h3>
            <p class="text-lg font-bold text-brand-black dark:text-white">{product.price}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Todos os Produtos -->
  <div>
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center">
        <h2 class="text-xl font-medium text-brand-black dark:text-white tracking-widest uppercase">{t('shop.products.title')}</h2>
        <div class="hidden sm:block ml-4 w-32 h-px bg-gradient-to-r from-brand-gold/50 to-transparent"></div>
      </div>
      <span class="text-sm text-brand-black/50 dark:text-gray-400">Mostrando 24 produtos</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {produtos.map(product => (
        <div class="group bg-brand-white dark:bg-brand-dark-card/50 border border-gray-200 dark:border-white/5 hover:border-brand-gold/30 rounded-xl overflow-hidden transition-all duration-300 shadow-sm dark:shadow-none">
          <div class="relative aspect-square overflow-hidden bg-gray-100 dark:bg-[#111]">
            <img src={product.img} alt={product.name} class="w-full h-full object-cover opacity-90 dark:opacity-80 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-105" loading="lazy" decoding="async" />

            <button class="absolute top-3 right-3 w-8 h-8 rounded-full bg-brand-white/80 dark:bg-black/50 backdrop-blur border border-gray-300 dark:border-white/10 flex items-center justify-center text-brand-black/50 dark:text-white/50 hover:text-brand-gold hover:border-brand-gold transition-colors opacity-0 group-hover:opacity-100">
              <ShoppingBag class="w-4 h-4" />
            </button>
          </div>

          <div class="p-4">
            <h3 class="text-sm text-brand-black/80 dark:text-gray-300 mb-2 line-clamp-1 group-hover:text-brand-gold transition-colors">{product.name}</h3>
            <div class="flex items-center justify-between">
              <p class="font-bold text-brand-black dark:text-white">{product.price}</p>
              <div class="flex items-center gap-1 text-[10px] text-brand-black/50 dark:text-gray-500">
                <Star class="w-3 h-3 text-brand-gold fill-current" />
                {product.reviews}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

</div>
