---
import { Star, ShoppingBag } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);

const destaques = [
  { name: 'Camisa Oficial Modulação Dakila', price: 'R$ 159,90', reviews: 128, category: t('shop.categories.apparel'), img: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=500&auto=format&fit=crop' },
  { name: 'Moletom com Capuz Modulação Dakila', price: 'R$ 199,90', reviews: 96, category: t('shop.categories.apparel'), img: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=500&auto=format&fit=crop' },
  { name: 'Pingente Modulação Dakila', price: 'R$ 89,90', reviews: 74, category: t('shop.categories.accessories'), img: 'https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=500&auto=format&fit=crop' },
  { name: 'Livro: Modulação – A Ciência da Vida', price: 'R$ 69,90', reviews: 52, category: t('shop.categories.books'), img: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?q=80&w=500&auto=format&fit=crop' },
];

const produtos = [
  { name: 'Boné Modulação Dakila', price: 'R$ 89,90', reviews: 42, img: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?q=80&w=500&auto=format&fit=crop' },
  { name: 'Camiseta Básica Modulação Dakila', price: 'R$ 99,90', reviews: 58, img: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=500&auto=format&fit=crop' },
  { name: 'Caderno Modulação Dakila', price: 'R$ 59,90', reviews: 31, img: 'https://images.unsplash.com/photo-1531346878377-a541e4ab0eaf?q=80&w=500&auto=format&fit=crop' },
  { name: 'Caneca Modulação Dakila', price: 'R$ 49,90', reviews: 27, img: 'https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?q=80&w=500&auto=format&fit=crop' },
  { name: 'Quadro Ondas da Modulação', price: 'R$ 249,90', reviews: 18, category: t('shop.categories.art'), img: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?q=80&w=500&auto=format&fit=crop' },
  { name: 'Curso: Consciência e Propósito', price: 'R$ 297,00', reviews: 67, category: t('shop.categories.courses'), img: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?q=80&w=500&auto=format&fit=crop' },
  { name: 'Livro: Filosofia da Modulação', price: 'R$ 79,90', reviews: 44, category: t('shop.categories.books'), img: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?q=80&w=500&auto=format&fit=crop' },
  { name: 'Consultoria em Desenvolvimento Humano', price: 'R$ 450,00', reviews: 15, category: t('shop.categories.services'), img: 'https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=500&auto=format&fit=crop' },
];
---
<div class="flex-1">

  <!-- Destaques Section -->
  <div class="mb-16">
    <div class="flex items-center mb-8">
      <h2 class="dark:text-white font-medium text-brand-black text-xl tracking-widest uppercase">{t('shop.highlights.title')}</h2>
      <div class="bg-gradient-to-r flex-1 from-brand-gold/50 h-px ml-4 to-transparent"></div>
    </div>

    <div class="gap-6 grid grid-cols-1 lg:grid-cols-4 sm:grid-cols-2">
      {destaques.map(product => (
        <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card/50 dark:border-white/5 dark:shadow-none duration-300 group hover:-translate-y-1 hover:border-brand-gold/30 hover:transform overflow-hidden rounded-xl shadow-sm transition-all">
          <div class="aspect-square bg-gray-100 dark:bg-brand-dark dark:bg-brand-black overflow-hidden relative">
            {product.category && (
              <div class="absolute backdrop-blur-md bg-brand-white/90 border border-brand-gold/50 dark:bg-black/70 dark:border-brand-gold/20 font-bold left-3 px-2 py-1 rounded text-[10px] text-brand-gold top-3 tracking-wider uppercase z-10">
                {product.category}
              </div>
            )}
            <img src={product.img} alt={product.name} class="dark:opacity-80 duration-500 group-hover:opacity-100 group-hover:scale-105 h-full object-cover opacity-90 transition-opacity w-full" loading="lazy" decoding="async" />
            <div class="absolute bg-gradient-to-t duration-300 from-black/60 group-hover:opacity-100 inset-0 opacity-0 to-transparent transition-opacity via-transparent"></div>

            <button class="-translate-x-1/2 absolute bg-brand-gold bottom-4 dark:text-brand-white duration-300 flex font-bold gap-2 group-hover:opacity-100 group-hover:translate-y-0 hover:bg-white items-center left-1/2 opacity-0 px-6 py-2 rounded-full text-black text-xs tracking-widest transition-all translate-y-4 uppercase">
              <ShoppingBag class="h-4 w-4" />
              {t('shop.products.buy')}
            </button>
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center text-brand-gold">
                <Star class="fill-current h-3.5 w-3.5" />
                <Star class="fill-current h-3.5 w-3.5" />
                <Star class="fill-current h-3.5 w-3.5" />
                <Star class="fill-current h-3.5 w-3.5" />
                <Star class="fill-current h-3.5 w-3.5" />
              </div>
              <span class="dark:text-brand-white/50 dark:text-gray-400 dark:text-gray-500 text-[10px] text-brand-black">({product.reviews})</span>
            </div>
            <h3 class="dark:text-white font-medium group-hover:text-brand-gold line-clamp-2 mb-2 text-brand-black text-sm transition-colors">{product.name}</h3>
            <p class="dark:text-white font-bold text-brand-black text-lg">{product.price}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Todos os Produtos -->
  <div>
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center">
        <h2 class="dark:text-white font-medium text-brand-black text-xl tracking-widest uppercase">{t('shop.products.title')}</h2>
        <div class="bg-gradient-to-r from-brand-gold/50 h-px hidden ml-4 sm:block to-transparent w-32"></div>
      </div>
      <span class="dark:text-brand-white/50 dark:text-gray-400 text-brand-black text-sm">{t('shop.filters.showing')}</span>
    </div>

    <div class="gap-6 grid grid-cols-1 lg:grid-cols-3 sm:grid-cols-2 xl:grid-cols-4">
      {produtos.map(product => (
        <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card/50 dark:border-white/5 dark:shadow-none duration-300 group hover:border-brand-gold/30 overflow-hidden rounded-xl shadow-sm transition-all">
          <div class="aspect-square bg-gray-100 dark:bg-brand-dark dark:bg-brand-black overflow-hidden relative">
            <img src={product.img} alt={product.name} class="dark:opacity-80 duration-500 group-hover:opacity-100 group-hover:scale-105 h-full object-cover opacity-90 transition-opacity w-full" loading="lazy" decoding="async" />

            <button class="absolute backdrop-blur bg-brand-white/80 border border-gray-300 dark:bg-black/50 dark:border-white/10 dark:text-brand-white/50 dark:text-white/50 flex group-hover:opacity-100 h-8 hover:border-brand-gold hover:text-brand-gold items-center justify-center opacity-0 right-3 rounded-full text-brand-black top-3 transition-colors w-8">
              <ShoppingBag class="h-4 w-4" />
            </button>
          </div>

          <div class="p-4">
            <h3 class="dark:text-brand-white/80 dark:text-gray-300 group-hover:text-brand-gold line-clamp-1 mb-2 text-brand-black text-sm transition-colors">{product.name}</h3>
            <div class="flex items-center justify-between">
              <p class="dark:text-white font-bold text-brand-black">{product.price}</p>
              <div class="dark:text-brand-white/50 dark:text-gray-400 dark:text-gray-500 flex gap-1 items-center text-[10px] text-brand-black">
                <Star class="fill-current h-3 text-brand-gold w-3" />
                {product.reviews}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

</div>
