---
import { ChevronDown } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);

const sidebarCategories = [
  { name: t('shop.categories.all_lower'), count: 24, active: true },
  { name: t('shop.categories.apparel_lower'), count: 6 },
  { name: t('shop.categories.accessories_lower'), count: 6 },
  { name: t('shop.categories.books_lower'), count: 4 },
  { name: t('shop.categories.art_lower'), count: 3 },
  { name: t('shop.categories.courses_lower'), count: 3 },
  { name: t('shop.categories.services_lower'), count: 2 },
];
---
<div class="flex-shrink-0 hidden lg:block w-64">
  <div class="bg-brand-white/80 dark:bg-transparent p-4 rounded-xl space-y-10 sticky top-[160px]">

    <!-- Categories -->
    <div>
      <h3 class="dark:text-white flex font-bold items-center justify-between mb-6 text-brand-black text-sm tracking-wider uppercase">
        {t('shop.sidebar.title')}
        <ChevronDown class="h-4 text-brand-gold w-4" />
      </h3>
      <ul class="space-y-3">
        {sidebarCategories.map(cat => (
          <li>
            <a href="#" class={`flex items-center justify-between text-sm group ${cat.active ? 'text-brand-gold font-medium' : 'text-gray-600 dark:text-gray-400 hover:text-brand-black dark:hover:text-white'}`}>
              <span class="relative">
                {cat.name}
                <span class={`absolute -bottom-1 left-0 h-[1px] bg-brand-gold transition-all duration-300 ${cat.active ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
              </span>
              <span class={`text-[10px] py-0.5 px-2 rounded-full ${cat.active ? 'bg-brand-gold/20 text-brand-gold' : 'bg-gray-100 dark:bg-black/5 dark:bg-white/5 text-brand-black dark:text-brand-white/50 dark:text-gray-500 dark:text-gray-400 group-hover:bg-black/10 dark:group-hover:bg-white/10'}`}>
                {cat.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-gradient-to-r dark:from-white/10 from-gray-200 h-px to-transparent"></div>

    <!-- Filters (Price Example) -->
    <div>
      <h3 class="dark:text-white flex font-bold items-center justify-between mb-6 text-brand-black text-sm tracking-wider uppercase">
        {t('shop.sidebar.price')}
        <ChevronDown class="h-4 text-brand-gold w-4" />
      </h3>
      <ul class="space-y-3">
        {['all', 'under50', '50to100', '100to200', 'over200'].map((price, idx) => (
          <li>
            <label class="cursor-pointer flex group items-center space-x-3">
              <div class={`w-4 h-4 rounded border flex items-center justify-center transition-colors ${idx === 0 ? 'border-brand-gold bg-brand-gold/20' : 'border-gray-300 dark:border-white/20 group-hover:border-brand-gold/50'}`}>
                {idx === 0 && <div class="bg-brand-gold h-2 rounded-sm w-2"></div>}
              </div>
              <span class={`text-sm ${idx === 0 ? 'text-brand-black dark:text-white font-medium' : 'text-gray-600 dark:text-gray-400 group-hover:text-brand-black dark:text-brand-white dark:group-hover:text-gray-700 dark:text-gray-200'}`}>
                {t(`shop.sidebar.price.${price}`)}
              </span>
            </label>
          </li>
        ))}
      </ul>
    </div>

  </div>
</div>
