---
import { ChevronRight } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<section class="bg-brand-white border-b border-black/5 dark:bg-brand-dark-card dark:bg-transparent dark:border-white/5 flex items-center min-h-[400px] overflow-hidden pb-12 pt-24 relative">
  <!-- Hero Background Image (Right side) -->
  <div class="absolute dark:opacity-60 flex inset-0 justify-end opacity-20 z-0">
    <div class="h-full lg:w-2/3 relative w-full">
      <div class="absolute bg-gradient-to-r dark:from-brand-black dark:via-brand-black/80 from-brand-white inset-0 to-transparent via-brand-white/80 z-10"></div>
      <img
        src="https://images.unsplash.com/photo-1616423640778-28d1b53229bd?q=80&w=1200&auto=format&fit=crop"
        alt="Shop Hero"
        class="h-full object-cover w-full"
      />
      <!-- Gold Wave overlay (abstract representation) -->
      <div class="absolute bg-[url('/wave-pattern.svg')] bg-cover dark:mix-blend-screen inset-0 mix-blend-multiply opacity-30 pointer-events-none z-20"></div>
    </div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl">
      <div class="dark:text-brand-white/50 dark:text-gray-400 flex items-center mb-6 text-brand-black text-sm">
        <a href="/" class="dark:hover:text-white hover:text-brand-black transition-colors">{t('shop.hero.home')}</a>
        <ChevronRight class="h-4 mx-2 w-4" />
        <span class="dark:text-white text-brand-black">{t('shop.hero.breadcrumb')}</span>
      </div>

      <h1 class="dark:text-white font-bold font-display lg:text-6xl mb-6 text-5xl text-brand-black tracking-tight">{t('shop.hero.title')}</h1>

      <p class="dark:text-brand-white/70 dark:text-gray-300 leading-relaxed max-w-lg text-brand-black text-lg">
        {t('shop.hero.desc')}
      </p>
    </div>
  </div>
</section>
