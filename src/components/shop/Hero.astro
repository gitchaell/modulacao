---
import { ChevronRight } from '@lucide/astro';
import { usePageTranslations } from '@/utils/i18n';

interface Props {
  pageDict: any;
  lang: any;
}

const { pageDict, lang } = Astro.props;
const t = usePageTranslations(pageDict, lang);
---
<section class="relative min-h-[400px] flex items-center pt-24 pb-12 overflow-hidden border-b border-black/5 dark:border-white/5 bg-brand-white dark:bg-transparent">
  <!-- Hero Background Image (Right side) -->
  <div class="absolute inset-0 z-0 flex justify-end opacity-20 dark:opacity-60">
    <div class="w-full lg:w-2/3 h-full relative">
      <div class="absolute inset-0 bg-gradient-to-r from-brand-white dark:from-brand-black via-brand-white/80 dark:via-brand-black/80 to-transparent z-10"></div>
      <img
        src="https://images.unsplash.com/photo-1616423640778-28d1b53229bd?q=80&w=1200&auto=format&fit=crop"
        alt="Shop Hero"
        class="w-full h-full object-cover"
      />
      <!-- Gold Wave overlay (abstract representation) -->
      <div class="absolute inset-0 z-20 opacity-30 bg-[url('/wave-pattern.svg')] bg-cover mix-blend-multiply dark:mix-blend-screen pointer-events-none"></div>
    </div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl">
      <div class="flex items-center text-sm text-brand-black dark:text-brand-white/50 dark:text-gray-400 mb-6">
        <a href="/" class="hover:text-brand-black dark:text-brand-white dark:hover:text-brand-black dark:text-white transition-colors">{t('shop.hero.home')}</a>
        <ChevronRight class="w-4 h-4 mx-2" />
        <span class="text-brand-black dark:text-white">{t('shop.hero.breadcrumb')}</span>
      </div>

      <h1 class="text-5xl lg:text-6xl font-bold text-brand-black dark:text-white mb-6 font-display tracking-tight">{t('shop.hero.title')}</h1>

      <p class="text-lg text-brand-black dark:text-brand-white/70 dark:text-gray-300 leading-relaxed max-w-lg">
        {t('shop.hero.desc')}
      </p>
    </div>
  </div>
</section>
