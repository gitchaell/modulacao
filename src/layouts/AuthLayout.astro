---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={title}>
  <div class="min-h-screen flex bg-brand-black">
    <!-- Image/Brand Section -->
    <div class="hidden lg:flex flex-1 relative bg-brand-dark items-center justify-center border-r border-brand-dark-card/50 overflow-hidden">
      <!-- Decoración de ondas moduladoras abstracta -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold via-brand-black to-brand-black"></div>
      <div class="relative z-10 text-center">
        <h1 class="text-4xl font-bold text-brand-gold uppercase tracking-widest mb-4">Modulação</h1>
        <p class="text-gray-400 max-w-md mx-auto">La red oficial. Ingresa para acceder a la comunidad y gestionar tu actividad.</p>
      </div>
    </div>
    <!-- Form Section -->
    <div class="flex-1 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-20 xl:px-24">
      <div class="mx-auto w-full max-w-sm">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>