---
import BaseLayout from './BaseLayout.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={`${title} | ${tenantConfig.name}`}>
  <div class="bg-brand-offwhite dark:bg-brand-black flex min-h-screen">
    <!-- Image/Brand Section -->
    <div class="bg-gray-100 border-gray-200 border-r dark:bg-brand-black dark:border-white/5 flex-1 hidden items-center justify-center lg:flex overflow-hidden premium-shadow relative">
      <!-- Decoración de ondas moduladoras abstracta -->
      <div class="absolute bg-gradient-to-b from-brand-black inset-0 to-[#0a0a0a] via-brand-black z-0"></div>
      <div class="absolute bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-transparent via-transparent z-0"></div>

      <div class="absolute inset-0 mix-blend-screen opacity-40 z-0">
        <WaveBackground />
      </div>

      <div class="animate-smooth-fade px-12 relative text-center z-10">
        <h1 class="dark:text-brand-white drop-shadow-lg font-bold font-display mb-6 text-5xl text-brand-black tracking-tighter uppercase">
          {tenantConfig.name} <span class="block mt-2 text-2xl text-brand-gold tracking-widest">Workspace</span>
        </h1>
        <p class="dark:text-gray-400 leading-relaxed max-w-md mx-auto text-balance text-gray-500 dark:text-gray-400 text-lg">
          Accede a tu cuenta para gestionar tu actividad, participar en la comunidad y descubrir todo lo que tenemos para ofrecerte.
        </p>
      </div>
    </div>
    <!-- Form Section -->
    <div class="bg-brand-white dark:bg-brand-dark flex flex-1 flex-col justify-center lg:px-20 px-4 py-12 sm:px-6 xl:px-24">
      <div class="animate-smooth-fade max-w-sm mx-auto w-full" style="animation-delay: 0.1s;">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>