---
import BaseLayout from './BaseLayout.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={`${title} | ${tenantConfig.name}`}>
  <div class="min-h-screen flex bg-brand-offwhite dark:bg-brand-black">
    <!-- Image/Brand Section -->
    <div class="hidden lg:flex flex-1 relative bg-brand-black items-center justify-center border-r border-gray-200 dark:border-white/5 overflow-hidden premium-shadow">
      <!-- Decoración de ondas moduladoras abstracta -->
      <div class="absolute inset-0 bg-gradient-to-b from-brand-black via-brand-black to-[#0a0a0a] z-0"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-transparent to-transparent opacity-80 z-0"></div>

      <div class="absolute inset-0 z-0 opacity-40 mix-blend-screen">
        <WaveBackground />
      </div>

      <div class="relative z-10 text-center px-12 animate-smooth-fade">
        <h1 class="text-5xl font-display font-bold text-brand-black dark:text-brand-white uppercase tracking-tighter mb-6 drop-shadow-lg">
          {tenantConfig.name} <span class="text-brand-gold block mt-2 text-2xl tracking-widest">Workspace</span>
        </h1>
        <p class="text-gray-400 max-w-md mx-auto text-lg leading-relaxed text-balance">
          Accede a tu cuenta para gestionar tu actividad, participar en la comunidad y descubrir todo lo que tenemos para ofrecerte.
        </p>
      </div>
    </div>
    <!-- Form Section -->
    <div class="flex-1 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-20 xl:px-24 bg-brand-white dark:bg-brand-dark">
      <div class="mx-auto w-full max-w-sm animate-smooth-fade" style="animation-delay: 0.1s;">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>