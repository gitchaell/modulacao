---
import BaseLayout from './BaseLayout.astro';
import NotificationBell from '@/components/ui/NotificationBell.astro';
import Avatar from '@/components/core/Avatar.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={`${title} | ${tenantConfig.name}`}>
  <div class="flex h-screen overflow-hidden bg-brand-offwhite dark:bg-brand-black relative">
    <!-- Sidebar / Off-canvas for mobile -->
    <div id="mobile-sidebar-overlay" class="fixed inset-0 bg-brand-black/50 backdrop-blur-sm z-20 hidden md:hidden transition-opacity"></div>
    <aside id="app-sidebar" class="fixed md:relative inset-y-0 left-0 w-72 bg-brand-white dark:bg-brand-dark border-r border-gray-200 dark:border-white/5 flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-out z-30 premium-shadow">
      <div class="h-16 px-6 border-b border-gray-200 dark:border-white/5 flex justify-between items-center bg-brand-white/80 dark:bg-brand-dark/80 backdrop-blur-md">
        <a href="/" class="flex items-center gap-3 group focus-visible">
          <svg class="w-7 h-7 text-brand-gold group-hover:scale-110 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <div class="font-bold text-lg text-brand-black dark:text-brand-white tracking-widest uppercase">{tenantConfig.name}</div>
        </a>
        <button id="close-sidebar-btn" class="md:hidden text-gray-500 dark:text-gray-400 hover:text-brand-black dark:hover:text-white transition-colors focus-visible" aria-label="Close sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 px-4 py-6 flex flex-col gap-2 overflow-y-auto">
        <a href="/app/comunidad" class="px-4 py-3 rounded-sm text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-gray-300 hover:bg-brand-gold/10 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('app.community')}</a>
        <a href="/app/grupos" class="px-4 py-3 rounded-sm text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-gray-300 hover:bg-brand-gold/10 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('app.groups')}</a>
        <a href="/app/eventos" class="px-4 py-3 rounded-sm text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-gray-300 hover:bg-brand-gold/10 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('app.events')}</a>
        <a href="/app/directorio" class="px-4 py-3 rounded-sm text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-gray-300 hover:bg-brand-gold/10 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('app.directory')}</a>
      </nav>
      <div class="p-6 border-t border-gray-200 dark:border-white/5">
        <a href="/app/ajustes" class="flex items-center gap-4 group focus-visible p-2 -mx-2 rounded-sm hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
          <Avatar alt="User Avatar" size="sm" fallback="U" />
          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-brand-black dark:text-white truncate group-hover:text-brand-gold transition-colors">{t('app.settings')}</div>
          </div>
        </a>
      </div>
    </aside>
    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-brand-offwhite dark:bg-brand-black flex flex-col min-w-0 w-full relative">
      <header class="h-16 px-4 md:px-8 border-b border-gray-200 dark:border-white/5 flex items-center justify-between md:justify-end bg-brand-white/80 dark:bg-brand-dark/80 backdrop-blur-md sticky top-0 z-10">
        <button id="open-sidebar-btn" class="md:hidden text-brand-black dark:text-brand-white p-2 focus-visible hover:text-brand-gold transition-colors" aria-label="Open sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        <div class="flex items-center gap-6">
          <a href="/buscar" class="text-brand-black dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <NotificationBell />
        </div>
      </header>
      <div class="flex-1 p-6 md:p-8 lg:p-12 max-w-6xl mx-auto w-full">
        <slot />
      </div>
    </main>
  </div>

  <script>
    const openBtn = document.getElementById('open-sidebar-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('app-sidebar');
    const overlay = document.getElementById('mobile-sidebar-overlay');

    const toggleSidebar = () => {
      sidebar?.classList.toggle('-translate-x-full');
      overlay?.classList.toggle('hidden');
    };

    openBtn?.addEventListener('click', toggleSidebar);
    closeBtn?.addEventListener('click', toggleSidebar);
    overlay?.addEventListener('click', toggleSidebar);
  </script>
</BaseLayout>