---
import BaseLayout from './BaseLayout.astro';
import NotificationBell from '@/components/ui/NotificationBell.astro';
import Avatar from '@/components/core/Avatar.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);
---
<BaseLayout title={`${title} | ${tenantConfig.name}`}>
  <div class="bg-brand-offwhite dark:bg-brand-black flex h-screen overflow-hidden relative">
    <!-- Sidebar / Off-canvas for mobile -->
    <div id="mobile-sidebar-overlay" class="backdrop-blur-sm bg-gray-100 dark:bg-brand-black/50 duration-300 fixed hidden inset-0 md:hidden opacity-0 transition-opacity z-20"></div>
    <aside id="app-sidebar" class="-translate-x-full bg-brand-white border-gray-200 border-r dark:bg-brand-dark dark:border-white/5 duration-300 ease-out fixed flex flex-col inset-y-0 left-0 md:relative md:translate-x-0 premium-shadow transform transition-transform w-80 z-30">
      <div class="backdrop-blur-md bg-brand-white/80 border-b border-gray-200 dark:bg-brand-dark/80 dark:border-white/5 flex h-16 items-center justify-between px-6">
        <a href="/" class="flex focus-visible gap-3 group items-center">
          <svg class="duration-300 group-hover:scale-110 h-7 text-brand-gold transition-transform w-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <div class="dark:text-brand-white font-bold text-brand-black text-lg tracking-widest uppercase">{tenantConfig.name}</div>
        </a>
        <button id="close-sidebar-btn" class="dark:hover:text-brand-white dark:text-gray-400 focus-visible hover:text-brand-black md:hidden text-gray-500 dark:text-gray-400 transition-colors" aria-label="Close sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex flex-1 flex-col gap-2 overflow-y-auto px-4 py-6">
        <a href="/app/comunidade" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('app.community')}</a>
        <a href="/app/grupos" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('app.groups')}</a>
        <a href="/app/eventos" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('app.events')}</a>
        <a href="/app/diretorio" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('app.directory')}</a>
        <a href="/campeonatos" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('app.championships')}</a>
        <a href="/biblioteca" class="dark:hover:text-brand-gold dark:text-gray-300 focus-visible font-semibold hover:bg-brand-gold/10 hover:scale-[1.02] hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-all uppercase">{t('nav.library')}</a>
      </nav>
      <div class="border-gray-200 border-t dark:border-white/5 p-6">
        <a href="/app/configuracoes" class="-mx-2 dark:hover:bg-white/5 flex focus-visible gap-4 group hover:bg-gray-50 items-center p-2 rounded-sm transition-colors">
          <Avatar alt="User Avatar" size="sm" fallback="U" />
          <div class="flex-1 min-w-0">
            <div class="dark:text-brand-white font-semibold group-hover:text-brand-gold text-brand-black text-sm transition-colors truncate">{t('app.settings')}</div>
          </div>
        </a>
      </div>
    </aside>
    <!-- Main Content -->
    <main class="bg-brand-offwhite dark:bg-brand-black flex flex-1 flex-col min-w-0 overflow-y-auto relative w-full">
      <header class="backdrop-blur-md bg-brand-white/80 border-b border-gray-200 dark:bg-brand-dark/80 dark:border-white/5 flex h-16 items-center justify-between md:justify-end md:px-8 px-4 sticky top-0 z-10">
        <button id="open-sidebar-btn" class="dark:text-brand-white focus-visible hover:text-brand-gold md:hidden p-2 text-brand-black transition-colors" aria-label="Open sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        <div class="flex gap-6 items-center">
          <a href="/buscar" class="dark:hover:text-brand-gold dark:text-gray-400 focus-visible hover:text-brand-gold text-brand-black transition-colors" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <NotificationBell />
        </div>
      </header>
      <div class="flex-1 lg:p-12 max-w-6xl md:p-8 mx-auto p-6 w-full">
        <slot />
      </div>
    </main>
  </div>

  <script>
    const openBtn = document.getElementById('open-sidebar-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('app-sidebar');
    const overlay = document.getElementById('mobile-sidebar-overlay');

    // Check local storage or match media for theme preference
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }

    const toggleSidebar = () => {
      sidebar?.classList.toggle('-translate-x-full');

      if (overlay?.classList.contains('hidden')) {
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.remove('opacity-0'), 10);
      } else {
        overlay?.classList.add('opacity-0');
        setTimeout(() => overlay?.classList.add('hidden'), 300);
      }
    };

    openBtn?.addEventListener('click', toggleSidebar);
    closeBtn?.addEventListener('click', toggleSidebar);
    overlay?.addEventListener('click', toggleSidebar);
  </script>
</BaseLayout>