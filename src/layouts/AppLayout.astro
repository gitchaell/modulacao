---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={title}>
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-brand-dark-card border-r border-brand-dark-card/50 flex flex-col">
      <div class="p-6 border-b border-brand-dark-card/50">
        <div class="font-bold text-xl text-brand-gold">Modulação App</div>
      </div>
      <nav class="flex-1 p-4 flex flex-col gap-2">
        <a href="/app/comunidad" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">Comunidad</a>
        <a href="/app/grupos" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">Grupos</a>
        <a href="/app/eventos" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">Eventos</a>
        <a href="/app/directorio" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">Directorio</a>
      </nav>
      <div class="p-4 border-t border-brand-dark-card/50">
        <a href="/app/perfil" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-gold/20"></div>
          <div>
            <div class="font-medium text-sm">Mi Perfil</div>
          </div>
        </a>
      </div>
    </aside>
    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-brand-black p-8">
      <slot />
    </main>
  </div>
</BaseLayout>