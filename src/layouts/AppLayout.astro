---
import BaseLayout from './BaseLayout.astro';
import NotificationBell from '@/components/ui/NotificationBell.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={title}>
  <div class="flex h-screen overflow-hidden relative">
    <!-- Sidebar / Off-canvas for mobile -->
    <div id="mobile-sidebar-overlay" class="fixed inset-0 bg-black/50 z-20 hidden md:hidden"></div>
    <aside id="app-sidebar" class="fixed md:relative inset-y-0 left-0 w-64 bg-brand-dark-card border-r border-brand-dark-card/50 flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-30">
      <div class="p-6 border-b border-brand-dark-card/50 flex justify-between items-center">
        <div class="font-bold text-xl text-brand-gold">Modulação App</div>
        <button id="close-sidebar-btn" class="md:hidden text-gray-400 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 p-4 flex flex-col gap-2">
        <a href="/app/comunidad" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">{t('app.community')}</a>
        <a href="/app/grupos" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">{t('app.groups')}</a>
        <a href="/app/eventos" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">{t('app.events')}</a>
        <a href="/app/directorio" class="px-4 py-2 rounded-lg hover:bg-brand-gold/10 hover:text-brand-gold transition-colors">{t('app.directory')}</a>
      </nav>
      <div class="p-4 border-t border-brand-dark-card/50 space-y-2">
        <a href="/app/ajustes" class="flex items-center gap-3 hover:text-brand-gold transition-colors">
          <div class="w-10 h-10 rounded-full bg-brand-gold/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div>
            <div class="font-medium text-sm">{t('app.settings')}</div>
          </div>
        </a>
      </div>
    </aside>
    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-brand-black flex flex-col min-w-0 w-full">
      <header class="h-16 px-4 md:px-8 border-b border-brand-dark-card flex items-center justify-between md:justify-end">
        <button id="open-sidebar-btn" class="md:hidden text-brand-gold p-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        <div class="flex items-center gap-4">
          <a href="/buscar" class="p-2 text-gray-400 hover:text-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <NotificationBell />
        </div>
      </header>
      <div class="flex-1 p-8">
        <slot />
      </div>
    </main>
  </div>

  <script>
    const openBtn = document.getElementById('open-sidebar-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('app-sidebar');
    const overlay = document.getElementById('mobile-sidebar-overlay');

    const toggleSidebar = () => {
      sidebar?.classList.toggle('-translate-x-full');
      overlay?.classList.toggle('hidden');
    };

    openBtn?.addEventListener('click', toggleSidebar);
    closeBtn?.addEventListener('click', toggleSidebar);
    overlay?.addEventListener('click', toggleSidebar);
  </script>
</BaseLayout>