---
import BaseLayout from './BaseLayout.astro';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={`Admin | ${title}`}>
  <div class="bg-brand-offwhite dark:bg-brand-black flex h-screen overflow-hidden">
    <!-- Admin Sidebar -->
    <aside class="bg-brand-white border-gray-200 border-r dark:bg-brand-dark dark:border-white/5 flex flex-col premium-shadow w-72 z-20">
      <div class="border-b border-gray-200 dark:border-white/5 flex items-center justify-center p-6">
        <div class="dark:text-brand-white font-bold text-brand-black text-center text-lg tracking-widest uppercase">{tenantConfig.name} <span class="block mt-1 text-brand-gold text-xs">Workspace</span></div>
      </div>
      <nav class="flex flex-1 flex-col gap-2 overflow-y-auto p-4">
        <a href="/admin/dashboard" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Dashboard</a>
        <a href="/admin/membros" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Membros</a>
        <a href="/admin/noticias" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Noticias</a>
        <a href="/admin/eventos" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Eventos</a>
        <a href="/admin/campeonatos" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Campeonatos</a>
        <a href="/admin/catalogo" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Catálogo</a>
        <a href="/admin/configuracion" class="dark:hover:bg-white/5 dark:text-gray-300 focus-visible font-semibold hover:bg-gray-100 hover:text-brand-gold px-4 py-3 rounded-sm text-brand-black text-sm tracking-wide transition-colors uppercase">Configuración Global</a>
      </nav>
    </aside>
    <!-- Main Content -->
    <div class="flex flex-1 flex-col min-w-0">
      <header class="backdrop-blur-md bg-brand-white/80 border-b border-gray-200 dark:bg-brand-dark/80 dark:border-white/5 flex h-16 items-center justify-between px-8 sticky top-0 z-10">
        <h1 class="dark:text-white font-display font-semibold text-brand-black text-xl tracking-wide uppercase">{title}</h1>
        <div class="flex font-semibold gap-2 items-center text-brand-gold text-xs tracking-wider uppercase">
          <span class="animate-pulse bg-brand-gold h-2 rounded-full w-2"></span>
          Admin Session
        </div>
      </header>
      <main class="flex-1 lg:p-12 overflow-y-auto p-8">
        <div class="max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>