---
import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={title}>
  <header class="w-full py-6 px-8 flex justify-between items-center border-b border-gray-200 dark:border-white/10 bg-white/95 dark:bg-[#111]/95 backdrop-blur-md sticky top-0 z-50 transition-all duration-300">
    <a href="/" class="flex items-center gap-3 group focus-visible">
      <svg class="w-8 h-8 text-brand-gold group-hover:scale-110 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <div class="font-medium text-[15px] tracking-[0.05em] uppercase text-[#111111] dark:text-brand-white hidden sm:block group-hover:text-brand-gold transition-colors duration-300">{tenantConfig.name}</div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-6 lg:gap-8">
      <a href="/" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('nav.home')}</a>
      <a href="/nosotros" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('nav.about')}</a>
      <a href="/eventos" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('app.events')}</a>
      <a href="/pesquisas" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('nav.championships')}</a>
      <a href="/ecosistema" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('nav.catalog')}</a>
      <a href="/biblioteca" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">{t('nav.library')}</a>
      <a href="/campeonatos" class="text-[11px] font-medium uppercase tracking-[0.15em] text-[#333333] dark:text-gray-300 hover:text-brand-gold dark:hover:text-brand-gold transition-colors focus-visible">Campeonatos</a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-brand-black dark:text-brand-white p-2 focus-visible hover:text-brand-gold dark:hover:text-brand-gold transition-colors" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </header>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden opacity-0 -translate-y-4 md:hidden bg-brand-white/95 dark:bg-brand-black/95 border-b border-brand-black/10 dark:border-white/10 shadow-lg fixed inset-0 z-40 backdrop-blur-lg pt-20 transition-all duration-300 ease-in-out">
    <nav class="flex flex-col px-8 py-6 gap-6 mt-4">
      <a href="/" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('nav.home')}</a>
      <a href="/nosotros" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('nav.about')}</a>
      <a href="/eventos" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('app.events')}</a>
      <a href="/pesquisas" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('nav.championships')}</a>
      <a href="/ecosistema" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('nav.catalog')}</a>
      <a href="/biblioteca" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">{t('nav.library')}</a>
      <a href="/campeonatos" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">Campeonatos</a>
      <a href="/faq" class="hover:text-brand-gold transition-colors focus-visible">FAQ</a>
        <a href="/contacto" class="text-base font-semibold uppercase tracking-wide text-brand-black dark:text-gray-300 hover:text-brand-gold transition-colors focus-visible">Contacto</a>
    </nav>
  </div>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    // Check local storage or match media for theme preference
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          setTimeout(() => {
            menu.classList.remove('opacity-0', '-translate-y-4');
          }, 10);
        } else {
          menu.classList.add('opacity-0', '-translate-y-4');
          setTimeout(() => {
            menu.classList.add('hidden');
          }, 300);
        }
        btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
    }
  </script>
  <main class="min-h-screen">
    <slot />
  </main>
  <footer class="py-16 text-center text-sm font-medium tracking-wide uppercase text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-white/5 bg-brand-white dark:bg-brand-black mt-auto">
    <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-brand-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span class="font-bold text-lg tracking-wider text-brand-black dark:text-brand-white">{tenantConfig.name}</span>
      </div>
      <nav class="flex flex-wrap justify-center gap-6 md:gap-8">
        <a href="/" class="hover:text-brand-gold transition-colors focus-visible">{t('nav.home')}</a>
        <a href="/nosotros" class="hover:text-brand-gold transition-colors focus-visible">{t('nav.about')}</a>
        <a href="/eventos" class="hover:text-brand-gold transition-colors focus-visible">{t('app.events')}</a>
        <a href="/pesquisas" class="hover:text-brand-gold transition-colors focus-visible">{t('nav.championships')}</a>
        <a href="/ecosistema" class="hover:text-brand-gold transition-colors focus-visible">{t('nav.catalog')}</a>
        <a href="/biblioteca" class="hover:text-brand-gold transition-colors focus-visible">{t('nav.library')}</a>
        <a href="/campeonatos" class="hover:text-brand-gold transition-colors focus-visible">Campeonatos</a>
        <a href="/faq" class="hover:text-brand-gold transition-colors focus-visible">FAQ</a>
        <a href="/contacto" class="hover:text-brand-gold transition-colors focus-visible">Contacto</a>
      </nav>
    </div>
    <div class="mt-12 text-xs opacity-60">
      &copy; {new Date().getFullYear()} {tenantConfig.name}. Todos los derechos reservados.
    </div>
  </footer>
</BaseLayout>