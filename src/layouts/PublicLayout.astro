---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={title}>
  <header class="w-full py-4 px-8 flex justify-between items-center border-b border-brand-dark-card/50">
    <div class="font-bold text-xl tracking-wider uppercase text-brand-gold">Modulação</div>
    <nav class="flex gap-6">
      <a href="/" class="hover:text-brand-gold transition-colors">Inicio</a>
      <a href="/nosotros" class="hover:text-brand-gold transition-colors">Nosotros</a>
      <a href="/campeonatos" class="hover:text-brand-gold transition-colors">Campeonatos</a>
      <a href="/catalogo" class="hover:text-brand-gold transition-colors">Catálogo</a>
    </nav>
  </header>
  <main class="min-h-screen">
    <slot />
  </main>
  <footer class="py-8 text-center text-sm text-gray-500 border-t border-brand-dark-card/50">
    &copy; {new Date().getFullYear()} Modulação. Todos los derechos reservados.
  </footer>
</BaseLayout>