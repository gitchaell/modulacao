---
import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={title}>
  <header class="w-full py-4 px-8 flex justify-between items-center border-b border-brand-dark-card/50">
    <div class="font-bold text-xl tracking-wider uppercase text-brand-gold">Modulação</div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-6">
      <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
      <a href="/nosotros" class="hover:text-brand-gold transition-colors">{t('nav.about')}</a>
      <a href="/campeonatos" class="hover:text-brand-gold transition-colors">{t('nav.championships')}</a>
      <a href="/catalogo" class="hover:text-brand-gold transition-colors">{t('nav.catalog')}</a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-brand-gold p-2 focus:outline-none" aria-label="Abrir menú de navegación">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </header>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-brand-black border-b border-brand-dark-card/50">
    <nav class="flex flex-col px-8 py-4 gap-4">
      <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
      <a href="/nosotros" class="hover:text-brand-gold transition-colors">{t('nav.about')}</a>
      <a href="/campeonatos" class="hover:text-brand-gold transition-colors">{t('nav.championships')}</a>
      <a href="/catalogo" class="hover:text-brand-gold transition-colors">{t('nav.catalog')}</a>
    </nav>
  </div>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  </script>
  <main class="min-h-screen">
    <slot />
  </main>
  <footer class="py-8 text-center text-sm text-gray-500 border-t border-brand-dark-card/50">
    &copy; {new Date().getFullYear()} Modulação. Todos los derechos reservados.
  </footer>
</BaseLayout>