---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { Telescope, Map, Users } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);
---
<PublicLayout title={t('nav.catalog')}>
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-24 relative">
    <div class="absolute bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-6xl mx-auto px-6 relative z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('nav.catalog')}</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 text-lg">{t('ecosistema.description')}</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-20">
    <div class="container max-w-6xl mx-auto px-6">
      <div class="gap-10 grid grid-cols-1 md:grid-cols-3">
        <Card class="backdrop-blur-xl bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/10 flex flex-col group items-center premium-shadow text-center">
          <div class="bg-brand-gold/10 dark:text-brand-white duration-300 flex group-hover:bg-brand-gold group-hover:text-brand-black h-16 items-center justify-center mb-6 mx-auto rounded-full text-brand-gold transition-all w-16">
            <Users class="h-8 w-8" />
          </div>
          <h3 class="dark:text-white font-bold font-display mb-4 text-2xl text-brand-black tracking-widest uppercase">{t('ecosistema.dakila')}</h3>
          <p class="dark:text-gray-400 leading-relaxed text-base text-gray-600">
            Asociación de investigación mundial que reúne a buscadores del conocimiento. Organizamos gincanas, estudios de campo y promovemos el desarrollo humano integral a través del cuestionamiento constante.
          </p>
        </Card>

        <Card class="backdrop-blur-xl bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/10 flex flex-col group items-center premium-shadow text-center">
          <div class="bg-brand-gold/10 dark:text-brand-white duration-300 flex group-hover:bg-brand-gold group-hover:text-brand-black h-16 items-center justify-center mb-6 mx-auto rounded-full text-brand-gold transition-all w-16">
            <Telescope class="h-8 w-8" />
          </div>
          <h3 class="dark:text-white font-bold font-display mb-4 text-2xl text-brand-black tracking-widest uppercase">{t('ecosistema.zigurats')}</h3>
          <p class="dark:text-gray-400 leading-relaxed text-base text-gray-600">
            Complejo turístico y base de investigaciones en Mato Grosso do Sul. Aquí realizamos nuestras principales observaciones de anomalías astronómicas utilizando equipamiento especializado y el método de la Ciencia Lilarial.
          </p>
        </Card>

        <Card class="backdrop-blur-xl bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/10 flex flex-col group items-center premium-shadow text-center">
          <div class="bg-brand-gold/10 dark:text-brand-white duration-300 flex group-hover:bg-brand-gold group-hover:text-brand-black h-16 items-center justify-center mb-6 mx-auto rounded-full text-brand-gold transition-all w-16">
            <Map class="h-8 w-8" />
          </div>
          <h3 class="dark:text-white font-bold font-display mb-4 text-2xl text-brand-black tracking-widest uppercase">{t('ecosistema.havalon')}</h3>
          <p class="dark:text-gray-400 leading-relaxed text-base text-gray-600">
            Sede rural destinada a experimentos de campo y tecnologías mentales. Un entorno natural donde los participantes interactúan con diversas realidades vibracionales y prueban conceptos físicos como los reflectores parabólicos.
          </p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>
