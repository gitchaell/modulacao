---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { Telescope, Map, Users } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);
---
<PublicLayout title={t('nav.catalog')}>
  <div class="py-24 bg-brand-black border-b border-gray-200 dark:border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 max-w-6xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('nav.catalog')}</h1>
      <p class="text-gray-400 text-lg font-medium text-balance">Conoce más sobre las sedes de investigación y grupos de Dakila Pesquisas.</p>
    </div>
  </div>

  <section class="py-20 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <Card class="group flex flex-col items-center text-center bg-brand-white dark:bg-brand-dark-card backdrop-blur-xl border border-gray-200 dark:border-white/10 premium-shadow">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-300">
            <Users class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">Dakila Pesquisas</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed">
            Asociación de investigación mundial que reúne a buscadores del conocimiento. Organizamos gincanas, estudios de campo y promovemos el desarrollo humano integral a través del cuestionamiento constante.
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-brand-white dark:bg-brand-dark-card backdrop-blur-xl border border-gray-200 dark:border-white/10 premium-shadow">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-300">
            <Telescope class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">Zigurats</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed">
            Complejo turístico y base de investigaciones en Mato Grosso do Sul. Aquí realizamos nuestras principales observaciones de anomalías astronómicas utilizando equipamiento especializado y el método de la Ciencia Lilarial.
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-brand-white dark:bg-brand-dark-card backdrop-blur-xl border border-gray-200 dark:border-white/10 premium-shadow">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-300">
            <Map class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">Recanto de Havalon</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed">
            Sede rural destinada a experimentos de campo y tecnologías mentales. Un entorno natural donde los participantes interactúan con diversas realidades vibracionales y prueban conceptos físicos como los reflectores parabólicos.
          </p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>
