---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { championships, seasons } from '@/data/db/schema';
import { eq } from 'drizzle-orm';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

// Fetch data
const allChampionships = await db.select({
  id: championships.id,
  name: championships.name,
  slug: championships.slug,
  type: championships.type,
  status: championships.status,
  seasonName: seasons.name,
  coverImageUrl: championships.coverImageUrl,
}).from(championships)
  .leftJoin(seasons, eq(championships.seasonId, seasons.id));

---

<PublicLayout title={t('nav.championships')}>
  <div class="relative py-32 bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('nav.championships')}</h1>
      <p class="text-gray-400 text-xl font-semibold text-balance">Explora nuestras últimas competiciones, estadísticas y clasificaciones.</p>
    </div>
  </div>

  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 lg:px-8 max-w-6xl animate-smooth-fade" style="animation-delay: 0.1s;">

      {allChampionships.length === 0 ? (
        <Card class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 text-center py-24 premium-shadow relative overflow-hidden">
           <p class="text-gray-500 font-semibold">No hay campeonatos activos en este momento.</p>
        </Card>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allChampionships.map((champ) => (
             <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all premium-shadow group overflow-hidden flex flex-col h-full focus-visible">
               <div class="h-48 relative bg-brand-black/5 flex items-center justify-center overflow-hidden">
                 {champ.coverImageUrl ? (
                   <img src={champ.coverImageUrl} alt={champ.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
                 ) : (
                   <div class="text-gray-300 dark:text-gray-700">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                   </div>
                 )}
                 <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                 <div class="absolute top-4 right-4 flex gap-2">
                   <Badge variant={champ.status === 'ONGOING' ? 'success' : champ.status === 'FINISHED' ? 'neutral' : 'warning'}>
                     {champ.status === 'ONGOING' ? 'En Curso' : champ.status === 'FINISHED' ? 'Finalizado' : 'Próximamente'}
                   </Badge>
                 </div>
               </div>
               <div class="p-6 flex-1 flex flex-col">
                 <div class="text-xs font-bold tracking-widest text-brand-gold uppercase mb-2">{champ.seasonName || 'General'} • {champ.type}</div>
                 <h2 class="font-display text-xl font-bold text-brand-black dark:text-white mb-4 group-hover:text-brand-gold transition-colors">{champ.name}</h2>
                 <div class="mt-auto">
                   <a href="/campeonatos" class="block mt-auto"><Button variant="outline" size="sm" fullWidth class="group-hover:bg-brand-gold group-hover:text-brand-black transition-colors">Ver Detalles</Button></a>
                 </div>
               </div>
             </Card>
          ))}
        </div>
      )}

    </div>
  </section>
</PublicLayout>
