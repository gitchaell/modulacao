---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { championships, seasons } from '@/data/db/schema';
import { desc, eq, and } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Obtener la temporada activa
const [activeSeason] = await db.select().from(seasons).where(eq(seasons.isActive, true)).limit(1);

// Obtener campeonatos de la temporada activa
let activeChampionships = [];
if (activeSeason) {
  activeChampionships = await db
    .select()
    .from(championships)
    .where(and(
      eq(championships.seasonId, activeSeason.id),
      eq(championships.status, 'ONGOING')
    ))
    .orderBy(desc(championships.name));
}
---

<PublicLayout title={t('nav.championships')}>
  <div class="bg-brand-black border-b border-gray-200 dark:border-white/5 text-center py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-4">{t('nav.championships')}</h1>
      <p class="text-gray-400 text-lg font-medium text-balance">Resultados en vivo, tablas de posiciones y estadísticas oficiales de {tenantConfig.name}.</p>
    </div>
  </div>

  <section class="py-16 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 max-w-5xl">

      {activeSeason ? (
        <div class="mb-12 animate-smooth-fade" style="animation-delay: 0.1s;">
          <div class="flex items-center gap-4 mb-10">
            <h2 class="font-display text-2xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{activeSeason.name}</h2>
            <Badge variant="gold">Temporada Actual</Badge>
          </div>

          {activeChampionships.length === 0 ? (
            <div class="text-center py-16 text-gray-500 bg-brand-white dark:bg-brand-dark-card rounded-sm border border-gray-200 dark:border-white/5 premium-shadow">
              <p class="font-medium text-lg">No hay campeonatos en curso en esta temporada.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {activeChampionships.map(champ => (
                <a href={`/campeonatos/${champ.slug}`} class="block group focus-visible">
                  <Card noPadding class="bg-brand-white dark:bg-brand-black flex overflow-hidden h-40">
                    <div class="w-1/3 bg-gray-50 dark:bg-brand-dark border-r border-gray-200 dark:border-white/5 flex items-center justify-center relative overflow-hidden">
                      {champ.coverImageUrl ? (
                        <img loading="lazy" decoding="async" src={champ.coverImageUrl} alt={champ.name} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" />
                      ) : (
                        <svg class="w-12 h-12 text-brand-gold/40 group-hover:text-brand-gold transition-colors duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                      )}
                    </div>
                    <div class="w-2/3 p-6 flex flex-col justify-center">
                      <div class="text-[10px] font-bold tracking-widest text-brand-gold uppercase mb-2">
                        {champ.type === 'LEAGUE' ? 'Liga' : 'Copa'}
                      </div>
                      <h3 class="font-display text-lg font-bold text-brand-black dark:text-white mb-2 group-hover:text-brand-gold transition-colors line-clamp-2 leading-snug">{champ.name}</h3>
                      <div class="text-xs text-gray-500 font-semibold uppercase tracking-wider flex items-center gap-1.5 mt-auto group-hover:text-brand-black dark:group-hover:text-white transition-colors">
                        Ver Posiciones <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                      </div>
                    </div>
                  </Card>
                </a>
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="text-center py-24 text-gray-500 animate-smooth-fade">
          <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-700 mb-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <p class="font-display text-2xl font-semibold text-brand-black dark:text-white mb-2">Fuera de temporada.</p>
          <p class="text-base text-gray-500">Actualmente no hay ninguna temporada deportiva activa.</p>
        </div>
      )}

      <!-- Archivo Histórico Placeholder -->
      <div class="border-t border-gray-200 dark:border-white/5 pt-12 mt-16 text-center animate-smooth-fade" style="animation-delay: 0.2s;">
        <h3 class="font-display text-lg font-bold text-brand-black dark:text-gray-300 uppercase tracking-wider mb-4">Archivo Histórico</h3>
        <p class="text-gray-500 text-sm font-medium">Las estadísticas de temporadas anteriores estarán disponibles próximamente.</p>
      </div>

    </div>
  </section>
</PublicLayout>