---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { championships, seasons } from '@/data/db/schema';
import { eq } from 'drizzle-orm';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('championships', lang);
const t = usePageTranslations(pageDict, lang);

// Fetch data
const allChampionships = await db.select({
  id: championships.id,
  name: championships.name,
  slug: championships.slug,
  type: championships.type,
  status: championships.status,
  seasonName: seasons.name,
  coverImageUrl: championships.coverImageUrl,
}).from(championships)
  .leftJoin(seasons, eq(championships.seasonId, seasons.id));

---

<PublicLayout title={t('champ.title')}>
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-32 relative">
    <div class="absolute bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 relative text-center z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('champ.title')}</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 dark:text-gray-400 text-xl">{t('champ.subtitle')}</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-24">
    <div class="animate-smooth-fade container lg:px-8 max-w-6xl mx-auto px-6" style="animation-delay: 0.1s;">

      {allChampionships.length === 0 ? (
        <Card class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden premium-shadow py-24 relative text-center">
           <p class="dark:text-gray-400 font-semibold text-gray-500 dark:text-gray-400">{t('champ.empty')}</p>
        </Card>
      ) : (
        <div class="gap-8 grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2">
          {allChampionships.map((champ) => (
             <Card noPadding class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 flex flex-col focus-visible group h-full hover:border-brand-gold/50 overflow-hidden premium-shadow transition-all">
               <div class="bg-gray-100 dark:bg-brand-black/5 flex h-48 items-center justify-center overflow-hidden relative">
                 {champ.coverImageUrl ? (
                   <img src={champ.coverImageUrl} alt={champ.name} class="duration-700 group-hover:scale-105 h-full object-cover transition-transform w-full" loading="lazy" decoding="async" />
                 ) : (
                   <div class="dark:text-gray-700 text-gray-600 dark:text-gray-300">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                   </div>
                 )}
                 <div class="absolute bg-gradient-to-t from-black/60 inset-0 to-transparent"></div>
                 <div class="absolute flex gap-2 right-4 top-4">
                   <Badge variant={champ.status === 'ONGOING' ? 'success' : champ.status === 'FINISHED' ? 'neutral' : 'warning'}>
                     {champ.status === 'ONGOING' ? t('champ.ongoing') : champ.status === 'FINISHED' ? t('champ.finished') : t('champ.upcoming')}
                   </Badge>
                 </div>
               </div>
               <div class="flex flex-1 flex-col p-6">
                 <div class="font-bold mb-2 text-brand-gold text-xs tracking-widest uppercase">{champ.seasonName || t('champ.general')} • {champ.type}</div>
                 <h2 class="dark:text-brand-white font-bold font-display group-hover:text-brand-gold mb-4 text-brand-black text-xl transition-colors">{champ.name}</h2>
                 <div class="mt-auto">
                   <a href="/campeonatos" class="block mt-auto"><Button variant="outline" size="sm" fullWidth class="dark:hover:text-brand-white dark:text-gray-400 group-hover:bg-brand-gold group-text-gray-500 dark:text-gray-400 hover:text-brand-black text-gray-500 dark:text-gray-400 transition-colors">{t('champ.details')}</Button></a>
                 </div>
               </div>
             </Card>
          ))}
        </div>
      )}

    </div>
  </section>
</PublicLayout>
