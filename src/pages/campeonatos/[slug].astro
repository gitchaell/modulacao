---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { db } from '@/data/db/db';
import { championships, seasons, matches, teams, championshipTeams } from '@/data/db/schema';
import { eq, and, desc, asc } from 'drizzle-orm';

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Fetch Championship
const [championship] = await db
  .select({
    champ: championships,
    season: seasons
  })
  .from(championships)
  .innerJoin(seasons, eq(championships.seasonId, seasons.id))
  .where(eq(championships.slug, slug));

if (!championship) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Fetch Teams in this championship
const teamsInChamp = await db
  .select({ team: teams })
  .from(championshipTeams)
  .innerJoin(teams, eq(championshipTeams.teamId, teams.id))
  .where(eq(championshipTeams.championshipId, championship.champ.id));

// Fetch Matches for this championship
const champMatches = await db
  .select()
  .from(matches)
  .where(eq(matches.championshipId, championship.champ.id))
  .orderBy(asc(matches.date));

// Calculate automated standings table
const standingsMap = new Map();

// Initialize standings for all participating teams
teamsInChamp.forEach(({ team }) => {
  standingsMap.set(team.id, {
    team,
    played: 0,
    won: 0,
    drawn: 0,
    lost: 0,
    goalsFor: 0,
    goalsAgainst: 0,
    goalDifference: 0,
    points: 0
  });
});

// Process finished matches to calculate points
champMatches.forEach(match => {
  if (match.status !== 'FINISHED') return;
  if (match.homeScore === null || match.awayScore === null) return;

  const home = standingsMap.get(match.homeTeamId);
  const away = standingsMap.get(match.awayTeamId);

  if (!home || !away) return;

  home.played += 1;
  away.played += 1;
  home.goalsFor += match.homeScore;
  home.goalsAgainst += match.awayScore;
  away.goalsFor += match.awayScore;
  away.goalsAgainst += match.homeScore;

  if (match.homeScore > match.awayScore) {
    home.won += 1;
    home.points += 3;
    away.lost += 1;
  } else if (match.homeScore < match.awayScore) {
    away.won += 1;
    away.points += 3;
    home.lost += 1;
  } else {
    home.drawn += 1;
    away.drawn += 1;
    home.points += 1;
    away.points += 1;
  }

  home.goalDifference = home.goalsFor - home.goalsAgainst;
  away.goalDifference = away.goalsFor - away.goalsAgainst;
});

// Sort standings array
const standings = Array.from(standingsMap.values()).sort((a, b) => {
  if (b.points !== a.points) return b.points - a.points;
  if (b.goalDifference !== a.goalDifference) return b.goalDifference - a.goalDifference;
  return b.goalsFor - a.goalsFor;
});

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(date));
};
---

<PublicLayout title={`${championship.champ.name} | Tabla de Posiciones`}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">

    <div class="bg-brand-black border-b border-brand-dark-card py-12 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-60"></div>
      <div class="relative z-10 container mx-auto px-6 max-w-6xl flex flex-col md:flex-row items-center gap-6">
        <div class="w-24 h-24 bg-brand-dark border-2 border-brand-dark-card rounded-2xl flex items-center justify-center flex-shrink-0">
          {championship.champ.coverImageUrl ? (
            <img loading="lazy" decoding="async" src={championship.champ.coverImageUrl} alt={championship.champ.name} class="w-full h-full object-cover rounded-xl" />
          ) : (
             <svg class="w-10 h-10 text-brand-gold" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          )}
        </div>
        <div class="text-center md:text-left">
          <div class="text-brand-gold text-sm font-bold tracking-widest uppercase mb-1">{championship.season.name}</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white">{championship.champ.name}</h1>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-6 max-w-6xl mt-12 grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Standings Table -->
      <div class="lg:col-span-2">
        <h2 class="text-xl font-bold text-brand-gold uppercase tracking-wider mb-6">Tabla de Posiciones</h2>
        <div class="bg-brand-black border border-brand-dark-card rounded-xl overflow-hidden shadow-2xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[600px]">
              <thead>
                <tr class="bg-brand-dark border-b border-brand-dark-card text-xs font-bold text-gray-400 uppercase tracking-wider">
                  <th class="px-4 py-3 text-center w-12">#</th>
                  <th class="px-4 py-3">Equipo</th>
                  <th class="px-3 py-3 text-center w-12" title="Partidos Jugados">PJ</th>
                  <th class="px-3 py-3 text-center w-12" title="Partidos Ganados">G</th>
                  <th class="px-3 py-3 text-center w-12" title="Partidos Empatados">E</th>
                  <th class="px-3 py-3 text-center w-12" title="Partidos Perdidos">P</th>
                  <th class="px-3 py-3 text-center w-12" title="Diferencia de Goles">DG</th>
                  <th class="px-4 py-3 text-center w-16 text-white text-sm">PTS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-dark-card">
                {standings.map((row, index) => (
                  <tr class="hover:bg-brand-dark/50 transition-colors">
                    <td class="px-4 py-3 text-center font-bold text-gray-500">{index + 1}</td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-brand-dark border border-brand-dark-card flex items-center justify-center overflow-hidden flex-shrink-0">
                          {row.team.logoUrl ? (
                            <img loading="lazy" decoding="async" src={row.team.logoUrl} alt={row.team.name} class="w-full h-full object-cover" />
                          ) : (
                            <span class="text-xs font-bold text-brand-gold">{row.team.name.charAt(0)}</span>
                          )}
                        </div>
                        <span class="font-bold text-white">{row.team.name}</span>
                      </div>
                    </td>
                    <td class="px-3 py-3 text-center text-sm text-gray-300">{row.played}</td>
                    <td class="px-3 py-3 text-center text-sm text-gray-300">{row.won}</td>
                    <td class="px-3 py-3 text-center text-sm text-gray-300">{row.drawn}</td>
                    <td class="px-3 py-3 text-center text-sm text-gray-300">{row.lost}</td>
                    <td class="px-3 py-3 text-center text-sm text-gray-300 font-mono">{row.goalDifference > 0 ? `+${row.goalDifference}` : row.goalDifference}</td>
                    <td class="px-4 py-3 text-center font-bold text-brand-gold text-lg">{row.points}</td>
                  </tr>
                ))}
                {standings.length === 0 && (
                  <tr>
                    <td colspan="8" class="p-8 text-center text-gray-500">Aún no hay equipos inscritos en este campeonato.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Fixture / Matches -->
      <div>
        <h2 class="text-xl font-bold text-brand-gold uppercase tracking-wider mb-6">Partidos Recientes</h2>
        <div class="space-y-4">
          {champMatches.length === 0 ? (
            <div class="bg-brand-black border border-brand-dark-card rounded-xl p-6 text-center text-gray-500 text-sm">
              El fixture aún no ha sido generado.
            </div>
          ) : (
            champMatches.slice(-5).reverse().map(match => {
              const home = teamsInChamp.find(t => t.team.id === match.homeTeamId)?.team;
              const away = teamsInChamp.find(t => t.team.id === match.awayTeamId)?.team;
              return (
                <div class="bg-brand-black border border-brand-dark-card rounded-xl p-4 flex flex-col gap-3 hover:border-brand-gold/50 transition-colors">
                  <div class="flex justify-between items-center text-xs text-gray-500 font-bold uppercase tracking-wider">
                    <span>{formatDate(match.date as unknown as Date)}</span>
                    <span class={match.status === 'FINISHED' ? 'text-gray-600' : match.status === 'PLAYING' ? 'text-green-500 animate-pulse' : 'text-brand-gold'}>
                      {match.status === 'FINISHED' ? 'Finalizado' : match.status === 'PLAYING' ? 'En Vivo' : 'Por Jugar'}
                    </span>
                  </div>
                  <div class="flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded bg-brand-dark border border-brand-dark-card flex items-center justify-center overflow-hidden">
                           {home?.logoUrl ? <img loading="lazy" decoding="async" src={home.logoUrl} class="w-full h-full object-cover"/> : <span class="text-[10px] text-gray-500">{home?.name.charAt(0)}</span>}
                        </div>
                        <span class="font-bold text-white text-sm">{home?.name || 'Local'}</span>
                      </div>
                      <span class={`font-bold text-lg ${match.homeScore > match.awayScore ? 'text-white' : 'text-gray-500'}`}>{match.status === 'SCHEDULED' ? '-' : match.homeScore}</span>
                    </div>
                    <div class="flex justify-between items-center">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded bg-brand-dark border border-brand-dark-card flex items-center justify-center overflow-hidden">
                           {away?.logoUrl ? <img loading="lazy" decoding="async" src={away.logoUrl} class="w-full h-full object-cover"/> : <span class="text-[10px] text-gray-500">{away?.name.charAt(0)}</span>}
                        </div>
                        <span class="font-bold text-white text-sm">{away?.name || 'Visita'}</span>
                      </div>
                      <span class={`font-bold text-lg ${match.awayScore > match.homeScore ? 'text-white' : 'text-gray-500'}`}>{match.status === 'SCHEDULED' ? '-' : match.awayScore}</span>
                    </div>
                  </div>
                </div>
              );
            })
          )}
        </div>
      </div>

    </div>
  </div>
</PublicLayout>