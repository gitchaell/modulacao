---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import Card from '@/components/core/Card.astro';


const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('faq', lang);
const t = usePageTranslations(pageDict, lang);
---
<PublicLayout title={t('faq.title')}>
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-32 relative">
    <div class="absolute bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 relative text-center z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('faq.title')}</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 dark:text-gray-400 text-xl">{t('faq.subtitle')}</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-24">
    <div class="animate-smooth-fade container lg:px-8 max-w-4xl mx-auto px-6 space-y-16" style="animation-delay: 0.1s;">
      <Card noPadding class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 premium-shadow">
        <div class="md:p-12 p-8">
          <div class="border-b border-gray-100 dark:border-white/5 flex gap-6 items-center mb-8 pb-6">
            <div class="bg-brand-gold/10 flex h-16 items-center justify-center rounded-sm shrink-0 text-brand-gold w-16">
              <div class="h-8 w-8"></div>
            </div>
            <h2 class="dark:text-white font-bold font-display text-3xl text-brand-black tracking-wider uppercase">{t('about.faq.title')}</h2>
          </div>

          <div class="space-y-6">
            <details class="bg-gray-50 border border-gray-200 cursor-pointer dark:bg-brand-black dark:border-white/5 group hover:border-brand-gold/50 p-6 rounded-sm shadow-sm transition-colors">
              <summary class="dark:text-white flex font-bold font-display gap-3 items-start outline-none text-brand-black text-xl">
                <span class="text-brand-gold">Q.</span> {t('faq.q1')}
              </summary>
              <p class="border-gray-200 border-l-2 dark:border-gray-800 dark:text-gray-400 font-semibold ml-2 mt-4 pl-8 py-2 text-base text-gray-600">{t('faq.a1')}</p>
            </details>
            <details class="bg-gray-50 border border-gray-200 cursor-pointer dark:bg-brand-black dark:border-white/5 group hover:border-brand-gold/50 p-6 rounded-sm shadow-sm transition-colors">
              <summary class="dark:text-white flex font-bold font-display gap-3 items-start outline-none text-brand-black text-xl">
                <span class="text-brand-gold">Q.</span> {t('faq.q2')}
              </summary>
              <p class="border-gray-200 border-l-2 dark:border-gray-800 dark:text-gray-400 font-semibold ml-2 mt-4 pl-8 py-2 text-base text-gray-600">{t('faq.a2')}</p>
            </details>
            <details class="bg-gray-50 border border-gray-200 cursor-pointer dark:bg-brand-black dark:border-white/5 group hover:border-brand-gold/50 p-6 rounded-sm shadow-sm transition-colors">
              <summary class="dark:text-white flex font-bold font-display gap-3 items-start outline-none text-brand-black text-xl">
                <span class="text-brand-gold">Q.</span> {t('faq.q3')}
              </summary>
              <p class="border-gray-200 border-l-2 dark:border-gray-800 dark:text-gray-400 font-semibold ml-2 mt-4 pl-8 py-2 text-base text-gray-600">{t('faq.a3')}</p>
            </details>
          </div>
        </div>
      </Card>
    </div>
  </section>
</PublicLayout>
