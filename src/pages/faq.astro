---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import Card from '@/components/core/Card.astro';
import { HelpCircle } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('faq', lang);
const t = usePageTranslations(pageDict, lang);
---
<PublicLayout title={t('faq.title')}>
  <div class="relative py-32 bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('faq.title')}</h1>
      <p class="text-gray-400 text-xl font-semibold text-balance">{t('faq.subtitle')}</p>
    </div>
  </div>

  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 lg:px-8 max-w-4xl space-y-16 animate-smooth-fade" style="animation-delay: 0.1s;">
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 premium-shadow">
        <div class="p-8 md:p-12">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
              <HelpCircle class="w-8 h-8" />
            </div>
            <h2 class="font-display text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.faq.title')}</h2>
          </div>

          <div class="space-y-6">
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> {t('faq.q1')}
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-semibold pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">{t('faq.a1')}</p>
            </details>
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> {t('faq.q2')}
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-semibold pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">{t('faq.a2')}</p>
            </details>
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> {t('faq.q3')}
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-semibold pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">{t('faq.a3')}</p>
            </details>
          </div>
        </div>
      </Card>
    </div>
  </section>
</PublicLayout>
