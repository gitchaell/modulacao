---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { db } from '@/data/db/db';
import { events, groups } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const { id } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [eventData] = await db
  .select({
    event: events,
    group: groups
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .where(eq(events.id, id as string))
  .limit(1);

if (!eventData) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { event, group } = eventData;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
---

<PublicLayout title={event.title}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">

    <!-- Hero Image -->
    <div class="relative h-[40vh] md:h-[50vh] bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
      {event.coverImageUrl ? (
        <img loading="lazy" decoding="async" src={event.coverImageUrl} alt={event.title} class="w-full h-full object-cover opacity-60 mix-blend-overlay" />
      ) : (
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-brand-black to-brand-black opacity-80 z-0"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-brand-offwhite dark:from-brand-dark to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-6 max-w-4xl relative z-10 -mt-32">
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 shadow-2xl overflow-hidden animate-smooth-fade">
        <div class="p-8 md:p-12">

          <div class="flex flex-wrap gap-3 mb-6">
            <Badge variant="gold">{group ? group.name : 'Evento Global'}</Badge>
            <Badge variant="neutral">Capacidad: {event.capacity} personas</Badge>
          </div>

          <h1 class="font-display text-3xl md:text-5xl font-bold text-brand-black dark:text-white mb-6 leading-tight">{event.title}</h1>

          <div class="flex flex-col md:flex-row gap-6 md:gap-12 mb-10 pb-10 border-b border-gray-100 dark:border-white/5">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <p class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-1">Fecha y Hora</p>
                <p class="font-medium text-brand-black dark:text-white">{formatDate(event.date as unknown as Date)}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-1">Ubicación</p>
                <p class="font-medium text-brand-black dark:text-white">{event.location}</p>
              </div>
            </div>
          </div>

          <div class="prose dark:prose-invert prose-brand max-w-none text-gray-600 dark:text-gray-300 font-medium leading-relaxed whitespace-pre-wrap">
            {event.description}
          </div>

          <div class="mt-12 pt-10 border-t border-gray-100 dark:border-white/5 flex justify-center">
            <Button size="lg" variant="primary" class="w-full md:w-auto px-12 shadow-[0_0_20px_rgba(212,175,55,0.3)] hover:shadow-[0_0_30px_rgba(212,175,55,0.5)] transition-shadow">
              Registrar Asistencia
            </Button>
          </div>

        </div>
      </Card>
    </div>
  </div>
</PublicLayout>
