---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { db } from '@/data/db/db';
import { events, groups } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { getLangFromUrl } from '@/utils/i18n';


const { id } = Astro.params;
const lang = getLangFromUrl(Astro.cookies);



const [eventData] = await db
  .select({
    event: events,
    group: groups
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .where(eq(events.id, id as string))
  .limit(1);

if (!eventData) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { event, group } = eventData;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
---

<PublicLayout title={event.title}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">

    <!-- Hero Image -->
    <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 h-[40vh] md:h-[50vh] overflow-hidden relative">
      {event.coverImageUrl ? (
        <img loading="lazy" decoding="async" src={event.coverImageUrl} alt={event.title} class="h-full mix-blend-overlay object-cover opacity-60 w-full" />
      ) : (
        <div class="absolute bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
      )}
      <div class="absolute bg-gradient-to-t dark:from-brand-dark from-brand-offwhite inset-0 to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="-mt-32 container max-w-4xl mx-auto px-6 relative z-10">
      <Card noPadding class="animate-smooth-fade bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden shadow-2xl">
        <div class="md:p-12 p-8">

          <div class="flex flex-wrap gap-3 mb-6">
            <Badge variant="gold">{group ? group.name : 'Evento Global'}</Badge>
            <Badge variant="neutral">Capacidad: {event.capacity} personas</Badge>
          </div>

          <h1 class="dark:text-white font-bold font-display leading-tight mb-6 md:text-5xl text-3xl text-brand-black">{event.title}</h1>

          <div class="border-b border-gray-100 dark:border-white/5 flex flex-col gap-6 mb-10 md:flex-row md:gap-12 pb-10">
            <div class="flex gap-4 items-start">
              <div class="bg-brand-gold/10 flex h-12 items-center justify-center rounded-sm shrink-0 text-brand-gold w-12">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <p class="dark:text-gray-400 font-bold mb-1 text-gray-500 text-sm tracking-widest uppercase">Fecha y Hora</p>
                <p class="dark:text-white font-semibold text-brand-black">{formatDate(event.date as unknown as Date)}</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="bg-brand-gold/10 flex h-12 items-center justify-center rounded-sm shrink-0 text-brand-gold w-12">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="dark:text-gray-400 font-bold mb-1 text-gray-500 text-sm tracking-widest uppercase">Ubicación</p>
                <p class="dark:text-white font-semibold text-brand-black">{event.location}</p>
              </div>
            </div>
          </div>

          <div class="dark:prose-invert dark:text-gray-300 font-semibold leading-relaxed max-w-none prose prose-brand text-gray-600 whitespace-pre-wrap">
            {event.description}
          </div>

          <div class="border-gray-100 border-t dark:border-white/5 flex justify-center mt-12 pt-10">
            <Button size="lg" variant="primary" class="hover:shadow-[0_0_30px_rgba(212,175,55,0.5)] md:w-auto px-12 shadow-[0_0_20px_rgba(212,175,55,0.3)] transition-shadow w-full">
              Registrar Asistencia
            </Button>
          </div>

        </div>
      </Card>
    </div>
  </div>
</PublicLayout>
