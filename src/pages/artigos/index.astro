---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { db } from '@/data/db/db';
import { articles, profiles } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import { Search, ChevronDown, LayoutGrid, List } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('articles', lang);
const t = usePageTranslations(pageDict, lang);

// Fetch articles with author profiles
const listArticlesRaw = await db
  .select({
    article: articles,
    author: profiles
  })
  .from(articles)
  .leftJoin(profiles, eq(articles.authorId, profiles.userId))
  .where(eq(articles.type, 'ARTIGO'))
  .orderBy(desc(articles.publishedAt));

// Format for easy template use
const listArticles = listArticlesRaw.map(row => ({
  ...row.article,
  author: row.author
}));

const formatDate = (date: Date | null) => {
  if (!date) return '';
  const locale = lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US';
  return new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(date)).toUpperCase();
};

const featuredArticle = listArticles[0];
const gridArticles = listArticles.slice(1);

const navItems = [
  { label: 'TODOS OS TEMAS', active: true, icon: 'grid-2x2' },
  { label: 'FILOSOFIA', active: false, icon: 'feather' },
  { label: 'CIÊNCIA', active: false, icon: 'microscope' },
  { label: 'ARTES', active: false, icon: 'palette' },
  { label: 'CULTURA', active: false, icon: 'book-open' },
  { label: 'CONSCIÊNCIA', active: false, icon: 'brain' },
  { label: 'PROPÓSITO', active: false, icon: 'compass' }
];
---

<PublicLayout title="Artigos - Grupo Modulação">
  <div class="bg-brand-white dark:bg-brand-black dark:bg-brand-dark-card dark:text-gray-300 font-sans min-h-screen text-gray-600">

    {/* HERO SECTION */}
    <div class="border-b border-black/10 dark:border-white/10 overflow-hidden pb-16 pt-24 relative">
      {/* Wave background logic using pseudo-elements in global css or absolute positioning here */}
      <div class="absolute inset-0 mix-blend-screen opacity-40 pointer-events-none z-0" style="background-image: url('https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?q=80&w=1920&h=600&auto=format&fit=crop'); background-size: cover; background-position: center; filter: sepia(1) hue-rotate(10deg) saturate(3);"></div>
      <div class="absolute bg-gradient-to-r from-black inset-0 to-transparent via-black/80 z-0"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="dark:text-gray-400 flex font-semibold items-center mb-6 text-gray-500 text-xs tracking-wider uppercase">
          <a href="/" class="hover:text-brand-gold transition-colors">Início</a>
          <span class="mx-2">></span>
          <span class="dark:text-brand-white text-brand-black">Artigos</span>
        </div>

        <div class="max-w-2xl">
          <h1 class="dark:text-brand-white font-bold mb-2 text-5xl text-brand-black tracking-tight uppercase">ARTIGOS</h1>
          <h2 class="font-semibold mb-6 text-2xl text-brand-gold tracking-wide uppercase">CONHECIMENTO QUE TRANSFORMA</h2>
          <p class="dark:text-gray-400 leading-relaxed max-w-md text-gray-600 text-lg">
            Exploramos ideias, experiências e descobertas que inspiram evolução, consciência e propósito.
          </p>
        </div>
      </div>
    </div>

    {/* NAVIGATION & FILTERS SECTION */}
    <div class="container mx-auto px-6 py-8">
      {/* Top Nav Categories */}
      <div class="border-b border-black/10 dark:border-white/10 flex flex-wrap gap-4 items-center mb-8 pb-6">
        {navItems.map(item => (
          <a href="#" class={`flex items-center gap-2 px-4 py-2 rounded-sm text-sm font-bold uppercase tracking-wider transition-colors ${item.active ? 'bg-brand-gold/10 text-brand-gold border border-brand-gold/30' : 'text-gray-600 hover:text-brand-black dark:text-gray-400 dark:hover:text-brand-black dark:text-brand-white hover:bg-white/5'}`}>
            {/* Pseudo-icon logic for now, using standard generic icons or lucide */}
            {item.label}
          </a>
        ))}
      </div>

      {/* Filter Bar */}
      <div class="flex flex-col gap-4 items-center justify-between mb-10 md:flex-row">
        <div class="flex flex-1 gap-4 items-center md:w-auto w-full">
          <div class="max-w-sm relative w-full">
            <input type="text" placeholder="Buscar artigos..." class="bg-brand-white border border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none pl-4 placeholder-gray-500 pr-10 py-2 rounded-sm text-brand-black text-sm transition-colors w-full" />
            <Search class="absolute h-4 right-3 text-brand-gold top-2.5 w-4" />
          </div>

          <div class="hidden md:block min-w-[160px] relative">
            <select class="appearance-none bg-gray-100 border border-black/10 cursor-pointer dark:bg-black/50 dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none pl-4 pr-10 py-2 rounded-sm text-brand-black text-sm w-full">
              <option>Todos os autores</option>
            </select>
            <ChevronDown class="absolute h-4 pointer-events-none right-3 text-brand-gold top-2.5 w-4" />
          </div>

          <div class="hidden md:block min-w-[140px] relative">
            <select class="appearance-none bg-gray-100 border border-black/10 cursor-pointer dark:bg-black/50 dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none pl-4 pr-10 py-2 rounded-sm text-brand-black text-sm w-full">
              <option>Mais recentes</option>
            </select>
            <ChevronDown class="absolute h-4 pointer-events-none right-3 text-brand-gold top-2.5 w-4" />
          </div>

          <div class="hidden lg:block min-w-[140px] relative">
            <select class="appearance-none bg-gray-100 border border-black/10 cursor-pointer dark:bg-black/50 dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none pl-4 pr-10 py-2 rounded-sm text-brand-black text-sm w-full">
              <option>Dificuldade</option>
            </select>
            <ChevronDown class="absolute h-4 pointer-events-none right-3 text-brand-gold top-2.5 w-4" />
          </div>
        </div>

        <div class="flex gap-2 items-center md:self-auto self-end">
          <button class="bg-brand-gold/10 border border-brand-gold/30 p-2 rounded-sm text-brand-gold"><LayoutGrid class="h-4 w-4" /></button>
          <button class="border border-transparent dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black p-2 rounded-sm text-gray-500"><List class="h-4 w-4" /></button>
        </div>
      </div>

      {/* MAIN CONTENT AREA: 70/30 SPLIT */}
      <div class="flex flex-col gap-10 lg:flex-row pb-20">

        {/* Left Column (70%) - Articles Grid */}
        <div class="flex flex-col gap-6 lg:w-2/3 xl:w-3/4">

          {/* Featured Article (Full Width) */}
          {featuredArticle && (
            <a href={`/artigos/${featuredArticle.slug}`} class="block border border-black/10 dark:border-white/10 group hover:border-brand-gold/50 overflow-hidden relative rounded-xl transition-colors">
              <div class="h-96 relative">
                {featuredArticle.coverImageUrl ? (
                  <img src={featuredArticle.coverImageUrl} alt={featuredArticle.title} class="duration-700 ease-out group-hover:scale-105 h-full object-cover transition-transform w-full" />
                ) : (
                  <div class="bg-gray-100 dark:bg-brand-black/50 h-full w-full"></div>
                )}
                <div class="absolute bg-gradient-to-t from-brand-black inset-0 to-transparent via-brand-black/80"></div>
              </div>
              <div class="absolute bottom-0 flex flex-col left-0 p-8 w-full">
                <div class="mb-4">
                  {featuredArticle.tags && featuredArticle.tags[0] && (
                    <span class="border border-brand-gold/30 font-bold inline-block px-3 py-1 rounded-sm text-[10px] text-brand-gold tracking-widest uppercase">
                      {featuredArticle.tags[0]}
                    </span>
                  )}
                </div>
                <h3 class="dark:text-brand-white font-bold group-hover:text-brand-gold leading-tight mb-2 text-3xl text-brand-black transition-colors">{featuredArticle.title}</h3>
                <p class="dark:text-gray-400 line-clamp-2 max-w-2xl mb-6 text-gray-600 text-sm">{featuredArticle.excerpt}</p>

                <div class="flex gap-3 items-center">
                  {featuredArticle.author?.avatarUrl ? (
                    <img src={featuredArticle.author.avatarUrl} alt={featuredArticle.author.fullName} class="border border-black/10 dark:border-white/10 h-8 rounded-full w-8" />
                  ) : (
                    <div class="bg-brand-gold/20 flex font-bold h-8 items-center justify-center rounded-full text-brand-gold text-xs w-8">
                      {featuredArticle.author?.fullName?.charAt(0) || 'A'}
                    </div>
                  )}
                  <div class="flex flex-col">
                    <span class="dark:text-brand-white font-semibold text-brand-black text-sm">{featuredArticle.author?.fullName || 'Autor'}</span>
                    <div class="dark:text-gray-400 flex gap-2 items-center text-gray-500 text-xs">
                      <span>{formatDate(featuredArticle.publishedAt as Date)}</span>
                      <span class="bg-gray-600 h-1 rounded-full w-1"></span>
                      <span>8 MIN LEITURA</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          )}

          {/* Regular Articles (2 Column Grid) */}
          <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
            {gridArticles.map(article => (
              <a href={`/artigos/${article.slug}`} class="bg-gray-100 block border border-black/10 dark:bg-black/20 dark:bg-gray-100 dark:border-white/10 flex flex-col group hover:border-brand-gold/50 overflow-hidden rounded-xl transition-colors">
                <div class="h-48 overflow-hidden relative">
                  {article.coverImageUrl ? (
                    <img src={article.coverImageUrl} alt={article.title} class="duration-700 ease-out group-hover:scale-105 h-full object-cover transition-transform w-full" />
                  ) : (
                    <div class="bg-gray-100 dark:bg-brand-black/50 h-full w-full"></div>
                  )}
                  <div class="absolute left-4 top-4">
                    {article.tags && article.tags[0] && (
                      <span class="backdrop-blur-sm bg-brand-white border border-brand-gold/30 dark:bg-brand-black/80 dark:bg-brand-dark-card font-bold inline-block px-3 py-1 rounded-sm text-[10px] text-brand-gold tracking-widest uppercase">
                        {article.tags[0]}
                      </span>
                    )}
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <h3 class="dark:text-brand-white font-bold group-hover:text-brand-gold leading-tight line-clamp-2 mb-3 text-brand-black text-xl transition-colors">
                    {article.title}
                  </h3>
                  <p class="dark:text-gray-400 flex-1 line-clamp-3 mb-6 text-gray-600 text-sm">
                    {article.excerpt}
                  </p>

                  <div class="flex gap-3 items-center mt-auto">
                    {article.author?.avatarUrl ? (
                      <img src={article.author.avatarUrl} alt={article.author.fullName} class="border border-black/10 dark:border-white/10 h-8 rounded-full w-8" />
                    ) : (
                      <div class="bg-brand-gold/20 flex font-bold h-8 items-center justify-center rounded-full text-brand-gold text-xs w-8">
                        {article.author?.fullName?.charAt(0) || 'A'}
                      </div>
                    )}
                    <div class="flex flex-col">
                      <span class="dark:text-brand-white font-semibold text-brand-black text-sm">{article.author?.fullName || 'Autor'}</span>
                      <div class="dark:text-gray-400 flex gap-2 items-center text-gray-500 text-xs">
                        <span>{formatDate(article.publishedAt as Date)}</span>
                        <span class="bg-gray-600 h-1 rounded-full w-1"></span>
                        <span>4 MIN LEITURA</span>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* Pagination */}
          <div class="flex gap-2 items-center justify-center mt-8">
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-500 transition-colors w-10">&lt;</button>
            <button class="bg-brand-gold/10 border border-brand-gold/50 flex h-10 items-center justify-center rounded-sm text-brand-gold w-10">1</button>
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-600 transition-colors w-10">2</button>
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-600 transition-colors w-10">3</button>
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-600 transition-colors w-10">4</button>
            <span class="dark:text-gray-400 px-2 text-gray-500">...</span>
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-600 transition-colors w-10">8</button>
            <button class="border border-black/10 dark:border-white/10 dark:hover:text-brand-white dark:text-gray-400 flex h-10 hover:border-brand-gold/50 hover:text-brand-black items-center justify-center rounded-sm text-gray-500 transition-colors w-10">&gt;</button>
          </div>

        </div>

        {/* Right Column (30%) - Sidebar */}
        <div class="flex flex-col gap-8 lg:w-1/3 xl:w-1/4">

          {/* Categorias */}
          <div class="bg-gray-100 border border-black/10 dark:bg-brand-dark-card dark:border-white/10 p-6 rounded-xl">
            <h3 class="dark:text-brand-white flex font-bold gap-2 items-center mb-6 text-brand-black text-sm tracking-widest uppercase">
              {t('articles.categories')}
              <span class="bg-brand-gold/30 flex-1 h-px ml-2"></span>
            </h3>
            <ul class="space-y-4">
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Filosofia
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">24</span>
              </li>
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Ciência
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">18</span>
              </li>
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Artes
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">15</span>
              </li>
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Cultura
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">16</span>
              </li>
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Consciência
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">30</span>
              </li>
              <li class="flex items-center justify-between text-sm">
                <a href="#" class="dark:text-gray-400 flex gap-3 hover:text-brand-gold items-center text-gray-600 transition-colors">
                  <span class="text-brand-gold/50">#</span> Propósito
                </a>
                <span class="dark:text-gray-400 font-mono text-gray-600 text-xs">12</span>
              </li>
            </ul>
            <a href="#" class="dark:hover:text-brand-black dark:text-brand-white font-bold gap-2 hover:text-brand-black inline-flex items-center mt-6 text-brand-gold text-xs tracking-widest transition-colors uppercase">
              {t('articles.view_all_categories')} <span class="leading-none text-lg">&rarr;</span>
            </a>
          </div>

          {/* Artigos Mais Lidos */}
          <div class="bg-gray-100 border border-black/10 dark:bg-brand-dark-card dark:border-white/10 p-6 rounded-xl">
            <h3 class="dark:text-brand-white flex font-bold gap-2 items-center mb-6 text-brand-black text-sm tracking-widest uppercase">
              {t('articles.most_read')}
            </h3>
            <div class="space-y-6">
              {listArticles.slice(0, 4).map(article => (
                <a href={`/artigos/${article.slug}`} class="flex gap-4 group items-center">
                  <div class="border border-black/10 dark:border-white/10 h-16 overflow-hidden rounded-sm shrink-0 w-16">
                    {article.coverImageUrl ? (
                      <img src={article.coverImageUrl} alt={article.title} class="duration-500 group-hover:scale-110 h-full object-cover transition-transform w-full" />
                    ) : (
                      <div class="bg-gray-100 dark:bg-brand-black/50 h-full w-full"></div>
                    )}
                  </div>
                  <div class="flex flex-col">
                    <h4 class="dark:text-gray-200 font-bold group-hover:text-brand-gold leading-tight line-clamp-2 mb-1 text-gray-700 text-sm transition-colors">{article.title}</h4>
                    <span class="dark:text-gray-400 font-mono text-gray-500 text-xs">{formatDate(article.publishedAt as Date)}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* Newsletter Box */}
          <div class="bg-brand-gold/5 border border-brand-gold/20 overflow-hidden p-6 relative rounded-xl">
            <div class="absolute bg-[radial-gradient(ellipse_at_bottom_right,_var(--tw-gradient-stops))] from-brand-gold/20 inset-0 pointer-events-none to-transparent via-transparent"></div>
            <h3 class="dark:text-brand-white font-bold mb-3 relative text-brand-black text-sm tracking-widest uppercase z-10">
              {t('articles.newsletter.title')}
            </h3>
            <p class="dark:text-gray-400 mb-4 relative text-gray-600 text-xs z-10">
              {t('articles.newsletter.desc')}
            </p>
            <form class="flex flex-col gap-3 relative z-10">
              <input type="email" placeholder={t('articles.newsletter.placeholder')} class="bg-brand-white border border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none px-4 py-2.5 rounded-sm text-brand-black text-sm w-full" />
              <button type="button" class="bg-brand-gold dark:text-brand-white flex font-bold gap-2 hover:bg-brand-gold/90 items-center justify-center py-3 rounded-sm text-brand-black text-xs tracking-widest transition-colors uppercase w-full">
                {t('articles.newsletter.btn')} <span class="leading-none text-lg">&rarr;</span>
              </button>
            </form>
          </div>

        </div>

      </div>

      {/* Bottom CTA Banner */}
      <div class="bg-gray-100 border border-brand-gold/30 dark:bg-brand-dark-card flex flex-col gap-6 items-center justify-between mb-12 md:flex-row md:p-12 overflow-hidden p-8 relative rounded-xl">
        <div class="absolute bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 pointer-events-none to-transparent via-transparent"></div>
        <div class="absolute bottom-0 opacity-20 pointer-events-none right-0">
          {/* decorative wave SVG or similar could go here */}
        </div>

        <div class="flex gap-6 items-center relative z-10">
          <div class="bg-brand-gold/10 border border-brand-gold/30 flex h-16 items-center justify-center rounded-full shrink-0 text-brand-gold w-16">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </div>
          <div>
            <h3 class="dark:text-brand-white font-bold mb-2 md:text-2xl text-brand-black text-xl tracking-wider uppercase">{t('articles.cta.title')}</h3>
            <p class="dark:text-gray-400 md:text-base text-gray-600 text-sm">{t('articles.cta.desc')}</p>
          </div>
        </div>

        <div class="md:w-auto relative shrink-0 w-full z-10">
          <button class="bg-brand-gold dark:text-brand-white font-bold hover:bg-brand-gold/90 md:w-auto px-8 py-3 rounded-sm shadow-[0_0_20px_rgba(212,175,55,0.3)] text-brand-black text-sm tracking-widest transition-colors uppercase w-full">
            {t('articles.cta.btn')} <span class="leading-none ml-2 text-lg">&rarr;</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</PublicLayout>
