---
import AppLayout from '@/layouts/AppLayout.astro';
import { getSession } from '@/utils/session';
import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import { getLangFromUrl } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const { slug } = Astro.params;

const session = await getSession(Astro.request, Astro.response as any);
if (!session || !session.userId) {
  return Astro.redirect('/');
}


if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const [article] = await db
  .select()
  .from(articles)
  .where(eq(articles.slug, slug));

if (!article) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const formatDate = (date: Date | null) => {
  if (!date) return '';
  const locale = lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US';
  return new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(date));
};
---

<AppLayout title={article.title}>
  <article class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">
    {/* Cabecera del artículo */}
    <header class="py-20 bg-brand-black border-b border-brand-dark-card/50 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-60"></div>
      <div class="relative z-10 container mx-auto px-6 max-w-4xl">
        <div class="inline-block px-3 py-1 mb-6 text-xs font-semibold tracking-widest text-brand-black bg-brand-gold rounded-full uppercase">
          Artigo
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-black dark:text-white mb-6 leading-tight">
          {article.title}
        </h1>
        <div class="text-gray-600 dark:text-gray-400 font-semibold tracking-wide text-sm">
          {formatDate(article.publishedAt as unknown as Date)}
        </div>
      </div>
    </header>

    {/* Imagen de portada si existe */}
    {article.coverImageUrl && (
      <div class="container mx-auto max-w-5xl -mt-10 mb-12 px-6 relative z-20">
        <div class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl border border-brand-dark-card">
          <img loading="lazy" decoding="async" src={article.coverImageUrl} alt={article.title} class="w-full h-full object-cover" />
        </div>
      </div>
    )}

    {/* Contenido (Esperando HTML renderizado desde el CMS) */}
    <div class="container mx-auto px-6 max-w-3xl mt-16 prose prose-invert prose-brand lg:prose-lg max-w-none">
      {/*
        NOTA: En producción con un CMS real, el contenido en HTML se insertaría con set:html.
        Al venir directamente de Drizzle, asumiendo HTML seguro del admin.
      */}
      <div set:html={article.content} />
    </div>

    {/* Footer del artículo - Regresar */}
    <div class="container mx-auto px-6 max-w-3xl mt-16 pt-8 border-t border-brand-dark-card/50">
      <a href="/artigos" class="inline-flex items-center text-brand-gold hover:text-brand-black dark:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="m15 18-6-6 6-6"/></svg>
        Volver a Artigos
      </a>
    </div>
  </article>
</AppLayout>