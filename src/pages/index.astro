---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';
import { Trophy, Globe, Shirt } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title={t('nav.home')}>
  <!-- Hero Section -->
  <section class="relative bg-transparent text-brand-black dark:text-white min-h-[90vh] flex items-center justify-center overflow-hidden">
    <!-- Sophisticated Background Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-brand-offwhite/50 via-transparent to-brand-offwhite dark:from-brand-black/80 dark:via-transparent dark:to-brand-black z-0 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-transparent to-transparent opacity-100 z-0 pointer-events-none"></div>

    <div class="relative z-10 container mx-auto px-6 lg:px-8 text-center max-w-5xl animate-smooth-fade">
      <h1 class="font-display text-6xl md:text-8xl lg:text-9xl font-bold uppercase tracking-tight mb-8 drop-shadow-2xl text-brand-black dark:text-white leading-[1.1]">
        {t('home.hero.title')} <br/>
        <span class="text-brand-gold relative inline-block mt-2">
          {tenantConfig.name}
          <div class="absolute -bottom-4 left-0 w-full h-2 bg-brand-gold/40 blur-md"></div>
        </span>
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 dark:text-gray-300 mb-12 font-light max-w-3xl mx-auto leading-relaxed text-balance">
        {t('home.hero.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <Button variant="primary" size="lg" class="w-full sm:w-auto shadow-[0_0_20px_rgba(212,175,55,0.3)] hover:shadow-[0_0_30px_rgba(212,175,55,0.5)] transition-shadow">
          {t('home.hero.catalog_btn')}
        </Button>
        <Button variant="outline" size="lg" class="w-full sm:w-auto text-brand-black dark:text-brand-white hover:text-brand-black dark:hover:text-brand-black border-brand-black/20 dark:border-white/20 bg-white/10 dark:bg-black/10 backdrop-blur-sm">
          {t('home.hero.champ_btn')}
        </Button>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-32 relative bg-transparent">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-offwhite to-brand-white dark:from-brand-black dark:to-brand-dark z-0 pointer-events-none"></div>
    <div class="container mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 relative z-10">
        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Trophy class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.competition.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.competition.desc')}
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Globe class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.community.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.community.desc')}
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Shirt class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.identity.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.identity.desc')}
          </p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>