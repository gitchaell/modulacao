---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

import Hero from '@/components/home/Hero.astro';
import Features from '@/components/home/Features.astro';
import Highlights from '@/components/home/Highlights.astro';
import Events from '@/components/home/Events.astro';
import Articles from '@/components/home/Articles.astro';
import CTA from '@/components/home/CTA.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title={t('nav.home')}>
  <Hero />
  <Features />
  <Highlights />
  <Events />
  <Articles />
  <CTA />
</PublicLayout>