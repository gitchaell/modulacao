---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations } from '@/utils/i18n';

import Hero from '@/components/home/Hero.astro';
import Features from '@/components/home/Features.astro';
import Highlights from '@/components/home/Highlights.astro';
import Events from '@/components/home/Events.astro';
import Articles from '@/components/home/Articles.astro';
import CTA from '@/components/home/CTA.astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('home', lang);
const t = (key: string) => pageDict[key] || key;
---

<PublicLayout title={t('meta.title') || 'Home'}>
  <Hero pageDict={pageDict} />
  <Features pageDict={pageDict} />
  <Highlights pageDict={pageDict} />
  <Events pageDict={pageDict} />
  <Articles pageDict={pageDict} />
  <CTA pageDict={pageDict} />
</PublicLayout>