---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';
import { Trophy, Globe, Shirt } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title="Inicio">
  <!-- Hero Section -->
  <section class="relative bg-brand-black text-white overflow-hidden py-32">
    <!-- Background Gradient Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-brand-black to-brand-black opacity-60 z-0"></div>

    <!-- Modulating Wave Background -->
    <WaveBackground />

    <div class="relative z-10 container mx-auto px-6 lg:px-8 text-center max-w-5xl">
      <h1 class="font-display text-6xl md:text-8xl font-bold uppercase tracking-tighter mb-6 drop-shadow-lg text-white">
        {t('home.hero.title').split('Modulação')[0]}<span class="text-brand-gold drop-shadow-[0_0_20px_rgba(212,175,55,0.4)]">Modulação</span>
      </h1>
      <p class="text-lg md:text-2xl text-gray-300 mb-12 font-light max-w-3xl mx-auto leading-relaxed">
        {t('home.hero.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button variant="primary" size="lg" class="uppercase tracking-widest text-sm w-full sm:w-auto">
          {t('home.hero.catalog_btn')}
        </Button>
        <Button variant="outline" size="lg" class="uppercase tracking-widest text-sm w-full sm:w-auto text-brand-gold border-brand-gold hover:bg-brand-gold/10">
          {t('home.hero.champ_btn')}
        </Button>
      </div>
    </div>
  </section>

  <!-- Secciones Resumen -->
  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
        <Card class="text-center group">
          <div class="w-16 h-16 rounded-2xl bg-brand-gold/10 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-black transition-colors duration-300">
            <Trophy class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-wider mb-3 text-brand-black dark:text-white">Competición</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">Estadísticas en tiempo real, tablas de posiciones y fixtures de nuestros campeonatos.</p>
        </Card>
        <Card class="text-center group">
          <div class="w-16 h-16 rounded-2xl bg-brand-gold/10 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-black transition-colors duration-300">
            <Globe class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-wider mb-3 text-brand-black dark:text-white">Comunidad</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">Foros de discusión, grupos por ciudad y país, eventos exclusivos para miembros.</p>
        </Card>
        <Card class="text-center group">
          <div class="w-16 h-16 rounded-2xl bg-brand-gold/10 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-6 group-hover:bg-brand-gold group-hover:text-black transition-colors duration-300">
            <Shirt class="w-8 h-8" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-wider mb-3 text-brand-black dark:text-white">Identidad</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">Accede al catálogo oficial de indumentaria y servicios exclusivos.</p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>