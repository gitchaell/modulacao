---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
---

<PublicLayout title="Inicio">
  <!-- Hero Section -->
  <section class="relative bg-brand-black text-white overflow-hidden py-32">
    <!-- Overlay/Ondas sutiles para el fondo -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-brand-black to-brand-black opacity-60"></div>

    <div class="relative z-10 container mx-auto px-6 lg:px-8 text-center max-w-4xl">
      <h1 class="text-5xl md:text-7xl font-extrabold uppercase tracking-tight mb-6">
        Somos <span class="text-brand-gold">Modulação</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 font-light max-w-2xl mx-auto">
        La plataforma oficial que unifica la pasión por el deporte, la comunidad y nuestra identidad. Descubre nuestros campeonatos, productos y mantente conectado.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button variant="primary" size="lg" class="uppercase tracking-widest text-sm w-full sm:w-auto">
          Catálogo Oficial
        </Button>
        <Button variant="outline" size="lg" class="uppercase tracking-widest text-sm w-full sm:w-auto text-brand-gold border-brand-gold hover:bg-brand-gold/10">
          Explorar Campeonatos
        </Button>
      </div>
    </div>
  </section>

  <!-- Secciones Resumen -->
  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <Card class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center mx-auto mb-4 text-xl">🏆</div>
          <h3 class="text-xl font-bold uppercase tracking-wider mb-2">Competición</h3>
          <p class="text-gray-400 text-sm">Estadísticas en tiempo real, tablas de posiciones y fixtures de nuestros campeonatos.</p>
        </Card>
        <Card class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center mx-auto mb-4 text-xl">🌐</div>
          <h3 class="text-xl font-bold uppercase tracking-wider mb-2">Comunidad</h3>
          <p class="text-gray-400 text-sm">Foros de discusión, grupos por ciudad y país, eventos exclusivos para miembros.</p>
        </Card>
        <Card class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand-gold/20 text-brand-gold flex items-center justify-center mx-auto mb-4 text-xl">👕</div>
          <h3 class="text-xl font-bold uppercase tracking-wider mb-2">Identidad</h3>
          <p class="text-gray-400 text-sm">Accede al catálogo oficial de indumentaria y servicios exclusivos.</p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>