---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';
import { Microscope, Brain, Network } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title={t('nav.home')}>
  <!-- Hero Section -->
  <section class="relative bg-[#FAFAFA] dark:bg-[#111] text-brand-black dark:text-white min-h-screen flex items-center justify-center overflow-hidden pt-20">
    <div class="absolute inset-0 z-0 pointer-events-none"></div>

    <div class="relative z-10 container mx-auto px-4 md:px-8 text-center max-w-screen-xl animate-smooth-fade flex flex-col items-center justify-center">
      <h1 class="font-display font-black uppercase tracking-tighter mb-12 text-[#111111] dark:text-white flex flex-col items-center justify-center w-full">
        <span class="text-[20vw] md:text-[10rem] lg:text-[12rem] leading-[0.85] mb-2">{t('home.hero.title')}</span>
        <span class="text-[#D4AF37] text-[20vw] md:text-[10rem] lg:text-[12rem] leading-[0.85] relative inline-block">
          {tenantConfig.name.split(' ')[0]}
        </span>
        <span class="text-[#D4AF37] text-[14vw] md:text-[10rem] lg:text-[12rem] leading-[0.85] relative inline-block">
          {tenantConfig.name.split(' ').slice(1).join(' ')}
        </span>
      </h1>
      <p class="text-lg md:text-2xl text-[#333333] dark:text-gray-300 mb-16 font-normal max-w-3xl mx-auto leading-normal text-balance">
        {t('home.hero.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-col gap-6 justify-center items-center pb-20 mt-4 w-full max-w-md mx-auto">
        <a href="/noticias" class="w-full">
          <Button variant="primary" size="lg" class="w-full font-bold uppercase tracking-[0.2em] px-10 py-5 rounded-none text-sm md:text-base border-none hover:translate-y-0 bg-[#D4AF37] text-black hover:bg-[#B5952F]">
            {t('home.hero.catalog_btn')}
          </Button>
        </a>
        <a href="/nosotros" class="w-full">
          <Button variant="outline" size="lg" class="w-full font-bold uppercase tracking-[0.2em] px-10 py-5 rounded-none text-sm md:text-base border border-[#D4AF37] text-[#D4AF37] hover:bg-[#D4AF37] hover:text-black hover:translate-y-0">
            {t('home.hero.champ_btn')}
          </Button>
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-32 relative bg-transparent">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-offwhite to-brand-white dark:from-brand-black dark:to-brand-dark z-0 pointer-events-none"></div>
    <div class="container mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 relative z-10">
        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Microscope class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.competition.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.competition.desc')}
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Brain class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.community.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.community.desc')}
          </p>
        </Card>

        <Card class="group flex flex-col items-center text-center bg-white/50 dark:bg-white/5 backdrop-blur-xl border border-black/5 dark:border-white/10 premium-shadow">
          <div class="w-20 h-20 rounded-full bg-brand-gold/5 dark:bg-brand-gold/10 text-brand-gold flex items-center justify-center mx-auto mb-8 group-hover:bg-brand-gold group-hover:text-brand-black transition-all duration-500 ease-out border border-brand-gold/20 group-hover:border-transparent group-hover:scale-110 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.4)]">
            <Network class="w-10 h-10" />
          </div>
          <h3 class="font-display text-2xl font-bold uppercase tracking-widest mb-4 text-brand-black dark:text-white">
            {t('home.features.identity.title')}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-balance">
            {t('home.features.identity.desc')}
          </p>
        </Card>
      </div>
    </div>
  </section>
</PublicLayout>