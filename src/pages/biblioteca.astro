---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { documents } from '@/data/db/schema';
import { FileText, Download } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('library', lang);
const t = usePageTranslations(pageDict, lang);

// Fetch data
const allDocuments = await db.select().from(documents).orderBy(documents.createdAt);

---

<PublicLayout title={t('nav.library')}>
  <div class="relative py-32 bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('library.title')}</h1>
      <p class="text-gray-400 text-xl font-semibold text-balance">{t('library.subtitle')}</p>
    </div>
  </div>

  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 lg:px-8 max-w-5xl animate-smooth-fade" style="animation-delay: 0.1s;">

      {allDocuments.length === 0 ? (
        <Card class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 text-center py-24 premium-shadow relative overflow-hidden">
           <p class="text-gray-500 font-semibold">{t('library.empty')}</p>
        </Card>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {allDocuments.map((doc) => (
             <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all premium-shadow group flex items-center p-6 focus-visible">
               <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0 mr-6 group-hover:scale-110 transition-transform">
                 <FileText class="w-6 h-6" />
               </div>
               <div class="flex-1 min-w-0 pr-4">
                 <div class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-1">{doc.type}</div>
                 <h2 class="font-display text-lg font-bold text-brand-black dark:text-white truncate group-hover:text-brand-gold transition-colors">{doc.title}</h2>
                 {doc.description && <p class="text-sm text-gray-500 truncate mt-1">{doc.description}</p>}
               </div>
               <a href={doc.fileUrl} target="_blank" download class="p-3 rounded-sm bg-gray-50 dark:bg-brand-black text-gray-500 hover:text-brand-gold hover:bg-brand-gold/10 transition-all focus-visible" aria-label={t('library.download') + ` ${doc.title}`}>
                 <Download class="w-5 h-5" />
               </a>
             </Card>
          ))}
        </div>
      )}

    </div>
  </section>
</PublicLayout>
