---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { documents } from '@/data/db/schema';
import { FileText, Download } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('library', lang);
const t = usePageTranslations(pageDict, lang);

// Fetch data
const allDocuments = await db.select().from(documents).orderBy(documents.createdAt);

---

<PublicLayout title={t('nav.library')}>
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-32 relative">
    <div class="absolute bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 relative text-center z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('library.title')}</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 dark:text-gray-400 text-xl">{t('library.subtitle')}</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-24">
    <div class="animate-smooth-fade container lg:px-8 max-w-5xl mx-auto px-6" style="animation-delay: 0.1s;">

      {allDocuments.length === 0 ? (
        <Card class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden premium-shadow py-24 relative text-center">
           <p class="dark:text-gray-400 font-semibold text-gray-500 dark:text-gray-400">{t('library.empty')}</p>
        </Card>
      ) : (
        <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
          {allDocuments.map((doc) => (
             <Card noPadding class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 flex focus-visible group hover:border-brand-gold/50 items-center p-6 premium-shadow transition-all">
               <div class="bg-brand-gold/10 flex group-hover:scale-110 h-12 items-center justify-center mr-6 rounded-sm shrink-0 text-brand-gold transition-transform w-12">
                 <FileText class="h-6 w-6" />
               </div>
               <div class="flex-1 min-w-0 pr-4">
                 <div class="dark:text-gray-400 font-bold mb-1 text-gray-500 dark:text-gray-400 text-xs tracking-widest uppercase">{doc.type}</div>
                 <h2 class="dark:text-white font-bold font-display group-hover:text-brand-gold text-brand-black text-lg transition-colors truncate">{doc.title}</h2>
                 {doc.description && <p class="dark:text-gray-400 mt-1 text-gray-500 dark:text-gray-400 text-sm truncate">{doc.description}</p>}
               </div>
               <a href={doc.fileUrl} target="_blank" download class="bg-gray-50 dark:bg-brand-black dark:text-gray-400 focus-visible hover:bg-brand-gold/10 hover:text-brand-gold p-3 rounded-sm text-gray-500 dark:text-gray-400 transition-all" aria-label={t('library.download') + ` ${doc.title}`}>
                 <Download class="h-5 w-5" />
               </a>
             </Card>
          ))}
        </div>
      )}

    </div>
  </section>
</PublicLayout>
