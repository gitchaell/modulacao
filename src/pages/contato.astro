---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Card from '@/components/core/Card.astro';
import { MapPin, Phone, Mail } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);
---
<PublicLayout title={t('contact.hero.title')}>
  <div class="grid grid-cols-1 lg:grid-cols-2 min-h-screen">

    {/* Left Column: Content and Form */}
    <div class="px-6 py-12 md:py-20 lg:px-16 xl:px-24 flex flex-col justify-center bg-brand-white dark:bg-brand-dark-card/90 border-r border-gray-200 dark:border-white/5 relative z-10 shadow-[8px_0_30px_-15px_rgba(0,0,0,0.3)]">

      <div class="max-w-xl mx-auto w-full">
        {/* Breadcrumbs */}
        <div class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-8 font-medium">
          <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
          <span class="mx-2">/</span>
          <span class="text-brand-black dark:text-brand-white uppercase">{t('contact.hero.title')}</span>
        </div>

        {/* Header */}
        <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-black dark:text-brand-white mb-6">
          {t('contact.hero.title')}
        </h1>
        <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-10 text-balance">
          {t('contact.info.desc')}
        </p>

        {/* Contact Details row/grid */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
           <div class="flex flex-col gap-3">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20">
                <MapPin class="w-5 h-5 text-brand-gold" />
              </div>
              <div class="text-sm font-medium text-brand-black dark:text-brand-white">
                {t('contact.info.address')}
              </div>
           </div>

           <div class="flex flex-col gap-3">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20">
                <Phone class="w-5 h-5 text-brand-gold" />
              </div>
              <div class="text-sm font-medium text-brand-black dark:text-brand-white">
                {t('contact.info.phone')}
              </div>
           </div>

           <div class="flex flex-col gap-3">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20">
                <Mail class="w-5 h-5 text-brand-gold" />
              </div>
              <div class="text-sm font-medium text-brand-black dark:text-brand-white">
                {t('contact.info.email')}
              </div>
           </div>
        </div>

        {/* Form */}
        <form id="contact-form" method="POST" action="/api/contacto" class="space-y-6">
          <div id="form-success" class="hidden bg-green-500/10 text-green-500 border border-green-500/20 p-4 rounded-sm text-sm font-semibold">
            {t('contact.form.success')}
          </div>
          <div id="form-error" class="hidden bg-red-500/10 text-red-500 border border-red-500/20 p-4 rounded-sm text-sm font-semibold">
            {t('contact.form.error')}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Input type="text" name="name" label={t('contact.form.name.label')} placeholder={t('contact.form.name.placeholder')} required />
            <Input type="email" name="email" label={t('contact.form.email.label')} placeholder={t('contact.form.email.placeholder')} required />
          </div>

          <div class="flex flex-col gap-2 w-full">
            <label for="message" class="text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite">
              {t('contact.form.message.label')}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder={t('contact.form.message.placeholder')}
              class="flex w-full rounded-sm border bg-white dark:bg-brand-black/50 px-4 py-3 text-sm text-brand-black dark:text-white placeholder:text-gray-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold disabled:cursor-not-allowed disabled:opacity-50 border-gray-300 dark:border-gray-700 hover:border-brand-gold/50"
            ></textarea>
          </div>

          <div class="pt-2">
            <Button type="submit" fullWidth>{t('contact.form.submit')}</Button>
          </div>
        </form>

      </div>
    </div>

    {/* Right Column: Map */}
    <div class="hidden lg:block relative min-h-[400px] h-full w-full">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3657.0654069818817!2d-46.65431638502213!3d-23.566089767664687!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce59c8da0aa315%3A0xd59f9431f2c9776a!2sAv.%20Paulista%20-%20Bela%20Vista%2C%20S%C3%A3o%20Paulo%20-%20SP!5e0!3m2!1sen!2sbr!4v1620310000000!5m2!1sen!2sbr"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="absolute inset-0 w-full h-full object-cover dark:filter dark:grayscale dark:contrast-125 dark:opacity-70 grayscale"
      ></iframe>
      {/* Optional dark overlay for map in dark mode to blend better */}
      <div class="absolute inset-0 pointer-events-none hidden dark:block bg-brand-dark/20 mix-blend-multiply"></div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (res.ok) {
            successMsg?.classList.remove('hidden');
            form.reset();
          } else {
            errorMsg?.classList.remove('hidden');
          }
        } catch (error) {
          errorMsg?.classList.remove('hidden');
        }
      });
    }
  </script>
</PublicLayout>
