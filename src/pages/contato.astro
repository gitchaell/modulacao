---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Card from '@/components/core/Card.astro';
import { MapPin, Phone, Mail, Clock, Share2, Users, Shield, Calendar, ShoppingCart, ChevronRight, Send, Map } from '@lucide/astro';
import { Instagram, Youtube, Facebook, Twitter } from 'lucide-astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('contact', lang);
const t = usePageTranslations(pageDict, lang);
---
<PublicLayout title={t('contact.hero.title')}>

  {/* Hero Section */}
  <section class="flex h-[400px] items-center justify-start md:h-[500px] overflow-hidden relative w-full">
    {/* Background Image - Mountain Climbers (Placeholder from Unsplash) */}
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1522163182402-834f871fd851?q=80&w=2000&auto=format&fit=crop" alt="Hero background" class="dark:opacity-30 h-full mix-blend-overlay object-center object-cover opacity-40 w-full" />
      <div class="absolute bg-gradient-to-r from-brand-black inset-0 to-transparent via-brand-black/80"></div>
      <div class="absolute bg-gradient-to-t bottom-0 from-brand-black h-32 to-transparent w-full"></div>

      {/* Decorative Gold Wave SVG Placeholder (Abstract) */}
      <svg class="absolute bottom-10 h-24 pointer-events-none text-brand-gold/30 w-full" preserveAspectRatio="none" viewBox="0 0 1440 320" fill="none" xmlns="http://www.w3.org/2000/svg">
         <path fill="currentColor" d="M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,144C672,139,768,181,864,197.3C960,213,1056,203,1152,186.7C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
      </svg>
    </div>

    <div class="lg:px-8 max-w-7xl mt-16 mx-auto px-6 relative w-full z-10">
      <div class="dark:text-gray-400 flex font-medium items-center mb-6 text-gray-500 text-sm">
        <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
        <span class="mx-2">&gt;</span>
        <span class="dark:text-brand-white text-brand-black uppercase">{t('contact.hero.title')}</span>
      </div>

      <h1 class="dark:text-brand-white font-bold font-display mb-6 md:text-6xl text-5xl text-brand-black tracking-widest uppercase">
        {t('contact.hero.title')}
      </h1>

      <h2 class="font-bold font-display max-w-2xl mb-8 md:text-2xl text-brand-gold text-xl tracking-wider uppercase">
        {t('contact.info.desc')}
      </h2>

      <p class="dark:text-gray-300 leading-relaxed max-w-xl md:text-lg text-base text-gray-600 whitespace-pre-line">
        {t('contact.info.desc2')}
      </p>
    </div>
  </section>

  <main class="bg-brand-offwhite dark:bg-brand-black dark:text-brand-white py-16 text-brand-black w-full">
    <div class="lg:px-8 max-w-7xl mx-auto px-6 space-y-24">

      {/* Info Grid (5 Columns) */}
      <section class="border-b border-black/10 dark:border-white/10 gap-8 grid grid-cols-1 lg:grid-cols-5 md:grid-cols-3 pb-16">
        {/* Email */}
        <div class="flex flex-col gap-3 group">
          <div class="flex gap-3 items-center">
             <Mail class="h-6 text-brand-gold w-6" />
             <h3 class="font-bold text-sm tracking-widest uppercase">{t('contact.info.email.label')}</h3>
          </div>
          <div class="pl-9 space-y-1">
             <p class="dark:text-gray-300 text-gray-600 text-sm">contato@modulacao.org</p>
             <p class="dark:text-gray-400 text-gray-500 text-xs">{t('contact.info.email.desc')}</p>
          </div>
        </div>

        {/* WhatsApp */}
        <div class="flex flex-col gap-3 group">
          <div class="flex gap-3 items-center">
             <Phone class="h-6 text-brand-gold w-6" />
             <h3 class="font-bold text-sm tracking-widest uppercase">{t('contact.info.whatsapp')}</h3>
          </div>
          <div class="pl-9 space-y-1">
             <p class="dark:text-gray-300 text-gray-600 text-sm">+591 780 00000</p>
             <p class="dark:text-gray-400 text-gray-500 text-xs">{t('contact.info.whatsapp.desc')}</p>
          </div>
        </div>

        {/* Address */}
        <div class="flex flex-col gap-3 group">
          <div class="flex gap-3 items-center">
             <MapPin class="h-6 text-brand-gold w-6" />
             <h3 class="font-bold text-sm tracking-widest uppercase">{t('contact.info.address.label')}</h3>
          </div>
          <div class="pl-9 space-y-1">
             <p class="dark:text-gray-300 leading-tight text-gray-600 text-sm whitespace-pre-line">{t('contact.info.address.desc')}</p>
             <a href="#" class="flex font-semibold gap-1 hover:underline items-center mt-1 text-brand-gold text-xs">Ver no mapa <ChevronRight class="h-3 w-3"/></a>
          </div>
        </div>

        {/* Hours */}
        <div class="flex flex-col gap-3 group">
          <div class="flex gap-3 items-center">
             <Clock class="h-6 text-brand-gold w-6" />
             <h3 class="font-bold text-sm tracking-widest uppercase">{t('contact.info.hours')}</h3>
          </div>
          <div class="pl-9 space-y-1">
             <p class="dark:text-gray-300 leading-tight text-gray-600 text-sm whitespace-pre-line">{t('contact.info.hours.desc')}</p>
             <p class="dark:text-gray-400 text-gray-500 text-xs">{t('contact.info.hours.exc')}</p>
          </div>
        </div>

        {/* Social */}
        <div class="flex flex-col gap-3 group">
          <div class="flex gap-3 items-center">
             <Share2 class="h-6 text-brand-gold w-6" />
             <h3 class="font-bold text-sm tracking-widest uppercase">{t('contact.info.social')}</h3>
          </div>
          <div class="flex gap-3 items-center mt-1 pl-9">
             <a href="#" class="dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black text-brand-gold text-gray-500 transition-colors" aria-label="Instagram"><Instagram class="h-5 w-5"/></a>
             <a href="#" class="dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black text-brand-gold text-gray-500 transition-colors" aria-label="YouTube"><Youtube class="h-5 w-5"/></a>
             <a href="#" class="dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black text-brand-gold text-gray-500 transition-colors" aria-label="Facebook"><Facebook class="h-5 w-5"/></a>
             <a href="#" class="dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black text-brand-gold text-gray-500 transition-colors" aria-label="Twitter/X"><Twitter class="h-5 w-5"/></a>
          </div>
        </div>
      </section>

      {/* Form and Map Section */}
      <section class="gap-16 grid grid-cols-1 lg:grid-cols-2">

        {/* Left: Form */}
        <div class="space-y-6">
          <div>
            <h2 class="dark:text-brand-white font-bold font-display mb-2 text-2xl text-brand-black tracking-widest uppercase">{t('contact.form.title2')}</h2>
            <p class="dark:text-gray-400 text-gray-500 text-sm">{t('contact.form.desc')}</p>
          </div>

          <form id="contact-form" method="POST" action="/api/contacto" class="space-y-6">
            <div id="form-success" class="bg-green-500/10 border border-green-500/20 font-semibold hidden p-4 rounded-sm text-green-500 text-sm">
              {t('contact.form.success')}
            </div>
            <div id="form-error" class="bg-red-500/10 border border-red-500/20 font-semibold hidden p-4 rounded-sm text-red-500 text-sm">
              {t('contact.form.error')}
            </div>

            <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
              <Input type="text" name="name" label="" placeholder={t('contact.form.name.label')} required class="bg-gray-50 border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 placeholder:text-gray-500 text-brand-black" />
              <Input type="email" name="email" label="" placeholder={t('contact.form.email.label')} required class="bg-gray-50 border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 placeholder:text-gray-500 text-brand-black" />
            </div>

            <div class="relative">
               <select name="subject" class="appearance-none bg-gray-50 border border-black/10 cursor-pointer dark:bg-brand-dark dark:border-white/10 dark:text-brand-white flex focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold hover:border-brand-gold/50 px-4 py-3 rounded-sm text-brand-black text-sm w-full">
                 <option value="" disabled selected>{t('contact.form.subject.label')}</option>
                 <option value="duvida">{t('contact.form.subject.opt1')}</option>
                 <option value="suporte">{t('contact.form.subject.opt2')}</option>
                 <option value="parceria">{t('contact.form.subject.opt3')}</option>
               </select>
               <div class="absolute flex inset-y-0 items-center pointer-events-none px-4 right-0 text-brand-gold">
                 <ChevronRight class="h-4 rotate-90 w-4" />
               </div>
            </div>

            <div>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder={t('contact.form.message.placeholder')}
                class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white dark:text-gray-400 duration-300 flex focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold hover:border-brand-gold/50 placeholder:text-gray-500 px-4 py-3 rounded-sm text-brand-black text-sm transition-all w-full"
              ></textarea>
            </div>

            <div class="flex gap-3 items-start">
              <input type="checkbox" id="privacy" required class="bg-gray-50 border-black/10 cursor-pointer dark:bg-brand-dark dark:border-white/10 focus:ring-brand-gold mt-1 rounded-sm text-brand-gold" />
              <label for="privacy" class="dark:text-gray-400 text-gray-500 text-sm">
                {t('contact.form.privacy')} <a href="#" class="hover:underline text-brand-gold">{t('contact.form.privacy.link')}</a>
              </label>
            </div>

            <div class="pt-2">
              <Button type="submit" class="!bg-brand-gold !text-brand-black dark:!text-brand-white flex gap-2 hover:!bg-brand-gold-dark items-center justify-center w-full">
                <Send class="h-4 w-4" /> {t('contact.form.submit')}
              </Button>
            </div>
          </form>
        </div>

        {/* Right: Where We Are */}
        <div class="space-y-6">
          <div>
            <h2 class="dark:text-brand-white font-bold font-display mb-2 text-2xl text-brand-black tracking-widest uppercase">{t('contact.location.title')}</h2>
            <p class="dark:text-gray-400 text-gray-500 text-sm">{t('contact.location.desc')}</p>
          </div>

          <div class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 group h-[300px] overflow-hidden relative rounded-sm w-full">
             {/* Map Iframe */}
             <iframe
               src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119934.33230678887!2d-63.26760578857416!3d-17.801048956976722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x93f1e81d770519bf%3A0x62f03672d5dbfb56!2sSanta%20Cruz%20de%20la%20Sierra%2C%20Bolivia!5e0!3m2!1sen!2sbr!4v1700000000000!5m2!1sen!2sbr"
               width="100%"
               height="100%"
               style="border:0;"
               allowfullscreen=""
               loading="lazy"
               referrerpolicy="no-referrer-when-downgrade"
               class="absolute dark:contrast-125 dark:filter dark:grayscale dark:opacity-70 grayscale h-full inset-0 object-cover w-full"
             ></iframe>
             <div class="absolute bg-gray-50 dark:bg-brand-dark/20 inset-0 mix-blend-multiply pointer-events-none"></div>
          </div>

          <Card class="bg-gray-50 border-black/10 dark:bg-brand-dark/50 dark:border-white/10 flex flex-col gap-6 items-center p-4 sm:flex-row">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=200&auto=format&fit=crop" alt="Building" class="border border-gray-200 dark:border-white/5 h-24 object-cover rounded-sm shrink-0 sm:w-32 w-full" />
            <div class="space-y-2 w-full">
              <h3 class="dark:text-brand-white font-bold text-brand-black tracking-wide">{t('contact.location.building')}</h3>
              <p class="dark:text-gray-400 text-gray-500 text-sm whitespace-pre-line">{t('contact.location.address')}</p>
              <a href="#" class="flex font-bold gap-1 hover:underline items-center mt-2 text-brand-gold text-xs tracking-widest uppercase">
                {t('contact.location.directions')} <ChevronRight class="h-3 w-3"/>
              </a>
            </div>
          </Card>

        </div>
      </section>

      {/* FAQ Section */}
      <section class="border-black/10 border-t dark:border-white/10 pt-16 space-y-8">
        <div>
           <div class="flex gap-4 items-center mb-2">
             <h2 class="dark:text-brand-white font-bold font-display text-2xl text-brand-black tracking-widest uppercase">{t('contact.faq.title')}</h2>
             <div class="bg-brand-gold/50 h-px w-16"></div>
           </div>
           <p class="dark:text-gray-400 text-gray-500 text-sm">{t('contact.faq.desc')}</p>
        </div>

        <div class="gap-6 grid grid-cols-1 lg:grid-cols-4 md:grid-cols-2">
           {/* FAQ 1 */}
           <a href="#" class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 flex group hover:border-brand-gold/50 items-center justify-between p-6 rounded-sm transition-all">
              <div class="flex gap-4 items-center">
                 <Users class="group-hover:scale-110 h-6 text-brand-gold transition-transform w-6" />
                 <span class="dark:group-hover:text-brand-black dark:text-brand-white dark:text-gray-300 font-semibold group-hover:text-brand-black text-gray-600 text-sm whitespace-pre-line">{t('contact.faq.q1')}</span>
              </div>
              <ChevronRight class="h-5 text-brand-gold w-5" />
           </a>
           {/* FAQ 2 */}
           <a href="#" class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 flex group hover:border-brand-gold/50 items-center justify-between p-6 rounded-sm transition-all">
              <div class="flex gap-4 items-center">
                 <Shield class="group-hover:scale-110 h-6 text-brand-gold transition-transform w-6" />
                 <span class="dark:group-hover:text-brand-black dark:text-brand-white dark:text-gray-300 font-semibold group-hover:text-brand-black text-gray-600 text-sm whitespace-pre-line">{t('contact.faq.q2')}</span>
              </div>
              <ChevronRight class="h-5 text-brand-gold w-5" />
           </a>
           {/* FAQ 3 */}
           <a href="#" class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 flex group hover:border-brand-gold/50 items-center justify-between p-6 rounded-sm transition-all">
              <div class="flex gap-4 items-center">
                 <Calendar class="group-hover:scale-110 h-6 text-brand-gold transition-transform w-6" />
                 <span class="dark:group-hover:text-brand-black dark:text-brand-white dark:text-gray-300 font-semibold group-hover:text-brand-black text-gray-600 text-sm whitespace-pre-line">{t('contact.faq.q3')}</span>
              </div>
              <ChevronRight class="h-5 text-brand-gold w-5" />
           </a>
           {/* FAQ 4 */}
           <a href="#" class="bg-gray-50 border border-black/10 dark:bg-brand-dark dark:border-white/10 flex group hover:border-brand-gold/50 items-center justify-between p-6 rounded-sm transition-all">
              <div class="flex gap-4 items-center">
                 <ShoppingCart class="group-hover:scale-110 h-6 text-brand-gold transition-transform w-6" />
                 <span class="dark:group-hover:text-brand-black dark:text-brand-white dark:text-gray-300 font-semibold group-hover:text-brand-black text-gray-600 text-sm whitespace-pre-line">{t('contact.faq.q4')}</span>
              </div>
              <ChevronRight class="h-5 text-brand-gold w-5" />
           </a>
        </div>

        <div class="flex justify-center mt-6">
           <a href="/faq" class="flex font-bold gap-2 hover:underline items-center text-brand-gold text-sm tracking-widest uppercase">
             {t('contact.faq.all')} <ChevronRight class="h-4 w-4"/>
           </a>
        </div>
      </section>

      {/* CTA Banner */}
      <section class="bg-gray-50 border border-brand-gold/20 dark:bg-brand-dark flex flex-col gap-8 items-center justify-between md:flex-row md:p-12 mt-16 overflow-hidden p-8 relative rounded-sm w-full">
         {/* Gold Wave Background */}
         <div class="absolute inset-0 opacity-10 pointer-events-none z-0">
            <svg class="h-full text-brand-gold w-full" preserveAspectRatio="none" viewBox="0 0 1440 320" fill="none" xmlns="http://www.w3.org/2000/svg">
               <path fill="currentColor" d="M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,144C672,139,768,181,864,197.3C960,213,1056,203,1152,186.7C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
            </svg>
         </div>

         <div class="flex gap-4 items-start relative z-10">
            <div class="mt-1 text-brand-gold"><Map class="h-6 w-6" /></div>
            <div>
               <h2 class="dark:text-brand-white font-bold font-display mb-1 md:text-2xl text-brand-black text-xl tracking-widest uppercase">{t('contact.cta.title')}</h2>
               <p class="dark:text-gray-400 md:text-base text-gray-500 text-sm">{t('contact.cta.desc')}</p>
            </div>
         </div>

         <a href="/sobre" class="bg-brand-gold dark:text-brand-white flex font-bold gap-2 hover:bg-brand-gold-dark items-center px-8 py-4 relative rounded-sm shrink-0 text-brand-black text-sm tracking-widest transition-colors uppercase z-10">
            {t('contact.cta.btn')} <ChevronRight class="h-4 w-4"/>
         </a>
      </section>

    </div>
  </main>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (res.ok) {
            successMsg?.classList.remove('hidden');
            form.reset();
          } else {
            errorMsg?.classList.remove('hidden');
          }
        } catch (error) {
          errorMsg?.classList.remove('hidden');
        }
      });
    }
  </script>
</PublicLayout>
