---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Card from '@/components/core/Card.astro';
import { MapPin, Phone, Mail } from '@lucide/astro';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);
---
<PublicLayout title={t('contact.hero.title')}>
  <main class="min-h-screen py-20 px-6 lg:px-16 flex flex-col items-center justify-center relative z-10">
    <div class="w-full max-w-5xl mx-auto space-y-16">

      {/* Hero Section */}
      <div class="text-center space-y-6">
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold uppercase tracking-widest text-brand-black dark:text-brand-white">
          {t('contact.hero.title')}
        </h1>
        <p class="text-gray-600 dark:text-gray-400 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto text-balance">
          {t('contact.info.desc')}
        </p>
      </div>

      {/* Info Grid */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card class="flex flex-col items-center text-center p-8 gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border-gray-200 dark:border-white/10 hover:border-brand-gold/50 transition-colors">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20 mb-2">
            <MapPin class="w-7 h-7 text-brand-gold" />
          </div>
          <div class="text-base font-medium text-brand-black dark:text-brand-white">
            {t('contact.info.address')}
          </div>
        </Card>

        <Card class="flex flex-col items-center text-center p-8 gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border-gray-200 dark:border-white/10 hover:border-brand-gold/50 transition-colors">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20 mb-2">
            <Phone class="w-7 h-7 text-brand-gold" />
          </div>
          <div class="text-base font-medium text-brand-black dark:text-brand-white">
            {t('contact.info.phone')}
          </div>
        </Card>

        <Card class="flex flex-col items-center text-center p-8 gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border-gray-200 dark:border-white/10 hover:border-brand-gold/50 transition-colors">
          <div class="w-16 h-16 rounded-full bg-brand-gold/10 dark:bg-brand-gold/5 flex items-center justify-center border border-brand-gold/20 mb-2">
            <Mail class="w-7 h-7 text-brand-gold" />
          </div>
          <div class="text-base font-medium text-brand-black dark:text-brand-white">
            {t('contact.info.email')}
          </div>
        </Card>
      </div>

      {/* Form Section */}
      <Card class="max-w-3xl mx-auto p-8 md:p-12 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border-gray-200 dark:border-white/10 premium-shadow">
        <h2 class="font-display text-2xl md:text-3xl font-bold uppercase tracking-widest text-brand-black dark:text-brand-white mb-8 text-center">
          {t('contact.form.title')}
        </h2>

        <form id="contact-form" method="POST" action="/api/contacto" class="space-y-8">
          <div id="form-success" class="hidden bg-green-500/10 text-green-500 border border-green-500/20 p-4 rounded-sm text-sm font-semibold text-center">
            {t('contact.form.success')}
          </div>
          <div id="form-error" class="hidden bg-red-500/10 text-red-500 border border-red-500/20 p-4 rounded-sm text-sm font-semibold text-center">
            {t('contact.form.error')}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Input type="text" name="name" label={t('contact.form.name.label')} placeholder={t('contact.form.name.placeholder')} required />
            <Input type="email" name="email" label={t('contact.form.email.label')} placeholder={t('contact.form.email.placeholder')} required />
          </div>

          <div class="flex flex-col gap-2 w-full">
            <label for="message" class="text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite">
              {t('contact.form.message.label')}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder={t('contact.form.message.placeholder')}
              class="flex w-full rounded-sm border bg-white dark:bg-brand-black/50 px-4 py-3 text-sm text-brand-black dark:text-white placeholder:text-gray-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold disabled:cursor-not-allowed disabled:opacity-50 border-gray-300 dark:border-gray-700 hover:border-brand-gold/50"
            ></textarea>
          </div>

          <div class="pt-4 flex justify-center">
            <Button type="submit" fullWidth>{t('contact.form.submit')}</Button>
          </div>
        </form>
      </Card>

    </div>
  </main>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (res.ok) {
            successMsg?.classList.remove('hidden');
            form.reset();
          } else {
            errorMsg?.classList.remove('hidden');
          }
        } catch (error) {
          errorMsg?.classList.remove('hidden');
        }
      });
    }
  </script>
</PublicLayout>
