---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';

import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';
import { getLangFromUrl } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);


const newsArticles = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'NEWS'))
  .orderBy(desc(articles.publishedAt));

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'medium' }).format(new Date(date));
};
---

<PublicLayout title="Noticias">
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-24 relative">
    <div class="absolute bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-6xl mx-auto px-6 relative z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">Noticias</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 text-lg">Últimas novedades y actualizaciones de {tenantConfig.name}.</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-20">
    <div class="container max-w-6xl mx-auto px-6">
      {newsArticles.length === 0 ? (
        <div class="dark:text-gray-400 font-semibold py-24 text-center text-gray-500">
          <p>Aún no hay noticias publicadas.</p>
        </div>
      ) : (
        <div class="gap-10 grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2">
          {newsArticles.map((article) => (
            <a href={`/noticias/${article.slug}`} class="block focus-visible group">
              <Card noPadding class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 flex flex-col h-full hover:border-brand-gold/50 overflow-hidden premium-shadow transition-all">
                <div class="bg-gray-50 border-b border-gray-100 dark:bg-brand-black dark:border-white/5 h-56 overflow-hidden relative">
                  {article.coverImageUrl ? (
                    <img loading="lazy" decoding="async" src={article.coverImageUrl} alt={article.title} class="duration-700 ease-out group-hover:scale-105 h-full object-cover transition-transform w-full" />
                  ) : (
                    <div class="absolute duration-700 ease-out flex group-hover:scale-110 inset-0 items-center justify-center text-brand-gold/20 transition-transform">
                      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-8">
                  <div class="font-bold mb-4 text-brand-gold text-xs tracking-widest uppercase">
                    {formatDate(article.publishedAt as unknown as Date)}
                  </div>
                  <h2 class="dark:text-white font-bold font-display group-hover:text-brand-gold leading-tight line-clamp-2 mb-4 text-brand-black text-xl transition-colors">
                    {article.title}
                  </h2>
                  <p class="dark:text-gray-400 leading-relaxed line-clamp-3 mt-auto text-gray-600 text-sm">
                    {article.excerpt}
                  </p>
                </div>
              </Card>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</PublicLayout>