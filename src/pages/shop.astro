---
import PublicLayout from '../layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';

import Hero from '@/components/shop/Hero.astro';
import CategoriesBar from '@/components/shop/CategoriesBar.astro';
import Sidebar from '@/components/shop/Sidebar.astro';
import ProductGrid from '@/components/shop/ProductGrid.astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('shop', lang);
const t = usePageTranslations(pageDict, lang);
---
<PublicLayout title={t('meta.title') || 'Shop'}>
  <Hero pageDict={pageDict} lang={lang} />
  <CategoriesBar pageDict={pageDict} lang={lang} />

  <div class="container mx-auto px-6 py-12">
    <div class="flex flex-col gap-8 lg:flex-row">
      <Sidebar pageDict={pageDict} lang={lang} />
      <ProductGrid pageDict={pageDict} lang={lang} />
    </div>
  </div>
</PublicLayout>
