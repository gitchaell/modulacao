---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { validateToken } from '@/domain/auth/invitation';

const { token } = Astro.params;

// Validate the token Server-Side (SSR)
const invitation = token ? await validateToken(token) : null;
const isValid = !!invitation;
---

<AuthLayout title="Establecer Contraseña">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold uppercase tracking-wider text-white">Bienvenido</h2>
    <p class="text-sm text-gray-400 mt-2">Crea tu contraseña para acceder a la plataforma.</p>
  </div>

  {isValid ? (
    <form class="space-y-4" method="POST" action="/api/auth/setup-password">
      <input type="hidden" name="token" value={token} />
      <Input type="email" label="Correo Electrónico" value={invitation.email} disabled />
      <Input type="password" name="password" label="Nueva Contraseña" required minlength="8" />
      <Input type="password" name="confirmPassword" label="Confirmar Contraseña" required minlength="8" />

      <Button type="submit" fullWidth class="mt-6">Crear Cuenta</Button>
    </form>
  ) : (
    <div class="bg-red-500/10 border border-red-500/50 rounded-md p-4 text-center">
      <p class="text-red-400 text-sm">El enlace de invitación es inválido, ya ha sido utilizado o ha expirado.</p>
      <a href="/" class="text-brand-gold text-sm hover:underline mt-4 inline-block">Volver al inicio</a>
    </div>
  )}
</AuthLayout>