---
import { getLangFromUrl } from '@/utils/i18n';
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';

const communiques = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'COMMUNIQUE'))
  .orderBy(desc(articles.publishedAt));

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'medium' }).format(new Date(date));
};
const lang = getLangFromUrl(Astro.cookies);
---

<PublicLayout title="Comunicados Oficiales">
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-24 relative">
    <div class="absolute bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 relative text-center z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">Comunicados Oficiales</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 dark:text-gray-400 text-lg">Información oficial, normas y anuncios importantes para la comunidad Modulação.</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-20">
    <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 space-y-6" style="animation-delay: 0.1s;">
      {communiques.length === 0 ? (
        <div class="dark:text-gray-400 py-20 text-center text-gray-500 dark:text-gray-400">
          <p>Aún no hay comunicados publicados.</p>
        </div>
      ) : (
        communiques.map((communique) => (
          <a href={`/comunicados/${communique.slug}`} class="block focus-visible group">
            <Card class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 flex flex-col gap-6 hover:border-brand-gold/50 premium-shadow sm:flex-row sm:items-center transition-colors">
              <div class="bg-brand-gold/10 duration-300 flex flex-shrink-0 group-hover:scale-110 h-16 items-center justify-center rounded-full text-brand-gold transition-transform w-16">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </div>
              <div class="flex-1">
                <div class="font-semibold mb-2 text-brand-gold text-xs tracking-wider">
                  {formatDate(communique.publishedAt as unknown as Date)}
                </div>
                <h2 class="dark:text-white font-bold group-hover:text-brand-gold mb-2 text-brand-black text-xl transition-colors">
                  {communique.title}
                </h2>
                <p class="dark:text-gray-400 line-clamp-2 text-gray-500 dark:text-gray-400 text-sm">
                  {communique.excerpt}
                </p>
              </div>
              <div class="dark:text-gray-400 group-hover:text-brand-gold hidden sm:flex text-gray-500 dark:text-gray-400 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </Card>
          </a>
        ))
      )}
    </div>
  </section>
</PublicLayout>