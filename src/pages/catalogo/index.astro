---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { products } from '@/data/db/schema';
import { desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const catalogProducts = await db
  .select()
  .from(products)
  .orderBy(desc(products.createdAt));
---

<PublicLayout title={t('nav.catalog')}>
  <div class="py-24 bg-brand-black border-b border-gray-200 dark:border-white/5 text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('nav.catalog')}</h1>
      <p class="text-gray-400 text-lg font-medium text-balance">Adquiere productos, servicios e indumentaria exclusiva de {tenantConfig.name} directamente a través de WhatsApp.</p>
    </div>
  </div>

  <section class="py-20 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 max-w-7xl">
      {catalogProducts.length === 0 ? (
        <div class="text-center py-24 text-gray-500 animate-smooth-fade">
          <p class="font-medium text-lg">El catálogo se encuentra en mantenimiento. Vuelve pronto.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {catalogProducts.map((product) => (
            <a href={`/catalogo/${product.slug}`} class="block group focus-visible">
              <Card noPadding class="h-full overflow-hidden flex flex-col bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all duration-300">
                <div class="aspect-square bg-gray-50 dark:bg-brand-black border-b border-gray-100 dark:border-white/5 p-8 flex items-center justify-center relative overflow-hidden">
                  {product.coverImageUrl ? (
                    <img loading="lazy" decoding="async" src={product.coverImageUrl} alt={product.name} class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-700 ease-out" />
                  ) : (
                    <div class="text-brand-gold/20 flex flex-col items-center group-hover:scale-110 transition-transform duration-700 ease-out">
                       <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    </div>
                  )}
                </div>

                <div class="p-6 flex flex-col flex-1">
                  <h2 class="font-display text-lg font-bold text-brand-black dark:text-white mb-2 group-hover:text-brand-gold transition-colors line-clamp-2 leading-snug">
                    {product.name}
                  </h2>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 line-clamp-2 leading-relaxed">
                    {product.description}
                  </p>

                  <div class="mt-auto flex items-center justify-between">
                    <span class="font-display font-bold text-xl text-brand-gold">{product.price}</span>
                    <span class="text-[10px] text-gray-400 uppercase tracking-widest font-bold group-hover:text-brand-black dark:group-hover:text-white transition-colors">Ver Detalles &rarr;</span>
                  </div>
                </div>
              </Card>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</PublicLayout>