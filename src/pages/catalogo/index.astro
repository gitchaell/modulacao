---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { products } from '@/data/db/schema';
import { desc } from 'drizzle-orm';

const catalogProducts = await db
  .select()
  .from(products)
  .orderBy(desc(products.createdAt));
---

<PublicLayout title="Catálogo Oficial">
  <div class="py-16 bg-brand-black border-b border-brand-dark-card/50 text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-60"></div>
    <div class="relative z-10 container mx-auto px-6 max-w-4xl">
      <h1 class="text-4xl font-bold uppercase tracking-widest text-brand-gold mb-4">Catálogo Oficial</h1>
      <p class="text-gray-400">Adquiere productos, servicios e indumentaria exclusiva de la comunidad Modulação directamente a través de WhatsApp.</p>
    </div>
  </div>

  <section class="py-16 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 max-w-6xl">
      {catalogProducts.length === 0 ? (
        <div class="text-center py-20 text-gray-500">
          <p>El catálogo se encuentra en mantenimiento. Vuelve pronto.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {catalogProducts.map((product) => (
            <a href={`/catalogo/${product.slug}`} class="block group">
              <Card noPadding class="h-full hover:border-brand-gold transition-colors overflow-hidden flex flex-col bg-brand-dark-card">

                <div class="aspect-square bg-brand-black border-b border-brand-dark/50 p-6 flex items-center justify-center relative">
                  {product.coverImageUrl ? (
                    <img src={product.coverImageUrl} alt={product.name} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="text-brand-gold/20 flex flex-col items-center">
                       <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    </div>
                  )}
                </div>

                <div class="p-5 flex flex-col flex-1">
                  <h2 class="text-lg font-bold text-white mb-1 group-hover:text-brand-gold transition-colors line-clamp-2">
                    {product.name}
                  </h2>
                  <p class="text-sm text-gray-400 mb-4 line-clamp-2">
                    {product.description}
                  </p>

                  <div class="mt-auto flex items-center justify-between">
                    <span class="font-bold text-lg text-brand-gold">{product.price}</span>
                    <span class="text-xs text-gray-500 uppercase tracking-widest font-semibold">Ver Detalles &rarr;</span>
                  </div>
                </div>
              </Card>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</PublicLayout>