---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { products } from '@/data/db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;

if (!id) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const [product] = await db.select().from(products).where(eq(products.slug, id));

if (!product) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Generar mensaje prellenado para WhatsApp
const whatsappMessage = encodeURIComponent(`Hola, estoy interesado en adquirir "${product.name}" que vi en el Catálogo Oficial de Modulação.`);
const whatsappUrl = `https://wa.me/${product.whatsappNumber}?text=${whatsappMessage}`;
---

<PublicLayout title={product.name}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen py-16">
    <div class="container mx-auto px-6 max-w-5xl">

      <div class="bg-brand-black border border-brand-dark-card rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row">

        <!-- Imagen -->
        <div class="w-full md:w-1/2 aspect-square md:aspect-auto md:min-h-[500px] bg-brand-dark p-8 flex items-center justify-center border-b md:border-b-0 md:border-r border-brand-dark-card relative">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/5 via-brand-dark to-brand-dark"></div>
          {product.coverImageUrl ? (
            <img loading="lazy" decoding="async" src={product.coverImageUrl} alt={product.name} class="w-full h-full object-contain relative z-10" />
          ) : (
             <svg class="text-brand-gold/10 w-48 h-48 relative z-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
          )}
        </div>

        <!-- Info -->
        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col">
          <div class="text-xs font-bold tracking-widest text-brand-gold uppercase mb-4">Catálogo Oficial</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">{product.name}</h1>
          <div class="text-2xl font-light text-gray-300 mb-8">{product.price}</div>

          <div class="prose prose-invert prose-brand text-gray-400 mb-8 flex-1">
            <p class="whitespace-pre-wrap">{product.description}</p>
          </div>

          {product.variants && product.variants.length > 0 && (
            <div class="mb-8 border-t border-brand-dark-card pt-6">
              <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Variantes Disponibles</h3>
              <div class="flex flex-wrap gap-2">
                {product.variants.map((variant) => (
                  <span class="px-3 py-1 bg-brand-dark border border-brand-dark-card rounded text-sm text-gray-300">{variant}</span>
                ))}
              </div>
            </div>
          )}

          <div class="border-t border-brand-dark-card pt-8 mt-auto">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="block w-full">
              <Button variant="primary" size="lg" fullWidth class="flex items-center justify-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Contactar por WhatsApp
              </Button>
            </a>
            <p class="text-center text-xs text-gray-500 mt-4">
              La compra se coordina directamente de forma personal a través de WhatsApp.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</PublicLayout>