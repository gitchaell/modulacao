---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);

// If user is already logged in, redirect them to the app
const session = await import('@/utils/session').then(m => m.getSession(Astro.request, new Response()));
if (session.userId) {
  return Astro.redirect('/app/comunidad');
}
---

<AuthLayout title={t('auth.login.title')}>
  <div class="text-center mb-8">
    <h2 class="font-display text-3xl font-bold uppercase tracking-wider text-brand-black dark:text-white">{t('auth.login.title')}</h2>
    <p class="text-base text-gray-500 font-medium mt-2">Accede a tu cuenta de {tenantConfig.name}.</p>
  </div>

  <form class="space-y-6" method="POST" action="/api/auth/login">
    <Input type="email" name="email" label={t('auth.login.email')} required placeholder="usuario@ejemplo.com" />
    <Input type="password" name="password" label={t('auth.login.password')} required />

    <Button type="submit" fullWidth class="mt-8">{t('auth.login.submit')}</Button>
  </form>

  <div class="mt-8 text-center border-t border-gray-200 dark:border-white/5 pt-6">
    <p class="text-sm text-gray-500 font-medium">
      El acceso es estrictamente por invitación. <br/> Si recibiste una, revisa tu correo electrónico.
    </p>
  </div>
</AuthLayout>