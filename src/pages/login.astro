---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';
import { Users, FileText, Calendar, Shield, Mail, Lock } from 'lucide-astro';
import Footer from '@/components/core/Footer.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('login', lang);
const t = usePageTranslations(pageDict, lang);

// If user is already logged in, redirect them to the app
const session = await import('@/utils/session').then(m => m.getSession(Astro.request, new Response() as any));
if (session.userId) {
  return Astro.redirect('/app/comunidad');
}
---

<BaseLayout title={t('auth.login.title') + ` | ${tenantConfig.name}`}>
  <!-- Add wave pattern explicitly to match the dark aesthetic behind -->
  <div class="bg-brand-white dark:bg-brand-black dark:bg-brand-dark-card fixed h-full inset-0 opacity-40 pointer-events-none w-full z-[-1]">
    <WaveBackground />
  </div>

  <div class="flex flex-col flex-grow justify-center lg:px-8 pt-24 px-4 py-16 relative sm:px-6 w-full z-10">
    <!-- Main 2-column layout mirroring the design -->
    <div class="gap-6 grid grid-cols-1 items-stretch lg:gap-8 lg:grid-cols-[1.2fr_0.8fr] max-w-[1400px] mx-auto w-full">

      <!-- Left side: Content Panels -->
      <div class="animate-smooth-fade flex flex-col gap-6">

        <!-- Top Image Banner in Left Side -->
        <div class="border border-black/5 dark:border-white/5 h-64 md:h-80 overflow-hidden premium-shadow relative rounded-2xl w-full">
          <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop" alt="Earth from Space" class="h-full object-cover w-full" />
          <div class="absolute bg-gradient-to-t from-brand-black/90 inset-0 to-transparent via-transparent"></div>
        </div>

        <!-- Highlight & Text content box -->
        <div class="backdrop-blur-md bg-white/80 border border-black/5 dark:bg-brand-dark/80 dark:border-white/5 flex-grow p-8 premium-shadow rounded-2xl sm:p-12">
          <div class="max-w-2xl">
            <h2 class="dark:text-brand-white font-bold font-display leading-tight lg:text-5xl mb-6 text-4xl text-brand-black tracking-wider uppercase">
              BEM-VINDO À<br />
              <span class="text-brand-gold">{t('login.member_area')}</span>
            </h2>
            <p class="dark:text-gray-400 leading-relaxed mb-12 text-gray-600 text-lg">
              {t('auth.login.welcome_desc')}
            </p>

            <div class="gap-8 grid grid-cols-1 mb-12 md:grid-cols-2">
              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Users class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="dark:text-brand-white font-bold mb-1 text-brand-black text-sm tracking-wide">{t('auth.login.feature1.title')}</h3>
                  <p class="dark:text-gray-400 text-gray-600 text-sm">{t('auth.login.feature1.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <FileText class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="dark:text-brand-white font-bold mb-1 text-brand-black text-sm tracking-wide">{t('auth.login.feature2.title')}</h3>
                  <p class="dark:text-gray-400 text-gray-600 text-sm">{t('auth.login.feature2.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Calendar class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="dark:text-brand-white font-bold mb-1 text-brand-black text-sm tracking-wide">{t('auth.login.feature3.title')}</h3>
                  <p class="dark:text-gray-400 text-gray-600 text-sm">{t('auth.login.feature3.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Shield class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="dark:text-brand-white font-bold mb-1 text-brand-black text-sm tracking-wide">{t('auth.login.feature4.title')}</h3>
                  <p class="dark:text-gray-400 text-gray-600 text-sm">{t('auth.login.feature4.desc')}</p>
                </div>
              </div>
            </div>

            <!-- "Ainda não é membro?" section matching the design -->
            <div class="border-black/10 border-t dark:border-white/10 flex flex-col gap-6 items-start justify-between pt-8 sm:flex-row sm:items-center">
              <div>
                <p class="dark:text-gray-400 mb-1 text-gray-600 text-sm">{t('auth.login.not_member')}</p>
                <a href="#" class="dark:text-brand-white flex font-bold gap-2 group hover:text-brand-black items-center text-brand-gold text-sm tracking-wide transition-colors">
                  {t('auth.login.join_now')}
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right side: Login Form Card Panel -->
      <div class="animate-smooth-fade flex flex-col h-full" style="animation-delay: 0.1s;">
        <div class="backdrop-blur-md bg-white/90 border border-black/5 dark:bg-brand-dark/90 dark:border-white/5 flex flex-col h-full justify-center overflow-hidden p-8 premium-shadow relative rounded-2xl sm:p-12">

          <!-- Subtle gold gradient decoration at the top -->
          <div class="absolute bg-gradient-to-r from-transparent h-1 left-0 opacity-30 to-transparent top-0 via-brand-gold w-full"></div>

          <div class="mb-10 text-center">
            <h1 class="dark:text-brand-white font-bold font-display mb-3 text-3xl text-brand-black tracking-wider uppercase">
              {t('auth.login.header_title')}
            </h1>
            <p class="dark:text-gray-400 text-gray-600">
              {t('auth.login.header_subtitle')}
            </p>
          </div>

          <form class="max-w-sm mx-auto space-y-6 w-full" method="POST" action="/api/auth/login">

            <!-- Email Input -->
            <div class="relative">
              <label class="block dark:text-gray-400 font-bold mb-2 text-gray-600 text-xs tracking-widest uppercase">{t('auth.login.email')}</label>
              <div class="relative">
                <div class="absolute flex inset-y-0 items-center left-0 pl-3 pointer-events-none">
                  <Mail class="dark:text-gray-400 h-5 text-gray-500 w-5" />
                </div>
                <input
                  type="email"
                  name="email"
                  required
                  class="bg-gray-50 border border-black/10 dark:bg-brand-dark-card dark:bg-brand-black dark:border-white/10 dark:text-brand-white focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold pl-10 placeholder-gray-500 pr-4 py-3 rounded-sm text-brand-black text-sm transition-colors w-full"
                  placeholder="seu@email.com"
                />
              </div>
            </div>

            <!-- Password Input -->
            <div class="relative">
              <label class="block dark:text-gray-400 font-bold mb-2 text-gray-600 text-xs tracking-widest uppercase">{t('auth.login.password')}</label>
              <div class="relative">
                <div class="absolute flex inset-y-0 items-center left-0 pl-3 pointer-events-none">
                  <Lock class="dark:text-gray-400 h-5 text-gray-500 w-5" />
                </div>
                <input
                  type="password"
                  name="password"
                  required
                  class="bg-gray-50 border border-black/10 dark:bg-brand-dark-card dark:bg-brand-black dark:border-white/10 dark:text-brand-white focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold pl-10 placeholder-gray-500 pr-10 py-3 rounded-sm text-brand-black text-sm transition-colors w-full"
                  placeholder="••••••••"
                />
                <button type="button" id="toggle-password" class="absolute dark:text-gray-300 dark:text-gray-400 flex hover:text-gray-600 inset-y-0 items-center pr-3 right-0 text-gray-500 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <div class="flex justify-end mt-2">
              <a href="#" class="dark:text-gray-400 hover:text-brand-gold text-gray-600 text-xs transition-colors">
                {t('auth.login.forgot_password')}
              </a>
            </div>

            <Button type="submit" fullWidth class="!bg-brand-gold !py-4 !text-brand-black border-none dark:!text-brand-black dark:text-brand-white font-bold hover:!bg-brand-gold-dark mt-8 rounded-sm tracking-widest transition-colors uppercase">
              {t('auth.login.header_title')}
            </Button>

            <div class="flex items-center my-8 relative">
              <div class="border-black/10 border-t dark:border-white/10 flex-grow"></div>
              <span class="dark:text-gray-400 flex-shrink-0 mx-4 text-gray-500 text-xs tracking-widest uppercase">{t('auth.login.or')}</span>
              <div class="border-black/10 border-t dark:border-white/10 flex-grow"></div>
            </div>

            <Button type="button" variant="outline" fullWidth class="!bg-transparent !border-black/10 !py-4 !text-brand-black border-gray-200 dark:!text-brand-white dark:border-white/10 font-bold hover:!bg-white/5 hover:!border-white/30 rounded-sm tracking-widest transition-colors uppercase">
              {t('auth.login.invite_btn')}
            </Button>

          </form>

        </div>
      </div>

    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const togglePassword = document.getElementById('toggle-password');
  const passwordInput = document.querySelector('input[name="password"]');

  if (togglePassword && passwordInput) {
    togglePassword.addEventListener('click', () => {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
    });
  }
</script>
