---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';
import { Users, FileText, Calendar, Shield, Mail, Lock } from 'lucide-astro';
import Footer from '@/components/core/Footer.astro';
import WaveBackground from '@/components/ui/WaveBackground.astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('login', lang);
const t = usePageTranslations(pageDict, lang);

// If user is already logged in, redirect them to the app
const session = await import('@/utils/session').then(m => m.getSession(Astro.request, new Response() as any));
if (session.userId) {
  return Astro.redirect('/app/comunidad');
}
---

<BaseLayout title={t('auth.login.title') + ` | ${tenantConfig.name}`}>
  <!-- Add wave pattern explicitly to match the dark aesthetic behind -->
  <div class="fixed inset-0 w-full h-full z-[-1] opacity-40 pointer-events-none bg-brand-white dark:bg-[#0a0a0a]">
    <WaveBackground />
  </div>

  <div class="w-full flex-grow flex flex-col justify-center py-16 px-4 sm:px-6 lg:px-8 relative z-10 pt-24">
    <!-- Main 2-column layout mirroring the design -->
    <div class="max-w-[1400px] w-full mx-auto grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-6 lg:gap-8 items-stretch">

      <!-- Left side: Content Panels -->
      <div class="flex flex-col gap-6 animate-smooth-fade">

        <!-- Top Image Banner in Left Side -->
        <div class="w-full h-64 md:h-80 rounded-2xl overflow-hidden relative border border-black/5 dark:border-white/5 premium-shadow">
          <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop" alt="Earth from Space" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/90 via-transparent to-transparent"></div>
        </div>

        <!-- Highlight & Text content box -->
        <div class="bg-white/80 dark:bg-[#111111]/80 backdrop-blur-md border border-black/5 dark:border-white/5 rounded-2xl p-8 sm:p-12 premium-shadow flex-grow">
          <div class="max-w-2xl">
            <h2 class="text-4xl lg:text-5xl leading-tight font-display font-bold text-brand-black dark:text-brand-white uppercase tracking-wider mb-6">
              BEM-VINDO À<br />
              <span class="text-brand-gold">ÁREA DE MEMBROS</span>
            </h2>
            <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-12">
              {t('auth.login.welcome_desc')}
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Users class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-brand-black dark:text-brand-white font-bold text-sm tracking-wide mb-1">{t('auth.login.feature1.title')}</h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{t('auth.login.feature1.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <FileText class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-brand-black dark:text-brand-white font-bold text-sm tracking-wide mb-1">{t('auth.login.feature2.title')}</h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{t('auth.login.feature2.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Calendar class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-brand-black dark:text-brand-white font-bold text-sm tracking-wide mb-1">{t('auth.login.feature3.title')}</h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{t('auth.login.feature3.desc')}</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1 shrink-0 text-brand-gold">
                  <Shield class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-brand-black dark:text-brand-white font-bold text-sm tracking-wide mb-1">{t('auth.login.feature4.title')}</h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{t('auth.login.feature4.desc')}</p>
                </div>
              </div>
            </div>

            <!-- "Ainda não é membro?" section matching the design -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pt-8 border-t border-black/10 dark:border-white/10 gap-6">
              <div>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-1">{t('auth.login.not_member')}</p>
                <a href="#" class="text-brand-gold hover:text-brand-black dark:text-brand-white transition-colors text-sm font-bold tracking-wide flex items-center gap-2 group">
                  {t('auth.login.join_now')}
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right side: Login Form Card Panel -->
      <div class="flex flex-col h-full animate-smooth-fade" style="animation-delay: 0.1s;">
        <div class="bg-white/90 dark:bg-[#111111]/90 backdrop-blur-md p-8 sm:p-12 border border-black/5 dark:border-white/5 premium-shadow rounded-2xl h-full flex flex-col justify-center relative overflow-hidden">

          <!-- Subtle gold gradient decoration at the top -->
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-gold to-transparent opacity-30"></div>

          <div class="mb-10 text-center">
            <h1 class="text-3xl font-display font-bold text-brand-black dark:text-brand-white uppercase tracking-wider mb-3">
              {t('auth.login.header_title')}
            </h1>
            <p class="text-gray-600 dark:text-gray-400">
              {t('auth.login.header_subtitle')}
            </p>
          </div>

          <form class="space-y-6 max-w-sm mx-auto w-full" method="POST" action="/api/auth/login">

            <!-- Email Input -->
            <div class="relative">
              <label class="block text-xs font-bold text-gray-600 dark:text-gray-400 uppercase tracking-widest mb-2">{t('auth.login.email')}</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <Mail class="h-5 w-5 text-gray-500 dark:text-gray-400" />
                </div>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-black/10 dark:border-white/10 rounded-sm text-brand-black dark:text-brand-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold transition-colors text-sm"
                  placeholder="seu@email.com"
                />
              </div>
            </div>

            <!-- Password Input -->
            <div class="relative">
              <label class="block text-xs font-bold text-gray-600 dark:text-gray-400 uppercase tracking-widest mb-2">{t('auth.login.password')}</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <Lock class="h-5 w-5 text-gray-500 dark:text-gray-400" />
                </div>
                <input
                  type="password"
                  name="password"
                  required
                  class="w-full pl-10 pr-10 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-black/10 dark:border-white/10 rounded-sm text-brand-black dark:text-brand-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold transition-colors text-sm"
                  placeholder="••••••••"
                />
                <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500 dark:text-gray-400 hover:text-gray-600 dark:text-gray-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <div class="flex justify-end mt-2">
              <a href="#" class="text-xs text-gray-600 dark:text-gray-400 hover:text-brand-gold transition-colors">
                {t('auth.login.forgot_password')}
              </a>
            </div>

            <Button type="submit" fullWidth class="mt-8 !bg-brand-gold hover:!bg-brand-gold-dark !text-brand-black dark:!text-brand-white uppercase tracking-widest font-bold border-none rounded-sm !py-4 transition-colors">
              {t('auth.login.header_title')}
            </Button>

            <div class="relative my-8 flex items-center">
              <div class="flex-grow border-t border-black/10 dark:border-white/10"></div>
              <span class="flex-shrink-0 mx-4 text-xs text-gray-500 dark:text-gray-400 uppercase tracking-widest">{t('auth.login.or')}</span>
              <div class="flex-grow border-t border-black/10 dark:border-white/10"></div>
            </div>

            <Button type="button" variant="outline" fullWidth class="!bg-transparent !border-black/10 dark:border-white/10 hover:!border-white/30 hover:!bg-white/5 !text-brand-black dark:!text-brand-white uppercase tracking-widest font-bold rounded-sm !py-4 transition-colors">
              {t('auth.login.invite_btn')}
            </Button>

          </form>

        </div>
      </div>

    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const togglePassword = document.getElementById('toggle-password');
  const passwordInput = document.querySelector('input[name="password"]');

  if (togglePassword && passwordInput) {
    togglePassword.addEventListener('click', () => {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
    });
  }
</script>
