---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { Target, HelpCircle, History } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title={t('nav.about')}>
  <div class="relative py-32 bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('nav.about')}</h1>
      <p class="text-gray-400 text-xl font-medium text-balance">{t('about.subtitle')}{tenantConfig.name}.</p>
    </div>
  </div>

  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 lg:px-8 max-w-7xl animate-smooth-fade" style="animation-delay: 0.1s;">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Historia -->
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 premium-shadow lg:col-span-1 h-full flex flex-col">
        <div class="p-8 md:p-12 flex flex-col h-full">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
              <History class="w-8 h-8" />
            </div>
            <h2 class="font-display text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.history.title')}</h2>
          </div>
          <div class="text-gray-600 dark:text-gray-300 space-y-6 text-lg leading-relaxed font-medium flex-grow">
            <p>{tenantConfig.name} nació con una visión clara: buscar el conocimiento y revelar la verdadera realidad. Como parte de Dakila Pesquisas, realizamos investigaciones de campo en Corguinho, MS, y en todo el mundo.</p>
          </div>
        </div>
      </Card>

      <!-- Imagen -->
      <div class="lg:col-span-1 h-full relative rounded-sm premium-shadow overflow-hidden min-h-[300px] border border-gray-200 dark:border-white/5">
        <img
          src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=2048&auto=format&fit=crop"
          alt="Astronomy Research"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-brand-black/20"></div>
      </div>

      <!-- Objetivo -->
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 premium-shadow lg:col-span-1 h-full flex flex-col">
        <div class="p-8 md:p-12 flex flex-col h-full">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
              <Target class="w-8 h-8" />
            </div>
            <h2 class="font-display text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.objective.title')}</h2>
          </div>
          <div class="text-gray-600 dark:text-gray-300 space-y-6 text-lg leading-relaxed font-medium flex-grow">
          <p>Buscamos entender los fenómenos universales a través de la Ciencia Lilarial, documentando anomalías astronómicas, desarrollando tecnología mental y participando activamente en el Complejo Turístico Zigurats y el Recanto de Havalon.</p>
        </div>
      </div>

      </Card>

      <!-- Preguntas Frecuentes -->
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 premium-shadow lg:col-span-1 h-full flex flex-col">
        <div class="p-8 md:p-12 flex flex-col h-full">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold shrink-0">
              <HelpCircle class="w-8 h-8" />
            </div>
            <h2 class="font-display text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.faq.title')}</h2>
          </div>

          <div class="space-y-6">
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> ¿Qué es Dakila Pesquisas?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">Es una asociación mundial que reúne a personas en la búsqueda del conocimiento, cuestionando los dogmas y promoviendo el desarrollo personal.</p>
            </details>
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> ¿Qué es Zigurats?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">Zigurats es nuestra principal sede de investigaciones y complejo turístico ubicado en Corguinho, Mato Grosso do Sul, Brasil. Es el centro neurálgico de nuestras observaciones astronómicas.</p>
            </details>
            <details class="group bg-gray-50 dark:bg-brand-black border border-gray-200 dark:border-white/5 rounded-sm p-6 shadow-sm hover:border-brand-gold/50 transition-colors cursor-pointer">
              <summary class="font-display text-xl font-bold flex items-start gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold">Q.</span> ¿Cómo participo en las actividades de campo?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-gray-200 dark:border-gray-800 ml-2 mt-4 py-2">Las actividades y gincanas de conocimiento son eventos programados para los asociados. Al unirte a los grupos de investigación de Dakila, tendrás la oportunidad de sumarte a nuestras misiones de campo.</p>
            </details>
          </div>
        </div>
      </Card>
      </div>

    </div>
  </section>
</PublicLayout>