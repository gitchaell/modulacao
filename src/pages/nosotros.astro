---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { Target, HelpCircle, History } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PublicLayout title={t('nav.about')}>
  <!-- Hero Section -->
  <div class="relative py-32 bg-brand-white dark:bg-[#0a0a0a] overflow-hidden border-b border-gray-200 dark:border-white/5 transition-colors duration-300">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/5 via-brand-white to-brand-white dark:from-brand-gold/10 dark:via-[#0a0a0a] dark:to-[#0a0a0a] opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('nav.about')}</h1>
      <p class="text-gray-600 dark:text-gray-400 text-xl font-medium text-balance">{t('about.subtitle')}{tenantConfig.name}.</p>
    </div>
  </div>

  <!-- Bento Grid Section -->
  <section class="py-24 bg-gray-50 dark:bg-[#050505] min-h-[50vh] transition-colors duration-300">
    <div class="container mx-auto px-6 lg:px-8 max-w-7xl animate-smooth-fade" style="animation-delay: 0.1s;">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Historia -->
        <div class="bg-white dark:bg-[#0f0f0f] border border-gray-200 dark:border-white/5 rounded-3xl p-8 md:p-12 flex flex-col hover:border-brand-gold/20 dark:hover:border-brand-gold/20 transition-colors duration-300 premium-shadow dark:shadow-none">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-full border border-brand-gold/30 bg-brand-gold/5 flex items-center justify-center text-brand-gold shrink-0">
              <History class="w-7 h-7" />
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.history.title')}</h2>
          </div>
          <div class="text-gray-600 dark:text-gray-400 space-y-6 text-lg leading-relaxed font-medium">
            <p>{tenantConfig.name} nació con una visión clara: buscar el conocimiento y revelar la verdadera realidad. Como parte de Dakila Pesquisas, realizamos investigaciones de campo en Corguinho, MS, y en todo el mundo.</p>
          </div>
        </div>

        <!-- Imagen -->
        <div class="relative rounded-3xl overflow-hidden min-h-[400px] lg:min-h-[auto] border border-gray-200 dark:border-white/5 group premium-shadow dark:shadow-none">
          <img
            src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=2048&auto=format&fit=crop"
            alt="Astronomy Research"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-50/80 dark:from-[#050505]/80 via-transparent to-transparent transition-colors duration-300"></div>
        </div>

        <!-- Objetivo -->
        <div class="bg-white dark:bg-[#0f0f0f] border border-gray-200 dark:border-white/5 rounded-3xl p-8 md:p-12 flex flex-col hover:border-brand-gold/20 dark:hover:border-brand-gold/20 transition-colors duration-300 premium-shadow dark:shadow-none">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-full border border-brand-gold/30 bg-brand-gold/5 flex items-center justify-center text-brand-gold shrink-0">
              <Target class="w-7 h-7" />
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.objective.title')}</h2>
          </div>
          <div class="text-gray-600 dark:text-gray-400 space-y-6 text-lg leading-relaxed font-medium">
            <p>Buscamos entender los fenómenos universales a través de la Ciencia Lilarial, documentando anomalías astronómicas, desarrollando tecnología mental y participando activamente en el Complejo Turístico Zigurats y el Recanto de Havalon.</p>
          </div>
        </div>

        <!-- Preguntas Frecuentes -->
        <div class="bg-white dark:bg-[#0f0f0f] border border-gray-200 dark:border-white/5 rounded-3xl p-8 md:p-12 flex flex-col hover:border-brand-gold/20 dark:hover:border-brand-gold/20 transition-colors duration-300 premium-shadow dark:shadow-none">
          <div class="flex items-center gap-6 mb-8 border-b border-gray-100 dark:border-white/5 pb-6">
            <div class="w-16 h-16 rounded-full border border-brand-gold/30 bg-brand-gold/5 flex items-center justify-center text-brand-gold shrink-0">
              <HelpCircle class="w-7 h-7" />
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-black dark:text-white uppercase tracking-wider">{t('about.faq.title')}</h2>
          </div>

          <div class="space-y-4">
            <details class="group bg-gray-50 dark:bg-[#141414] border border-gray-100 dark:border-white/5 rounded-2xl p-6 hover:border-brand-gold/30 dark:hover:border-brand-gold/30 transition-colors cursor-pointer">
              <summary class="font-display text-lg font-bold flex items-center gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold font-bold">Q.</span> ¿Qué es Dakila Pesquisas?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-brand-gold/20 ml-2 mt-4 py-2">Es una asociación mundial que reúne a personas en la búsqueda del conocimiento, cuestionando los dogmas y promoviendo el desarrollo personal.</p>
            </details>
            <details class="group bg-gray-50 dark:bg-[#141414] border border-gray-100 dark:border-white/5 rounded-2xl p-6 hover:border-brand-gold/30 dark:hover:border-brand-gold/30 transition-colors cursor-pointer">
              <summary class="font-display text-lg font-bold flex items-center gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold font-bold">Q.</span> ¿Qué es Zigurats?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-brand-gold/20 ml-2 mt-4 py-2">Zigurats es nuestra principal sede de investigaciones y complejo turístico ubicado en Corguinho, Mato Grosso do Sul, Brasil. Es el centro neurálgico de nuestras observaciones astronómicas.</p>
            </details>
            <details class="group bg-gray-50 dark:bg-[#141414] border border-gray-100 dark:border-white/5 rounded-2xl p-6 hover:border-brand-gold/30 dark:hover:border-brand-gold/30 transition-colors cursor-pointer">
              <summary class="font-display text-lg font-bold flex items-center gap-3 text-brand-black dark:text-white outline-none">
                <span class="text-brand-gold font-bold">Q.</span> ¿Cómo participo?
              </summary>
              <p class="text-gray-600 dark:text-gray-400 text-base font-medium pl-8 border-l-2 border-brand-gold/20 ml-2 mt-4 py-2">Las actividades y gincanas de conocimiento son eventos programados para los asociados. Al unirte a los grupos de investigación de Dakila, tendrás la oportunidad de sumarte a nuestras misiones de campo.</p>
            </details>
          </div>
        </div>

      </div>
    </div>
  </section>
</PublicLayout>
