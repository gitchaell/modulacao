---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { getLangFromUrl, getPageTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('search', lang);
const t = (key: string) => pageDict[key] || key;

// Obtener parámetro de búsqueda inicial si existe
const query = Astro.url.searchParams.get('q') || '';
---

<PublicLayout title={t('common.search')}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">

    <div class="bg-brand-black border-b border-gray-200 dark:border-white/5 py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
      <div class="relative z-10 container mx-auto px-6 max-w-4xl text-center animate-smooth-fade">
        <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-8">{t('common.search')}</h1>
        <form class="flex w-full max-w-2xl mx-auto gap-4 items-end" id="search-form">
          <Input type="search" name="q" value={query} id="search-input" placeholder={t('common.search_placeholder')} class="flex-1 bg-brand-white dark:bg-brand-black/50" autocomplete="off" />
          <Button type="submit" class="h-12 w-12 px-0 flex items-center justify-center shrink-0" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </Button>
        </form>
      </div>
    </div>

    <div class="container mx-auto px-6 max-w-4xl mt-12 animate-smooth-fade" style="animation-delay: 0.1s;">
      <div id="loading-indicator" class="hidden text-center py-16 text-gray-500 font-semibold">
        <svg class="animate-spin w-10 h-10 mx-auto mb-4 text-brand-gold" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        Buscando...
      </div>

      <div id="results-container" class="space-y-4">
        <!-- Results will be injected here by client JS -->
      </div>

      <div id="no-results" class="hidden text-center py-24 text-gray-500 font-semibold">
        No se encontraron resultados para tu búsqueda.
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('search-form') as HTMLFormElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const container = document.getElementById('results-container');
    const loading = document.getElementById('loading-indicator');
    const noResults = document.getElementById('no-results');

    const performSearch = async (query: string) => {
      if (!query || query.length < 2) return;

      container!.innerHTML = '';
      loading?.classList.remove('hidden');
      noResults?.classList.add('hidden');

      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const data = await res.json();

        loading?.classList.add('hidden');

        if (!data.results || data.results.length === 0) {
          noResults?.classList.remove('hidden');
          return;
        }

        data.results.forEach((item: { type: string; label: string; url: string; }) => {
          const card = document.createElement('a');
          card.href = item.url;
          card.className = "block bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 rounded-sm p-5 hover:border-brand-gold/50 hover:-translate-y-1 transition-all flex items-center justify-between group premium-shadow focus-visible";

          card.innerHTML = `
            <div class="flex items-center">
              <span class="text-xs uppercase tracking-widest font-bold text-gray-500 bg-gray-100 dark:bg-brand-black px-2.5 py-1 rounded-sm mr-4">${item.type}</span>
              <span class="font-semibold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors text-lg font-display">${item.label}</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-brand-gold group-hover:translate-x-1 transition-all" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          `;
          container!.appendChild(card);
        });

      } catch (e) {
        console.error(e);
        loading?.classList.add('hidden');
      }
    };

    // Initialize search if query param is present on load
    if (input && input.value) {
      performSearch(input.value);
    }

    // Handle form submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const url = new URL(window.location.href);
        url.searchParams.set('q', input.value);
        window.history.pushState({}, '', url);
        performSearch(input.value);
      });
    }

    // Real-time debounced search
    let timeout: ReturnType<typeof setTimeout>;
    if (input) {
      input.addEventListener('input', () => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          if (input.value.length >= 2) {
             const url = new URL(window.location.href);
             url.searchParams.set('q', input.value);
             window.history.replaceState({}, '', url);
             performSearch(input.value);
          } else {
             container!.innerHTML = '';
             noResults?.classList.add('hidden');
          }
        }, 300);
      });
    }
  </script>
</PublicLayout>