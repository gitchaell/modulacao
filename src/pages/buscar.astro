---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('search', lang);
const t = usePageTranslations(pageDict, lang);

// Obtener parámetro de búsqueda inicial si existe
const query = Astro.url.searchParams.get('q') || '';
---

<PublicLayout title={t('common.search')}>
  <div class="bg-brand-offwhite dark:bg-brand-dark min-h-screen pb-24">

    <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-24 relative">
      <div class="absolute bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
      <div class="animate-smooth-fade container max-w-4xl mx-auto px-6 relative text-center z-10">
        <h1 class="font-bold font-display mb-8 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('common.search')}</h1>
        <form class="flex gap-4 items-end max-w-2xl mx-auto w-full" id="search-form">
          <Input type="search" name="q" value={query} id="search-input" placeholder={t('common.search_placeholder')} class="bg-brand-white dark:bg-brand-black/50 flex-1" autocomplete="off" />
          <Button type="submit" class="flex h-12 items-center justify-center px-0 shrink-0 w-12" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </Button>
        </form>
      </div>
    </div>

    <div class="animate-smooth-fade container max-w-4xl mt-12 mx-auto px-6" style="animation-delay: 0.1s;">
      <div id="loading-indicator" class="dark:text-gray-400 font-semibold hidden py-16 text-center text-gray-500 dark:text-gray-400">
        <svg class="animate-spin h-10 mb-4 mx-auto text-brand-gold w-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        Buscando...
      </div>

      <div id="results-container" class="space-y-4">
        <!-- Results will be injected here by client JS -->
      </div>

      <div id="no-results" class="dark:text-gray-400 font-semibold hidden py-24 text-center text-gray-500 dark:text-gray-400">
        No se encontraron resultados para tu búsqueda.
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('search-form') as HTMLFormElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const container = document.getElementById('results-container');
    const loading = document.getElementById('loading-indicator');
    const noResults = document.getElementById('no-results');

    const performSearch = async (query: string) => {
      if (!query || query.length < 2) return;

      container!.innerHTML = '';
      loading?.classList.remove('hidden');
      noResults?.classList.add('hidden');

      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const data = await res.json();

        loading?.classList.add('hidden');

        if (!data.results || data.results.length === 0) {
          noResults?.classList.remove('hidden');
          return;
        }

        data.results.forEach((item: { type: string; label: string; url: string; }) => {
          const card = document.createElement('a');
          card.href = item.url;
          card.className = "block bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 rounded-sm p-5 hover:border-brand-gold/50 hover:-translate-y-1 transition-all flex items-center justify-between group premium-shadow focus-visible";

          card.innerHTML = `
            <div class="flex items-center">
              <span class="bg-gray-100 dark:bg-brand-black dark:text-gray-400 font-bold mr-4 px-2.5 py-1 rounded-sm text-gray-500 dark:text-gray-400 text-xs tracking-widest uppercase">${item.type}</span>
              <span class="dark:text-white font-display font-semibold group-hover:text-brand-gold text-brand-black text-lg transition-colors">${item.label}</span>
            </div>
            <svg class="dark:text-gray-400 group-hover:text-brand-gold group-hover:translate-x-1 h-5 text-gray-500 dark:text-gray-400 transition-all w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          `;
          container!.appendChild(card);
        });

      } catch (e) {
        console.error(e);
        loading?.classList.add('hidden');
      }
    };

    // Initialize search if query param is present on load
    if (input && input.value) {
      performSearch(input.value);
    }

    // Handle form submit
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const url = new URL(window.location.href);
        url.searchParams.set('q', input.value);
        window.history.pushState({}, '', url);
        performSearch(input.value);
      });
    }

    // Real-time debounced search
    let timeout: ReturnType<typeof setTimeout>;
    if (input) {
      input.addEventListener('input', () => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          if (input.value.length >= 2) {
             const url = new URL(window.location.href);
             url.searchParams.set('q', input.value);
             window.history.replaceState({}, '', url);
             performSearch(input.value);
          } else {
             container!.innerHTML = '';
             noResults?.classList.add('hidden');
          }
        }, 300);
      });
    }
  </script>
</PublicLayout>