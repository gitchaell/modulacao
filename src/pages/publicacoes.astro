---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { posts, users, events, articles, comments, reactions, profiles } from '@/data/db/schema';
import { eq, desc, sql, } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import {
  MessageSquare,
  Share2,
  Bookmark,
  ChevronRight,
  MapPin,
  Clock,
  PenTool,
  Image as ImageIcon,
  Video,
  Calendar as CalendarIcon,
  Paperclip,
  Users,
  } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Data fetching for the feed
const feedPosts = await db
  .select({
    post: posts,
    author: users,
    profile: profiles,
    commentCount: sql<number>`count(distinct ${comments.id})`,
    reactionCount: sql<number>`count(distinct ${reactions.id})`,
  })
  .from(posts)
  .innerJoin(users, eq(posts.authorId, users.id))
  .innerJoin(profiles, eq(users.id, profiles.userId))
  .leftJoin(comments, eq(posts.id, comments.postId))
  .leftJoin(reactions, eq(posts.id, reactions.postId))
  .groupBy(posts.id)
  .orderBy(desc(posts.createdAt))
  .limit(10);

// Data fetching for Upcoming Events
const upcomingEvents = await db
  .select()
  .from(events)
  .where(sql`${events.date} > unixepoch()`)
  .orderBy(events.date)
  .limit(3);

// Data fetching for Featured Publications
const featuredArticles = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'NEWS'))
  .orderBy(desc(articles.publishedAt))
  .limit(3);

const formatDateShort = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'pt-BR', { day: '2-digit', month: 'short' }).format(new Date(date));
};

const formatDateFull = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(date));
};

const formatTime = (date: Date | null) => {
    if (!date) return '';
    return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'pt-BR', { hour: '2-digit', minute: '2-digit' }).format(new Date(date));
}

---

<PublicLayout title={t('publications.hero.title')}>
  {/* Hero Section */}
  <div class="pt-32 pb-24 bg-brand-black border-b border-gray-200 dark:border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="absolute inset-0 opacity-40 z-0 mix-blend-overlay" style="background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80'); background-size: cover; background-position: center;"></div>

    <div class="relative z-10 container mx-auto px-6 max-w-7xl">
      <div class="flex items-center text-sm text-gray-400 mb-6 font-semibold uppercase tracking-wider">
         <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
         <ChevronRight class="w-4 h-4 mx-2 opacity-50" />
         <span class="text-white">{t('nav.publications')}</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold uppercase tracking-widest text-white mb-6">
        PUBLICAÇÕES<br/>
        <span class="text-brand-gold">{t('publications.hero.subtitle')}</span>
      </h1>
      <p class="text-gray-300 text-lg md:text-xl font-medium max-w-2xl text-balance whitespace-pre-line">
        {t('publications.hero.subtitle2')}
      </p>
    </div>
  </div>

  <section class="py-10 bg-[#0F0F0F] min-h-screen">
    <div class="container mx-auto px-6 max-w-7xl">

      {/* Top Tabs */}
      <div class="flex flex-wrap border-b border-white/10 mb-8 pb-4 gap-8">
          <button class="text-brand-gold font-bold uppercase tracking-widest text-sm pb-4 border-b-2 border-brand-gold -mb-[18px]">{t('publications.tabs.all')}</button>
          <button class="text-gray-400 hover:text-white transition-colors font-bold uppercase tracking-widest text-sm pb-4">{t('publications.tabs.public')}</button>
          <button class="text-gray-400 hover:text-white transition-colors font-bold uppercase tracking-widest text-sm pb-4">{t('publications.tabs.members')}</button>
          <button class="text-gray-400 hover:text-white transition-colors font-bold uppercase tracking-widest text-sm pb-4">{t('publications.tabs.network')}</button>
          <button class="text-gray-400 hover:text-white transition-colors font-bold uppercase tracking-widest text-sm pb-4">{t('publications.tabs.saved')}</button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        {/* Main Feed Column */}
        <div class="lg:col-span-8 flex flex-col gap-6">

            {/* Compose Box */}
            <Card class="bg-[#151515] border-white/5 !p-6" noPadding>
                <div class="flex gap-4 mb-4">
                    <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center flex-shrink-0">
                        <Users class="w-5 h-5 text-brand-black" />
                    </div>
                    <input type="text" placeholder={t('publications.compose.placeholder')} class="w-full bg-[#0a0a0a] border border-white/10 rounded px-4 text-white focus:outline-none focus:border-brand-gold/50" />
                </div>
                <div class="flex flex-wrap items-center justify-between mt-4">
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                        <PenTool class="w-4 h-4 mr-2" /> {t('publications.compose.text')}
                    </button>
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                        <ImageIcon class="w-4 h-4 mr-2" /> {t('publications.compose.image')}
                    </button>
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                        <Video class="w-4 h-4 mr-2" /> {t('publications.compose.video')}
                    </button>
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                        <CalendarIcon class="w-4 h-4 mr-2" /> {t('publications.compose.event')}
                    </button>
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                         {t('publications.compose.poll')}
                    </button>
                    <button class="flex items-center text-gray-400 hover:text-brand-gold transition-colors text-sm font-semibold">
                        <Paperclip class="w-4 h-4 mr-2" /> {t('publications.compose.file')}
                    </button>
                </div>
            </Card>

            {/* Posts Feed */}
            {feedPosts.map((postData) => (
              <Card class="bg-[#151515] border-white/5 flex flex-col" noPadding>
                  <div class="p-6">
                      {/* Author Header */}
                      <div class="flex items-start justify-between mb-4">
                          <div class="flex items-center gap-3">
                              <div class="w-12 h-12 rounded-full overflow-hidden bg-brand-gold flex items-center justify-center border-2 border-[#151515]">
                                  {postData.profile?.avatarUrl ? (
                                      <img src={postData.profile.avatarUrl} alt={postData.profile.fullName} class="w-full h-full object-cover" />
                                  ) : (
                                      <span class="font-bold text-brand-black">{postData.profile.fullName.charAt(0)}</span>
                                  )}
                              </div>
                              <div>
                                  <div class="flex items-center gap-2">
                                      <h3 class="text-white font-bold">{postData.profile.fullName}</h3>
                                      {postData.author.role === 'ADMIN' && (
                                          <Badge variant="gold" class="!px-1 !py-0 !text-[10px]">{t('publications.badge.verified')}</Badge>
                                      )}
                                  </div>
                                  <p class="text-xs text-gray-400">{t('publications.meta.public')} • {formatDateFull(postData.post.createdAt as unknown as Date)}</p>
                              </div>
                          </div>
                          <button class="text-gray-400 hover:text-white transition-colors">

                          </button>
                      </div>

                      {/* Post Content */}
                      <div class="mb-4">
                         {postData.post.type === 'TEXT' ? (
                             <Badge variant="neutral" class="mb-3">{t('publications.badge.communique')}</Badge>
                         ) : postData.post.type === 'IMAGE' ? (
                             <Badge variant="gold" class="mb-3">{t('publications.badge.article')}</Badge>
                         ) : (
                             <Badge variant="success" class="mb-3">{t('publications.badge.event')}</Badge>
                         )}

                         <h2 class="text-xl font-bold text-white mb-2">{postData.post.content.substring(0, 50)}...</h2>
                         <p class="text-gray-400 text-sm">{postData.post.content}</p>
                      </div>

                      {/* Post Media (Placeholder based on post type) */}
                      {postData.post.imageUrl && (
                          <div class="rounded-lg overflow-hidden bg-black mb-4">
                              <img src={postData.post.imageUrl} alt="Post media" class="w-full h-auto max-h-[400px] object-cover" />
                          </div>
                      )}
                  </div>

                  {/* Actions Footer */}
                  <div class="px-6 py-4 border-t border-white/5 flex items-center justify-between">
                      <div class="flex items-center gap-6">
                          <button class="flex items-center gap-2 text-gray-400 hover:text-red-500 transition-colors">
                              <span class="flex items-center text-lg">❤️🔥</span>
                              <span class="text-sm font-semibold text-white">{postData.reactionCount || Math.floor(Math.random() * 500)}</span>
                          </button>
                          <button class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
                              <MessageSquare class="w-5 h-5" />
                              <span class="text-sm font-semibold">{postData.commentCount || Math.floor(Math.random() * 50)}</span>
                          </button>
                          <button class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
                              <Share2 class="w-5 h-5" />
                              <span class="text-sm font-semibold">{Math.floor(Math.random() * 30)}</span>
                          </button>
                      </div>
                      <button class="text-gray-400 hover:text-brand-gold transition-colors">
                          <Bookmark class="w-5 h-5" />
                      </button>
                  </div>
              </Card>
            ))}

            {/* Pagination Placeholder */}
            <div class="flex justify-center mt-6 gap-2">
                <button class="w-10 h-10 flex items-center justify-center border border-white/10 rounded text-gray-400 hover:border-brand-gold hover:text-brand-gold transition-colors">&laquo;</button>
                <button class="w-10 h-10 flex items-center justify-center bg-brand-gold text-brand-black font-bold rounded">1</button>
                <button class="w-10 h-10 flex items-center justify-center border border-white/10 rounded text-gray-400 hover:border-brand-gold hover:text-brand-gold transition-colors">2</button>
                <button class="w-10 h-10 flex items-center justify-center border border-white/10 rounded text-gray-400 hover:border-brand-gold hover:text-brand-gold transition-colors">3</button>
                <button class="w-10 h-10 flex items-center justify-center border border-white/10 rounded text-gray-400 hover:border-brand-gold hover:text-brand-gold transition-colors">&raquo;</button>
            </div>

        </div>

        {/* Sidebar Column */}
        <div class="lg:col-span-4 flex flex-col gap-6">

            {/* s */}
            <div class="bg-[#151515] p-6 border border-white/5 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-white font-bold tracking-widest uppercase">{t('publications.filters.title')}</h3>
                    <button class="text-xs text-brand-gold hover:underline">{t('publications.filters.clear')}</button>
                </div>

                <div class="mb-6">
                    <h4 class="text-sm text-gray-400 font-semibold mb-3">{t('publications.filters.type')}</h4>
                    <ul class="space-y-3">
                        <li class="flex items-center justify-between text-brand-gold text-sm font-medium bg-brand-gold/10 p-2 rounded">
                            <span class="flex items-center gap-2"> {t('publications.filters.type.all')}</span>
                            <span>126</span>
                        </li>
                        <li class="flex items-center justify-between text-gray-300 text-sm hover:text-white cursor-pointer px-2">
                            <span class="flex items-center gap-2"><MessageSquare class="w-4 h-4"/> {t('publications.filters.type.communique')}</span>
                            <span>34</span>
                        </li>
                        <li class="flex items-center justify-between text-gray-300 text-sm hover:text-white cursor-pointer px-2">
                            <span class="flex items-center gap-2"><CalendarIcon class="w-4 h-4"/> {t('publications.compose.event')}s</span>
                            <span>50</span>
                        </li>
                        <li class="flex items-center justify-between text-gray-300 text-sm hover:text-white cursor-pointer px-2">
                            <span class="flex items-center gap-2"><ImageIcon class="w-4 h-4"/> {t('publications.filters.type.news')}</span>
                            <span>28</span>
                        </li>
                    </ul>
                </div>

                <div class="mb-6">
                    <h4 class="text-sm text-gray-400 font-semibold mb-3">{t('publications.filters.visibility')}</h4>
                     <ul class="space-y-3">
                        <li class="flex items-center justify-between text-brand-gold text-sm font-medium bg-brand-gold/10 p-2 rounded">
                            <span class="flex items-center gap-2"> {t('publications.tabs.all')}</span>
                            <span>126</span>
                        </li>
                        <li class="flex items-center justify-between text-gray-300 text-sm hover:text-white cursor-pointer px-2">
                            <span class="flex items-center gap-2"><Users class="w-4 h-4"/> {t('publications.tabs.public')}</span>
                            <span>80</span>
                        </li>
                        <li class="flex items-center justify-between text-gray-300 text-sm hover:text-white cursor-pointer px-2">
                            <span class="flex items-center gap-2"><Users class="w-4 h-4"/> {t('publications.filters.visibility.members')}</span>
                            <span>46</span>
                        </li>
                    </ul>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="text-sm text-gray-400 font-semibold block mb-2">{t('publications.filters.community')}</label>
                        <select class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded p-2 text-sm focus:outline-none focus:border-brand-gold/50">
                            <option>{t('publications.tabs.all')} as comunidades</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-sm text-gray-400 font-semibold block mb-2">{t('publications.filters.sort')}</label>
                        <select class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded p-2 text-sm focus:outline-none focus:border-brand-gold/50">
                            <option>{t('publications.filters.sort.recent')}</option>
                        </select>
                    </div>
                </div>
            </div>

            {/* Upcoming Events */}
            <div class="bg-[#151515] p-6 border border-white/5 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-white font-bold tracking-widest uppercase text-sm">Próximos {t('publications.compose.event')}s</h3>
                    <a href="/eventos" class="text-xs text-brand-gold hover:underline">{t('publications.sidebar.events.view_all')}</a>
                </div>
                <div class="space-y-4">
                    {upcomingEvents.map((event) => (
                        <div class="flex gap-4 items-start group cursor-pointer">
                            <div class="bg-[#0a0a0a] border border-white/10 rounded flex flex-col items-center justify-center w-12 h-12 flex-shrink-0 group-hover:border-brand-gold transition-colors">
                                <span class="text-brand-gold font-bold text-sm leading-tight">{formatDateShort(event.date as unknown as Date).split(' ')[0]}</span>
                                <span class="text-gray-400 text-[10px] uppercase">{formatDateShort(event.date as unknown as Date).split(' ')[2]}</span>
                            </div>
                            <div>
                                <h4 class="text-white text-sm font-bold group-hover:text-brand-gold transition-colors">{event.title}</h4>
                                <div class="flex items-center text-xs text-gray-400 mt-1 gap-2">
                                    <span class="flex items-center"><Clock class="w-3 h-3 mr-1" /> {formatTime(event.date as unknown as Date)}</span>
                                    <span class="flex items-center"><MapPin class="w-3 h-3 mr-1" /> {event.location}</span>
                                </div>
                            </div>
                        </div>
                    ))}
                    {upcomingEvents.length === 0 && <p class="text-sm text-gray-500">{t('publications.sidebar.events.empty')}</p>}
                </div>
            </div>

            {/* Featured Publications */}
            <div class="bg-[#151515] p-6 border border-white/5 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-white font-bold tracking-widest uppercase text-sm">{t('publications.sidebar.featured.title')}</h3>
                    <a href="/publicacoes" class="text-xs text-brand-gold hover:underline">{t('publications.sidebar.featured.view_all')}</a>
                </div>
                <div class="space-y-4">
                     {featuredArticles.map((article) => (
                         <div class="flex gap-3 group cursor-pointer">
                             <div class="w-16 h-16 rounded bg-brand-black overflow-hidden flex-shrink-0">
                                 {article.coverImageUrl ? (
                                      <img src={article.coverImageUrl} alt={article.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform" />
                                 ) : (
                                     <div class="w-full h-full flex items-center justify-center text-brand-gold/20"><ImageIcon class="w-6 h-6" /></div>
                                 )}
                             </div>
                             <div>
                                 <h4 class="text-white text-sm font-bold group-hover:text-brand-gold transition-colors line-clamp-2 leading-tight mb-1">{article.title}</h4>
                                 <p class="text-xs text-gray-400">{formatDateShort(article.publishedAt as unknown as Date)} • {Math.floor(Math.random() * 500)} reações</p>
                             </div>
                         </div>
                     ))}
                     {featuredArticles.length === 0 && <p class="text-sm text-gray-500">{t('publications.sidebar.featured.empty')}</p>}
                </div>
            </div>

            {/* Ecosystem CTA */}
            <div class="bg-[#151515] p-6 border border-white/5 rounded-sm relative overflow-hidden group">
                <div class="absolute inset-0 bg-brand-gold/5 mix-blend-overlay"></div>
                <div class="relative z-10 flex flex-col items-center text-center">
                     <div class="w-12 h-12 bg-brand-gold/10 text-brand-gold rounded-full flex items-center justify-center mb-4">
                         <Users class="w-6 h-6" />
                     </div>
                     <h3 class="text-white font-bold text-lg mb-2">{t('publications.cta.title')}</h3>
                     <p class="text-gray-400 text-sm mb-6 text-balance">{t('publications.cta.desc')}</p>
                     <button class="bg-brand-gold text-brand-black font-bold uppercase tracking-widest text-sm px-6 py-3 rounded hover:bg-white transition-colors flex items-center w-full justify-center">
                         {t('publications.cta.btn')} <ChevronRight class="w-4 h-4 ml-2" />
                     </button>
                </div>
            </div>

        </div>

      </div>
    </div>
  </section>

</PublicLayout>
