---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { posts, users, events, articles, comments, reactions, profiles } from '@/data/db/schema';
import { eq, desc, sql, } from 'drizzle-orm';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import {
  MessageSquare,
  Share2,
  Bookmark,
  ChevronRight,
  MapPin,
  Clock,
  PenTool,
  Image as ImageIcon,
  Video,
  Calendar as CalendarIcon,
  Paperclip,
  Users,
  } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const pageDict = await getPageTranslations("publications", lang);
const t = usePageTranslations(pageDict, lang);

// Data fetching for the feed
const feedPosts = await db
  .select({
    post: posts,
    author: users,
    profile: profiles,
    commentCount: sql<number>`count(distinct ${comments.id})`,
    reactionCount: sql<number>`count(distinct ${reactions.id})`,
  })
  .from(posts)
  .innerJoin(users, eq(posts.authorId, users.id))
  .innerJoin(profiles, eq(users.id, profiles.userId))
  .leftJoin(comments, eq(posts.id, comments.postId))
  .leftJoin(reactions, eq(posts.id, reactions.postId))
  .groupBy(posts.id)
  .orderBy(desc(posts.createdAt))
  .limit(10);

// Data fetching for Upcoming Events
const upcomingEvents = await db
  .select()
  .from(events)
  .where(sql`${events.date} > unixepoch()`)
  .orderBy(events.date)
  .limit(3);

// Data fetching for Featured Publications
const featuredArticles = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'NEWS'))
  .orderBy(desc(articles.publishedAt))
  .limit(3);

const formatDateShort = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'short' }).format(new Date(date));
};

const formatDateFull = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(date));
};

const formatTime = (date: Date | null) => {
    if (!date) return '';
    return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { hour: '2-digit', minute: '2-digit' }).format(new Date(date));
}

---

<PublicLayout title={t('publications.hero.title')}>
  {/* Hero Section */}
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-black/5 dark:border-white/5 overflow-hidden pb-24 pt-32 relative">
    <div class="absolute bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="absolute inset-0 mix-blend-overlay opacity-40 z-0" style="background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80'); background-size: cover; background-position: center;"></div>

    <div class="container max-w-7xl mx-auto px-6 relative z-10">
      <div class="dark:text-gray-400 flex font-semibold items-center mb-6 text-gray-600 text-sm tracking-wider uppercase">
         <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
         <ChevronRight class="h-4 mx-2 opacity-50 w-4" />
         <span class="dark:text-brand-white text-brand-black">{t('nav.publications')}</span>
      </div>
      <h1 class="dark:text-brand-white font-bold font-display lg:text-6xl mb-6 md:text-5xl text-4xl text-brand-black tracking-widest uppercase">
        PUBLICAÇÕES<br/>
        <span class="text-brand-gold">{t('publications.hero.subtitle')}</span>
      </h1>
      <p class="dark:text-gray-300 font-medium max-w-2xl md:text-xl text-balance text-gray-600 text-lg whitespace-pre-line">
        {t('publications.hero.subtitle2')}
      </p>
    </div>
  </div>

  <section class="bg-[#0F0F0F] min-h-screen py-10">
    <div class="container max-w-7xl mx-auto px-6">

      {/* Top Tabs */}
      <div class="border-b border-black/10 dark:border-white/10 flex flex-wrap gap-8 mb-8 pb-4">
          <button class="-mb-[18px] border-b-2 border-brand-gold font-bold pb-4 text-brand-gold text-sm tracking-widest uppercase">{t('publications.tabs.all')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.public')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.members')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.network')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.saved')}</button>
      </div>

      <div class="gap-8 grid grid-cols-1 lg:grid-cols-12">

        {/* Main Feed Column */}
        <div class="flex flex-col gap-6 lg:col-span-8">

            {/* Compose Box */}
            <Card class="!p-6 bg-brand-white border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5" noPadding>
                <div class="flex gap-4 mb-4">
                    <div class="bg-brand-gold flex flex-shrink-0 h-10 items-center justify-center rounded-full w-10">
                        <Users class="dark:text-brand-white h-5 text-brand-black w-5" />
                    </div>
                    <input type="text" placeholder={t('publications.compose.placeholder')} class="bg-brand-white border border-black/10 dark:bg-[#0a0a0a] dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none px-4 rounded text-brand-black w-full" />
                </div>
                <div class="flex flex-wrap items-center justify-between mt-4">
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <PenTool class="h-4 mr-2 w-4" /> {t('publications.compose.text')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <ImageIcon class="h-4 mr-2 w-4" /> {t('publications.compose.image')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <Video class="h-4 mr-2 w-4" /> {t('publications.compose.video')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <CalendarIcon class="h-4 mr-2 w-4" /> {t('publications.compose.event')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                         {t('publications.compose.poll')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <Paperclip class="h-4 mr-2 w-4" /> {t('publications.compose.file')}
                    </button>
                </div>
            </Card>

            {/* Posts Feed */}
            {feedPosts.map((postData) => (
              <Card class="bg-brand-white border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5 flex flex-col" noPadding>
                  <div class="p-6">
                      {/* Author Header */}
                      <div class="flex items-start justify-between mb-4">
                          <div class="flex gap-3 items-center">
                              <div class="bg-brand-gold border-2 border-[#151515] flex h-12 items-center justify-center overflow-hidden rounded-full w-12">
                                  {postData.profile?.avatarUrl ? (
                                      <img src={postData.profile.avatarUrl} alt={postData.profile.fullName} class="h-full object-cover w-full" />
                                  ) : (
                                      <span class="dark:text-brand-white font-bold text-brand-black">{postData.profile.fullName.charAt(0)}</span>
                                  )}
                              </div>
                              <div>
                                  <div class="flex gap-2 items-center">
                                      <h3 class="dark:text-brand-white font-bold text-brand-black">{postData.profile.fullName}</h3>
                                      {postData.author.role === 'ADMIN' && (
                                          <Badge variant="gold" class="!px-1 !py-0 !text-[10px]">{t('publications.badge.verified')}</Badge>
                                      )}
                                  </div>
                                  <p class="dark:text-gray-400 text-gray-600 text-xs">{t('publications.meta.public')} • {formatDateFull(postData.post.createdAt as unknown as Date)}</p>
                              </div>
                          </div>
                          <button class="dark:hover:text-brand-white dark:text-gray-400 hover:text-brand-black text-gray-600 transition-colors">

                          </button>
                      </div>

                      {/* Post Content */}
                      <div class="mb-4">
                         {postData.post.type === 'TEXT' ? (
                             <Badge variant="neutral" class="mb-3">{t('publications.badge.communique')}</Badge>
                         ) : postData.post.type === 'IMAGE' ? (
                             <Badge variant="gold" class="mb-3">{t('publications.badge.article')}</Badge>
                         ) : (
                             <Badge variant="success" class="mb-3">{t('publications.badge.event')}</Badge>
                         )}

                         <h2 class="dark:text-brand-white font-bold mb-2 text-brand-black text-xl">{postData.post.content.substring(0, 50)}...</h2>
                         <p class="dark:text-gray-400 text-gray-600 text-sm">{postData.post.content}</p>
                      </div>

                      {/* Post Media (Placeholder based on post type) */}
                      {postData.post.imageUrl && (
                          <div class="bg-gray-100 dark:bg-black mb-4 overflow-hidden rounded-sm">
                              <img src={postData.post.imageUrl} alt="Post media" class="h-auto max-h-[400px] object-cover w-full" />
                          </div>
                      )}
                  </div>

                  {/* Actions Footer */}
                  <div class="border-black/5 border-t dark:border-white/5 flex items-center justify-between px-6 py-4">
                      <div class="flex gap-6 items-center">
                          <button class="dark:text-gray-400 flex gap-2 hover:text-red-500 items-center text-gray-600 transition-colors">
                              <span class="flex items-center text-lg">❤️🔥</span>
                              <span class="dark:text-brand-white font-semibold text-brand-black text-sm">{postData.reactionCount || Math.floor(Math.random() * 500)}</span>
                          </button>
                          <button class="dark:hover:text-brand-white dark:text-gray-400 flex gap-2 hover:text-brand-black items-center text-gray-600 transition-colors">
                              <MessageSquare class="h-5 w-5" />
                              <span class="font-semibold text-sm">{postData.commentCount || Math.floor(Math.random() * 50)}</span>
                          </button>
                          <button class="dark:hover:text-brand-white dark:text-gray-400 flex gap-2 hover:text-brand-black items-center text-gray-600 transition-colors">
                              <Share2 class="h-5 w-5" />
                              <span class="font-semibold text-sm">{Math.floor(Math.random() * 30)}</span>
                          </button>
                      </div>
                      <button class="dark:text-gray-400 hover:text-brand-gold text-gray-600 transition-colors">
                          <Bookmark class="h-5 w-5" />
                      </button>
                  </div>
              </Card>
            ))}

            {/* Pagination Placeholder */}
            <div class="flex gap-2 justify-center mt-6">
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">&laquo;</button>
                <button class="bg-brand-gold dark:text-brand-white flex font-bold h-10 items-center justify-center rounded text-brand-black w-10">1</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">2</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">3</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">&raquo;</button>
            </div>

        </div>

        {/* Sidebar Column */}
        <div class="flex flex-col gap-6 lg:col-span-4">

            {/* s */}
            <div class="bg-brand-white border border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="dark:text-brand-white font-bold text-brand-black tracking-widest uppercase">{t('publications.filters.title')}</h3>
                    <button class="hover:underline text-brand-gold text-xs">{t('publications.filters.clear')}</button>
                </div>

                <div class="mb-6">
                    <h4 class="dark:text-gray-400 font-semibold mb-3 text-gray-600 text-sm">{t('publications.filters.type')}</h4>
                    <ul class="space-y-3">
                        <li class="bg-brand-gold/10 flex font-medium items-center justify-between p-2 rounded text-brand-gold text-sm">
                            <span class="flex gap-2 items-center"> {t('publications.filters.type.all')}</span>
                            <span>126</span>
                        </li>
                        <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                            <span class="flex gap-2 items-center"><MessageSquare class="h-4 w-4"/> {t('publications.filters.type.communique')}</span>
                            <span>34</span>
                        </li>
                        <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                            <span class="flex gap-2 items-center"><CalendarIcon class="h-4 w-4"/> {t('publications.compose.event')}s</span>
                            <span>50</span>
                        </li>
                        <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                            <span class="flex gap-2 items-center"><ImageIcon class="h-4 w-4"/> {t('publications.filters.type.news')}</span>
                            <span>28</span>
                        </li>
                    </ul>
                </div>

                <div class="mb-6">
                    <h4 class="dark:text-gray-400 font-semibold mb-3 text-gray-600 text-sm">{t('publications.filters.visibility')}</h4>
                     <ul class="space-y-3">
                        <li class="bg-brand-gold/10 flex font-medium items-center justify-between p-2 rounded text-brand-gold text-sm">
                            <span class="flex gap-2 items-center"> {t('publications.tabs.all')}</span>
                            <span>126</span>
                        </li>
                        <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                            <span class="flex gap-2 items-center"><Users class="h-4 w-4"/> {t('publications.tabs.public')}</span>
                            <span>80</span>
                        </li>
                        <li class="cursor-pointer dark:hover:text-brand-white dark:text-gray-300 flex hover:text-brand-black items-center justify-between px-2 text-gray-600 text-sm">
                            <span class="flex gap-2 items-center"><Users class="h-4 w-4"/> {t('publications.filters.visibility.members')}</span>
                            <span>46</span>
                        </li>
                    </ul>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block dark:text-gray-400 font-semibold mb-2 text-gray-600 text-sm">{t('publications.filters.community')}</label>
                        <select class="bg-brand-white border border-black/10 dark:bg-[#0a0a0a] dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none p-2 rounded text-brand-black text-sm w-full">
                            <option>{t('publications.tabs.all')} as comunidades</option>
                        </select>
                    </div>
                    <div>
                        <label class="block dark:text-gray-400 font-semibold mb-2 text-gray-600 text-sm">{t('publications.filters.sort')}</label>
                        <select class="bg-brand-white border border-black/10 dark:bg-[#0a0a0a] dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none p-2 rounded text-brand-black text-sm w-full">
                            <option>{t('publications.filters.sort.recent')}</option>
                        </select>
                    </div>
                </div>
            </div>

            {/* Upcoming Events */}
            <div class="bg-brand-white border border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest uppercase">Próximos {t('publications.compose.event')}s</h3>
                    <a href="/eventos" class="hover:underline text-brand-gold text-xs">{t('publications.sidebar.events.view_all')}</a>
                </div>
                <div class="space-y-4">
                    {upcomingEvents.map((event) => (
                        <div class="cursor-pointer flex gap-4 group items-start">
                            <div class="bg-brand-white border border-black/10 dark:bg-[#0a0a0a] dark:bg-brand-dark-card dark:border-white/10 flex flex-col flex-shrink-0 group-hover:border-brand-gold h-12 items-center justify-center rounded transition-colors w-12">
                                <span class="font-bold leading-tight text-brand-gold text-sm">{formatDateShort(event.date as unknown as Date).split(' ')[0]}</span>
                                <span class="dark:text-gray-400 text-[10px] text-gray-600 uppercase">{formatDateShort(event.date as unknown as Date).split(' ')[2]}</span>
                            </div>
                            <div>
                                <h4 class="dark:text-brand-white font-bold group-hover:text-brand-gold text-brand-black text-sm transition-colors">{event.title}</h4>
                                <div class="dark:text-gray-400 flex gap-2 items-center mt-1 text-gray-600 text-xs">
                                    <span class="flex items-center"><Clock class="h-3 mr-1 w-3" /> {formatTime(event.date as unknown as Date)}</span>
                                    <span class="flex items-center"><MapPin class="h-3 mr-1 w-3" /> {event.location}</span>
                                </div>
                            </div>
                        </div>
                    ))}
                    {upcomingEvents.length === 0 && <p class="dark:text-gray-400 dark:text-gray-500 text-gray-500 text-sm">{t('publications.sidebar.events.empty')}</p>}
                </div>
            </div>

            {/* Featured Publications */}
            <div class="bg-brand-white border border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5 p-6 rounded-sm">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="dark:text-brand-white font-bold text-brand-black text-sm tracking-widest uppercase">{t('publications.sidebar.featured.title')}</h3>
                    <a href="/publicacoes" class="hover:underline text-brand-gold text-xs">{t('publications.sidebar.featured.view_all')}</a>
                </div>
                <div class="space-y-4">
                     {featuredArticles.map((article) => (
                         <div class="cursor-pointer flex gap-3 group">
                             <div class="bg-gray-100 dark:bg-brand-black flex-shrink-0 h-16 overflow-hidden rounded w-16">
                                 {article.coverImageUrl ? (
                                      <img src={article.coverImageUrl} alt={article.title} class="group-hover:scale-110 h-full object-cover transition-transform w-full" />
                                 ) : (
                                     <div class="flex h-full items-center justify-center text-brand-gold/20 w-full"><ImageIcon class="h-6 w-6" /></div>
                                 )}
                             </div>
                             <div>
                                 <h4 class="dark:text-brand-white font-bold group-hover:text-brand-gold leading-tight line-clamp-2 mb-1 text-brand-black text-sm transition-colors">{article.title}</h4>
                                 <p class="dark:text-gray-400 text-gray-600 text-xs">{formatDateShort(article.publishedAt as unknown as Date)} • {Math.floor(Math.random() * 500)} reações</p>
                             </div>
                         </div>
                     ))}
                     {featuredArticles.length === 0 && <p class="dark:text-gray-400 dark:text-gray-500 text-gray-500 text-sm">{t('publications.sidebar.featured.empty')}</p>}
                </div>
            </div>

            {/* Ecosystem CTA */}
            <div class="bg-brand-white border border-black/5 dark:bg-[#151515] dark:bg-brand-dark-card dark:border-white/5 group overflow-hidden p-6 relative rounded-sm">
                <div class="absolute bg-brand-gold/5 inset-0 mix-blend-overlay"></div>
                <div class="flex flex-col items-center relative text-center z-10">
                     <div class="bg-brand-gold/10 flex h-12 items-center justify-center mb-4 rounded-full text-brand-gold w-12">
                         <Users class="h-6 w-6" />
                     </div>
                     <h3 class="dark:text-brand-white font-bold mb-2 text-brand-black text-lg">{t('publications.cta.title')}</h3>
                     <p class="dark:text-gray-400 mb-6 text-balance text-gray-600 text-sm">{t('publications.cta.desc')}</p>
                     <button class="bg-brand-gold dark:text-brand-white flex font-bold hover:bg-brand-gold-dark items-center justify-center px-6 py-3 rounded text-brand-black text-sm tracking-widest transition-colors uppercase w-full">
                         {t('publications.cta.btn')} <ChevronRight class="h-4 ml-2 w-4" />
                     </button>
                </div>
            </div>

        </div>

      </div>
    </div>
  </section>

</PublicLayout>
