---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { ArrowRight } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Using 'NEWS' as the type for publications based on seeded data
const newsArticles = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'NEWS'))
  .orderBy(desc(articles.publishedAt));

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'pt-BR', { dateStyle: 'medium' }).format(new Date(date));
};
---

<PublicLayout title={t('publications.hero.title')}>
  <div class="py-24 bg-brand-black border-b border-gray-200 dark:border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 max-w-6xl animate-smooth-fade text-center md:text-left">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">{t('publications.hero.title')}</h1>
      <p class="text-gray-400 text-lg font-semibold text-balance">{t('publications.hero.subtitle')}</p>
    </div>
  </div>

  <section class="py-20 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 max-w-6xl">
      {newsArticles.length === 0 ? (
        <div class="text-center py-24 text-gray-500 font-semibold">
          <p>{t('publications.empty')}</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {newsArticles.map((article) => (
            <a href={`/publicacoes/${article.slug}`} class="block group focus-visible h-full">
              <Card noPadding class="h-full border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all overflow-hidden flex flex-col bg-brand-white dark:bg-brand-dark-card premium-shadow">
                <div class="h-56 bg-gray-50 dark:bg-brand-black border-b border-gray-100 dark:border-white/5 relative overflow-hidden">
                  {article.coverImageUrl ? (
                    <img loading="lazy" decoding="async" src={article.coverImageUrl} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-brand-gold/20 group-hover:scale-110 transition-transform duration-700 ease-out bg-brand-black/5 dark:bg-brand-black/50">
                      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                  )}
                </div>
                <div class="p-8 flex flex-col flex-1 relative">
                  <div class="text-xs text-brand-gold mb-4 font-bold tracking-widest uppercase">
                    {formatDate(article.publishedAt as unknown as Date)}
                  </div>
                  <h2 class="font-display text-xl font-bold text-brand-black dark:text-white mb-4 group-hover:text-brand-gold transition-colors line-clamp-2 leading-tight">
                    {article.title}
                  </h2>
                  <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mt-auto leading-relaxed mb-6">
                    {article.excerpt}
                  </p>

                  <div class="mt-auto pt-4 border-t border-gray-100 dark:border-white/5 flex items-center text-brand-gold text-sm font-bold uppercase tracking-wider group-hover:translate-x-2 transition-transform duration-300">
                    {t('publications.read_more')}
                    <ArrowRight class="w-4 h-4 ml-2" />
                  </div>
                </div>
              </Card>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</PublicLayout>
