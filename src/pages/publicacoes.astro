---
import PostFeed from '@/components/publicacoes/PostFeed.astro';
import Sidebar from '@/components/publicacoes/Sidebar.astro';

import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { posts, users, events, articles, comments, reactions, profiles } from '@/data/db/schema';
import { eq, desc, sql, } from 'drizzle-orm';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import {

  ChevronRight,
  PenTool,
  Image as ImageIcon,
  Video,
  Calendar as CalendarIcon,
  Paperclip,
  Users,
  } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const pageDict = await getPageTranslations("publications", lang);
const t = usePageTranslations(pageDict, lang);

// Data fetching for the feed
const feedPosts = await db
  .select({
    post: posts,
    author: users,
    profile: profiles,
    commentCount: sql<number>`count(distinct ${comments.id})`,
    reactionCount: sql<number>`count(distinct ${reactions.id})`,
  })
  .from(posts)
  .innerJoin(users, eq(posts.authorId, users.id))
  .innerJoin(profiles, eq(users.id, profiles.userId))
  .leftJoin(comments, eq(posts.id, comments.postId))
  .leftJoin(reactions, eq(posts.id, reactions.postId))
  .groupBy(posts.id)
  .orderBy(desc(posts.createdAt))
  .limit(10);

// Data fetching for Upcoming Events
const upcomingEvents = await db
  .select()
  .from(events)
  .where(sql`${events.date} > unixepoch()`)
  .orderBy(events.date)
  .limit(3);

// Data fetching for Featured Publications
const featuredArticles = await db
  .select()
  .from(articles)
  .where(eq(articles.type, 'NEWS'))
  .orderBy(desc(articles.publishedAt))
  .limit(3);

const formatDateShort = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'short' }).format(new Date(date));
};

const formatDateFull = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(date));
};

const formatTime = (date: Date | null) => {
    if (!date) return '';
    return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { hour: '2-digit', minute: '2-digit' }).format(new Date(date));
}

---

<PublicLayout title={t('publications.hero.title')}>
  {/* Hero Section */}
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-black/5 dark:border-white/5 overflow-hidden pb-24 pt-32 relative">
    <div class="absolute bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="absolute inset-0 mix-blend-overlay opacity-40 z-0" style="background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&q=80'); background-size: cover; background-position: center;"></div>

    <div class="container max-w-7xl mx-auto px-6 relative z-10">
      <div class="dark:text-gray-400 flex font-semibold items-center mb-6 text-gray-600 text-sm tracking-wider uppercase">
         <a href="/" class="hover:text-brand-gold transition-colors">{t('nav.home')}</a>
         <ChevronRight class="h-4 mx-2 opacity-50 w-4" />
         <span class="dark:text-brand-white text-brand-black">{t('nav.publications')}</span>
      </div>
      <h1 class="dark:text-brand-white font-bold font-display lg:text-6xl mb-6 md:text-5xl text-4xl text-brand-black tracking-widest uppercase">
        PUBLICAÇÕES<br/>
        <span class="text-brand-gold">{t('publications.hero.subtitle')}</span>
      </h1>
      <p class="dark:text-gray-300 font-medium max-w-2xl md:text-xl text-balance text-gray-600 text-lg whitespace-pre-line">
        {t('publications.hero.subtitle2')}
      </p>
    </div>
  </div>

  <section class="bg-transparent dark:bg-brand-black/10 min-h-screen py-10">
    <div class="container max-w-7xl mx-auto px-6">

      {/* Top Tabs */}
      <div class="border-b border-black/10 dark:border-white/10 flex flex-wrap gap-8 mb-8 pb-4">
          <button class="-mb-[18px] border-b-2 border-brand-gold font-bold pb-4 text-brand-gold text-sm tracking-widest uppercase">{t('publications.tabs.all')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.public')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.members')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.network')}</button>
          <button class="dark:hover:text-brand-white dark:text-gray-400 font-bold hover:text-brand-black pb-4 text-gray-600 text-sm tracking-widest transition-colors uppercase">{t('publications.tabs.saved')}</button>
      </div>

      <div class="gap-8 grid grid-cols-1 lg:grid-cols-12">

        {/* Main Feed Column */}
        <div class="flex flex-col gap-6 lg:col-span-8">

            {/* Compose Box */}
            <Card class="!p-6 bg-brand-white border-black/5 dark:bg-brand-dark-card dark:border-white/5" noPadding>
                <div class="flex gap-4 mb-4">
                    <div class="bg-brand-gold flex flex-shrink-0 h-10 items-center justify-center rounded-full w-10">
                        <Users class="dark:text-brand-white h-5 text-brand-black w-5" />
                    </div>
                    <input type="text" placeholder={t('publications.compose.placeholder')} class="bg-brand-white border border-black/10 dark:bg-brand-black dark:bg-brand-dark-card dark:border-white/10 dark:text-brand-white focus:border-brand-gold/50 focus:outline-none px-4 rounded text-brand-black w-full" />
                </div>
                <div class="flex flex-wrap items-center justify-between mt-4">
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <PenTool class="h-4 mr-2 w-4" /> {t('publications.compose.text')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <ImageIcon class="h-4 mr-2 w-4" /> {t('publications.compose.image')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <Video class="h-4 mr-2 w-4" /> {t('publications.compose.video')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <CalendarIcon class="h-4 mr-2 w-4" /> {t('publications.compose.event')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                         {t('publications.compose.poll')}
                    </button>
                    <button class="dark:text-gray-400 flex font-semibold hover:text-brand-gold items-center text-gray-600 text-sm transition-colors">
                        <Paperclip class="h-4 mr-2 w-4" /> {t('publications.compose.file')}
                    </button>
                </div>
            </Card>

            {/* Posts Feed */}
            <PostFeed feedPosts={feedPosts} formatDateFull={formatDateFull} t={t} />

            {/* Pagination Placeholder */}
            <div class="flex gap-2 justify-center mt-6">
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">&laquo;</button>
                <button class="bg-brand-gold dark:text-brand-white flex font-bold h-10 items-center justify-center rounded text-brand-black w-10">1</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">2</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">3</button>
                <button class="border border-black/10 dark:border-white/10 dark:text-gray-400 flex h-10 hover:border-brand-gold hover:text-brand-gold items-center justify-center rounded text-gray-600 transition-colors w-10">&raquo;</button>
            </div>

        </div>

        {/* Sidebar Column */}
        <Sidebar upcomingEvents={upcomingEvents} featuredArticles={featuredArticles} formatDateShort={formatDateShort} formatTime={formatTime} t={t} />
      </div>
    </div>
  </section>

</PublicLayout>
