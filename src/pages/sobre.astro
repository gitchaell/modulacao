---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { Target, Eye, Gem, Users, Globe, LayoutGrid, Heart, ChevronRight, Briefcase, Palette, Microscope, Network } from '@lucide/astro';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('about', lang);
const t = usePageTranslations(pageDict, lang);

const topics = [
  {
    id: 'filosofia',
    title: t('about.topics.philosophy'),
    desc: t('about.topics.philosophy_desc'),
    icon: Target,
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop'
  },
  {
    id: 'ciencia',
    title: t('about.topics.science'),
    desc: t('about.topics.science_desc'),
    icon: Microscope,
    image: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=80&w=2070&auto=format&fit=crop'
  },
  {
    id: 'arte',
    title: t('about.topics.art'),
    desc: t('about.topics.art_desc'),
    icon: Palette,
    image: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?q=80&w=2080&auto=format&fit=crop'
  },
  {
    id: 'projetos',
    title: t('about.topics.projects'),
    desc: t('about.topics.projects_desc'),
    icon: Briefcase,
    image: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?q=80&w=2013&auto=format&fit=crop'
  },
  {
    id: 'ecossistema',
    title: t('about.topics.ecosystem'),
    desc: t('about.topics.ecosystem_desc'),
    icon: Network,
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop'
  }
];
---

<PublicLayout title={t('nav.about')}>
  <!-- Layout Wrapper for sidebar + content -->
  <div class="bg-brand-offwhite dark:bg-brand-black min-h-screen text-brand-black dark:text-brand-white relative">

    <!-- Background Texture -->
    <div class="fixed inset-0 pointer-events-none z-0 opacity-20" style="background-image: radial-gradient(circle at center, #D4AF37 0%, transparent 40%); mix-blend-mode: screen;"></div>

    <div class="container mx-auto px-4 md:px-6 flex flex-col lg:flex-row relative z-10 pt-24 pb-24 gap-8">

      <!-- Left Sidebar (Sticky) -->
      <aside class="hidden lg:block w-64 shrink-0">
        <div class="sticky top-32 bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-2xl p-6 overflow-hidden">
          <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand-gold/10 rounded-full blur-3xl pointer-events-none"></div>

          <nav class="flex flex-col space-y-4">
            <a href="#grupo" class="flex items-center gap-3 text-brand-gold font-semibold group transition-colors">
              <Users class="w-4 h-4" />
              <span>{t('about.nav.group')}</span>
            </a>
            <a href="#historia" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.nav.history')}</span>
            </a>
            <a href="#missao" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.nav.mission')}</span>
            </a>
            <a href="#visao" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.nav.vision')}</span>
            </a>
            <a href="#valores" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.nav.values')}</span>
            </a>
            <a href="#filosofia" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.topics.philosophy')}</span>
            </a>
            <a href="#ciencia" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.topics.science')}</span>
            </a>
            <a href="#arte" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.topics.art')}</span>
            </a>
            <a href="#projetos" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.topics.projects')}</span>
            </a>
            <a href="#ecossistema" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-brand-black dark:text-brand-white transition-colors">
              <span class="w-4 h-4 flex items-center justify-center border border-gray-600 rounded-sm text-xs">&nbsp;</span>
              <span>{t('about.topics.ecosystem')}</span>
            </a>
          </nav>
        </div>
      </aside>

      <!-- Right Main Content -->
      <main class="flex-1 w-full space-y-12">

        <!-- Hero: O Grupo -->
        <section id="grupo" class="relative rounded-3xl overflow-hidden border border-black/10 dark:border-white/10 group min-h-[400px] flex items-end p-8 md:p-12">
          <img
            src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=2070&auto=format&fit=crop"
            alt="Grupo ao por do sol"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-gray-200 dark:from-[#050505]/95 via-[#050505]/70 to-transparent"></div>

          <div class="relative z-10 max-w-2xl">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-brand-gold text-sm font-bold uppercase tracking-widest">{t('about.group.label')}</span>
              <div class="h-px w-12 bg-brand-gold/30"></div>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-brand-black dark:text-brand-white mb-6 uppercase tracking-wider">{t('about.hero.title')}</h1>
            <p class="text-gray-700 dark:text-gray-300 text-lg md:text-xl font-semibold leading-relaxed mb-8">
              {t('about.group.title')}
            </p>
            <a href="#historia" class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-brand-gold/50 text-brand-gold hover:bg-brand-gold text-gray-500 hover:text-brand-black dark:text-gray-400 dark:hover:text-brand-white transition-colors duration-300 font-bold text-sm tracking-widest uppercase">
              {t('about.group.btn')}
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>
        </section>

        <!-- Stats -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-4 pb-8 border-b border-black/5 dark:border-white/5">
          <div class="flex flex-col items-center justify-center text-center p-6 bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-2xl">
            <Users class="w-8 h-8 text-brand-gold mb-4" />
            <span class="text-2xl font-bold text-brand-black dark:text-brand-white mb-1">{t('about.stats.members')}</span>
            <span class="text-gray-500 dark:text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">{t('about.stats.members_label')}</span>
          </div>
          <div class="flex flex-col items-center justify-center text-center p-6 bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-2xl">
            <Globe class="w-8 h-8 text-brand-gold mb-4" />
            <span class="text-2xl font-bold text-brand-black dark:text-brand-white mb-1">{t('about.stats.countries')}</span>
            <span class="text-gray-500 dark:text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">{t('about.stats.countries_label')}</span>
          </div>
          <div class="flex flex-col items-center justify-center text-center p-6 bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-2xl">
            <LayoutGrid class="w-8 h-8 text-brand-gold mb-4" />
            <span class="text-2xl font-bold text-brand-black dark:text-brand-white mb-1">{t('about.stats.projects')}</span>
            <span class="text-gray-500 dark:text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">{t('about.stats.projects_label')}</span>
          </div>
          <div class="flex flex-col items-center justify-center text-center p-6 bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-2xl">
            <Heart class="w-8 h-8 text-brand-gold mb-4" />
            <span class="text-2xl font-bold text-brand-black dark:text-brand-white mb-1">{t('about.stats.purpose')}</span>
            <span class="text-gray-500 dark:text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">{t('about.stats.purpose_label')}</span>
          </div>
        </section>

        <!-- Historia -->
        <section id="historia" class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-3xl p-6 lg:p-8">
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden group">
            <img
              src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=2048&auto=format&fit=crop"
              alt="Compass"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
            />
            <div class="absolute inset-0 bg-brand-gold/10 mix-blend-normal dark:mix-blend-overlay"></div>
          </div>
          <div class="p-4 lg:p-8">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-brand-gold text-sm font-bold uppercase tracking-widest">{t('about.history.label')}</span>
              <div class="h-px w-12 bg-brand-gold/30"></div>
            </div>
            <h2 class="text-3xl font-display font-bold text-brand-black dark:text-brand-white mb-6 leading-tight">{t('about.history.title2')}</h2>
            <p class="text-gray-600 dark:text-gray-400 text-lg mb-4 leading-relaxed">
              {t('about.history.p1')}
            </p>
            <p class="text-gray-600 dark:text-gray-400 text-lg mb-8 leading-relaxed">
              {t('about.history.p2')}
            </p>
            <a href="#filosofia" class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-brand-gold/50 text-brand-gold hover:bg-brand-gold text-gray-500 hover:text-brand-black dark:text-gray-400 dark:hover:text-brand-white transition-colors duration-300 font-bold text-sm tracking-widest uppercase">
              {t('about.history.btn')}
              <ChevronRight class="w-4 h-4 ml-2" />
            </a>
          </div>
        </section>

        <!-- Missao, Visao, Valores Grid -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

          <!-- Missao -->
          <div id="missao" class="bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-3xl p-8 hover:border-brand-gold/20 transition-colors flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <Target class="w-8 h-8 text-brand-gold" />
              <h3 class="text-xl font-display font-bold text-brand-gold uppercase tracking-wider">{t('about.mission.label')}</h3>
            </div>
            <div class="relative h-32 rounded-2xl overflow-hidden mb-6">
              <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2070&auto=format&fit=crop" alt="Missao" class="absolute inset-0 w-full h-full object-cover opacity-60" />
            </div>
            <p class="text-gray-600 dark:text-gray-400 font-semibold leading-relaxed flex-1">
              {t('about.mission.desc')}
            </p>
          </div>

          <!-- Visao -->
          <div id="visao" class="bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-3xl p-8 hover:border-brand-gold/20 transition-colors flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <Eye class="w-8 h-8 text-brand-gold" />
              <h3 class="text-xl font-display font-bold text-brand-gold uppercase tracking-wider">{t('about.vision.label')}</h3>
            </div>
            <div class="relative h-32 rounded-2xl overflow-hidden mb-6">
              <img src="https://images.unsplash.com/photo-1454372182658-c712e4c5a1db?q=80&w=2070&auto=format&fit=crop" alt="Visao" class="absolute inset-0 w-full h-full object-cover opacity-60" />
            </div>
            <p class="text-gray-600 dark:text-gray-400 font-semibold leading-relaxed flex-1">
              {t('about.vision.desc')}
            </p>
          </div>

          <!-- Valores -->
          <div id="valores" class="bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-3xl p-8 hover:border-brand-gold/20 transition-colors flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <Gem class="w-8 h-8 text-brand-gold" />
              <h3 class="text-xl font-display font-bold text-brand-gold uppercase tracking-wider">{t('about.values.label')}</h3>
            </div>
            <div class="relative h-32 rounded-2xl overflow-hidden mb-6">
              <img src="https://images.unsplash.com/photo-1484807352052-23338990c6c6?q=80&w=2070&auto=format&fit=crop" alt="Valores" class="absolute inset-0 w-full h-full object-cover opacity-60" />
            </div>
            <div class="grid grid-cols-2 gap-x-2 gap-y-3 mt-auto">
              {Array.from({length: 10}).map((_, i) => (
                <div class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <div class="w-1.5 h-1.5 rounded-full bg-brand-gold"></div>
                  <span>{t(`about.values.v${i+1}` as any)}</span>
                </div>
              ))}
            </div>
          </div>

        </section>

        <!-- Topics List -->
        <section class="space-y-4">
          {topics.map(topic => (
            <div id={topic.id} class="relative bg-white dark:bg-brand-dark-card border border-black/5 dark:border-white/5 rounded-3xl overflow-hidden group flex flex-col md:flex-row items-center p-6 md:p-8 hover:border-brand-gold/30 transition-colors cursor-pointer">
              <!-- Background Image on hover or subtly behind -->
              <div class="absolute inset-0 opacity-10 group-hover:opacity-30 transition-opacity duration-500 pointer-events-none">
                <img src={topic.image} alt={topic.title} class="w-full h-full object-cover mix-blend-normal dark:mix-blend-overlay" />
                <div class="absolute inset-0 bg-gradient-to-r from-[#0f0f0f] via-[#0f0f0f]/80 to-transparent"></div>
              </div>

              <!-- Content -->
              <div class="relative z-10 flex items-center justify-center w-16 h-16 rounded-full border border-brand-gold/30 bg-brand-gold/10 shrink-0 text-brand-gold mb-4 md:mb-0 md:mr-8">
                {
                  (() => {
                    const Icon = topic.icon;
                    return <Icon class="w-8 h-8" />;
                  })()
                }
              </div>

              <div class="relative z-10 flex-1 text-center md:text-left pr-0 md:pr-12">
                <h3 class="text-2xl font-display font-bold text-brand-black dark:text-brand-white uppercase tracking-wider mb-2">{topic.title}</h3>
                <p class="text-gray-600 dark:text-gray-400 font-semibold">
                  {topic.desc}
                </p>
              </div>

              <div class="relative z-10 hidden md:flex items-center justify-center w-10 h-10 rounded-full bg-white/5 text-gray-500 dark:text-gray-500 dark:text-gray-400 group-hover:text-brand-gold group-hover:bg-brand-gold/10 transition-colors shrink-0">
                <ChevronRight class="w-5 h-5" />
              </div>
            </div>
          ))}
        </section>

        <!-- CTA Final -->
        <section class="relative bg-gradient-to-br from-gray-100 to-gray-200 dark:from-[#141414] dark:to-[#050505] border border-black/5 dark:border-white/5 rounded-3xl p-10 lg:p-16 flex flex-col md:flex-row items-center justify-between gap-8 overflow-hidden">
          <div class="absolute inset-0 z-0">
            <!-- decorative wave or glow -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-[1px] bg-gradient-to-r from-transparent via-brand-gold/20 to-transparent opacity-50 shadow-[0_0_50px_10px_#D4AF37]"></div>
          </div>
          <div class="relative z-10 flex items-center gap-6">
            <div class="hidden md:flex w-20 h-20 rounded-full border border-brand-gold/30 bg-brand-gold/10 items-center justify-center shrink-0">
              <Users class="w-10 h-10 text-brand-gold" />
            </div>
            <div>
              <h2 class="text-3xl font-display font-bold text-brand-black dark:text-brand-white mb-2">{t('about.cta.title')}</h2>
              <p class="text-gray-600 dark:text-gray-400 text-lg">{t('about.cta.desc')}</p>
            </div>
          </div>
          <button class="relative z-10 px-8 py-4 bg-brand-gold text-brand-black dark:text-brand-white font-bold uppercase tracking-widest text-sm rounded-full hover:bg-brand-gold-dark transition-colors duration-300 shrink-0">
            {t('about.cta.btn')}
            <ChevronRight class="w-4 h-4 inline-block ml-2 -mt-0.5" />
          </button>
        </section>

      </main>
    </div>
  </div>
</PublicLayout>
