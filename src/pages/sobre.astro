---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { Target, Eye, Gem, Users, Globe, LayoutGrid, Heart, ChevronRight, Briefcase, Palette, Microscope, Network } from '@lucide/astro';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';

import Stats from '@/components/sobre/Stats.astro';
import MissionVisionValues from '@/components/sobre/MissionVisionValues.astro';


const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('about', lang);
const t = usePageTranslations(pageDict, lang);

const topics = [
  {
    id: 'filosofia',
    title: t('about.topics.philosophy'),
    desc: t('about.topics.philosophy_desc'),
    icon: Target,
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop'
  },
  {
    id: 'ciencia',
    title: t('about.topics.science'),
    desc: t('about.topics.science_desc'),
    icon: Microscope,
    image: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=80&w=2070&auto=format&fit=crop'
  },
  {
    id: 'arte',
    title: t('about.topics.art'),
    desc: t('about.topics.art_desc'),
    icon: Palette,
    image: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?q=80&w=2080&auto=format&fit=crop'
  },
  {
    id: 'projetos',
    title: t('about.topics.projects'),
    desc: t('about.topics.projects_desc'),
    icon: Briefcase,
    image: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?q=80&w=2013&auto=format&fit=crop'
  },
  {
    id: 'ecossistema',
    title: t('about.topics.ecosystem'),
    desc: t('about.topics.ecosystem_desc'),
    icon: Network,
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop'
  }
];
---

<PublicLayout title={t('nav.about')}>
  <!-- Layout Wrapper for sidebar + content -->
  <div class="bg-brand-offwhite dark:bg-brand-black dark:text-brand-white min-h-screen relative text-brand-black">

    <!-- Background Texture -->
    <div class="fixed inset-0 opacity-20 pointer-events-none z-0" style="background-image: radial-gradient(circle at center, #D4AF37 0%, transparent 40%); mix-blend-mode: screen;"></div>

    <div class="container flex flex-col gap-8 lg:flex-row md:px-6 mx-auto pb-24 pt-24 px-4 relative z-10">

      <!-- Left Sidebar (Sticky) -->
      <aside class="hidden lg:block shrink-0 w-64">
        <div class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden p-6 rounded-2xl sticky top-32">
          <div class="-right-10 -top-10 absolute bg-brand-gold/10 blur-3xl h-32 pointer-events-none rounded-full w-32"></div>

          <nav class="flex flex-col space-y-4">
            <a href="#grupo" class="flex font-semibold gap-3 group items-center text-brand-gold transition-colors">
              <Users class="h-4 w-4" />
              <span>{t('about.nav.group')}</span>
            </a>
            <a href="#historia" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.nav.history')}</span>
            </a>
            <a href="#missao" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.nav.mission')}</span>
            </a>
            <a href="#visao" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.nav.vision')}</span>
            </a>
            <a href="#valores" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.nav.values')}</span>
            </a>
            <a href="#filosofia" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.topics.philosophy')}</span>
            </a>
            <a href="#ciencia" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.topics.science')}</span>
            </a>
            <a href="#arte" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.topics.art')}</span>
            </a>
            <a href="#projetos" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.topics.projects')}</span>
            </a>
            <a href="#ecossistema" class="dark:text-brand-white dark:text-gray-400 flex gap-3 hover:text-brand-black items-center text-gray-600 transition-colors">
              <span class="border border-gray-600 flex h-4 items-center justify-center rounded-sm text-xs w-4">&nbsp;</span>
              <span>{t('about.topics.ecosystem')}</span>
            </a>
          </nav>
        </div>
      </aside>

      <!-- Right Main Content -->
      <main class="flex-1 space-y-12 w-full">

        <!-- Hero: O Grupo -->
        <section id="grupo" class="border border-black/10 dark:border-white/10 flex group items-end md:p-12 min-h-[400px] overflow-hidden p-8 relative rounded-3xl">
          <img
            src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=2070&auto=format&fit=crop"
            alt="Grupo ao por do sol"
            class="absolute duration-1000 group-hover:scale-105 h-full inset-0 object-cover transition-transform w-full"
          />
          <div class="absolute bg-gradient-to-r dark:from-[#050505]/95 from-gray-200 inset-0 to-transparent via-[#050505]/70"></div>

          <div class="max-w-2xl relative z-10">
            <div class="flex gap-4 items-center mb-4">
              <span class="font-bold text-brand-gold text-sm tracking-widest uppercase">{t('about.group.label')}</span>
              <div class="bg-brand-gold/30 h-px w-12"></div>
            </div>
            <h1 class="dark:text-brand-white font-bold font-display lg:text-6xl mb-6 md:text-5xl text-4xl text-brand-black tracking-wider uppercase">{t('about.hero.title')}</h1>
            <p class="dark:text-gray-300 font-semibold leading-relaxed mb-8 md:text-xl text-gray-700 text-lg">
              {t('about.group.title')}
            </p>
            <a href="#historia" class="border border-brand-gold/50 dark:hover:text-brand-white dark:text-gray-400 duration-300 font-bold hover:bg-brand-gold hover:text-brand-black inline-flex items-center justify-center px-6 py-3 rounded-full text-brand-gold text-gray-500 dark:text-gray-400 text-sm tracking-widest transition-colors uppercase">
              {t('about.group.btn')}
              <ChevronRight class="h-4 ml-2 w-4" />
            </a>
          </div>
        </section>

        <!-- Stats -->
        <Stats t={t} />

        <!-- Historia -->
        <section id="historia" class="bg-white border border-black/5 dark:bg-brand-dark-card dark:border-white/5 gap-8 grid grid-cols-1 items-center lg:p-8 md:grid-cols-2 p-6 rounded-3xl">
          <div class="aspect-[4/3] group overflow-hidden relative rounded-2xl w-full">
            <img
              src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=2048&auto=format&fit=crop"
              alt="Compass"
              class="absolute duration-1000 group-hover:scale-105 h-full inset-0 object-cover transition-transform w-full"
            />
            <div class="absolute bg-brand-gold/10 dark:mix-blend-overlay inset-0 mix-blend-normal"></div>
          </div>
          <div class="lg:p-8 p-4">
            <div class="flex gap-4 items-center mb-4">
              <span class="font-bold text-brand-gold text-sm tracking-widest uppercase">{t('about.history.label')}</span>
              <div class="bg-brand-gold/30 h-px w-12"></div>
            </div>
            <h2 class="dark:text-brand-white font-bold font-display leading-tight mb-6 text-3xl text-brand-black">{t('about.history.title2')}</h2>
            <p class="dark:text-gray-400 leading-relaxed mb-4 text-gray-600 text-lg">
              {t('about.history.p1')}
            </p>
            <p class="dark:text-gray-400 leading-relaxed mb-8 text-gray-600 text-lg">
              {t('about.history.p2')}
            </p>
            <a href="#filosofia" class="border border-brand-gold/50 dark:hover:text-brand-white dark:text-gray-400 duration-300 font-bold hover:bg-brand-gold hover:text-brand-black inline-flex items-center justify-center px-6 py-3 rounded-full text-brand-gold text-gray-500 dark:text-gray-400 text-sm tracking-widest transition-colors uppercase">
              {t('about.history.btn')}
              <ChevronRight class="h-4 ml-2 w-4" />
            </a>
          </div>
        </section>

        <!-- Missao, Visao, Valores Grid -->
        <MissionVisionValues t={t} />

        <!-- Topics List -->
        <section class="space-y-4">
          {topics.map(topic => (
            <div id={topic.id} class="bg-white border border-black/5 cursor-pointer dark:bg-brand-dark-card dark:border-white/5 flex flex-col group hover:border-brand-gold/30 items-center md:flex-row md:p-8 overflow-hidden p-6 relative rounded-3xl transition-colors">
              <!-- Background Image on hover or subtly behind -->
              <div class="absolute duration-500 group-hover:opacity-30 inset-0 opacity-10 pointer-events-none transition-opacity">
                <img src={topic.image} alt={topic.title} class="dark:mix-blend-overlay h-full mix-blend-normal object-cover w-full" />
                <div class="absolute bg-gradient-to-r from-[#0f0f0f] inset-0 to-transparent via-[#0f0f0f]/80"></div>
              </div>

              <!-- Content -->
              <div class="bg-brand-gold/10 border border-brand-gold/30 flex h-16 items-center justify-center mb-4 md:mb-0 md:mr-8 relative rounded-full shrink-0 text-brand-gold w-16 z-10">
                {
                  (() => {
                    const Icon = topic.icon;
                    return <Icon class="h-8 w-8" />;
                  })()
                }
              </div>

              <div class="flex-1 md:pr-12 md:text-left pr-0 relative text-center z-10">
                <h3 class="dark:text-brand-white font-bold font-display mb-2 text-2xl text-brand-black tracking-wider uppercase">{topic.title}</h3>
                <p class="dark:text-gray-400 font-semibold text-gray-600">
                  {topic.desc}
                </p>
              </div>

              <div class="bg-white/5 dark:text-gray-400 dark:text-gray-500 group-hover:bg-brand-gold/10 group-hover:text-brand-gold h-10 hidden items-center justify-center md:flex relative rounded-full shrink-0 text-gray-500 dark:text-gray-400 transition-colors w-10 z-10">
                <ChevronRight class="h-5 w-5" />
              </div>
            </div>
          ))}
        </section>

        <!-- CTA Final -->
        <section class="bg-gradient-to-br border border-black/5 dark:border-white/5 dark:from-[#141414] dark:to-[#050505] flex flex-col from-gray-100 gap-8 items-center justify-between lg:p-16 md:flex-row overflow-hidden p-10 relative rounded-3xl to-gray-200">
          <div class="absolute inset-0 z-0">
            <!-- decorative wave or glow -->
            <div class="-translate-x-1/2 -translate-y-1/2 absolute bg-gradient-to-r from-transparent h-[1px] left-1/2 opacity-50 shadow-[0_0_50px_10px_#D4AF37] to-transparent top-1/2 via-brand-gold/20 w-full"></div>
          </div>
          <div class="flex gap-6 items-center relative z-10">
            <div class="bg-brand-gold/10 border border-brand-gold/30 h-20 hidden items-center justify-center md:flex rounded-full shrink-0 w-20">
              <Users class="h-10 text-brand-gold w-10" />
            </div>
            <div>
              <h2 class="dark:text-brand-white font-bold font-display mb-2 text-3xl text-brand-black">{t('about.cta.title')}</h2>
              <p class="dark:text-gray-400 text-gray-600 text-lg">{t('about.cta.desc')}</p>
            </div>
          </div>
          <button class="bg-brand-gold dark:text-brand-white duration-300 font-bold hover:bg-brand-gold-dark px-8 py-4 relative rounded-full shrink-0 text-brand-black text-sm tracking-widest transition-colors uppercase z-10">
            {t('about.cta.btn')}
            <ChevronRight class="-mt-0.5 h-4 inline-block ml-2 w-4" />
          </button>
        </section>

      </main>
    </div>
  </div>
</PublicLayout>
