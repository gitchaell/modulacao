---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { events, groups } from '@/data/db/schema';
import { desc, eq } from 'drizzle-orm';
import { getLangFromUrl, getPageTranslations , usePageTranslations} from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('events', lang);
const t = usePageTranslations(pageDict, lang);

const upcomingEvents = await db
  .select({
    event: events,
    group: groups,
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .orderBy(desc(events.date));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
---

<PublicLayout title={t('events.title')}>
  <div class="bg-gray-100 border-b border-gray-200 dark:bg-brand-black dark:border-white/5 overflow-hidden py-24 relative">
    <div class="absolute bg-[radial-gradient(circle_at_left,_var(--tw-gradient-stops))] from-brand-gold/10 inset-0 opacity-80 to-brand-black via-brand-black z-0"></div>
    <div class="animate-smooth-fade container max-w-6xl mx-auto px-6 relative z-10">
      <h1 class="font-bold font-display mb-6 md:text-5xl text-4xl text-brand-gold tracking-widest uppercase">{t('events.title')}</h1>
      <p class="dark:text-gray-400 font-semibold text-balance text-gray-500 text-lg">{t('events.subtitle').replace('{name}', tenantConfig.name)}</p>
    </div>
  </div>

  <section class="bg-brand-offwhite dark:bg-brand-dark min-h-[50vh] py-20">
    <div class="animate-smooth-fade container max-w-6xl mx-auto px-6 space-y-8" style="animation-delay: 0.1s;">
    {upcomingEvents.length === 0 ? (
      <div class="dark:text-gray-400 font-semibold py-20 text-center text-gray-500">
        {t('events.empty')}
      </div>
    ) : (
      <div class="gap-8 grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2">
        {upcomingEvents.map(({ event, group }) => (
          <a href={`/eventos/${event.id}`} class="block focus-visible group">
            <Card noPadding class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 flex flex-col h-full hover:border-brand-gold/50 overflow-hidden premium-shadow relative transition-all">

              <div class="absolute bg-brand-gold dark:text-brand-white font-bold px-3 py-1.5 right-4 rounded-sm shadow-lg text-brand-black text-xs top-4 tracking-wider uppercase z-10">
                 {new Date(event.date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { day: 'numeric', month: 'short' })}
              </div>

              <div class="bg-gray-50 border-b border-gray-100 dark:bg-brand-black dark:border-white/5 h-48 overflow-hidden relative">
                {event.coverImageUrl ? (
                  <img loading="lazy" decoding="async" src={event.coverImageUrl} alt={event.title} class="duration-700 ease-out group-hover:scale-105 h-full object-cover transition-transform w-full" />
                ) : (
                  <div class="absolute bg-gradient-to-br duration-700 ease-out flex from-brand-gold/5 group-hover:scale-110 inset-0 items-center justify-center text-brand-gold/20 to-transparent transition-transform">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex font-bold gap-1.5 items-center mb-3 text-brand-gold text-sm tracking-widest uppercase">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {formatDate(event.date as unknown as Date)}
                </div>
                <h2 class="dark:text-white font-bold font-display group-hover:text-brand-gold leading-tight line-clamp-2 mb-4 text-brand-black text-xl transition-colors">
                  {event.title}
                </h2>

                <div class="border-gray-100 border-t dark:border-white/5 mt-auto pt-4 space-y-3">
                  <p class="dark:text-gray-400 flex font-semibold gap-2 items-center text-gray-600 text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span class="truncate">{event.location}</span>
                  </p>
                  <p class="dark:text-gray-400 flex font-semibold gap-2 items-center text-gray-500 text-xs tracking-wider uppercase">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2"/><rect width="18" height="18" x="3" y="4" rx="2"/><circle cx="12" cy="10" r="2"/></svg>
                    {group ? group.name : t('events.global')}
                  </p>
                </div>

              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
    </div>
  </section>
</PublicLayout>