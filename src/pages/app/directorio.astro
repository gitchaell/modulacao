---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { profiles } from '@/data/db/schema';
import { desc, or, like } from 'drizzle-orm';

const query = Astro.url.searchParams.get('q') || '';

let dbQuery = db.select().from(profiles);

if (query) {
  const searchTerm = `%${query}%`;
  dbQuery = dbQuery.where(
    or(
      like(profiles.fullName, searchTerm),
      like(profiles.city, searchTerm),
      like(profiles.country, searchTerm),
      like(profiles.slug, searchTerm)
    )
  ) as any;
}

const allMembers = await dbQuery.orderBy(desc(profiles.updatedAt));
---

<AppLayout title="Directorio de Miembros">
  <div class="max-w-4xl mx-auto space-y-8">

    <!-- Cabecera y Buscador -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Directorio</h1>
        <p class="text-gray-400 mt-2 text-sm">Conoce y conecta con los miembros de Modulação.</p>
      </div>
      <form class="w-full md:w-96 flex gap-2" action="/app/directorio" method="GET">
        <Input type="search" name="q" value={query} placeholder="Buscar por nombre, país..." class="flex-1" />
        <Button type="submit" size="sm" class="h-10">Buscar</Button>
      </form>
    </div>

    <!-- Grid de Miembros -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allMembers.map((member) => (
        <a href={`/@${member.slug}`} class="block group">
          <Card class="h-full hover:border-brand-gold transition-colors text-center py-8">
            <div class="mx-auto w-24 h-24 rounded-full overflow-hidden border-2 border-brand-dark-card group-hover:border-brand-gold transition-colors mb-4 bg-brand-black flex items-center justify-center">
              {member.avatarUrl ? (
                <img src={member.avatarUrl} alt={member.fullName} class="w-full h-full object-cover" />
              ) : (
                <span class="text-3xl font-bold text-brand-gold">{member.fullName.charAt(0).toUpperCase()}</span>
              )}
            </div>
            <h3 class="font-semibold text-white group-hover:text-brand-gold transition-colors text-lg truncate px-2">{member.fullName}</h3>
            <p class="text-brand-gold text-sm truncate px-2 mb-2">@{member.slug}</p>

            {(member.city || member.country) && (
              <p class="text-gray-500 text-xs flex items-center justify-center gap-1 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {member.city}{member.city && member.country ? ', ' : ''}{member.country}
              </p>
            )}
          </Card>
        </a>
      ))}
    </div>
  </div>
</AppLayout>