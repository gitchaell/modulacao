---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import Flag from '@/components/core/Flag.astro';
import { db } from '@/data/db/db';
import { profiles } from '@/data/db/schema';
import { desc, or, like } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const query = Astro.url.searchParams.get('q') || '';

let dbQuery = db.select().from(profiles);

if (query) {
  const searchTerm = `%${query}%`;
  dbQuery = dbQuery.where(
    or(
      like(profiles.fullName, searchTerm),
      like(profiles.city, searchTerm),
      like(profiles.country, searchTerm),
      like(profiles.slug, searchTerm)
    )
  ) as any;
}

const allMembers = await dbQuery.orderBy(desc(profiles.updatedAt));
---

<AppLayout title={t('app.directory')}>
  <div class="max-w-5xl mx-auto space-y-8 animate-smooth-fade">

    <!-- Cabecera y Buscador -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">{t('app.directory')}</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-medium">Conoce y conecta con los miembros de {tenantConfig.name}.</p>
      </div>
      <form class="w-full md:w-[400px] flex gap-2 items-end" action="/app/directorio" method="GET">
        <Input type="search" name="q" value={query} placeholder="Buscar por nombre, país..." class="flex-1 h-12" />
        <Button type="submit" class="h-12 w-12 px-0 flex items-center justify-center" aria-label="Buscar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </Button>
      </form>
    </div>

    <!-- Grid de Miembros -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {allMembers.map((member) => (
        <a href={`/@${member.slug}`} class="block group focus-visible">
          <Card class="h-full text-center py-10 flex flex-col items-center border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all bg-brand-white dark:bg-brand-dark-card">
            <Avatar src={member.avatarUrl} alt={member.fullName} size="xl" fallback={member.fullName.charAt(0)} class="mb-6 group-hover:scale-110 transition-transform duration-500" />

            <h3 class="font-display font-bold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors text-xl truncate w-full px-4">{member.fullName}</h3>
            <p class="text-[11px] font-bold tracking-widest uppercase text-gray-400 group-hover:text-brand-gold dark:group-hover:text-brand-gold transition-colors truncate px-2 mt-1">@{member.slug}</p>

            {(member.city || member.country) && (
              <p class="text-gray-500 font-medium text-xs flex items-center justify-center gap-2 mt-6">
                {member.country && <Flag code={member.country} />}
                {member.city}{member.city && member.country ? ', ' : ''}{member.country}
              </p>
            )}
          </Card>
        </a>
      ))}

      {allMembers.length === 0 && (
         <div class="col-span-full py-24 text-center">
            <p class="text-lg font-medium text-gray-500 dark:text-gray-400">No se encontraron miembros con ese término de búsqueda.</p>
         </div>
      )}
    </div>
  </div>
</AppLayout>