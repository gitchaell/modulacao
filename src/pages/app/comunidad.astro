---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { posts, profiles } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';

// Obtener posts con la información del autor (perfil)
const allPosts = await db
  .select({
    post: posts,
    author: profiles
  })
  .from(posts)
  .innerJoin(profiles, eq(posts.authorId, profiles.userId))
  .orderBy(desc(posts.createdAt));

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(date));
};
---

<AppLayout title="Comunidad">
  <div class="max-w-2xl mx-auto space-y-8">

    <!-- Cabecera -->
    <div>
      <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Comunidad</h1>
      <p class="text-gray-400 mt-2 text-sm">Comparte y conéctate con otros miembros de Modulação.</p>
    </div>

    <!-- Creador de Post -->
    <Card class="bg-brand-dark shadow-xl">
      <form method="POST" action="/api/community/post" enctype="multipart/form-data" class="space-y-4">
        <textarea
          name="content"
          placeholder="¿Qué quieres compartir con la comunidad?"
          class="w-full bg-brand-black border border-brand-dark-card rounded-lg p-4 text-white focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold resize-none h-24"
          required
        ></textarea>
        <div class="flex justify-between items-center pt-2 border-t border-brand-dark-card/50">
          <div class="flex items-center gap-2">
            <label class="cursor-pointer text-gray-400 hover:text-brand-gold transition-colors flex items-center gap-2 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              <span>Añadir Imagen</span>
              <input type="file" name="image" accept="image/*" class="hidden" />
            </label>
          </div>
          <Button type="submit" size="sm">Publicar</Button>
        </div>
      </form>
    </Card>

    <!-- Feed de Posts -->
    <div class="space-y-6">
      {allPosts.length === 0 ? (
        <div class="text-center py-12 text-gray-500">
          No hay publicaciones recientes. Sé el primero en compartir algo.
        </div>
      ) : (
        allPosts.map(({ post, author }) => (
          <Card class="bg-brand-dark-card hover:border-brand-dark transition-colors">
            <div class="flex items-start gap-4">
              <a href={`/@${author.slug}`} class="flex-shrink-0">
                {author.avatarUrl ? (
                  <img src={author.avatarUrl} alt={author.fullName} class="w-12 h-12 rounded-full object-cover" />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-brand-gold/20 flex items-center justify-center text-brand-gold font-bold">
                    {author.fullName.charAt(0).toUpperCase()}
                  </div>
                )}
              </a>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <a href={`/@${author.slug}`} class="font-semibold text-white hover:text-brand-gold transition-colors truncate">
                    {author.fullName}
                  </a>
                  <span class="text-xs text-gray-500 flex-shrink-0">
                    {formatDate(post.createdAt as unknown as Date)}
                  </span>
                </div>

                <div class="text-gray-300 text-sm whitespace-pre-wrap mb-4 leading-relaxed">
                  {post.content}
                </div>

                {post.imageUrl && (
                  <div class="rounded-lg overflow-hidden border border-brand-black/50 mb-4">
                    <img src={post.imageUrl} alt="Publicación" class="w-full max-h-96 object-cover" />
                  </div>
                )}

                <div class="flex items-center gap-6 pt-3 border-t border-brand-black/50">
                  <button class="react-btn flex items-center gap-2 text-sm text-gray-400 hover:text-brand-gold transition-colors group" data-post-id={post.id}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    <span>Reaccionar</span>
                  </button>
                  <button class="comment-btn flex items-center gap-2 text-sm text-gray-400 transition-colors group cursor-not-allowed opacity-50" title="Comentarios (Próximamente)" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                    <span>Comentar</span>
                  </button>
                </div>
              </div>
            </div>
          </Card>
        ))
      )}
    </div>
  </div>

  <script>
    document.querySelectorAll('.react-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const postId = target.dataset.postId;
        if (!postId) return;

        try {
          const res = await fetch('/api/community/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId })
          });

          if (res.ok) {
            const data = await res.json();
            if(data.action === 'added') {
               target.classList.remove('text-gray-400');
               target.classList.add('text-brand-gold');
               target.querySelector('svg')?.setAttribute('fill', 'currentColor');
            } else {
               target.classList.add('text-gray-400');
               target.classList.remove('text-brand-gold');
               target.querySelector('svg')?.setAttribute('fill', 'none');
            }
          }
        } catch (err) {
          console.error(err);
        }
      });
    });
  </script>
</AppLayout>