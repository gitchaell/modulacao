---
import { getLangFromUrl } from '@/utils/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import { ArrowLeft, ChevronRight, MessageCircle, Star, ShieldCheck, HeartHandshake, Package, RotateCcw, Share2, Heart } from '@lucide/astro';

// Example Mock Data (in real life, fetch via id)
const product = {
  id: Astro.params.id,
  name: "Cápsulas de Magnésio Dimalato",
  category: "Saúde e Bem-estar",
  price: "R$ 89,90",
  originalPrice: "R$ 119,90",
  rating: 4.8,
  reviews: 124,
  description: "Suplemento de alta absorção para melhorar a energia, sono e função muscular. O Magnésio Dimalato atua diretamente no metabolismo energético celular, promovendo maior disposição e auxiliando na redução da fadiga crônica.",
  features: [
    "Alta biodisponibilidade",
    "Não causa desconforto gástrico",
    "Auxilia no funcionamento muscular",
    "Embalagem sustentável"
  ],
  images: [
    "https://images.unsplash.com/photo-1584308666744-24d5c474f2ad?w=800&q=80",
    "https://images.unsplash.com/photo-1550572017-edb799988a8d?w=800&q=80",
    "https://images.unsplash.com/photo-1577401239170-897942555fb3?w=800&q=80"
  ],
  variants: [
    { name: "Sabor", options: ["Sem Sabor", "Limão"] },
    { name: "Tamanho", options: ["60 cápsulas", "120 cápsulas"] }
  ],
  whatsappNumber: "5511999999999",
  stock: 45
};

const whatsappMessage = encodeURIComponent(`Olá! Gostaria de mais informações sobre o produto: ${product.name} (ID: ${product.id})`);
const whatsappLink = `https://wa.me/${product.whatsappNumber}?text=${whatsappMessage}`;
const lang = getLangFromUrl(Astro.cookies);
---

<AppLayout title={product.name}>
  <div class="space-y-6">

    <!-- Breadcrumbs -->
    <nav class="dark:text-gray-400 flex items-center text-gray-500 dark:text-gray-400 text-sm">
      <a href="/app/shop" class="flex hover:text-brand-gold items-center transition-colors">
        <ArrowLeft class="h-4 mr-2 w-4" />
        Loja
      </a>
      <ChevronRight class="h-4 mx-2 opacity-50 w-4" />
      <span class="dark:text-brand-white max-w-[200px] text-brand-black truncate">{product.category}</span>
      <ChevronRight class="h-4 mx-2 opacity-50 w-4" />
      <span class="max-w-[200px] text-brand-gold truncate">{product.name}</span>
    </nav>

    <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden premium-shadow rounded-2xl">
      <div class="flex flex-col lg:flex-row">

        <!-- Left Column: Image Gallery -->
        <div class="bg-gray-50 border-b border-gray-200 dark:bg-black/20 dark:bg-gray-100 dark:border-white/5 flex flex-col items-center justify-center lg:border-b-0 lg:border-r lg:p-10 lg:w-1/2 p-6 w-full">
          <div class="aspect-square bg-brand-white dark:bg-[#111] dark:bg-brand-dark-card group max-w-md mb-6 overflow-hidden premium-shadow relative rounded-xl w-full">
             <button class="absolute backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-black/50 dark:bg-gray-100 dark:border-white/10 dark:hover:text-brand-gold dark:text-gray-400 flex h-10 hover:text-brand-gold items-center justify-center right-4 rounded-full shadow-sm text-gray-500 dark:text-gray-400 top-4 transition-colors w-10 z-10">
                <Heart class="h-5 w-5" />
             </button>
            <img
              src={product.images[0]}
              alt={product.name}
              class="duration-700 group-hover:scale-105 h-full object-cover transition-transform w-full"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex gap-4 justify-start max-w-md overflow-x-auto pb-2 scrollbar-hide w-full">
            {product.images.map((img, i) => (
              <button class={`shrink-0 w-20 h-20 rounded-sm overflow-hidden border-2 transition-colors ${i === 0 ? 'border-brand-gold' : 'border-transparent hover:border-brand-gold/50'}`}>
                <img src={img} alt={`${product.name} - view ${i + 1}`} class="h-full object-cover w-full" />
              </button>
            ))}
          </div>
        </div>

        <!-- Right Column: Product Details -->
        <div class="flex flex-col lg:p-10 lg:w-1/2 p-6 w-full">
          <div class="mb-6">
            <div class="font-bold mb-2 text-brand-gold text-xs tracking-widest uppercase">{product.category}</div>
            <h1 class="dark:text-brand-white font-bold font-display leading-tight mb-4 md:text-3xl text-2xl text-brand-black">{product.name}</h1>

            <div class="flex gap-4 items-center mb-6">
              <div class="flex items-center">
                {[1, 2, 3, 4, 5].map((star) => (
                  <Star class={`w-4 h-4 ${star <= Math.floor(product.rating) ? 'fill-brand-gold text-brand-gold' : 'fill-gray-300 dark:fill-gray-700 text-gray-300 dark:text-gray-700'}`} />
                ))}
              </div>
              <span class="dark:text-brand-white font-medium text-brand-black text-sm">{product.rating}</span>
              <span class="cursor-pointer dark:text-gray-400 hover:text-brand-gold text-gray-500 dark:text-gray-400 text-sm transition-colors underline">({product.reviews} avaliações)</span>
            </div>

            <div class="flex gap-3 items-end mb-6">
              <span class="font-bold text-3xl text-brand-gold">{product.price}</span>
              {product.originalPrice && (
                <span class="dark:text-gray-400 line-through mb-1 text-gray-500 dark:text-gray-400 text-lg">{product.originalPrice}</span>
              )}
            </div>

            <p class="dark:text-gray-300 leading-relaxed mb-8 text-gray-600 text-sm">
              {product.description}
            </p>
          </div>

          <!-- Variants -->
          <div class="border-gray-200 border-t dark:border-white/5 mb-8 pt-6 space-y-6">
            {product.variants.map((variant) => (
              <div>
                <h4 class="dark:text-brand-white font-medium mb-3 text-brand-black text-sm tracking-wider uppercase">{variant.name}</h4>
                <div class="flex flex-wrap gap-3">
                  {variant.options.map((opt, i) => (
                    <button class={`px-4 py-2 rounded-sm border text-sm font-medium transition-colors ${i === 0 ? 'border-brand-gold bg-brand-gold/10 text-brand-gold' : 'border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-400 hover:border-brand-gold/50 hover:text-brand-gold'}`}>
                      {opt}
                    </button>
                  ))}
                </div>
              </div>
            ))}

             <div>
                <h4 class="dark:text-brand-white font-medium mb-3 text-brand-black text-sm tracking-wider uppercase">Quantidade</h4>
                <div class="border border-gray-200 dark:border-white/10 flex items-center max-w-[150px] overflow-hidden rounded-sm">
                  <button class="dark:hover:bg-white/5 dark:text-gray-400 flex h-10 hover:bg-gray-100 items-center justify-center text-gray-500 dark:text-gray-400 transition-colors w-10">-</button>
                  <input type="text" value="1" class="bg-transparent border-gray-200 border-x dark:border-white/10 dark:text-brand-white focus:outline-none font-medium h-10 text-brand-black text-center w-full" readonly />
                  <button class="dark:hover:bg-white/5 dark:text-gray-400 flex h-10 hover:bg-gray-100 items-center justify-center text-gray-500 dark:text-gray-400 transition-colors w-10">+</button>
                </div>
                <div class="dark:text-green-400 flex items-center mt-2 text-green-600 text-xs">
                  <ShieldCheck class="h-3 mr-1 w-3" />
                  Em estoque ({product.stock} disponíveis)
                </div>
              </div>
          </div>

          <!-- Action Buttons -->
          <div class="border-gray-200 border-t dark:border-white/5 flex flex-col gap-4 mt-auto pt-6">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-brand-gold dark:text-brand-white flex font-semibold group hover:bg-[#C5A030] items-center justify-center px-6 py-4 rounded-sm shadow-[0_0_20px_rgba(212,175,55,0.2)] text-brand-black transition-colors w-full"
            >
              <MessageCircle class="group-hover:scale-110 h-5 mr-2 transition-transform w-5" />
              COMPRAR VIA WHATSAPP
            </a>

            <div class="flex gap-4">
              <button class="bg-brand-white border border-gray-200 dark:bg-brand-dark dark:border-white/10 dark:text-brand-white flex flex-1 font-medium group hover:border-brand-gold/50 items-center justify-center px-4 py-3 rounded-sm text-brand-black transition-colors">
                <Share2 class="dark:text-gray-400 group-hover:text-brand-gold h-4 mr-2 text-gray-500 dark:text-gray-400 transition-colors w-4" />
                Compartilhar
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Additional Info Bar -->
      <div class="bg-gray-50 border-gray-200 border-t dark:bg-[#0a0a0a] dark:bg-brand-black dark:border-white/5 lg:p-8 p-6">
        <div class="gap-6 grid grid-cols-1 lg:gap-10 md:grid-cols-3">
          <div class="flex items-start">
            <Package class="h-6 mr-4 shrink-0 text-brand-gold w-6" />
            <div>
              <h4 class="dark:text-brand-white font-medium mb-1 text-brand-black text-sm">Envio para todo o país</h4>
              <p class="dark:text-gray-400 leading-relaxed text-gray-500 dark:text-gray-400 text-xs">Consulte opções e prazos no atendimento.</p>
            </div>
          </div>
          <div class="flex items-start">
            <RotateCcw class="h-6 mr-4 shrink-0 text-brand-gold w-6" />
            <div>
              <h4 class="dark:text-brand-white font-medium mb-1 text-brand-black text-sm">Trocas e Devoluções</h4>
              <p class="dark:text-gray-400 leading-relaxed text-gray-500 dark:text-gray-400 text-xs">Garantia de 7 dias após o recebimento.</p>
            </div>
          </div>
          <div class="flex items-start">
            <HeartHandshake class="h-6 mr-4 shrink-0 text-brand-gold w-6" />
            <div>
              <h4 class="dark:text-brand-white font-medium mb-1 text-brand-black text-sm">Atendimento Humanizado</h4>
              <p class="dark:text-gray-400 leading-relaxed text-gray-500 dark:text-gray-400 text-xs">Suporte dedicado para tirar suas dúvidas.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Description Tabs (Optional Expansion) -->
    <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 lg:p-10 mt-6 p-6 premium-shadow rounded-2xl">
       <div class="border-b border-gray-200 dark:border-white/5 flex gap-8 mb-6">
          <button class="border-b-2 border-brand-gold font-medium pb-4 text-brand-gold text-sm">Descrição Completa</button>
          <button class="border-b-2 border-transparent dark:hover:text-brand-white dark:text-gray-400 font-medium hover:text-brand-black pb-4 text-gray-500 dark:text-gray-400 text-sm transition-colors">Especificações</button>
       </div>

       <div class="dark:prose-invert dark:text-gray-300 leading-relaxed max-w-none prose text-gray-600 text-sm">
         <p>
            O <strong>{product.name}</strong> é desenvolvido com a mais alta tecnologia nutricional para garantir a máxima absorção e eficiência.
            Ideal para pessoas que buscam melhorar a qualidade de vida, aumentar a disposição no dia a dia e otimizar a recuperação muscular após atividades físicas.
         </p>
         <h4 class="dark:text-brand-white font-medium mb-3 mt-6 text-brand-black">Principais Benefícios:</h4>
         <ul class="list-disc pl-5 space-y-2">
            {product.features.map(feature => (
              <li>{feature}</li>
            ))}
         </ul>
       </div>
    </div>

  </div>
</AppLayout>
