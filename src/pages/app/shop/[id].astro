---
import { getLangFromUrl } from '@/utils/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import { ArrowLeft, ChevronRight, MessageCircle, Star, ShieldCheck, HeartHandshake, Package, RotateCcw, Share2, Heart } from '@lucide/astro';

// Example Mock Data (in real life, fetch via id)
const product = {
  id: Astro.params.id,
  name: "Cápsulas de Magnésio Dimalato",
  category: "Saúde e Bem-estar",
  price: "R$ 89,90",
  originalPrice: "R$ 119,90",
  rating: 4.8,
  reviews: 124,
  description: "Suplemento de alta absorção para melhorar a energia, sono e função muscular. O Magnésio Dimalato atua diretamente no metabolismo energético celular, promovendo maior disposição e auxiliando na redução da fadiga crônica.",
  features: [
    "Alta biodisponibilidade",
    "Não causa desconforto gástrico",
    "Auxilia no funcionamento muscular",
    "Embalagem sustentável"
  ],
  images: [
    "https://images.unsplash.com/photo-1584308666744-24d5c474f2ad?w=800&q=80",
    "https://images.unsplash.com/photo-1550572017-edb799988a8d?w=800&q=80",
    "https://images.unsplash.com/photo-1577401239170-897942555fb3?w=800&q=80"
  ],
  variants: [
    { name: "Sabor", options: ["Sem Sabor", "Limão"] },
    { name: "Tamanho", options: ["60 cápsulas", "120 cápsulas"] }
  ],
  whatsappNumber: "5511999999999",
  stock: 45
};

const whatsappMessage = encodeURIComponent(`Olá! Gostaria de mais informações sobre o produto: ${product.name} (ID: ${product.id})`);
const whatsappLink = `https://wa.me/${product.whatsappNumber}?text=${whatsappMessage}`;
const lang = getLangFromUrl(Astro.cookies);
---

<AppLayout title={product.name}>
  <div class="space-y-6">

    <!-- Breadcrumbs -->
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400">
      <a href="/app/shop" class="hover:text-brand-gold transition-colors flex items-center">
        <ArrowLeft class="w-4 h-4 mr-2" />
        Loja
      </a>
      <ChevronRight class="w-4 h-4 mx-2 opacity-50" />
      <span class="text-brand-black dark:text-white truncate max-w-[200px]">{product.category}</span>
      <ChevronRight class="w-4 h-4 mx-2 opacity-50" />
      <span class="text-brand-gold truncate max-w-[200px]">{product.name}</span>
    </nav>

    <div class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 rounded-2xl overflow-hidden premium-shadow">
      <div class="flex flex-col lg:flex-row">

        <!-- Left Column: Image Gallery -->
        <div class="w-full lg:w-1/2 p-6 lg:p-10 border-b lg:border-b-0 lg:border-r border-gray-200 dark:border-white/5 bg-gray-50 dark:bg-black/20 flex flex-col items-center justify-center">
          <div class="relative aspect-square w-full max-w-md rounded-xl overflow-hidden bg-brand-white dark:bg-[#111] mb-6 group premium-shadow">
             <button class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-brand-white/80 dark:bg-black/50 backdrop-blur-md flex items-center justify-center text-gray-500 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors border border-gray-200 dark:border-white/10 shadow-sm">
                <Heart class="w-5 h-5" />
             </button>
            <img
              src={product.images[0]}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex gap-4 w-full max-w-md justify-start overflow-x-auto pb-2 scrollbar-hide">
            {product.images.map((img, i) => (
              <button class={`shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 transition-colors ${i === 0 ? 'border-brand-gold' : 'border-transparent hover:border-brand-gold/50'}`}>
                <img src={img} alt={`${product.name} - view ${i + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        </div>

        <!-- Right Column: Product Details -->
        <div class="w-full lg:w-1/2 p-6 lg:p-10 flex flex-col">
          <div class="mb-6">
            <div class="text-xs font-bold text-brand-gold uppercase tracking-widest mb-2">{product.category}</div>
            <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-black dark:text-white leading-tight mb-4">{product.name}</h1>

            <div class="flex items-center gap-4 mb-6">
              <div class="flex items-center">
                {[1, 2, 3, 4, 5].map((star) => (
                  <Star class={`w-4 h-4 ${star <= Math.floor(product.rating) ? 'fill-brand-gold text-brand-gold' : 'fill-gray-300 dark:fill-gray-700 text-gray-300 dark:text-gray-700'}`} />
                ))}
              </div>
              <span class="text-sm font-medium text-brand-black dark:text-white">{product.rating}</span>
              <span class="text-sm text-gray-500 dark:text-gray-400 underline cursor-pointer hover:text-brand-gold transition-colors">({product.reviews} avaliações)</span>
            </div>

            <div class="flex items-end gap-3 mb-6">
              <span class="text-3xl font-bold text-brand-gold">{product.price}</span>
              {product.originalPrice && (
                <span class="text-lg text-gray-400 line-through mb-1">{product.originalPrice}</span>
              )}
            </div>

            <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-8">
              {product.description}
            </p>
          </div>

          <!-- Variants -->
          <div class="space-y-6 mb-8 border-t border-gray-200 dark:border-white/5 pt-6">
            {product.variants.map((variant) => (
              <div>
                <h4 class="text-sm font-medium text-brand-black dark:text-white mb-3 uppercase tracking-wider">{variant.name}</h4>
                <div class="flex flex-wrap gap-3">
                  {variant.options.map((opt, i) => (
                    <button class={`px-4 py-2 rounded-lg border text-sm font-medium transition-colors ${i === 0 ? 'border-brand-gold bg-brand-gold/10 text-brand-gold' : 'border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-400 hover:border-brand-gold/50 hover:text-brand-gold'}`}>
                      {opt}
                    </button>
                  ))}
                </div>
              </div>
            ))}

             <div>
                <h4 class="text-sm font-medium text-brand-black dark:text-white mb-3 uppercase tracking-wider">Quantidade</h4>
                <div class="flex items-center max-w-[150px] border border-gray-200 dark:border-white/10 rounded-lg overflow-hidden">
                  <button class="w-10 h-10 flex items-center justify-center text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">-</button>
                  <input type="text" value="1" class="w-full h-10 bg-transparent text-center text-brand-black dark:text-white font-medium border-x border-gray-200 dark:border-white/10 focus:outline-none" readonly />
                  <button class="w-10 h-10 flex items-center justify-center text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">+</button>
                </div>
                <div class="mt-2 text-xs text-green-600 dark:text-green-400 flex items-center">
                  <ShieldCheck class="w-3 h-3 mr-1" />
                  Em estoque ({product.stock} disponíveis)
                </div>
              </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col gap-4 mt-auto border-t border-gray-200 dark:border-white/5 pt-6">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-brand-gold hover:bg-[#C5A030] text-brand-black dark:text-brand-white font-semibold py-4 px-6 rounded-lg flex items-center justify-center transition-colors shadow-[0_0_20px_rgba(212,175,55,0.2)] group"
            >
              <MessageCircle class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" />
              COMPRAR VIA WHATSAPP
            </a>

            <div class="flex gap-4">
              <button class="flex-1 bg-brand-white dark:bg-brand-dark border border-gray-200 dark:border-white/10 hover:border-brand-gold/50 text-brand-black dark:text-white font-medium py-3 px-4 rounded-lg flex items-center justify-center transition-colors group">
                <Share2 class="w-4 h-4 mr-2 text-gray-500 dark:text-gray-400 group-hover:text-brand-gold transition-colors" />
                Compartilhar
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Additional Info Bar -->
      <div class="bg-gray-50 dark:bg-[#0a0a0a] border-t border-gray-200 dark:border-white/5 p-6 lg:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-10">
          <div class="flex items-start">
            <Package class="w-6 h-6 text-brand-gold shrink-0 mr-4" />
            <div>
              <h4 class="text-brand-black dark:text-white font-medium text-sm mb-1">Envio para todo o país</h4>
              <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Consulte opções e prazos no atendimento.</p>
            </div>
          </div>
          <div class="flex items-start">
            <RotateCcw class="w-6 h-6 text-brand-gold shrink-0 mr-4" />
            <div>
              <h4 class="text-brand-black dark:text-white font-medium text-sm mb-1">Trocas e Devoluções</h4>
              <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Garantia de 7 dias após o recebimento.</p>
            </div>
          </div>
          <div class="flex items-start">
            <HeartHandshake class="w-6 h-6 text-brand-gold shrink-0 mr-4" />
            <div>
              <h4 class="text-brand-black dark:text-white font-medium text-sm mb-1">Atendimento Humanizado</h4>
              <p class="text-gray-500 dark:text-gray-400 text-xs leading-relaxed">Suporte dedicado para tirar suas dúvidas.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Description Tabs (Optional Expansion) -->
    <div class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 rounded-2xl p-6 lg:p-10 premium-shadow mt-6">
       <div class="border-b border-gray-200 dark:border-white/5 mb-6 flex gap-8">
          <button class="pb-4 border-b-2 border-brand-gold text-brand-gold font-medium text-sm">Descrição Completa</button>
          <button class="pb-4 border-b-2 border-transparent text-gray-500 dark:text-gray-400 hover:text-brand-black dark:text-brand-white dark:hover:text-brand-black dark:text-white font-medium text-sm transition-colors">Especificações</button>
       </div>

       <div class="prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
         <p>
            O <strong>{product.name}</strong> é desenvolvido com a mais alta tecnologia nutricional para garantir a máxima absorção e eficiência.
            Ideal para pessoas que buscam melhorar a qualidade de vida, aumentar a disposição no dia a dia e otimizar a recuperação muscular após atividades físicas.
         </p>
         <h4 class="text-brand-black dark:text-white font-medium mt-6 mb-3">Principais Benefícios:</h4>
         <ul class="list-disc pl-5 space-y-2">
            {product.features.map(feature => (
              <li>{feature}</li>
            ))}
         </ul>
       </div>
    </div>

  </div>
</AppLayout>
