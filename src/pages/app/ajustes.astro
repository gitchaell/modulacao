---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { profiles, users } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import { getSession } from '@/utils/session';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const response = new Response();
const session = await getSession(Astro.request, response);

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);

if (!session.userId) {
  return Astro.redirect('/invitacion/invalid');
}

const [profile] = await db
  .select()
  .from(profiles)
  .where(eq(profiles.userId, session.userId));
---

<AppLayout title={t('app.settings')}>
  <div class="max-w-2xl mx-auto space-y-8 animate-smooth-fade">

    <div>
      <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">{t('app.settings')}</h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-semibold">Configura cómo te ven los demás miembros en {tenantConfig.name}.</p>
    </div>

    <Card class="bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md premium-shadow border border-gray-200 dark:border-white/10">
      <form method="POST" action="/api/user/update-profile" enctype="multipart/form-data" class="space-y-8">

        <!-- Avatar Upload -->
        <div class="flex items-center gap-6 pb-6 border-b border-gray-100 dark:border-white/5">
          <Avatar src={profile?.avatarUrl} alt={profile?.fullName || 'Avatar'} size="xl" fallback={(profile?.fullName || 'U').charAt(0).toUpperCase()} />
          <div>
            <label class="block text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite mb-2">Foto de Perfil</label>
            <input type="file" name="avatar" accept="image/*" class="text-sm font-semibold text-gray-500 dark:text-gray-400 file:mr-4 file:py-2.5 file:px-6 file:rounded-sm file:border-0 file:text-xs file:font-bold file:tracking-widest file:uppercase file:bg-brand-gold/10 file:text-brand-gold hover:file:bg-brand-gold hover:file:text-brand-black focus-visible file:transition-colors cursor-pointer" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Input
            name="fullName"
            label="Nombre Completo"
            value={profile?.fullName || ''}
            required
          />
          <Input
            name="slug"
            label="Usuario (Slug)"
            value={profile?.slug || ''}
            required
            pattern="[a-z0-9-]+"
            title="Solo letras minúsculas, números y guiones"
            helperText="Se usará para tu URL pública."
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Input
            name="city"
            label="Ciudad"
            value={profile?.city || ''}
          />
          <Input
            name="country"
            label="Código de País (EJ: AR)"
            value={profile?.country || ''}
            pattern="[A-Za-z]{2}"
            title="Ingresa el código ISO Alpha-2 de tu país (Ej: MX, ES, CO)"
            helperText="Usaremos esto para mostrar tu bandera."
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite">Biografía</label>
          <textarea
            name="bio"
            class="w-full bg-transparent border border-gray-300 dark:border-gray-700 rounded-sm p-4 text-sm text-brand-black dark:text-white placeholder:text-gray-400 focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold resize-none h-32 hover:border-brand-gold/50 transition-colors"
            placeholder="Cuéntanos un poco sobre ti..."
          >{profile?.bio || ''}</textarea>
        </div>

        <div class="pt-6 border-t border-gray-100 dark:border-white/5 flex justify-end">
          <Button type="submit">{t('common.save')}</Button>
        </div>
      </form>
    </Card>

  </div>
</AppLayout>