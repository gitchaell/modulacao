---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { groups } from '@/data/db/schema';
import { desc } from 'drizzle-orm';

const allGroups = await db
  .select()
  .from(groups)
  .orderBy(desc(groups.createdAt));
---

<AppLayout title="Grupos">
  <div class="max-w-5xl mx-auto space-y-8">

    <div>
      <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Grupos por Ciudad y País</h1>
      <p class="text-gray-400 mt-2 text-sm">Conéctate localmente. Únete a los grupos de tu área para enterarte de eventos y noticias específicas.</p>
    </div>

    {allGroups.length === 0 ? (
      <div class="text-center py-16 text-gray-500">
        No hay grupos creados actualmente.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allGroups.map((group) => (
          <a href={`/app/grupos/${group.id}`} class="block group block-card">
            <Card noPadding class="h-full hover:border-brand-gold transition-colors overflow-hidden flex flex-col">
              <div class="h-32 bg-brand-black border-b border-brand-dark/50 relative">
                {group.coverImageUrl ? (
                  <img loading="lazy" decoding="async" src={group.coverImageUrl} alt={group.name} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
                ) : (
                  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black flex items-center justify-center text-brand-gold/20">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="text-xs text-brand-gold mb-2 font-semibold tracking-wider">
                  {group.type === 'COUNTRY' ? 'GRUPO NACIONAL' : 'GRUPO LOCAL'}
                </div>
                <h2 class="text-xl font-bold text-white mb-2 group-hover:text-brand-gold transition-colors line-clamp-1">
                  {group.name}
                </h2>
                <p class="text-gray-400 text-sm line-clamp-2 mt-auto">
                  {group.description || 'Únete a este grupo para conectar con miembros locales.'}
                </p>
              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>