---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { groups } from '@/data/db/schema';
import { desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

const allGroups = await db
  .select()
  .from(groups)
  .orderBy(desc(groups.createdAt));
---

<AppLayout title={t('app.groups')}>
  <div class="animate-smooth-fade max-w-5xl mx-auto space-y-8">

    <div>
      <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">Grupos por Ciudad y País</h1>
      <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500">Conéctate localmente. Únete a los grupos de tu área en {tenantConfig.name}.</p>
    </div>

    {allGroups.length === 0 ? (
      <div class="dark:text-gray-400 font-semibold py-20 text-center text-gray-500">
        No hay grupos creados actualmente.
      </div>
    ) : (
      <div class="gap-8 grid grid-cols-1 lg:grid-cols-3 sm:grid-cols-2">
        {allGroups.map((group) => (
          <a href={`/app/grupos/${group.id}`} class="block focus-visible group">
            <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 flex flex-col h-full hover:border-brand-gold/50 overflow-hidden premium-shadow relative transition-all">
              <div class="bg-gray-50 border-b border-gray-100 dark:bg-brand-black dark:border-white/5 h-32 overflow-hidden relative">
                {group.coverImageUrl ? (
                  <img loading="lazy" decoding="async" src={group.coverImageUrl} alt={group.name} class="duration-700 ease-out group-hover:scale-105 h-full object-cover transition-transform w-full" />
                ) : (
                  <div class="absolute bg-gradient-to-br duration-700 ease-out flex from-brand-gold/5 group-hover:scale-110 inset-0 items-center justify-center text-brand-gold/20 to-transparent transition-transform">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="mb-3">
                  <Badge variant={group.type === 'COUNTRY' ? 'gold' : 'neutral'}>
                    {group.type === 'COUNTRY' ? 'Nacional' : 'Local'}
                  </Badge>
                </div>
                <h2 class="dark:text-white font-bold font-display group-hover:text-brand-gold line-clamp-1 mb-2 text-brand-black text-xl transition-colors">
                  {group.name}
                </h2>
                <p class="dark:text-gray-400 font-semibold line-clamp-2 mt-auto text-gray-600 text-sm">
                  {group.description || 'Únete a este grupo para conectar con miembros locales.'}
                </p>
              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>