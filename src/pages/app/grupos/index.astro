---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { groups } from '@/data/db/schema';
import { desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);

const allGroups = await db
  .select()
  .from(groups)
  .orderBy(desc(groups.createdAt));
---

<AppLayout title={t('app.groups')}>
  <div class="max-w-5xl mx-auto space-y-8 animate-smooth-fade">

    <div>
      <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">Grupos por Ciudad y País</h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-medium">Conéctate localmente. Únete a los grupos de tu área en {tenantConfig.name}.</p>
    </div>

    {allGroups.length === 0 ? (
      <div class="text-center py-20 text-gray-500 dark:text-gray-400 font-medium">
        No hay grupos creados actualmente.
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {allGroups.map((group) => (
          <a href={`/app/grupos/${group.id}`} class="block group focus-visible">
            <Card noPadding class="h-full border border-gray-200 dark:border-white/10 hover:border-brand-gold/50 transition-all overflow-hidden flex flex-col relative bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md premium-shadow">
              <div class="h-32 bg-gray-50 dark:bg-brand-black border-b border-gray-100 dark:border-white/5 relative overflow-hidden">
                {group.coverImageUrl ? (
                  <img loading="lazy" decoding="async" src={group.coverImageUrl} alt={group.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/5 to-transparent flex items-center justify-center text-brand-gold/20 group-hover:scale-110 transition-transform duration-700 ease-out">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="mb-3">
                  <Badge variant={group.type === 'COUNTRY' ? 'gold' : 'neutral'}>
                    {group.type === 'COUNTRY' ? 'Nacional' : 'Local'}
                  </Badge>
                </div>
                <h2 class="font-display text-xl font-bold text-brand-black dark:text-white mb-2 group-hover:text-brand-gold transition-colors line-clamp-1">
                  {group.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 mt-auto font-medium">
                  {group.description || 'Únete a este grupo para conectar con miembros locales.'}
                </p>
              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>