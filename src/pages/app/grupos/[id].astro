---
import { getLangFromUrl } from '@/utils/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { groups, groupMembers, profiles, users } from '@/data/db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;

if (!id) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const [group] = await db.select().from(groups).where(eq(groups.id, id));

if (!group) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Fetch members of this group
const membersList = await db
  .select({
    profile: profiles,
    role: groupMembers.role
  })
  .from(groupMembers)
  .innerJoin(users, eq(groupMembers.userId, users.id))
  .innerJoin(profiles, eq(users.id, profiles.userId))
  .where(eq(groupMembers.groupId, group.id));

const lang = getLangFromUrl(Astro.cookies);
---

<AppLayout title={group.name}>
  <div class="max-w-4xl mx-auto space-y-8">

    <!-- Cabecera del Grupo -->
    <div class="relative h-64 bg-gray-100 dark:bg-brand-black border border-brand-dark-card rounded-2xl overflow-hidden shadow-2xl">
       {group.coverImageUrl ? (
          <img loading="lazy" decoding="async" src={group.coverImageUrl} alt={group.name} class="w-full h-full object-cover opacity-60" />
        ) : (
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-gold/20 via-brand-black to-brand-black"></div>
        )}
        <div class="absolute inset-0 flex flex-col justify-end p-8 bg-gradient-to-t from-brand-black to-transparent">
          <div class="inline-block px-3 py-1 mb-3 text-xs font-semibold tracking-widest text-brand-black dark:text-brand-white bg-brand-gold rounded-full uppercase self-start">
            {group.type === 'COUNTRY' ? 'Grupo Nacional' : 'Grupo Local'}
          </div>
          <h1 class="text-4xl font-bold text-brand-black dark:text-white mb-2">{group.name}</h1>
          <p class="text-gray-600 dark:text-gray-300 max-w-2xl">{group.description}</p>
        </div>
    </div>

    <!-- Pestañas (Visual) -->
    <div class="flex border-b border-brand-dark-card/50">
      <button class="px-6 py-3 text-brand-gold border-b-2 border-brand-gold font-semibold">Miembros ({membersList.length})</button>
    </div>

    <!-- Lista de Miembros -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {membersList.length === 0 ? (
        <div class="col-span-full py-12 text-center text-gray-500 dark:text-gray-400">
          Aún no hay miembros en este grupo.
        </div>
      ) : (
        membersList.map(({ profile, role }) => (
          <a href={`/@${profile.slug}`} class="block focus-visible">
            <Card class="flex items-center gap-4 p-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 hover:border-brand-gold/50 transition-colors group premium-shadow">
            <div class="w-12 h-12 rounded-full overflow-hidden bg-brand-white dark:bg-brand-black flex items-center justify-center border border-gray-200 dark:border-brand-dark-card group-hover:border-brand-gold transition-colors">
              {profile.avatarUrl ? (
                <img loading="lazy" decoding="async" src={profile.avatarUrl} alt={profile.fullName} class="w-full h-full object-cover" />
              ) : (
                <span class="text-lg font-bold text-brand-gold">{profile.fullName.charAt(0).toUpperCase()}</span>
              )}
            </div>
            <div>
              <div class="font-semibold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors">{profile.fullName}</div>
              <div class="text-xs text-brand-gold flex gap-2">
                <span>@{profile.slug}</span>
                {role === 'ADMIN' && <span class="bg-brand-gold/20 text-brand-gold px-1.5 py-0.5 rounded text-xs">ADMIN</span>}
              </div>
            </div>
            </Card>
          </a>
        ))
      )}
    </div>

  </div>
</AppLayout>