---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { posts, profiles, comments } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

// Obtener posts con la información del autor (perfil)
const allPosts = await db
  .select({
    post: posts,
    author: profiles
  })
  .from(posts)
  .innerJoin(profiles, eq(posts.authorId, profiles.userId))
  .orderBy(desc(posts.createdAt));

// Get all comments with author info
const allComments = await db
  .select({
    comment: comments,
    author: profiles
  })
  .from(comments)
  .innerJoin(profiles, eq(comments.authorId, profiles.userId))
  .orderBy(comments.createdAt);

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(date));
};
---

<AppLayout title={t('app.community')}>
  <div class="animate-smooth-fade max-w-2xl mx-auto space-y-8">

    <!-- Cabecera -->
    <div>
      <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('app.community')}</h1>
      <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500 dark:text-gray-400">Comparte y conéctate con otros miembros de {tenantConfig.name}.</p>
    </div>

    <!-- Creador de Post -->
    <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow">
      <form method="POST" action="/api/community/post" enctype="multipart/form-data" class="space-y-4">
        <textarea
          name="content"
          placeholder="¿Qué quieres compartir con la comunidad?"
          class="bg-transparent border border-gray-300 dark:border-gray-700 dark:text-gray-400 dark:text-white focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold h-24 hover:border-brand-gold/50 p-4 placeholder:text-gray-500 dark:text-gray-400 resize-none rounded-sm text-brand-black transition-colors w-full"
          required
        ></textarea>
        <div class="border-gray-100 border-t dark:border-white/5 flex items-center justify-between pt-4">
          <div class="flex gap-2 items-center">
            <label class="cursor-pointer dark:text-gray-400 flex focus-visible font-semibold gap-2 hover:text-brand-gold items-center p-1 rounded-sm text-gray-500 dark:text-gray-400 text-sm tracking-wide transition-colors uppercase">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              <span>Añadir Imagen</span>
              <input type="file" name="image" accept="image/*" class="hidden" />
            </label>
          </div>
          <Button type="submit" size="sm">Publicar</Button>
        </div>
      </form>
    </Card>

    <!-- Feed de Posts -->
    <div class="space-y-8">
      {allPosts.length === 0 ? (
        <Card class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-white/5 overflow-hidden premium-shadow py-24 relative text-center">
          <div class="absolute bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] dark:from-brand-dark from-gray-50 inset-0 opacity-50 to-transparent via-transparent"></div>
          <div class="flex flex-col items-center justify-center relative z-10">
            <div class="max-w-md mb-8 mx-auto opacity-20 w-full">
              <svg viewBox="0 0 400 150" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="10" y="10" width="40" height="40" rx="20" class="dark:fill-gray-700 fill-gray-300" />
                <rect x="65" y="15" width="120" height="12" rx="4" class="dark:fill-gray-700 fill-gray-300" />
                <rect x="65" y="35" width="80" height="8" rx="4" class="dark:fill-gray-800 fill-gray-200" />
                <rect x="10" y="70" width="380" height="10" rx="4" class="dark:fill-gray-800 fill-gray-200" />
                <rect x="10" y="90" width="350" height="10" rx="4" class="dark:fill-gray-800 fill-gray-200" />
                <rect x="10" y="110" width="280" height="10" rx="4" class="dark:fill-gray-800 fill-gray-200" />
              </svg>
            </div>
            <h3 class="dark:text-white font-bold font-display mb-2 text-brand-black text-xl">Aún no hay publicaciones</h3>
            <p class="dark:text-gray-400 font-semibold text-gray-500 dark:text-gray-400 text-sm">Sé el primero en compartir algo con la comunidad {tenantConfig.name}.</p>
          </div>
        </Card>
      ) : (
        allPosts.map(({ post, author }) => (
          <Card class="backdrop-blur-sm bg-brand-white/90 border border-gray-200 dark:bg-brand-dark-card/90 dark:border-white/10 hover:border-brand-gold/50 premium-shadow transition-all">
            <div class="flex gap-4 items-start">
              <a href={`/@${author.slug}`} class="flex-shrink-0 focus-visible rounded-full">
                <Avatar src={author.avatarUrl} alt={author.fullName} size="lg" fallback={author.fullName.charAt(0)} />
              </a>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <a href={`/@${author.slug}`} class="dark:text-white font-semibold hover:text-brand-gold text-brand-black transition-colors truncate">
                    {author.fullName}
                  </a>
                  <span class="dark:text-gray-400 flex-shrink-0 text-gray-500 dark:text-gray-400 text-xs">
                    {formatDate(post.createdAt as unknown as Date)}
                  </span>
                </div>

                <div class="dark:text-gray-300 leading-relaxed mb-4 text-gray-600 text-sm whitespace-pre-wrap">
                  {post.content}
                </div>

                {post.imageUrl && (
                  <div class="border border-gray-200 dark:border-white/5 mb-6 overflow-hidden rounded-sm">
                    <img loading="lazy" decoding="async" src={post.imageUrl} alt="Publicación" class="max-h-96 object-cover w-full" />
                  </div>
                )}

                <div class="border-gray-100 border-t dark:border-white/5 flex gap-8 items-center pt-4">
                  <button class="dark:text-gray-400 flex focus-visible font-semibold gap-2 group hover:text-brand-gold items-center react-btn text-gray-500 dark:text-gray-400 text-sm tracking-wide transition-colors uppercase" data-post-id={post.id}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    <span>Reaccionar</span>
                  </button>
                  <button class="dark:text-gray-400 flex focus-visible font-semibold gap-2 group hover:text-brand-gold items-center text-gray-500 dark:text-gray-400 text-sm toggle-comments-btn tracking-wide transition-colors uppercase" data-post-id={post.id}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                    <span>Comentar ({allComments.filter(c => c.comment.postId === post.id).length})</span>
                  </button>
                </div>

                <!-- Comments Section -->
                <div id={`comments-section-${post.id}`} class="border-gray-100 border-t dark:border-white/5 hidden mt-6 pt-6">
                  <div class="mb-6 space-y-6">
                    {allComments.filter(c => c.comment.postId === post.id).map(c => (
                      <div class="flex gap-4 items-start">
                        <a href={`/@${c.author.slug}`} class="flex-shrink-0 focus-visible rounded-full">
                          <Avatar src={c.author.avatarUrl} alt={c.author.fullName} size="sm" fallback={c.author.fullName.charAt(0)} />
                        </a>
                        <div class="bg-gray-50 border border-gray-100 dark:bg-brand-black/50 dark:border-white/5 flex-1 p-4 rounded-sm">
                          <div class="flex items-center justify-between mb-2">
                            <a href={`/@${c.author.slug}`} class="dark:text-white font-semibold hover:text-brand-gold text-brand-black text-xs transition-colors">
                              {c.author.fullName}
                            </a>
                            <span class="dark:text-gray-400 font-semibold text-gray-500 dark:text-gray-400 text-xs tracking-wider uppercase">
                              {formatDate(c.comment.createdAt as unknown as Date)}
                            </span>
                          </div>
                          <p class="dark:text-gray-300 text-gray-600 text-sm whitespace-pre-wrap">{c.comment.content}</p>
                        </div>
                      </div>
                    ))}
                    {allComments.filter(c => c.comment.postId === post.id).length === 0 && (
                       <p class="dark:text-gray-400 font-semibold text-center text-gray-500 dark:text-gray-400 text-xs tracking-wide uppercase">No hay comentarios aún. ¡Sé el primero!</p>
                    )}
                  </div>

                  <!-- Comment Form -->
                  <form method="POST" action="/api/community/comment" class="flex gap-4 items-start">
                    <input type="hidden" name="postId" value={post.id} />
                    <textarea
                      name="content"
                      placeholder="Escribe un comentario..."
                      class="bg-brand-white border border-gray-300 dark:bg-brand-black/50 dark:border-gray-700 dark:text-white flex-1 focus:border-brand-gold focus:outline-none focus:ring-1 focus:ring-brand-gold hover:border-brand-gold/50 min-h-[48px] p-3 resize-none rounded-sm shadow-inner text-brand-black text-sm transition-colors"
                      required
                    ></textarea>
                    <Button type="submit" size="sm" class="h-auto self-stretch">Enviar</Button>
                  </form>
                </div>

              </div>
            </div>
          </Card>
        ))
      )}
    </div>
  </div>

  <script>
    document.querySelectorAll('.toggle-comments-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const postId = target.dataset.postId;
        const section = document.getElementById(`comments-section-${postId}`);
        if (section) {
          section.classList.toggle('hidden');
        }
      });
    });

    document.querySelectorAll('.react-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const postId = target.dataset.postId;
        if (!postId) return;

        try {
          const res = await fetch('/api/community/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId })
          });

          if (res.ok) {
            const data = await res.json();
            if(data.action === 'added') {
               target.classList.remove('text-gray-500 dark:text-gray-400');
               target.classList.add('text-brand-gold');
               target.querySelector('svg')?.setAttribute('fill', 'currentColor');
            } else {
               target.classList.add('text-gray-500 dark:text-gray-400');
               target.classList.remove('text-brand-gold');
               target.querySelector('svg')?.setAttribute('fill', 'none');
            }
          }
        } catch (err) {
          console.error(err);
        }
      });
    });
  </script>
</AppLayout>