---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { posts, profiles, comments } from '@/data/db/schema';
import { eq, desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

import CreatePostForm from '@/components/comunidade/CreatePostForm.astro';
import CommunityFeed from '@/components/comunidade/CommunityFeed.astro';


const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

// Obtener posts con la información del autor (perfil)
const allPosts = await db
  .select({
    post: posts,
    author: profiles
  })
  .from(posts)
  .innerJoin(profiles, eq(posts.authorId, profiles.userId))
  .orderBy(desc(posts.createdAt));

// Get all comments with author info
const allComments = await db
  .select({
    comment: comments,
    author: profiles
  })
  .from(comments)
  .innerJoin(profiles, eq(comments.authorId, profiles.userId))
  .orderBy(comments.createdAt);

const formatDate = (date: Date | null) => {
  if (!date) return '';
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(date));
};
---

<AppLayout title={t('app.community')}>
  <div class="animate-smooth-fade max-w-2xl mx-auto space-y-8">

    <!-- Cabecera -->
    <div>
      <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('app.community')}</h1>
      <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500 dark:text-gray-400">Comparte y conéctate con otros miembros de {tenantConfig.name}.</p>
    </div>

    <!-- Creador de Post -->
    <CreatePostForm t={t} />

    <!-- Feed de Posts -->
    <CommunityFeed allPosts={allPosts} allComments={allComments} tenantConfig={tenantConfig} formatDate={formatDate} t={t} />
  </div>

</AppLayout>