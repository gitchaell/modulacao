---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Badge from '@/components/core/Badge.astro';
import { db } from '@/data/db/db';
import { events, groups } from '@/data/db/schema';
import { desc, eq } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

const upcomingEvents = await db
  .select({
    event: events,
    group: groups,
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .orderBy(desc(events.date));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
---

<AppLayout title={t('app.events')}>
  <div class="max-w-5xl mx-auto space-y-8 animate-smooth-fade">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">Próximos Eventos</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-semibold">Descubre y participa en los eventos de la comunidad {tenantConfig.name}.</p>
      </div>
      <Button size="md" class="w-full sm:w-auto">{t('common.create')} Evento</Button>
    </div>

    {upcomingEvents.length === 0 ? (
      <div class="text-center py-20 text-gray-500 dark:text-gray-400 font-semibold">
        No hay eventos programados en este momento.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {upcomingEvents.map(({ event, group }) => (
          <a href={`/app/eventos/${event.id}`} class="block group focus-visible">
            <Card noPadding class="h-full border border-gray-200 dark:border-white/5 hover:border-brand-gold/50 transition-all overflow-hidden flex flex-col relative bg-brand-white dark:bg-brand-dark-card premium-shadow">

              <div class="absolute top-4 right-4 z-10 bg-brand-gold text-brand-black text-xs font-bold px-3 py-1.5 rounded-sm uppercase tracking-wider shadow-lg">
                 {new Date(event.date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { day: 'numeric', month: 'short' })}
              </div>

              <div class="h-48 bg-gray-50 dark:bg-brand-black border-b border-gray-100 dark:border-white/5 relative overflow-hidden">
                {event.coverImageUrl ? (
                  <img loading="lazy" decoding="async" src={event.coverImageUrl} alt={event.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/5 to-transparent flex items-center justify-center text-brand-gold/20 group-hover:scale-110 transition-transform duration-700 ease-out">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="text-sm text-brand-gold mb-3 font-bold tracking-widest uppercase flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {formatDate(event.date as unknown as Date)}
                </div>
                <h2 class="font-display text-xl font-bold text-brand-black dark:text-white mb-4 group-hover:text-brand-gold transition-colors line-clamp-2 leading-tight">
                  {event.title}
                </h2>

                <div class="mt-auto space-y-3 pt-4 border-t border-gray-100 dark:border-white/5">
                  <p class="text-gray-600 dark:text-gray-400 text-sm font-semibold flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span class="truncate">{event.location}</span>
                  </p>
                  <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2"/><rect width="18" height="18" x="3" y="4" rx="2"/><circle cx="12" cy="10" r="2"/></svg>
                    {group ? group.name : 'Evento Global'}
                  </p>
                </div>

              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>