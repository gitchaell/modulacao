---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { events, groups } from '@/data/db/schema';
import { desc, eq } from 'drizzle-orm';

const upcomingEvents = await db
  .select({
    event: events,
    group: groups,
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .orderBy(desc(events.date));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
---

<AppLayout title="Eventos">
  <div class="max-w-5xl mx-auto space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Próximos Eventos</h1>
        <p class="text-gray-400 mt-2 text-sm">Descubre y participa en los eventos de la comunidad Modulação.</p>
      </div>
      <Button size="sm" class="w-full sm:w-auto">Crear Evento</Button>
    </div>

    {upcomingEvents.length === 0 ? (
      <div class="text-center py-16 text-gray-500">
        No hay eventos programados en este momento.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {upcomingEvents.map(({ event, group }) => (
          <a href={`/app/eventos/${event.id}`} class="block group">
            <Card noPadding class="h-full hover:border-brand-gold transition-colors overflow-hidden flex flex-col relative">

              <div class="absolute top-4 right-4 z-10 bg-brand-gold text-brand-black text-xs font-bold px-3 py-1.5 rounded uppercase tracking-wider shadow-lg">
                 {new Date(event.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
              </div>

              <div class="h-40 bg-brand-black border-b border-brand-dark/50 relative">
                {event.coverImageUrl ? (
                  <img src={event.coverImageUrl} alt={event.title} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
                ) : (
                  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black flex items-center justify-center text-brand-gold/20">
                     <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="text-xs text-brand-gold mb-2 font-semibold tracking-wider flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {formatDate(event.date as unknown as Date)}
                </div>
                <h2 class="text-xl font-bold text-white mb-2 group-hover:text-brand-gold transition-colors line-clamp-2">
                  {event.title}
                </h2>

                <div class="mt-auto space-y-2">
                  <p class="text-gray-400 text-sm flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span class="truncate">{event.location}</span>
                  </p>
                  {group && (
                    <p class="text-gray-500 text-xs flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                      {group.name}
                    </p>
                  )}
                </div>

              </div>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>