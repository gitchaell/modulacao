---
import { getLangFromUrl } from '@/utils/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import Button from '@/components/core/Button.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { events, groups, eventAttendances, profiles, users } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import { getSession } from '@/utils/session';

const { id } = Astro.params;

if (!id) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Fetch event with group info
const [eventData] = await db
  .select({
    event: events,
    group: groups
  })
  .from(events)
  .leftJoin(groups, eq(events.groupId, groups.id))
  .where(eq(events.id, id));

if (!eventData) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { event, group } = eventData;

// Fetch attendees
const attendeesList = await db
  .select({
    profile: profiles,
    status: eventAttendances.status
  })
  .from(eventAttendances)
  .innerJoin(users, eq(eventAttendances.userId, users.id))
  .innerJoin(profiles, eq(users.id, profiles.userId))
  .where(eq(eventAttendances.eventId, event.id));

const attending = attendeesList.filter(a => a.status === 'ATTENDING');
const waitlist = attendeesList.filter(a => a.status === 'WAITLIST');

// Check current user status
const response = new Response();
const session = await getSession(Astro.request, response);
const currentUserAttendance = attendeesList.find(a => a.profile.userId === session.userId);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};
const lang = getLangFromUrl(Astro.cookies);
---

<AppLayout title={event.title}>
  <div class="max-w-4xl mx-auto pb-24">

    <!-- Hero Image -->
    <div class="bg-gray-100 border-2 border-gray-200 dark:bg-brand-black dark:border-brand-dark h-72 mb-8 md:h-96 overflow-hidden relative rounded-2xl shadow-xl w-full">
       {event.coverImageUrl ? (
          <img loading="lazy" decoding="async" src={event.coverImageUrl} alt={event.title} class="h-full object-cover opacity-80 w-full" />
        ) : (
          <div class="absolute bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] flex from-brand-gold/20 inset-0 items-center justify-center to-brand-black via-brand-black">
            <svg class="h-32 text-brand-gold/20 w-32" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
        )}
    </div>

    <div class="gap-8 grid grid-cols-1 lg:grid-cols-3">
      <!-- Main Info -->
      <div class="lg:col-span-2 space-y-8">
        <div>
          <div class="flex gap-3 items-center mb-4">
             <span class="bg-brand-gold dark:text-brand-white font-bold inline-block px-3 py-1 rounded text-brand-black text-xs tracking-widest uppercase">Evento</span>
             {group && (
               <a href={`/app/grupos/${group.id}`} class="font-semibold hover:underline text-brand-gold text-sm">{group.name}</a>
             )}
          </div>
          <h1 class="dark:text-white font-bold leading-tight mb-6 md:text-5xl text-4xl text-brand-black">{event.title}</h1>

          <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow">
            <div class="dark:text-gray-300 flex flex-col gap-6 p-6 sm:flex-row text-brand-black">
            <div class="flex flex-1 gap-4 items-start">
              <div class="bg-brand-gold/10 flex flex-shrink-0 h-12 items-center justify-center rounded-sm text-brand-gold w-12">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <p class="dark:text-white font-bold mb-1 text-brand-black">Fecha y Hora</p>
                <p class="capitalize text-sm">{formatDate(event.date as unknown as Date)}</p>
              </div>
            </div>

            <div class="bg-gray-200 dark:bg-white/10 hidden sm:block w-px"></div>

            <div class="flex flex-1 gap-4 items-start">
              <div class="bg-brand-gold/10 flex flex-shrink-0 h-12 items-center justify-center rounded-sm text-brand-gold w-12">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="dark:text-white font-bold mb-1 text-brand-black">Ubicación</p>
                <p class="text-sm">{event.location}</p>
                {event.mapUrl && <a href={event.mapUrl} target="_blank" rel="noopener noreferrer" class="hover:underline inline-block mt-1 text-brand-gold text-xs">Ver mapa</a>}
              </div>
            </div>
            </div>
          </Card>
        </div>

        <div>
          <h2 class="font-bold mb-4 text-2xl text-brand-gold tracking-widest uppercase">Acerca del evento</h2>
          <div class="dark:text-gray-300 leading-relaxed max-w-none prose prose-brand prose-invert text-gray-600 whitespace-pre-wrap">
            {event.description}
          </div>
        </div>

        {/* Placeholder for map */}
        {event.mapUrl && (
          <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow">
          <div class="dark:text-gray-400 flex h-64 items-center justify-center overflow-hidden relative rounded-xl text-gray-500 w-full">
             <div class="absolute bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] inset-0 opacity-10"></div>
             <p class="font-semibold text-brand-gold text-sm tracking-widest uppercase z-10">Vista del Mapa (Integración pendiente)</p>
          </div>
          </Card>
        )}

      </div>

      <!-- Sidebar / RSVP -->
      <div class="space-y-6">
        <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow sticky top-6">
          <h3 class="dark:text-white font-bold mb-6 text-brand-black text-lg tracking-wider uppercase">Asistencia</h3>

          <form method="POST" action="/api/events/attend" class="mb-8">
            <input type="hidden" name="eventId" value={event.id} />
            {currentUserAttendance ? (
              <div class="space-y-4">
                <div class="bg-brand-gold/10 border border-brand-gold/30 p-4 rounded-sm text-center">
                  <p class="font-semibold text-brand-gold text-sm">Estás en la lista de: <br/> <strong class="text-lg">{currentUserAttendance.status === 'ATTENDING' ? 'ASISTENTES' : 'ESPERA'}</strong></p>
                </div>
                <input type="hidden" name="action" value="LEAVE" />
                <Button type="submit" variant="outline" fullWidth>Cancelar Asistencia</Button>
              </div>
            ) : (
              <div class="space-y-4">
                <input type="hidden" name="action" value="JOIN" />
                <Button type="submit" variant="primary" fullWidth>Asistiré</Button>
                <p class="dark:text-gray-400 text-center text-gray-500 text-xs">Al confirmar aceptas las normas de convivencia del evento.</p>
              </div>
            )}
          </form>

          <div class="border-brand-black border-t pt-6 space-y-6">
            <div>
              <h4 class="dark:text-gray-400 flex font-bold items-center justify-between mb-3 text-gray-500 text-sm">
                ASISTENTES CONFIRMADOS <span class="bg-gray-100 dark:bg-brand-black dark:text-white px-2 py-0.5 rounded text-brand-black text-xs">{attending.length} / {event.capacity}</span>
              </h4>
              <div class="flex flex-wrap gap-2">
                {attending.slice(0, 8).map(a => (
                  <a href={`/@${a.profile.slug}`} title={a.profile.fullName}>
                    <div class="bg-brand-white border-2 border-gray-200 dark:bg-brand-black dark:border-brand-dark flex h-10 hover:border-brand-gold items-center justify-center overflow-hidden rounded-full transition-colors w-10">
                      {a.profile.avatarUrl ? (
                         <img loading="lazy" decoding="async" src={a.profile.avatarUrl} alt={a.profile.fullName} class="h-full object-cover w-full" />
                      ) : (
                        <span class="font-bold text-brand-gold text-xs">{a.profile.fullName.charAt(0).toUpperCase()}</span>
                      )}
                    </div>
                  </a>
                ))}
                {attending.length > 8 && (
                  <div class="bg-gray-100 border-2 border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-gray-400 flex h-10 items-center justify-center rounded-full text-gray-500 text-xs w-10">
                    +{attending.length - 8}
                  </div>
                )}
                {attending.length === 0 && <p class="dark:text-gray-400 text-gray-500 text-xs">Nadie confirmado aún.</p>}
              </div>
            </div>

            {waitlist.length > 0 && (
               <div class="border-gray-200 border-t dark:border-white/10 mt-6 pt-6">
                <h4 class="dark:text-gray-400 flex font-bold items-center justify-between mb-3 text-gray-500 text-sm">
                  LISTA DE ESPERA <span class="bg-gray-100 dark:bg-brand-black dark:text-white px-2 py-0.5 rounded text-brand-black text-xs">{waitlist.length}</span>
                </h4>
                <div class="flex flex-wrap gap-2">
                  {waitlist.slice(0, 8).map(a => (
                    <a href={`/@${a.profile.slug}`} title={a.profile.fullName}>
                      <div class="bg-brand-white border-2 border-gray-200 dark:bg-brand-black dark:border-brand-dark flex h-10 hover:border-brand-gold hover:opacity-100 items-center justify-center opacity-50 overflow-hidden rounded-full transition-all w-10">
                        {a.profile.avatarUrl ? (
                           <img loading="lazy" decoding="async" src={a.profile.avatarUrl} alt={a.profile.fullName} class="h-full object-cover w-full" />
                        ) : (
                          <span class="font-bold text-brand-gold text-xs">{a.profile.fullName.charAt(0).toUpperCase()}</span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </Card>
      </div>
    </div>
  </div>
</AppLayout>