---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import Flag from '@/components/core/Flag.astro';
import { db } from '@/data/db/db';
import { profiles } from '@/data/db/schema';
import { desc, or, like } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

const query = Astro.url.searchParams.get('q') || '';

let dbQuery = db.select().from(profiles);

if (query) {
  const searchTerm = `%${query}%`;
  dbQuery = dbQuery.where(
    or(
      like(profiles.fullName, searchTerm),
      like(profiles.city, searchTerm),
      like(profiles.country, searchTerm),
      like(profiles.slug, searchTerm)
    )
  ) as any;
}

const allMembers = await dbQuery.orderBy(desc(profiles.updatedAt));
---

<AppLayout title={t('app.directory')}>
  <div class="animate-smooth-fade max-w-5xl mx-auto space-y-8">

    <!-- Cabecera y Buscador -->
    <div class="flex flex-col gap-6 justify-between md:flex-row md:items-center">
      <div>
        <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('app.directory')}</h1>
        <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500">Conoce y conecta con los miembros de {tenantConfig.name}.</p>
      </div>
      <form class="flex gap-2 items-end md:w-[400px] w-full" action="/app/diretorio" method="GET">
        <Input type="search" name="q" value={query} placeholder="Buscar por nombre, país..." class="flex-1 h-12" />
        <Button type="submit" class="flex h-12 items-center justify-center px-0 w-12" aria-label="Buscar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </Button>
      </form>
    </div>

    <!-- Grid de Miembros -->
    <div class="gap-8 grid grid-cols-1 lg:grid-cols-3 sm:grid-cols-2">
      {allMembers.map((member) => (
        <a href={`/@${member.slug}`} class="block focus-visible group">
          <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 flex flex-col h-full hover:border-brand-gold/50 items-center premium-shadow py-10 text-center transition-all">
            <Avatar src={member.avatarUrl} alt={member.fullName} size="xl" fallback={member.fullName.charAt(0)}  />

            <h3 class="dark:text-white font-bold font-display group-hover:text-brand-gold px-4 text-brand-black text-xl transition-colors truncate w-full">{member.fullName}</h3>
            <p class="dark:group-hover:text-brand-gold dark:text-gray-400 font-bold group-hover:text-brand-gold mt-1 px-2 text-gray-500 text-sm tracking-widest transition-colors truncate uppercase">@{member.slug}</p>

            {(member.city || member.country) && (
              <p class="dark:text-gray-400 flex font-semibold gap-2 items-center justify-center mt-6 text-gray-500 text-xs">
                {member.country && <Flag country={member.country} />}
                {member.city}{member.city && member.country ? ', ' : ''}{member.country}
              </p>
            )}
          </Card>
        </a>
      ))}

      {allMembers.length === 0 && (
         <div class="col-span-full py-24 text-center">
            <p class="dark:text-gray-400 font-semibold text-gray-500 text-lg">{t('directory.empty')}</p>
         </div>
      )}
    </div>
  </div>
</AppLayout>