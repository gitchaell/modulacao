---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { profiles, users } from '@/data/db/schema';
import { eq } from 'drizzle-orm';
import { getSession } from '@/utils/session';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const response = new Response();
const session = await getSession(Astro.request, response);

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

if (!session.userId) {
  return Astro.redirect('/convite/invalid');
}

const [profile] = await db
  .select()
  .from(profiles)
  .where(eq(profiles.userId, session.userId));
---

<AppLayout title={t('app.settings')}>
  <div class="animate-smooth-fade max-w-2xl mx-auto space-y-8">

    <div>
      <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('app.settings')}</h1>
      <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500 dark:text-gray-400">Configura cómo te ven los demás miembros en {tenantConfig.name}.</p>
    </div>

    <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow">
      <form method="POST" action="/api/user/update-profile" enctype="multipart/form-data" class="space-y-8">

        <!-- Avatar Upload -->
        <div class="border-b border-gray-100 dark:border-white/5 flex gap-6 items-center pb-6">
          <Avatar src={profile?.avatarUrl} alt={profile?.fullName || 'Avatar'} size="xl" fallback={(profile?.fullName || 'U').charAt(0).toUpperCase()} />
          <div>
            <label class="block dark:text-brand-offwhite font-semibold mb-2 text-brand-black text-sm tracking-wide uppercase">Foto de Perfil</label>
            <input type="file" name="avatar" accept="image/*" class="cursor-pointer dark:text-brand-white dark:text-gray-400 file:bg-brand-gold/10 file:border-0 file:font-bold file:mr-4 file:px-6 file:py-2.5 file:rounded-sm file:text-brand-gold file:text-xs file:tracking-widest file:transition-colors file:uppercase focus-visible font-semibold hover:file:bg-brand-gold hover:file:text-brand-black text-gray-500 dark:text-gray-400 text-sm" />
          </div>
        </div>

        <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
          <Input
            name="fullName"
            label="Nombre Completo"
            value={profile?.fullName || ''}
            required
          />
          <Input
            name="slug"
            label="Usuario (Slug)"
            value={profile?.slug || ''}
            required
            pattern="[a-z0-9-]+"
            title="Solo letras minúsculas, números y guiones"
            helperText="Se usará para tu URL pública."
          />
        </div>

        <div class="gap-6 grid grid-cols-1 md:grid-cols-2">
          <Input
            name="city"
            label="Ciudad"
            value={profile?.city || ''}
          />
          <Input
            name="country"
            label="Código de País (EJ: AR)"
            value={profile?.country || ''}
            pattern="[A-Za-z]{2}"
            title="Ingresa el código ISO Alpha-2 de tu país (Ej: MX, ES, CO)"
            helperText="Usaremos esto para mostrar tu bandera."
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="dark:text-brand-offwhite font-semibold text-brand-black text-sm tracking-wide uppercase">Biografía</label>
          <textarea
            name="bio"
            class="bg-transparent border border-gray-300 dark:border-gray-700 dark:text-gray-400 dark:text-white focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold h-32 hover:border-brand-gold/50 p-4 placeholder:text-gray-500 dark:text-gray-400 resize-none rounded-sm text-brand-black text-sm transition-colors w-full"
            placeholder="Cuéntanos un poco sobre ti..."
          >{profile?.bio || ''}</textarea>
        </div>

        <div class="border-gray-100 border-t dark:border-white/5 flex justify-end pt-6">
          <Button type="submit">{t('common.save')}</Button>
        </div>
      </form>
    </Card>

  </div>
</AppLayout>