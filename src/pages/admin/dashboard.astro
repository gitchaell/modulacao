---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import { db } from '@/data/db/db';
import { users, posts, events, products } from '@/data/db/schema';
import { sql } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

// Obtener estadísticas globales usando Drizzle
const [membersCount] = await db.select({ count: sql<number>`count(*)` }).from(users);
const [postsCount] = await db.select({ count: sql<number>`count(*)` }).from(posts);
const [eventsCount] = await db.select({ count: sql<number>`count(*)` }).from(events);
const [productsCount] = await db.select({ count: sql<number>`count(*)` }).from(products);
---

<AdminLayout title={t('admin.dashboard.title')}>
  <div class="space-y-8 animate-smooth-fade">

    <!-- Resumen de Estadísticas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <Card noPadding class="p-6 flex items-center gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow hover:border-brand-gold/50 transition-all">
        <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('admin.dashboard.stats.members')}</p>
          <p class="text-2xl font-display font-bold text-brand-black dark:text-white mt-1">{membersCount.count}</p>
        </div>
      </Card>

      <Card noPadding class="p-6 flex items-center gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow hover:border-brand-gold/50 transition-all">
        <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('admin.dashboard.stats.posts')}</p>
          <p class="text-2xl font-display font-bold text-brand-black dark:text-white mt-1">{postsCount.count}</p>
        </div>
      </Card>

      <Card noPadding class="p-6 flex items-center gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow hover:border-brand-gold/50 transition-all">
        <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('admin.dashboard.stats.events')}</p>
          <p class="text-2xl font-display font-bold text-brand-black dark:text-white mt-1">{eventsCount.count}</p>
        </div>
      </Card>

      <Card noPadding class="p-6 flex items-center gap-4 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow hover:border-brand-gold/50 transition-all">
        <div class="w-12 h-12 rounded-sm bg-brand-gold/10 flex items-center justify-center text-brand-gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('admin.dashboard.stats.catalog')}</p>
          <p class="text-2xl font-display font-bold text-brand-black dark:text-white mt-1">{productsCount.count}</p>
        </div>
      </Card>
    </div>

    <!-- Actividad Rápida -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <Card class="bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow">
        <h2 class="font-display text-lg font-bold text-brand-gold uppercase tracking-wider mb-6">{t('admin.dashboard.shortcuts.title')}</h2>
        <div class="space-y-4">
          <a href="/admin/membros#invite" class="block p-4 rounded-sm bg-gray-50 dark:bg-brand-dark-card hover:bg-gray-100 dark:hover:bg-gray-100 dark:bg-brand-black border border-transparent hover:border-brand-gold/50 transition-colors focus-visible group">
            <h3 class="font-bold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors">{t('admin.members.invite_btn')}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Invita a nuevos miembros a unirse a la plataforma.</p>
          </a>
          <a href="/admin/noticias#create" class="block p-4 rounded-sm bg-gray-50 dark:bg-brand-dark-card hover:bg-gray-100 dark:hover:bg-gray-100 dark:bg-brand-black border border-transparent hover:border-brand-gold/50 transition-colors focus-visible group">
            <h3 class="font-bold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors">{t('admin.news.create_btn')}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Redacta una nueva noticia o aviso oficial.</p>
          </a>
          <a href="/admin/eventos#create" class="block p-4 rounded-sm bg-gray-50 dark:bg-brand-dark-card hover:bg-gray-100 dark:hover:bg-gray-100 dark:bg-brand-black border border-transparent hover:border-brand-gold/50 transition-colors focus-visible group">
            <h3 class="font-bold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors">{t('admin.events.create_btn')}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Configura fecha, mapa y cupos para el próximo encuentro.</p>
          </a>
        </div>
      </Card>

    </div>

  </div>
</AdminLayout>