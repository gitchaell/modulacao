---
import { getLangFromUrl } from '@/utils/i18n';
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Input from '@/components/core/Input.astro';
import Button from '@/components/core/Button.astro';
import { tenantConfig as staticConfig } from '@/config/tenant';
import { db } from '@/data/db/db';
import { tenantConfig as dbConfig } from '@/data/db/schema';
import { eq } from 'drizzle-orm';

const [currentConfig] = await db.select().from(dbConfig).where(eq(dbConfig.id, 'modulacao')).limit(1);

const config = {
  name: currentConfig?.name || staticConfig.name,
  contactEmail: currentConfig?.contactEmail || staticConfig.contactEmail,
  socials: {
    instagram: currentConfig?.instagram || staticConfig.socials.instagram,
    youtube: currentConfig?.youtube || staticConfig.socials.youtube,
    facebook: currentConfig?.facebook || staticConfig.socials.facebook,
    twitter: currentConfig?.twitter || staticConfig.socials.twitter,
  }
};

const lang = getLangFromUrl(Astro.cookies);
---

<AdminLayout title="Configuración Global">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="dark:text-white font-bold font-display text-3xl text-brand-black tracking-widest uppercase">Configuración Global</h1>
        <p class="dark:text-gray-400 font-semibold mt-1 text-gray-500">Administra la identidad y los ajustes principales de la plataforma.</p>
      </div>
    </div>

    <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow">
      <div class="p-8 space-y-8">

        <form id="config-form" method="POST" action="/api/admin/configuracion" class="space-y-8">
          <div id="form-success" class="bg-green-500/10 border border-green-500/20 font-semibold hidden p-4 rounded-sm text-green-500 text-sm">
            Configuración actualizada exitosamente.
          </div>
          <div id="form-error" class="bg-red-500/10 border border-red-500/20 font-semibold hidden p-4 rounded-sm text-red-500 text-sm">
            Ha ocurrido un error al actualizar la configuración.
          </div>

          <!-- Identidad -->
          <section>
            <h2 class="border-b border-gray-200 dark:border-brand-dark dark:text-white font-bold mb-4 pb-2 text-brand-black text-xl">Identidad de la Marca</h2>
            <div class="space-y-4">
              <div class="gap-4 grid grid-cols-1 md:grid-cols-2">
                <Input type="text" name="name" label="Nombre de la Institución" value={config.name} required minlength="3" />
                <Input type="email" name="email" label="Correo de Contacto Principal" value={config.contactEmail} required />
              </div>
              <div>
                <label class="block dark:text-brand-offwhite font-semibold mb-2 text-brand-black text-sm tracking-wide uppercase">Logotipo</label>
                <div class="flex gap-4 items-center">
                  <div class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark flex h-16 items-center justify-center rounded-sm w-16">
                    <svg class="h-8 text-brand-gold w-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  </div>
                  <Button variant="outline" type="button" size="sm">Subir Nuevo Logo</Button>
                </div>
              </div>
            </div>
          </section>

          <!-- Redes Sociales -->
          <section>
            <h2 class="border-b border-gray-200 dark:border-brand-dark dark:text-white font-bold mb-4 pb-2 text-brand-black text-xl">Redes Sociales</h2>
            <div class="space-y-4">
              <div class="gap-4 grid grid-cols-1 md:grid-cols-2">
                <Input type="url" name="instagram" label="Instagram URL" value={config.socials.instagram} placeholder="https://instagram.com/..." />
                <Input type="url" name="youtube" label="YouTube URL" value={config.socials.youtube} placeholder="https://youtube.com/..." />
                <Input type="url" name="facebook" label="Facebook URL" value={config.socials.facebook} placeholder="https://facebook.com/..." />
                <Input type="url" name="twitter" label="X (Twitter) URL" value={config.socials.twitter} placeholder="https://twitter.com/..." />
              </div>
            </div>
          </section>

          <div class="border-gray-200 border-t dark:border-brand-dark flex justify-end pt-6">
            <Button type="submit">Guardar Configuración</Button>
          </div>
        </form>

      </div>
    </Card>
  </div>

  <script>
    const form = document.getElementById('config-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (res.ok) {
            successMsg?.classList.remove('hidden');
          } else {
            const data = await res.json();
            if(errorMsg) errorMsg.textContent = data.error || 'Ha ocurrido un error al actualizar la configuración.';
            errorMsg?.classList.remove('hidden');
          }
        } catch (error) {
          if(errorMsg) errorMsg.textContent = 'Error de conexión.';
          errorMsg?.classList.remove('hidden');
        }
      });
    }
  </script>
</AdminLayout>
