---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Badge from '@/components/core/Badge.astro';
import Table from '@/components/core/Table.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { invitations, users, profiles } from '@/data/db/schema';
import { desc, eq } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);

// Fetch users
const allUsers = await db
  .select({
    user: users,
    profile: profiles
  })
  .from(users)
  .leftJoin(profiles, eq(users.id, profiles.userId))
  .orderBy(desc(users.createdAt));

// Fetch pending invitations
const pendingInvitations = await db
  .select()
  .from(invitations)
  .where(eq(invitations.status, 'PENDING'))
  .orderBy(desc(invitations.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title={t('admin.members.title')}>
  <div class="max-w-6xl mx-auto space-y-8 animate-smooth-fade">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">{t('admin.members.title')}</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-semibold">Administra los usuarios registrados y envía nuevas invitaciones.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Lista de Miembros (Ocupa 2 columnas) -->
      <Card noPadding class="lg:col-span-2 bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 overflow-hidden premium-shadow">
        <div class="p-6 border-b border-gray-200 dark:border-white/5 flex justify-between items-center bg-gray-50 dark:bg-brand-black/50">
          <h2 class="font-display text-lg font-bold text-brand-black dark:text-white uppercase tracking-wider">Usuarios Registrados</h2>
          <Badge variant="neutral">{allUsers.length}</Badge>
        </div>
        <Table headers={['Miembro', 'Email', 'Rol', 'Registro', '']}>
          {allUsers.map(({ user, profile }) => (
            <tr class="hover:bg-gray-50 dark:hover:bg-brand-dark/50 transition-colors group">
              <td class="p-4">
                <div class="flex items-center gap-4">
                  <Avatar src={profile?.avatarUrl} alt={profile?.fullName || user.email} size="sm" fallback={(profile?.fullName || user.email).charAt(0).toUpperCase()} />
                  <div>
                    <div class="font-semibold text-brand-black dark:text-white group-hover:text-brand-gold transition-colors">{profile?.fullName || 'Sin Configurar'}</div>
                    <div class="text-xs font-bold tracking-widest uppercase text-gray-500 dark:text-brand-gold mt-0.5">@{profile?.slug || 'n/a'}</div>
                  </div>
                </div>
              </td>
              <td class="p-4 text-sm font-semibold text-gray-600 dark:text-gray-300">{user.email}</td>
              <td class="p-4">
                <Badge variant={user.role === 'ADMIN' ? 'error' : 'gold'}>{user.role}</Badge>
              </td>
              <td class="p-4 text-xs font-semibold tracking-wider uppercase text-gray-400">{formatDate(user.createdAt as unknown as Date)}</td>
              <td class="p-4 text-right">
                <button class="p-2 text-gray-400 hover:text-brand-gold transition-colors focus-visible rounded-sm cursor-not-allowed opacity-50" aria-label="Gestionar Usuario" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
              </td>
            </tr>
          ))}
          {allUsers.length === 0 && (
            <tr>
              <td colspan="5" class="p-12 text-center font-semibold text-gray-500 dark:text-gray-400">No hay usuarios registrados.</td>
            </tr>
          )}
        </Table>
      </Card>

      <!-- Panel de Invitaciones -->
      <div class="space-y-6">
        <Card class="bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow" >
          <h2 class="font-display text-lg font-bold text-brand-black dark:text-white uppercase tracking-wider mb-6">{t('admin.members.invite_btn')}</h2>
          <form id="inviteForm" class="space-y-6">
            <Input type="email" id="inviteEmail" label="Correo Electrónico" placeholder="usuario@ejemplo.com" required />
            <div class="flex flex-col gap-2 w-full">
              <label class="text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite">Rol Inicial</label>
              <select id="inviteRole" class="flex h-12 w-full rounded-sm border border-gray-300 dark:border-gray-700 bg-transparent px-4 py-3 text-sm text-brand-black dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold hover:border-brand-gold/50 transition-colors">
                <option value="MEMBER" class="bg-brand-white dark:bg-brand-black">Miembro</option>
                <option value="ADMIN" class="bg-brand-white dark:bg-brand-black">Administrador</option>
              </select>
            </div>
            <Button type="submit" fullWidth class="mt-2">Generar Link</Button>
            <p id="inviteMessage" class="text-xs font-semibold text-center mt-2 hidden" role="alert"></p>
          </form>
        </Card>

        <Card class="bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 premium-shadow" noPadding>
          <div class="p-6 border-b border-gray-200 dark:border-white/5 flex justify-between items-center bg-gray-50 dark:bg-brand-black/50">
            <h2 class="text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Pendientes</h2>
            <Badge variant="neutral">{pendingInvitations.length}</Badge>
          </div>
          <ul class="divide-y divide-gray-100 dark:divide-white/5 max-h-96 overflow-y-auto">
            {pendingInvitations.map(inv => (
              <li class="p-6 hover:bg-gray-50 dark:hover:bg-brand-black/20 transition-colors">
                <div class="flex justify-between items-start mb-4">
                  <span class="text-sm text-brand-black dark:text-white font-semibold truncate mr-2">{inv.email}</span>
                  <Badge variant={inv.role === 'ADMIN' ? 'error' : 'gold'}>{inv.role}</Badge>
                </div>
                <div class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-3">Expira: {formatDate(inv.expiresAt as unknown as Date)}</div>
                <div class="flex gap-2">
                  <input type="text" readonly value={`${Astro.url.origin}/invitacion/${inv.token}`} class="flex-1 bg-gray-100 dark:bg-brand-black border border-gray-200 dark:border-gray-800 rounded-sm px-3 py-2 text-xs text-gray-500 focus:outline-none focus:ring-1 focus:ring-brand-gold" aria-label="Link de invitación" />
                </div>
              </li>
            ))}
            {pendingInvitations.length === 0 && (
              <li class="p-8 text-center text-sm font-semibold text-gray-500 dark:text-gray-400">No hay invitaciones pendientes.</li>
            )}
          </ul>
        </Card>
      </div>

    </div>
  </div>

  <script>
    // Lógica en el cliente para generar la invitación sin recargar toda la página de Admin
    const form = document.getElementById('inviteForm') as HTMLFormElement;
    const msg = document.getElementById('inviteMessage') as HTMLParagraphElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button');
        if(btn) btn.disabled = true;

        const email = (document.getElementById('inviteEmail') as HTMLInputElement).value;
        const role = (document.getElementById('inviteRole') as HTMLSelectElement).value;

        try {
          const response = await fetch('/api/auth/invite', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, role })
          });

          const data = await response.json();

          msg.classList.remove('hidden');
          if (response.ok) {
            msg.className = "text-xs text-center mt-2 text-green-400";
            msg.innerText = "Invitación generada exitosamente. Recarga la página para verla.";
            form.reset();
          } else {
            msg.className = "text-xs text-center mt-2 text-red-400";
            msg.innerText = data.error || "Error al generar la invitación.";
          }
        } catch (error) {
          msg.classList.remove('hidden');
          msg.className = "text-xs text-center mt-2 text-red-400";
          msg.innerText = "Error de red.";
        }

        if(btn) btn.disabled = false;
      });
    }
  </script>
</AdminLayout>