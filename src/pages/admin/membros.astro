---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Badge from '@/components/core/Badge.astro';
import Table from '@/components/core/Table.astro';
import Avatar from '@/components/core/Avatar.astro';
import { db } from '@/data/db/db';
import { invitations, users, profiles } from '@/data/db/schema';
import { desc, eq } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

// Fetch users
const allUsers = await db
  .select({
    user: users,
    profile: profiles
  })
  .from(users)
  .leftJoin(profiles, eq(users.id, profiles.userId))
  .orderBy(desc(users.createdAt));

// Fetch pending invitations
const pendingInvitations = await db
  .select()
  .from(invitations)
  .where(eq(invitations.status, 'PENDING'))
  .orderBy(desc(invitations.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title={t('admin.members.title')}>
  <div class="animate-smooth-fade max-w-6xl mx-auto space-y-8">

    <div class="flex flex-col gap-4 justify-between sm:flex-row sm:items-center">
      <div>
        <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('admin.members.title')}</h1>
        <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500">Administra los usuarios registrados y envía nuevas invitaciones.</p>
      </div>
    </div>

    <div class="gap-8 grid grid-cols-1 lg:grid-cols-3">

      <!-- Lista de Miembros (Ocupa 2 columnas) -->
      <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 lg:col-span-2 overflow-hidden premium-shadow">
        <div class="bg-gray-50 border-b border-gray-200 dark:bg-brand-black/50 dark:border-white/5 flex items-center justify-between p-6">
          <h2 class="dark:text-brand-white font-bold font-display text-brand-black text-lg tracking-wider uppercase">Usuarios Registrados</h2>
          <Badge variant="neutral">{allUsers.length}</Badge>
        </div>
        <Table headers={['Miembro', 'Email', 'Rol', 'Registro', '']}>
          {allUsers.map(({ user, profile }) => (
            <tr class="dark:hover:bg-brand-dark/50 group hover:bg-gray-50 transition-colors">
              <td class="p-4">
                <div class="flex gap-4 items-center">
                  <Avatar src={profile?.avatarUrl} alt={profile?.fullName || user.email} size="sm" fallback={(profile?.fullName || user.email).charAt(0).toUpperCase()} />
                  <div>
                    <div class="dark:text-brand-white font-semibold group-hover:text-brand-gold text-brand-black transition-colors">{profile?.fullName || 'Sin Configurar'}</div>
                    <div class="dark:text-brand-gold font-bold mt-0.5 text-gray-500 dark:text-gray-400 text-xs tracking-widest uppercase">@{profile?.slug || 'n/a'}</div>
                  </div>
                </div>
              </td>
              <td class="dark:text-gray-300 font-semibold p-4 text-gray-600 text-sm">{user.email}</td>
              <td class="p-4">
                <Badge variant={user.role === 'ADMIN' ? 'error' : 'gold'}>{user.role}</Badge>
              </td>
              <td class="dark:text-gray-400 font-semibold p-4 text-gray-500 text-xs tracking-wider uppercase">{formatDate(user.createdAt as unknown as Date)}</td>
              <td class="p-4 text-right">
                <button class="cursor-not-allowed dark:text-gray-400 focus-visible hover:text-brand-gold opacity-50 p-2 rounded-sm text-gray-500 transition-colors" aria-label="Gestionar Usuario" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
              </td>
            </tr>
          ))}
          {allUsers.length === 0 && (
            <tr>
              <td colspan="5" class="dark:text-gray-400 font-semibold p-12 text-center text-gray-500">No hay usuarios registrados.</td>
            </tr>
          )}
        </Table>
      </Card>

      <!-- Panel de Invitaciones -->
      <div class="space-y-6">
        <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow" >
          <h2 class="dark:text-brand-white font-bold font-display mb-6 text-brand-black text-lg tracking-wider uppercase">{t('admin.members.invite_btn')}</h2>
          <form id="inviteForm" class="space-y-6">
            <Input type="email" id="inviteEmail" label="Correo Electrónico" placeholder="usuario@ejemplo.com" required />
            <div class="flex flex-col gap-2 w-full">
              <label class="dark:text-brand-offwhite font-semibold text-brand-black text-sm tracking-wide uppercase">Rol Inicial</label>
              <select id="inviteRole" class="bg-transparent border border-gray-300 dark:border-gray-700 dark:text-brand-white flex focus:border-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold h-12 hover:border-brand-gold/50 px-4 py-3 rounded-sm text-brand-black text-sm transition-colors w-full">
                <option value="MEMBER" class="bg-brand-white dark:bg-brand-black">Miembro</option>
                <option value="ADMIN" class="bg-brand-white dark:bg-brand-black">Administrador</option>
              </select>
            </div>
            <Button type="submit" fullWidth class="mt-2">Generar Link</Button>
            <p id="inviteMessage" class="font-semibold hidden mt-2 text-center text-xs" role="alert"></p>
          </form>
        </Card>

        <Card class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 premium-shadow" noPadding>
          <div class="bg-gray-50 border-b border-gray-200 dark:bg-brand-black/50 dark:border-white/5 flex items-center justify-between p-6">
            <h2 class="dark:text-gray-300 font-bold text-gray-600 text-sm tracking-wider uppercase">Pendientes</h2>
            <Badge variant="neutral">{pendingInvitations.length}</Badge>
          </div>
          <ul class="dark:divide-white/5 divide-gray-100 divide-y max-h-96 overflow-y-auto">
            {pendingInvitations.map(inv => (
              <li class="dark:hover:bg-gray-100 dark:bg-brand-black/20 hover:bg-gray-50 p-6 transition-colors">
                <div class="flex items-start justify-between mb-4">
                  <span class="dark:text-brand-white font-semibold mr-2 text-brand-black text-sm truncate">{inv.email}</span>
                  <Badge variant={inv.role === 'ADMIN' ? 'error' : 'gold'}>{inv.role}</Badge>
                </div>
                <div class="dark:text-gray-400 font-semibold mb-3 text-gray-500 text-xs tracking-widest uppercase">Expira: {formatDate(inv.expiresAt as unknown as Date)}</div>
                <div class="flex gap-2">
                  <input type="text" readonly value={`${Astro.url.origin}/convite/${inv.token}`} class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-gray-800 dark:text-gray-400 flex-1 focus:outline-none focus:ring-1 focus:ring-brand-gold px-3 py-2 rounded-sm text-gray-500 text-xs" aria-label="Link de invitación" />
                </div>
              </li>
            ))}
            {pendingInvitations.length === 0 && (
              <li class="dark:text-gray-400 font-semibold p-8 text-center text-gray-500 text-sm">No hay invitaciones pendientes.</li>
            )}
          </ul>
        </Card>
      </div>

    </div>
  </div>

  <script>
    // Lógica en el cliente para generar la invitación sin recargar toda la página de Admin
    const form = document.getElementById('inviteForm') as HTMLFormElement;
    const msg = document.getElementById('inviteMessage') as HTMLParagraphElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button');
        if(btn) btn.disabled = true;

        const email = (document.getElementById('inviteEmail') as HTMLInputElement).value;
        const role = (document.getElementById('inviteRole') as HTMLSelectElement).value;

        try {
          const response = await fetch('/api/auth/invite', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, role })
          });

          const data = await response.json();

          msg.classList.remove('hidden');
          if (response.ok) {
            msg.className = "text-xs text-center mt-2 text-green-400";
            msg.innerText = "Invitación generada exitosamente. Recarga la página para verla.";
            form.reset();
          } else {
            msg.className = "text-xs text-center mt-2 text-red-400";
            msg.innerText = data.error || "Error al generar la invitación.";
          }
        } catch (error) {
          msg.classList.remove('hidden');
          msg.className = "text-xs text-center mt-2 text-red-400";
          msg.innerText = "Error de red.";
        }

        if(btn) btn.disabled = false;
      });
    }
  </script>
</AdminLayout>