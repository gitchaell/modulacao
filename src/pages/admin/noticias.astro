---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { desc } from 'drizzle-orm';

const allArticles = await db
  .select()
  .from(articles)
  .orderBy(desc(articles.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title="Gestión de Contenido">
  <div class="max-w-6xl mx-auto space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Noticias y Comunicados</h1>
        <p class="text-gray-400 mt-2 text-sm">Administra el blog público y la información oficial.</p>
      </div>
      <Button size="sm" class="w-full sm:w-auto" id="btn-create-news" onclick="document.getElementById('create-modal').classList.remove('hidden')">Crear Nuevo</Button>
    </div>

    <!-- Create Modal Base -->
    <div id="create-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-dark-card border border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-white mb-4">Crear Nueva Publicación</h2>
        <form method="POST" action="/api/admin/news/create" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Tipo</label>
            <select name="type" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white">
              <option value="NEWS">Noticia</option>
              <option value="COMMUNIQUE">Comunicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Título</label>
            <input type="text" name="title" required class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Contenido (Borrador)</label>
            <textarea name="content" required rows="4" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('create-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Guardar Borrador</Button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Modal Base -->
    <div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-dark-card border border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-white mb-4">Editar Publicación</h2>
        <form method="POST" action="/api/admin/news/update" class="space-y-4">
          <input type="hidden" name="id" id="edit-id" />
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Tipo</label>
            <select name="type" id="edit-type" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white">
              <option value="NEWS">Noticia</option>
              <option value="COMMUNIQUE">Comunicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Estado</label>
            <select name="status" id="edit-status" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white">
              <option value="DRAFT">Borrador</option>
              <option value="PUBLISHED">Publicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Título</label>
            <input type="text" name="title" id="edit-title" required class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Contenido</label>
            <textarea name="content" id="edit-content" required rows="4" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('edit-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Actualizar</Button>
          </div>
        </form>
      </div>
    </div>

    <Card noPadding class="bg-brand-black border-brand-dark-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-brand-dark border-b border-brand-dark-card text-xs uppercase tracking-wider text-gray-400">
              <th class="p-4 font-medium">Título</th>
              <th class="p-4 font-medium">Tipo</th>
              <th class="p-4 font-medium">Estado</th>
              <th class="p-4 font-medium">Fecha Pub.</th>
              <th class="p-4 font-medium text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-dark-card">
            {allArticles.map((article) => (
              <tr class="hover:bg-brand-dark/50 transition-colors group">
                <td class="p-4">
                  <div class="font-medium text-white line-clamp-1 group-hover:text-brand-gold transition-colors">{article.title}</div>
                  <div class="text-xs text-gray-500 truncate max-w-xs">{article.slug}</div>
                </td>
                <td class="p-4">
                  <span class={`inline-block px-2 py-1 text-[10px] font-bold rounded uppercase tracking-wider ${article.type === 'COMMUNIQUE' ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-brand-dark-card text-gray-300 border border-brand-dark'}`}>
                    {article.type === 'COMMUNIQUE' ? 'Comunicado' : 'Noticia'}
                  </span>
                </td>
                <td class="p-4">
                  <span class={`inline-flex items-center gap-1.5 text-xs font-medium ${article.status === 'PUBLISHED' ? 'text-green-400' : 'text-yellow-500'}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${article.status === 'PUBLISHED' ? 'bg-green-400' : 'bg-yellow-500'}`}></span>
                    {article.status === 'PUBLISHED' ? 'Publicado' : 'Borrador'}
                  </span>
                </td>
                <td class="p-4 text-sm text-gray-400">
                  {article.publishedAt ? formatDate(article.publishedAt as unknown as Date) : '-'}
                </td>
                <td class="p-4 text-right">
                  <div class="flex items-center justify-end gap-2 opacity-50 group-hover:opacity-100 transition-opacity">
                    {article.status === 'PUBLISHED' && (
                      <a href={`/noticias/${article.slug}`} target="_blank" class="p-1.5 text-gray-400 hover:text-white transition-colors" title="Ver Público">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                      </a>
                    )}
                    <button class="edit-article-btn p-1.5 text-brand-gold hover:text-white transition-colors" title="Editar" data-id={article.id} data-title={article.title} data-content={article.content} data-type={article.type} data-status={article.status}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </button>
                    <button class="delete-article-btn p-1.5 text-red-400 hover:text-red-300 transition-colors" title="Eliminar" data-id={article.id}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
            {allArticles.length === 0 && (
              <tr>
                <td colspan="5" class="p-12 text-center text-gray-500">
                  <div class="flex flex-col items-center justify-center gap-3">
                    <svg class="w-10 h-10 text-brand-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                    No hay contenido publicado. Crea tu primera noticia o comunicado.
                  </div>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </Card>

  </div>
  <script>
    document.querySelectorAll('.edit-article-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        const title = target.dataset.title;
        const content = target.dataset.content;
        const type = target.dataset.type;
        const status = target.dataset.status;

        (document.getElementById('edit-id') as HTMLInputElement).value = id || '';
        (document.getElementById('edit-title') as HTMLInputElement).value = title || '';
        (document.getElementById('edit-content') as HTMLTextAreaElement).value = content || '';
        (document.getElementById('edit-type') as HTMLSelectElement).value = type || 'NEWS';
        (document.getElementById('edit-status') as HTMLSelectElement).value = status || 'DRAFT';

        document.getElementById('edit-modal')?.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.delete-article-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('¿Seguro que deseas eliminar este artículo?')) return;

        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        if (!id) return;

        try {
          const res = await fetch('/api/admin/news/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            alert('Error al eliminar el artículo');
          }
        } catch (err) {
          console.error(err);
        }
      });
    });
  </script>
</AdminLayout>