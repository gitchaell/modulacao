---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Badge from '@/components/core/Badge.astro';
import Table from '@/components/core/Table.astro';
import { db } from '@/data/db/db';
import { articles } from '@/data/db/schema';
import { desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

const allArticles = await db
  .select()
  .from(articles)
  .orderBy(desc(articles.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title={t('admin.news.title')}>
  <div class="max-w-6xl mx-auto space-y-8 animate-smooth-fade">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-bold uppercase tracking-widest text-brand-gold">{t('admin.news.title')}</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-base font-semibold">Administra el blog público y la información oficial de {tenantConfig.name}.</p>
      </div>
      <Button size="md" class="w-full sm:w-auto" id="btn-create-news" onclick="document.getElementById('create-modal').classList.remove('hidden')">{t('admin.news.create_btn')}</Button>
    </div>

    <!-- Create Modal Base -->
    <div id="create-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-brand-black dark:text-white mb-4">Crear Nueva Publicación</h2>
        <form method="POST" action="/api/admin/news/create" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Tipo</label>
            <select name="type" class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white">
              <option value="NEWS">Noticia</option>
              <option value="COMMUNIQUE">Comunicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Título</label>
            <input type="text" name="title" required class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Contenido (Borrador)</label>
            <textarea name="content" required rows="4" class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('create-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Guardar Borrador</Button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Modal Base -->
    <div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-brand-black dark:text-white mb-4">Editar Publicación</h2>
        <form method="POST" action="/api/admin/news/update" class="space-y-4">
          <input type="hidden" name="id" id="edit-id" />
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Tipo</label>
            <select name="type" id="edit-type" class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white">
              <option value="NEWS">Noticia</option>
              <option value="COMMUNIQUE">Comunicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Estado</label>
            <select name="status" id="edit-status" class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white">
              <option value="DRAFT">Borrador</option>
              <option value="PUBLISHED">Publicado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Título</label>
            <input type="text" name="title" id="edit-title" required class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-1">Contenido</label>
            <textarea name="content" id="edit-content" required rows="4" class="w-full bg-gray-100 dark:bg-brand-black border border-gray-300 dark:border-brand-dark rounded-sm p-2 text-brand-black dark:text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('edit-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Actualizar</Button>
          </div>
        </form>
      </div>
    </div>

    <Card noPadding class="bg-brand-white/80 dark:bg-brand-dark-card/80 backdrop-blur-md border border-gray-200 dark:border-white/10 overflow-hidden premium-shadow">
      <Table headers={['Título', 'Tipo', 'Estado', 'Fecha Pub.', '']}>
        {allArticles.map((article) => (
          <tr class="hover:bg-gray-50 dark:hover:bg-brand-dark/50 transition-colors group">
            <td class="p-4">
              <div class="font-display font-semibold text-brand-black dark:text-brand-black dark:text-white line-clamp-1 group-hover:text-brand-gold transition-colors">{article.title}</div>
              <div class="text-xs font-bold tracking-widest text-gray-500 dark:text-gray-400 uppercase mt-0.5 truncate max-w-xs">{article.slug}</div>
            </td>
            <td class="p-4">
              <Badge variant={article.type === 'COMMUNIQUE' ? 'error' : 'neutral'}>
                {article.type === 'COMMUNIQUE' ? 'Comunicado' : 'Noticia'}
              </Badge>
            </td>
            <td class="p-4">
              <span class={`inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider ${article.status === 'PUBLISHED' ? 'text-green-500' : 'text-yellow-500'}`}>
                <span class={`w-1.5 h-1.5 rounded-full animate-pulse ${article.status === 'PUBLISHED' ? 'bg-green-500' : 'bg-yellow-500'}`}></span>
                {article.status === 'PUBLISHED' ? 'Publicado' : 'Borrador'}
              </span>
            </td>
            <td class="p-4 text-xs font-semibold tracking-wider text-gray-500 dark:text-gray-400 uppercase">
              {article.publishedAt ? formatDate(article.publishedAt as unknown as Date) : '-'}
            </td>
            <td class="p-4 text-right">
              <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
                {article.status === 'PUBLISHED' && (
                  <a href={`/noticias/${article.slug}`} target="_blank" class="p-2 rounded-sm text-gray-500 dark:text-gray-400 hover:text-brand-gold transition-colors focus-visible" aria-label="Ver Público">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                )}
                <button class="edit-article-btn p-2 rounded-sm text-gray-500 dark:text-gray-400 hover:text-brand-gold transition-colors focus-visible" data-id={article.id} data-title={article.title} data-content={article.content} data-type={article.type} data-status={article.status} aria-label="Editar">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </button>
                <form method="POST" action="/api/admin/news/delete" class="inline-block m-0 p-0" onsubmit="return confirm('¿Eliminar este artículo?')">
                  <input type="hidden" name="id" value={article.id} />
                  <button type="submit" class="delete-article-btn p-2 rounded-sm text-gray-500 dark:text-gray-400 hover:text-red-500 transition-colors focus-visible" aria-label="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {allArticles.length === 0 && (
          <tr>
            <td colspan="5" class="p-12 text-center text-gray-500 dark:text-gray-400 font-semibold">
              <div class="flex flex-col items-center justify-center gap-3">
                <svg class="w-10 h-10 text-gray-300 dark:text-gray-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                No hay contenido publicado. Crea tu primera noticia o comunicado.
              </div>
            </td>
          </tr>
        )}
      </Table>
    </Card>

  </div>
  <script>
    document.querySelectorAll('.edit-article-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        const title = target.dataset.title;
        const content = target.dataset.content;
        const type = target.dataset.type;
        const status = target.dataset.status;

        (document.getElementById('edit-id') as HTMLInputElement).value = id || '';
        (document.getElementById('edit-title') as HTMLInputElement).value = title || '';
        (document.getElementById('edit-content') as HTMLTextAreaElement).value = content || '';
        (document.getElementById('edit-type') as HTMLSelectElement).value = type || 'NEWS';
        (document.getElementById('edit-status') as HTMLSelectElement).value = status || 'DRAFT';

        document.getElementById('edit-modal')?.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.delete-article-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('¿Seguro que deseas eliminar este artículo?')) return;

        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        if (!id) return;

        try {
          const res = await fetch('/api/admin/news/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            alert('Error al eliminar el artículo');
          }
        } catch (err) {
          console.error(err);
        }
      });
    });
  </script>
</AdminLayout>