---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import Badge from '@/components/core/Badge.astro';
import Table from '@/components/core/Table.astro';
import { db } from '@/data/db/db';
import { products } from '@/data/db/schema';
import { desc } from 'drizzle-orm';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import { tenantConfig } from '@/config/tenant';

const lang = getLangFromUrl(Astro.cookies);
const t = await useTranslations(lang);

const allProducts = await db
  .select()
  .from(products)
  .orderBy(desc(products.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title={t('admin.catalog.title')}>
  <div class="animate-smooth-fade max-w-6xl mx-auto space-y-8">

    <div class="flex flex-col gap-4 justify-between sm:flex-row sm:items-center">
      <div>
        <h1 class="font-bold font-display text-3xl text-brand-gold tracking-widest uppercase">{t('admin.catalog.title')}</h1>
        <p class="dark:text-gray-400 font-semibold mt-2 text-base text-gray-500">Administra los productos y servicios oficiales ofrecidos a la comunidad {tenantConfig.name}.</p>
      </div>
      <Button size="md" class="sm:w-auto w-full" id="btn-add-product" onclick="document.getElementById('create-product-modal').classList.remove('hidden')">{t('admin.catalog.create_btn')}</Button>
    </div>

    <!-- Create Product Modal Base -->
    <div id="create-product-modal" class="bg-black/80 fixed flex hidden inset-0 items-center justify-center p-4 z-50">
      <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-brand-dark max-w-lg p-6 rounded-xl w-full">
        <h2 class="dark:text-white font-bold mb-4 text-brand-black text-xl">Añadir Nuevo Producto</h2>
        <form method="POST" action="/api/admin/catalog/create" class="space-y-4">
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Nombre del Producto</label>
            <input type="text" name="name" required class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Precio (Texto)</label>
            <input type="text" name="price" required placeholder="Ej: $15.00 o Consultar" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Número de WhatsApp de Contacto</label>
            <input type="text" name="whatsappNumber" required placeholder="+1234567890" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Descripción</label>
            <textarea name="description" required rows="3" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full"></textarea>
          </div>
          <div class="flex gap-2 justify-end mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('create-product-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Guardar Producto</Button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Product Modal Base -->
    <div id="edit-product-modal" class="bg-black/80 fixed flex hidden inset-0 items-center justify-center p-4 z-50">
      <div class="bg-brand-white border border-gray-200 dark:bg-brand-dark-card dark:border-brand-dark max-w-lg p-6 rounded-xl w-full">
        <h2 class="dark:text-white font-bold mb-4 text-brand-black text-xl">Editar Producto</h2>
        <form method="POST" action="/api/admin/catalog/update" class="space-y-4">
          <input type="hidden" name="id" id="edit-product-id" />
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Nombre del Producto</label>
            <input type="text" name="name" id="edit-product-name" required class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Precio (Texto)</label>
            <input type="text" name="price" id="edit-product-price" required placeholder="Ej: $15.00 o Consultar" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Número de WhatsApp de Contacto</label>
            <input type="text" name="whatsappNumber" id="edit-product-whatsapp" required placeholder="+1234567890" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full" />
          </div>
          <div>
            <label class="block dark:text-gray-300 font-semibold mb-1 text-gray-600 text-sm">Descripción</label>
            <textarea name="description" id="edit-product-description" required rows="3" class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-brand-dark dark:text-white p-2 rounded-sm text-brand-black w-full"></textarea>
          </div>
          <div class="flex gap-2 justify-end mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('edit-product-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Actualizar Producto</Button>
          </div>
        </form>
      </div>
    </div>

    <Card noPadding class="backdrop-blur-md bg-brand-white/80 border border-gray-200 dark:bg-brand-dark-card/80 dark:border-white/10 overflow-hidden premium-shadow">
      <Table headers={['Producto', 'Precio', 'Variantes', 'WhatsApp', '']}>
        {allProducts.map((product) => (
          <tr class="dark:hover:bg-brand-dark/50 group hover:bg-gray-50 transition-colors">
            <td class="p-4">
              <div class="flex gap-4 items-center">
                <div class="bg-gray-50 border border-gray-200 dark:bg-brand-black dark:border-white/5 flex flex-shrink-0 h-12 items-center justify-center overflow-hidden rounded-sm w-12">
                  {product.coverImageUrl ? (
                    <img loading="lazy" decoding="async" src={product.coverImageUrl} alt={product.name} class="duration-500 group-hover:scale-110 h-full object-cover transition-transform w-full" />
                  ) : (
                    <svg class="h-6 text-brand-gold/50 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                  )}
                </div>
                <div>
                  <div class="dark:text-white font-bold font-display group-hover:text-brand-gold mb-1 text-base text-brand-black transition-colors">{product.name}</div>
                  <div class="dark:text-gray-400 font-mono text-gray-500 text-xs tracking-wider">/{product.slug}</div>
                </div>
              </div>
            </td>
            <td class="p-4">
              <span class="font-display font-semibold text-brand-gold">{product.price}</span>
            </td>
            <td class="dark:text-gray-400 p-4 text-gray-500 text-sm">
              {product.variants && product.variants.length > 0 ? (
                <div class="flex flex-wrap gap-1">
                  {product.variants.map((v) => (
                    <span class="bg-gray-100 border border-gray-200 dark:bg-brand-black dark:border-gray-800 font-semibold px-2 py-0.5 rounded-sm text-xs tracking-wider uppercase">{v}</span>
                  ))}
                </div>
              ) : (
                <span class="dark:text-gray-400 italic text-gray-500 text-xs">Sin variantes</span>
              )}
            </td>
            <td class="dark:text-gray-400 font-mono font-semibold p-4 text-gray-500 text-xs">
              {product.whatsappNumber}
            </td>
            <td class="p-4 text-right">
              <div class="flex gap-2 group-hover:opacity-100 items-center justify-end opacity-50 transition-opacity">
                <a href={`/catalogo/${product.slug}`} target="_blank" class="dark:text-gray-400 focus-visible hover:text-brand-gold p-2 rounded-sm text-gray-500 transition-colors" aria-label="Ver Público">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
                <button class="dark:text-gray-400 edit-product-btn focus-visible hover:text-brand-gold p-2 rounded-sm text-gray-500 transition-colors" data-id={product.id} data-name={product.name} data-description={product.description} data-price={product.price} data-whatsapp={product.whatsappNumber} aria-label="Editar">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </button>
                <form method="POST" action="/api/admin/catalog/delete" class="inline-block m-0 p-0" onsubmit="return confirm('¿Eliminar este producto?')">
                  <input type="hidden" name="id" value={product.id} />
                  <button type="submit" class="dark:text-gray-400 focus-visible hover:text-red-500 p-2 rounded-sm text-gray-500 transition-colors" aria-label="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {allProducts.length === 0 && (
          <tr>
            <td colspan="5" class="dark:text-gray-400 font-semibold p-12 text-center text-gray-500">
              <div class="flex flex-col gap-3 items-center justify-center">
                <svg class="dark:text-gray-700 h-10 text-gray-600 dark:text-gray-300 w-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                El catálogo está vacío.
              </div>
            </td>
          </tr>
        )}
      </Table>
    </Card>

  </div>
  <script>
    document.querySelectorAll('.edit-product-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        const name = target.dataset.name;
        const description = target.dataset.description;
        const price = target.dataset.price;
        const whatsapp = target.dataset.whatsapp;

        (document.getElementById('edit-product-id') as HTMLInputElement).value = id || '';
        (document.getElementById('edit-product-name') as HTMLInputElement).value = name || '';
        (document.getElementById('edit-product-description') as HTMLTextAreaElement).value = description || '';
        (document.getElementById('edit-product-price') as HTMLInputElement).value = price || '';
        (document.getElementById('edit-product-whatsapp') as HTMLInputElement).value = whatsapp || '';

        document.getElementById('edit-product-modal')?.classList.remove('hidden');
      });
    });

  </script>
</AdminLayout>