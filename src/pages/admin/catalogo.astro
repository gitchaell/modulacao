---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/core/Card.astro';
import Button from '@/components/core/Button.astro';
import { db } from '@/data/db/db';
import { products } from '@/data/db/schema';
import { desc } from 'drizzle-orm';

const allProducts = await db
  .select()
  .from(products)
  .orderBy(desc(products.createdAt));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(date));
};
---

<AdminLayout title="Gestión de Catálogo">
  <div class="max-w-6xl mx-auto space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold uppercase tracking-widest text-brand-gold">Catálogo</h1>
        <p class="text-gray-400 mt-2 text-sm">Administra los productos y servicios oficiales ofrecidos a la comunidad.</p>
      </div>
      <Button size="sm" class="w-full sm:w-auto" id="btn-add-product" onclick="document.getElementById('create-product-modal').classList.remove('hidden')">Añadir Producto</Button>
    </div>

    <!-- Create Product Modal Base -->
    <div id="create-product-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-dark-card border border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-white mb-4">Añadir Nuevo Producto</h2>
        <form method="POST" action="/api/admin/catalog/create" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Nombre del Producto</label>
            <input type="text" name="name" required class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Precio (Texto)</label>
            <input type="text" name="price" required placeholder="Ej: $15.00 o Consultar" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Número de WhatsApp de Contacto</label>
            <input type="text" name="whatsappNumber" required placeholder="+1234567890" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Descripción</label>
            <textarea name="description" required rows="3" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('create-product-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Guardar Producto</Button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Product Modal Base -->
    <div id="edit-product-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
      <div class="bg-brand-dark-card border border-brand-dark rounded-xl p-6 w-full max-w-lg">
        <h2 class="text-xl font-bold text-white mb-4">Editar Producto</h2>
        <form method="POST" action="/api/admin/catalog/update" class="space-y-4">
          <input type="hidden" name="id" id="edit-product-id" />
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Nombre del Producto</label>
            <input type="text" name="name" id="edit-product-name" required class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Precio (Texto)</label>
            <input type="text" name="price" id="edit-product-price" required placeholder="Ej: $15.00 o Consultar" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Número de WhatsApp de Contacto</label>
            <input type="text" name="whatsappNumber" id="edit-product-whatsapp" required placeholder="+1234567890" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Descripción</label>
            <textarea name="description" id="edit-product-description" required rows="3" class="w-full bg-brand-black border border-brand-dark rounded-md p-2 text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button type="button" variant="ghost" onclick="document.getElementById('edit-product-modal').classList.add('hidden')">Cancelar</Button>
            <Button type="submit">Actualizar Producto</Button>
          </div>
        </form>
      </div>
    </div>

    <Card noPadding class="bg-brand-black border-brand-dark-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-brand-dark border-b border-brand-dark-card text-xs uppercase tracking-wider text-gray-400">
              <th class="p-4 font-medium">Producto</th>
              <th class="p-4 font-medium">Precio</th>
              <th class="p-4 font-medium">Variantes</th>
              <th class="p-4 font-medium">WhatsApp</th>
              <th class="p-4 font-medium text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-dark-card">
            {allProducts.map((product) => (
              <tr class="hover:bg-brand-dark/50 transition-colors group">
                <td class="p-4">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded bg-brand-dark border border-brand-dark-card flex items-center justify-center overflow-hidden flex-shrink-0">
                      {product.coverImageUrl ? (
                        <img loading="lazy" decoding="async" src={product.coverImageUrl} alt={product.name} class="w-full h-full object-cover" />
                      ) : (
                        <svg class="w-6 h-6 text-brand-gold/50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                      )}
                    </div>
                    <div>
                      <div class="font-bold text-white mb-1 group-hover:text-brand-gold transition-colors">{product.name}</div>
                      <div class="text-[10px] text-gray-500 font-mono tracking-wider">/{product.slug}</div>
                    </div>
                  </div>
                </td>
                <td class="p-4">
                  <span class="font-medium text-brand-gold">{product.price}</span>
                </td>
                <td class="p-4 text-sm text-gray-400">
                  {product.variants && product.variants.length > 0 ? (
                    <div class="flex flex-wrap gap-1">
                      {product.variants.map((v) => (
                        <span class="bg-brand-dark-card border border-brand-dark px-2 py-0.5 rounded text-[10px] uppercase tracking-wider">{v}</span>
                      ))}
                    </div>
                  ) : (
                    <span class="italic opacity-50">Sin variantes</span>
                  )}
                </td>
                <td class="p-4 text-sm text-gray-400 font-mono">
                  {product.whatsappNumber}
                </td>
                <td class="p-4 text-right">
                  <div class="flex items-center justify-end gap-2 opacity-50 group-hover:opacity-100 transition-opacity">
                    <a href={`/catalogo/${product.slug}`} target="_blank" class="p-1.5 text-gray-400 hover:text-white transition-colors" title="Ver Público">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </a>
                    <button class="edit-product-btn p-1.5 text-brand-gold hover:text-white transition-colors" title="Editar" data-id={product.id} data-name={product.name} data-description={product.description} data-price={product.price} data-whatsapp={product.whatsappNumber}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </button>
                    <button class="delete-product-btn p-1.5 text-red-400 hover:text-red-300 transition-colors" title="Eliminar" data-id={product.id}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
            {allProducts.length === 0 && (
              <tr>
                <td colspan="5" class="p-12 text-center text-gray-500">
                  <div class="flex flex-col items-center justify-center gap-3">
                    <svg class="w-10 h-10 text-brand-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                    El catálogo está vacío.
                  </div>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </Card>

  </div>
  <script>
    document.querySelectorAll('.edit-product-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        const name = target.dataset.name;
        const description = target.dataset.description;
        const price = target.dataset.price;
        const whatsapp = target.dataset.whatsapp;

        (document.getElementById('edit-product-id') as HTMLInputElement).value = id || '';
        (document.getElementById('edit-product-name') as HTMLInputElement).value = name || '';
        (document.getElementById('edit-product-description') as HTMLTextAreaElement).value = description || '';
        (document.getElementById('edit-product-price') as HTMLInputElement).value = price || '';
        (document.getElementById('edit-product-whatsapp') as HTMLInputElement).value = whatsapp || '';

        document.getElementById('edit-product-modal')?.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.delete-product-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('¿Seguro que deseas eliminar este producto?')) return;

        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        if (!id) return;

        try {
          const res = await fetch('/api/admin/catalog/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            alert('Error al eliminar el producto');
          }
        } catch (err) {
          console.error(err);
        }
      });
    });
  </script>
</AdminLayout>