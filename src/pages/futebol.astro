---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, getPageTranslations, usePageTranslations } from '@/utils/i18n';

import Hero from '@/components/futebol/Hero.astro';
import Tabs from '@/components/futebol/Tabs.astro';
import MatchList from '@/components/futebol/MatchList.astro';
import Leaderboard from '@/components/futebol/Leaderboard.astro';
import News from '@/components/futebol/News.astro';
import CTA from '@/components/futebol/CTA.astro';

const lang = getLangFromUrl(Astro.cookies);
const pageDict = await getPageTranslations('futebol', lang);
const t = usePageTranslations(pageDict, lang as any);
---

<PublicLayout title={t('meta.title') || 'Futebol - Modulação'}>
  <Hero pageDict={pageDict} lang={lang} />

  <Tabs pageDict={pageDict} lang={lang} />

  <section class="max-w-7xl mx-auto px-4 mb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5 space-y-8">
        <MatchList pageDict={pageDict} lang={lang} />
      </div>
      <div class="lg:col-span-7">
        <Leaderboard pageDict={pageDict} lang={lang} />
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 mb-16">
    <News pageDict={pageDict} lang={lang} />
  </section>

  <section class="max-w-7xl mx-auto px-4 mb-24">
    <CTA pageDict={pageDict} lang={lang} />
  </section>
</PublicLayout>
