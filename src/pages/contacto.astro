---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getLangFromUrl, useTranslations } from '@/utils/i18n';
import Button from '@/components/core/Button.astro';
import Input from '@/components/core/Input.astro';
import Card from '@/components/core/Card.astro';

const lang = getLangFromUrl(Astro.cookies);
const t = useTranslations(lang);
---
<PublicLayout title="Contacto">
  <div class="relative py-32 bg-brand-black overflow-hidden border-b border-gray-200 dark:border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-brand-black to-brand-black opacity-80 z-0"></div>
    <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl animate-smooth-fade">
      <h1 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-widest text-brand-gold mb-6">Contacto</h1>
      <p class="text-gray-400 text-xl font-semibold text-balance">Ponte en contacto con el Grupo Modulação para más información sobre nuestras actividades.</p>
    </div>
  </div>

  <section class="py-24 bg-brand-offwhite dark:bg-brand-dark min-h-[50vh]">
    <div class="container mx-auto px-6 lg:px-8 max-w-2xl space-y-16 animate-smooth-fade" style="animation-delay: 0.1s;">
      <Card noPadding class="bg-brand-white dark:bg-brand-dark-card border border-gray-200 dark:border-white/5 premium-shadow">
        <div class="p-8 md:p-12">
          <form id="contact-form" method="POST" action="/api/contacto" class="space-y-6">
            <div id="form-success" class="hidden bg-green-500/10 text-green-500 border border-green-500/20 p-4 rounded-sm text-sm font-semibold">
              Tu mensaje ha sido enviado correctamente.
            </div>
            <div id="form-error" class="hidden bg-red-500/10 text-red-500 border border-red-500/20 p-4 rounded-sm text-sm font-semibold">
              Ha ocurrido un error al enviar tu mensaje. Por favor, inténtalo de nuevo.
            </div>

            <Input type="text" name="name" label="Nombre" placeholder="Tu nombre completo" required />
            <Input type="email" name="email" label="Correo Electrónico" placeholder="tu@email.com" required />

            <div class="flex flex-col gap-2 w-full">
              <label for="message" class="text-sm font-semibold tracking-wide uppercase text-brand-black dark:text-brand-offwhite">Mensaje</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                placeholder="¿En qué podemos ayudarte?"
                class="flex w-full rounded-sm border bg-white dark:bg-brand-black/50 px-4 py-3 text-sm text-brand-black dark:text-white placeholder:text-gray-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:border-brand-gold disabled:cursor-not-allowed disabled:opacity-50 border-gray-300 dark:border-gray-700 hover:border-brand-gold/50"
              ></textarea>
            </div>

            <Button type="submit" fullWidth>Enviar Mensaje</Button>
          </form>
        </div>
      </Card>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (res.ok) {
            successMsg?.classList.remove('hidden');
            form.reset();
          } else {
            errorMsg?.classList.remove('hidden');
          }
        } catch (error) {
          errorMsg?.classList.remove('hidden');
        }
      });
    }
  </script>
</PublicLayout>
